{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"symbol","modules":[{"name":"TUIkit"}],"externalID":"s:10TUIkitView11RenderPhaseO","roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}],"navigatorTitle":[{"kind":"identifier","text":"RenderPhase"}],"title":"RenderPhase","symbolKind":"enum"},"abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/tuikit\/renderphase"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"type":"conformsTo"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"inlineContent":[{"type":"text","text":"A single frame may traverse the view tree several times before anything"},{"type":"text","text":" "},{"type":"text","text":"reaches the terminal:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout measurement"}]},{"type":"text","text":" — containers call "},{"code":"sizeThatFits","type":"codeVoice"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}],"type":"strong"},{"type":"text","text":" — the pass whose buffer becomes (or may"},{"type":"text","text":" "},{"type":"text","text":"become) the frame’s terminal output. A frame can evaluate more than"},{"type":"text","text":" "},{"type":"text","text":"one candidate: when the header height turns out different from the"},{"type":"text","text":" "},{"type":"text","text":"estimate, a correction pass re-evaluates the tree and the earlier"},{"type":"text","text":" "},{"type":"text","text":"candidate is discarded."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"text":" makes this distinction explicit on ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase"},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}],"type":"paragraph"},{"text":"Invariants","level":2,"type":"heading","anchor":"Invariants"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}]},{"type":"text","text":": no lifecycle"},{"type":"text","text":" "},{"type":"text","text":"or task mounting, no focus or handler registration, no state, cache,"},{"type":"text","text":" "},{"type":"text","text":"preference, header, status-bar, or terminal mutation. Bodies must be"},{"type":"text","text":" "},{"type":"text","text":"evaluable arbitrarily often without observable consequences."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"text":"candidate","type":"text"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Committing is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" after the final candidate is known."}]}]}]},{"text":"Classifying an effect","level":2,"type":"heading","anchor":"Classifying-an-effect"},{"inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"“Does the effect outlive the frame?”"}]}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]},{"type":"text","text":" (key handlers, preference values, status-bar items, header"},{"type":"text","text":" "},{"type":"text","text":"buffer, focus registrations): write it into the current pass’s scratch"},{"type":"text","text":" "},{"type":"text","text":"collector. The final pass’s collector replaces the live state wholesale;"},{"type":"text","text":" "},{"type":"text","text":"discarded passes are simply dropped."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Yes","type":"text"}]},{"text":" (","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"onDisappear","type":"codeVoice"},{"text":" actions, ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" mounts, ","type":"text"},{"code":"onChange","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"onPreferenceChange","type":"codeVoice"},{"text":" actions, GC liveness): record it. The frame","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"reference"},{"text":", and the frame choreography comment on","type":"text"},{"text":" ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" for where each phase begins and ends.","type":"text"}]}],"style":"note","type":"aside","name":"See Also"}]}],"references":{"doc://TUIkit/documentation/TUIkit/RenderPhase/Equatable-Implementations":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations","abstract":[],"title":"Equatable Implementations","role":"collectionGroup","url":"\/documentation\/tuikit\/renderphase\/equatable-implementations","kind":"article"},"doc://TUIkit/documentation/TUIkit/RenderContext/phase":{"role":"symbol","url":"\/documentation\/tuikit\/rendercontext\/phase","abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"kind":"symbol","title":"phase","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"phase","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10TUIkitView11RenderPhaseO","text":"RenderPhase","kind":"typeIdentifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"topic"},"doc://TUIkit/documentation/TUIkit/RenderPhase":{"role":"symbol","title":"RenderPhase","kind":"symbol","navigatorTitle":[{"text":"RenderPhase","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","url":"\/documentation\/tuikit\/renderphase","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/RenderPhase/render":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"render","kind":"identifier"}],"type":"topic","url":"\/documentation\/tuikit\/renderphase\/render","abstract":[{"type":"text","text":"Candidate-tree evaluation for the frame’s output. Effects are"},{"type":"text","text":" "},{"type":"text","text":"recorded for the frame commit, never applied directly."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","role":"symbol","kind":"symbol","title":"RenderPhase.render"},"doc://TUIkit/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/TUIkit\/SH"},"doc://TUIkit/documentation/TUIkit":{"abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","kind":"symbol","type":"topic","title":"TUIkit","url":"\/documentation\/tuikit","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"role":"collection"},"doc://TUIkit/s8SendableP":{"title":"Swift.Sendable","type":"unresolvable","identifier":"doc:\/\/TUIkit\/s8SendableP"},"doc://TUIkit/documentation/TUIkit/RenderPhase/measure":{"title":"RenderPhase.measure","url":"\/documentation\/tuikit\/renderphase\/measure","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"Layout sizing. Bodies may be evaluated arbitrarily often; no effect","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"may reach live runtime state."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"measure"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure"},"doc://TUIkit/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/TUIkit\/SQ"},"tuikit-logo.png":{"alt":"TUIkit Logo","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"type":"image","identifier":"tuikit-logo.png"}}}