{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/renderphase"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"generated":true}],"abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"kind":"symbol","metadata":{"externalID":"s:10TUIkitView11RenderPhaseO","navigatorTitle":[{"kind":"identifier","text":"RenderPhase"}],"title":"RenderPhase","roleHeading":"Enumeration","symbolKind":"enum","modules":[{"name":"TUIkit"}],"role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout measurement","type":"text"}]},{"type":"text","text":" — containers call "},{"type":"codeVoice","code":"sizeThatFits"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Candidate-tree evaluation","type":"text"}],"type":"strong"},{"text":" — the pass whose buffer becomes (or may","type":"text"},{"text":" ","type":"text"},{"text":"become) the frame’s terminal output. A frame can evaluate more than","type":"text"},{"text":" ","type":"text"},{"text":"one candidate: when the header height turns out different from the","type":"text"},{"text":" ","type":"text"},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"text":" makes this distinction explicit on ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}]},{"anchor":"Invariants","level":2,"type":"heading","text":"Invariants"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","isActive":true},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}]},{"type":"text","text":": no lifecycle"},{"type":"text","text":" "},{"type":"text","text":"or task mounting, no focus or handler registration, no state, cache,"},{"type":"text","text":" "},{"type":"text","text":"preference, header, status-bar, or terminal mutation. Bodies must be"},{"type":"text","text":" "},{"type":"text","text":"evaluable arbitrarily often without observable consequences."}]}]},{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","type":"reference"},{"text":", effects belong to a ","type":"text"},{"inlineContent":[{"text":"candidate","type":"text"}],"type":"emphasis"},{"text":" tree. They must not be","type":"text"},{"text":" ","type":"text"},{"text":"applied to live runtime state during traversal either, because the","type":"text"},{"text":" ","type":"text"},{"text":"candidate may still be discarded by a correction pass. Instead they are","type":"text"},{"text":" ","type":"text"},{"text":"recorded and applied exactly once when the frame commits (see the","type":"text"},{"text":" ","type":"text"},{"text":"classification rule below).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Committing is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" a phase of this enum: no view body is ever","type":"text"},{"text":" ","type":"text"},{"text":"evaluated while the frame commits. The commit is an explicit step in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RenderLoop.render()"},{"text":" after the final candidate is known.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Classifying-an-effect","level":2,"type":"heading","text":"Classifying an effect"},{"type":"paragraph","inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"“Does the effect outlive the frame?”"}],"type":"strong"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"},{"text":" (key handlers, preference values, status-bar items, header","type":"text"},{"text":" ","type":"text"},{"text":"buffer, focus registrations): write it into the current pass’s scratch","type":"text"},{"text":" ","type":"text"},{"text":"collector. The final pass’s collector replaces the live state wholesale;","type":"text"},{"text":" ","type":"text"},{"text":"discarded passes are simply dropped.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Yes"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"onDisappear"},{"text":" actions, ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" mounts, ","type":"text"},{"type":"codeVoice","code":"onChange"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"onPreferenceChange"},{"text":" actions, GC liveness): record it. The frame","type":"text"},{"text":" ","type":"text"},{"text":"commit diffs the final records against persistent runtime state and","type":"text"},{"text":" ","type":"text"},{"text":"applies the difference exactly once.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}]},{"name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase"},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" for where each phase begins and ends."}]}],"type":"aside","style":"note"}]}],"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/RenderContext/phase":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","url":"\/documentation\/tuikit\/rendercontext\/phase","title":"phase","abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"phase","kind":"identifier"},{"text":": ","kind":"text"},{"text":"RenderPhase","kind":"typeIdentifier","preciseIdentifier":"s:10TUIkitView11RenderPhaseO"}],"type":"topic","role":"symbol"},"doc://TUIkit/documentation/TUIkit/RenderPhase":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"role":"symbol","title":"RenderPhase","abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"RenderPhase","kind":"identifier"}],"url":"\/documentation\/tuikit\/renderphase"},"tuikit-logo.png":{"identifier":"tuikit-logo.png","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"alt":"TUIkit Logo","type":"image"},"doc://TUIkit/documentation/TUIkit":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","type":"topic","images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"title":"TUIkit","role":"collection","url":"\/documentation\/tuikit","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/RenderPhase/measure":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","url":"\/documentation\/tuikit\/renderphase\/measure","title":"RenderPhase.measure","abstract":[{"text":"Layout sizing. Bodies may be evaluated arbitrarily often; no effect","type":"text"},{"text":" ","type":"text"},{"text":"may reach live runtime state.","type":"text"}],"kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measure","kind":"identifier"}],"type":"topic","role":"symbol"},"doc://TUIkit/SH":{"identifier":"doc:\/\/TUIkit\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://TUIkit/s8SendableP":{"identifier":"doc:\/\/TUIkit\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://TUIkit/documentation/TUIkit/RenderPhase/Equatable-Implementations":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations","url":"\/documentation\/tuikit\/renderphase\/equatable-implementations","title":"Equatable Implementations","abstract":[],"kind":"article","type":"topic","role":"collectionGroup"},"doc://TUIkit/SQ":{"type":"unresolvable","identifier":"doc:\/\/TUIkit\/SQ","title":"Swift.Equatable"},"doc://TUIkit/documentation/TUIkit/RenderPhase/render":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","url":"\/documentation\/tuikit\/renderphase\/render","title":"RenderPhase.render","abstract":[{"text":"Candidate-tree evaluation for the frame’s output. Effects are","type":"text"},{"text":" ","type":"text"},{"text":"recorded for the frame commit, never applied directly.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"render"}],"type":"topic","role":"symbol"}}}