{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout measurement"}]},{"type":"text","text":" — containers call "},{"type":"codeVoice","code":"sizeThatFits"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}]},{"type":"text","text":" — the pass whose buffer becomes (or may"},{"type":"text","text":" "},{"type":"text","text":"become) the frame’s terminal output. A frame can evaluate more than"},{"type":"text","text":" "},{"type":"text","text":"one candidate: when the header height turns out different from the"},{"type":"text","text":" "},{"type":"text","text":"estimate, a correction pass re-evaluates the tree and the earlier"},{"type":"text","text":" "},{"type":"text","text":"candidate is discarded."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"text":" makes this distinction explicit on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"reference"},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}]},{"type":"heading","text":"Invariants","anchor":"Invariants","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}]},{"type":"text","text":": no lifecycle"},{"type":"text","text":" "},{"type":"text","text":"or task mounting, no focus or handler registration, no state, cache,"},{"type":"text","text":" "},{"type":"text","text":"preference, header, status-bar, or terminal mutation. Bodies must be"},{"type":"text","text":" "},{"type":"text","text":"evaluable arbitrarily often without observable consequences."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"},{"text":", effects belong to a ","type":"text"},{"inlineContent":[{"type":"text","text":"candidate"}],"type":"emphasis"},{"text":" tree. They must not be","type":"text"},{"text":" ","type":"text"},{"text":"applied to live runtime state during traversal either, because the","type":"text"},{"text":" ","type":"text"},{"text":"candidate may still be discarded by a correction pass. Instead they are","type":"text"},{"text":" ","type":"text"},{"text":"recorded and applied exactly once when the frame commits (see the","type":"text"},{"text":" ","type":"text"},{"text":"classification rule below).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Committing is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" after the final candidate is known."}],"type":"paragraph"}]}]},{"type":"heading","text":"Classifying an effect","anchor":"Classifying-an-effect","level":2},{"type":"paragraph","inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"“Does the effect outlive the frame?”","type":"text"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]},{"type":"text","text":" (key handlers, preference values, status-bar items, header"},{"type":"text","text":" "},{"type":"text","text":"buffer, focus registrations): write it into the current pass’s scratch"},{"type":"text","text":" "},{"type":"text","text":"collector. The final pass’s collector replaces the live state wholesale;"},{"type":"text","text":" "},{"type":"text","text":"discarded passes are simply dropped."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Yes"}]},{"text":" (","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"onDisappear","type":"codeVoice"},{"text":" actions, ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" mounts, ","type":"text"},{"code":"onChange","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"onPreferenceChange","type":"codeVoice"},{"text":" actions, GC liveness): record it. The frame","type":"text"},{"text":" ","type":"text"},{"text":"commit diffs the final records against persistent runtime state and","type":"text"},{"text":" ","type":"text"},{"text":"applies the difference exactly once.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" for where each phase begins and ends."}]}],"type":"aside","name":"See Also"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tuikit\/renderphase"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"externalID":"s:10TUIkitView11RenderPhaseO","symbolKind":"enum","modules":[{"name":"TUIkit"}],"roleHeading":"Enumeration","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"title":"RenderPhase","navigatorTitle":[{"kind":"identifier","text":"RenderPhase"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase"},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"generated":true,"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementatio