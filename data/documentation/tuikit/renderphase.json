{"schemaVersion":{"major":0,"minor":3,"patch":0},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A single frame may traverse the view tree several times before anything"},{"type":"text","text":" "},{"type":"text","text":"reaches the terminal:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout measurement"}],"type":"strong"},{"text":" — containers call ","type":"text"},{"code":"sizeThatFits","type":"codeVoice"},{"text":" (or render to","type":"text"},{"text":" ","type":"text"},{"text":"measure) arbitrarily often to negotiate sizes, and ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" ","type":"text"},{"text":"performs a full sizing pass on the first frame to discover the app","type":"text"},{"text":" ","type":"text"},{"text":"header height. None of these traversals produce the frame’s output.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}],"type":"strong"},{"text":" — the pass whose buffer becomes (or may","type":"text"},{"text":" ","type":"text"},{"text":"become) the frame’s terminal output. A frame can evaluate more than","type":"text"},{"text":" ","type":"text"},{"text":"one candidate: when the header height turns out different from the","type":"text"},{"text":" ","type":"text"},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"code":"RenderPhase","type":"codeVoice"},{"text":" makes this distinction explicit on ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}],"type":"paragraph"},{"text":"Invariants","anchor":"Invariants","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","type":"reference"},{"text":", ","type":"text"},{"type":"strong","inlineContent":[{"text":"no effect may reach live runtime state","type":"text"}]},{"text":": no lifecycle","type":"text"},{"text":" ","type":"text"},{"text":"or task mounting, no focus or handler registration, no state, cache,","type":"text"},{"text":" ","type":"text"},{"text":"preference, header, status-bar, or terminal mutation. Bodies must be","type":"text"},{"text":" ","type":"text"},{"text":"evaluable arbitrarily often without observable consequences.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"text":"candidate","type":"text"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Committing is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" after the final candidate is known."}],"type":"paragraph"}]}]},{"text":"Classifying an effect","anchor":"Classifying-an-effect","type":"heading","level":2},{"inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"“Does the effect outlive the frame?”","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]},{"text":" (key handlers, preference values, status-bar items, header","type":"text"},{"text":" ","type":"text"},{"text":"buffer, focus registrations): write it into the current pass’s scratch","type":"text"},{"text":" ","type":"text"},{"text":"collector. The final pass’s collector replaces the live state wholesale;","type":"text"},{"text":" ","type":"text"},{"text":"discarded passes are simply dropped.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Yes"}]},{"type":"text","text":" ("},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"onDisappear","type":"codeVoice"},{"type":"text","text":" actions, "},{"code":".task","type":"codeVoice"},{"type":"text","text":" mounts, "},{"code":"onChange","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"onPreferenceChange","type":"codeVoice"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"This mirrors SwiftUI’s model, where per-update values are recomputed and","type":"text"},{"text":" ","type":"text"},{"text":"replaced with each committed tree, while lifetime effects derive from the","type":"text"},{"text":" ","type":"text"},{"text":"identity diff between committed trees.","type":"text"}],"type":"paragraph"},{"name":"See Also","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true,"type":"reference"},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" for where each phase begins and ends."}],"type":"paragraph"}]}]}],"sections":[],"kind":"symbol","topicSections":[{"anchor":"Enumeration-Cases","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"title":"Enumeration Cases"},{"anchor":"Default-Implementations","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"title":"Default Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/renderphase"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase"},"metadata":{"title":"RenderPhase","roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"tex