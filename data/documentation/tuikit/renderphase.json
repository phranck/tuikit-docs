{"relationshipsSections":[{"identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"kind":"symbol","abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout measurement","type":"text"}]},{"text":" — containers call ","type":"text"},{"code":"sizeThatFits","type":"codeVoice"},{"text":" (or render to","type":"text"},{"text":" ","type":"text"},{"text":"measure) arbitrarily often to negotiate sizes, and ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" ","type":"text"},{"text":"performs a full sizing pass on the first frame to discover the app","type":"text"},{"text":" ","type":"text"},{"text":"header height. None of these traversals produce the frame’s output.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}]},{"type":"text","text":" — the pass whose buffer becomes (or may"},{"type":"text","text":" "},{"type":"text","text":"become) the frame’s terminal output. A frame can evaluate more than"},{"type":"text","text":" "},{"type":"text","text":"one candidate: when the header height turns out different from the"},{"type":"text","text":" "},{"type":"text","text":"estimate, a correction pass re-evaluates the tree and the earlier"},{"type":"text","text":" "},{"type":"text","text":"candidate is discarded."}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"type":"text","text":" makes this distinction explicit on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase"},{"type":"text","text":" "},{"type":"text","text":"so that effect sites can tell sizing work apart from output work."}],"type":"paragraph"},{"text":"Invariants","anchor":"Invariants","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","type":"reference"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}],"type":"strong"},{"text":": no lifecycle","type":"text"},{"text":" ","type":"text"},{"text":"or task mounting, no focus or handler registration, no state, cache,","type":"text"},{"text":" ","type":"text"},{"text":"preference, header, status-bar, or terminal mutation. Bodies must be","type":"text"},{"text":" ","type":"text"},{"text":"evaluable arbitrarily often without observable consequences.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","isActive":true},{"text":", effects belong to a ","type":"text"},{"inlineContent":[{"text":"candidate","type":"text"}],"type":"emphasis"},{"text":" tree. They must not be","type":"text"},{"text":" ","type":"text"},{"text":"applied to live runtime state during traversal either, because the","type":"text"},{"text":" ","type":"text"},{"text":"candidate may still be discarded by a correction pass. Instead they are","type":"text"},{"text":" ","type":"text"},{"text":"recorded and applied exactly once when the frame commits (see the","type":"text"},{"text":" ","type":"text"},{"text":"classification rule below).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Committing is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" after the final candidate is known."}],"type":"paragraph"}]}]},{"text":"Classifying an effect","anchor":"Classifying-an-effect","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"When writing or reviewing an effect site, ask one question:"},{"type":"text","text":" "},{"inlineContent":[{"text":"“Does the effect outlive the frame?”","type":"text"}],"type":"strong"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]},{"type":"text","text":" (key handlers, preference values, status-bar items, header"},{"type":"text","text":" "},{"type":"text","text":"buffer, focus registrations): write it into the current pass’s scratch"},{"type":"text","text":" "},{"type":"text","text":"collector. The final pass’s collector replaces the live state wholesale;"},{"type":"text","text":" "},{"type":"text","text":"discarded passes are simply dropped."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":" actions, "},{"type":"codeVoice","code":".task"},{"type":"text","text":" mounts, "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"onPreferenceChange"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}]}]}]},{"inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"reference","isActive":true},{"text":", and the frame choreography comment on","type":"text"},{"text":" ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" for where each phase begins and ends.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"See Also"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/tuikit\/renderphase"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"modules":[{"name":"TUIkit"}],"symbolKind":"enum","roleHeading":"Enumeration","navigatorTitle":[{"text":"RenderPhase","kind":"identifier"}],"role":"symbol","externalID":"s:10TUIkitView11RenderPhaseO","title":"RenderPhase","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}]},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"title":"Enumeration Cases","generated"