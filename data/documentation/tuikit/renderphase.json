{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase"},"abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"externalID":"s:10TUIkitView11RenderPhaseO","symbolKind":"enum","modules":[{"name":"TUIkit"}],"role":"symbol","title":"RenderPhase","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}],"navigatorTitle":[{"kind":"identifier","text":"RenderPhase"}],"roleHeading":"Enumeration"},"kind":"symbol","relationshipsSections":[{"identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Layout measurement"}],"type":"strong"},{"type":"text","text":" — containers call "},{"code":"sizeThatFits","type":"codeVoice"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}],"type":"strong"},{"text":" — the pass whose buffer becomes (or may","type":"text"},{"text":" ","type":"text"},{"text":"become) the frame’s terminal output. A frame can evaluate more than","type":"text"},{"text":" ","type":"text"},{"text":"one candidate: when the header height turns out different from the","type":"text"},{"text":" ","type":"text"},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"type":"text","text":" makes this distinction explicit on "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true},{"type":"text","text":" "},{"type":"text","text":"so that effect sites can tell sizing work apart from output work."}],"type":"paragraph"},{"level":2,"text":"Invariants","type":"heading","anchor":"Invariants"},{"items":[{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}],"type":"strong"},{"text":": no lifecycle","type":"text"},{"text":" ","type":"text"},{"text":"or task mounting, no focus or handler registration, no state, cache,","type":"text"},{"text":" ","type":"text"},{"text":"preference, header, status-bar, or terminal mutation. Bodies must be","type":"text"},{"text":" ","type":"text"},{"text":"evaluable arbitrarily often without observable consequences.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","isActive":true},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"text":"candidate","type":"text"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Committing is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" after the final candidate is known."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Classifying an effect","type":"heading","anchor":"Classifying-an-effect"},{"inlineContent":[{"type":"text","text":"When writing or reviewing an effect site, ask one question:"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"“Does the effect outlive the frame?”","type":"text"}]}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"},{"text":" (key handlers, preference values, status-bar items, header","type":"text"},{"text":" ","type":"text"},{"text":"buffer, focus registrations): write it into the current pass’s scratch","type":"text"},{"text":" ","type":"text"},{"text":"collector. The final pass’s collector replaces the live state wholesale;","type":"text"},{"text":" ","type":"text"},{"text":"discarded passes are simply dropped.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":" actions, "},{"type":"codeVoice","code":".task"},{"type":"text","text":" mounts, "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"onPreferenceChange"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This mirrors SwiftUI’s model, where per-update values are recomputed and","type":"text"},{"text":" ","type":"text"},{"text":"replaced with each committed tree, while lifetime effects derive from the","type":"text"},{"text":" ","type":"text"},{"text":"identity diff between committed trees.","type":"text"}]},{"name":"See Also","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase"},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" for where each phase begins and ends."}]}],"style":"note"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"title":"Enumeration Cases","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/TUIkit\/d