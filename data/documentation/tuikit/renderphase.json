{"topicSections":[{"generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"anchor":"Enumeration-Cases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"symbol","roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"externalID":"s:10TUIkitView11RenderPhaseO","navigatorTitle":[{"kind":"identifier","text":"RenderPhase"}],"symbolKind":"enum","modules":[{"name":"TUIkit"}],"title":"RenderPhase"},"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"type":"conformsTo","kind":"relationships"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout measurement"}]},{"type":"text","text":" — containers call "},{"code":"sizeThatFits","type":"codeVoice"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Candidate-tree evaluation","type":"text"}],"type":"strong"},{"type":"text","text":" — the pass whose buffer becomes (or may"},{"type":"text","text":" "},{"type":"text","text":"become) the frame’s terminal output. A frame can evaluate more than"},{"type":"text","text":" "},{"type":"text","text":"one candidate: when the header height turns out different from the"},{"type":"text","text":" "},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"type":"text","text":" makes this distinction explicit on "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"so that effect sites can tell sizing work apart from output work."}],"type":"paragraph"},{"anchor":"Invariants","level":2,"text":"Invariants","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"In ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","isActive":true},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}],"type":"strong"},{"text":": no lifecycle","type":"text"},{"text":" ","type":"text"},{"text":"or task mounting, no focus or handler registration, no state, cache,","type":"text"},{"text":" ","type":"text"},{"text":"preference, header, status-bar, or terminal mutation. Bodies must be","type":"text"},{"text":" ","type":"text"},{"text":"evaluable arbitrarily often without observable consequences.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"candidate"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Committing is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" after the final candidate is known."}]}]}],"type":"unorderedList"},{"anchor":"Classifying-an-effect","level":2,"text":"Classifying an effect","type":"heading"},{"inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"“Does the effect outlive the frame?”"}]}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]},{"type":"text","text":" (key handlers, preference values, status-bar items, header"},{"type":"text","text":" "},{"type":"text","text":"buffer, focus registrations): write it into the current pass’s scratch"},{"type":"text","text":" "},{"type":"text","text":"collector. The final pass’s collector replaces the live state wholesale;"},{"type":"text","text":" "},{"type":"text","text":"discarded passes are simply dropped."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"strong"},{"type":"text","text":" ("},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"onDisappear","type":"codeVoice"},{"type":"text","text":" actions, "},{"code":".task","type":"codeVoice"},{"type":"text","text":" mounts, "},{"code":"onChange","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"onPreferenceChange","type":"codeVoice"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}],"type":"paragraph"},{"type":"aside","style":"note","name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true,"type":"reference"},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" for where each phase begins and ends."}],"type":"paragraph"}]}],"kind":"content"}],"sections":[],"kind":"symbol","variants":[{"paths":["\/documentation\/tuikit\/renderphase"],"traits":[{