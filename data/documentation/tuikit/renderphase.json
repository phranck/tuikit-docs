{"sections":[],"kind":"symbol","topicSections":[{"anchor":"Enumeration-Cases","title":"Enumeration Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/renderphase"]}],"metadata":{"title":"RenderPhase","role":"symbol","symbolKind":"enum","externalID":"s:10TUIkitView11RenderPhaseO","navigatorTitle":[{"text":"RenderPhase","kind":"identifier"}],"modules":[{"name":"TUIkit"}],"roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"type":"conformsTo"}],"abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single frame may traverse the view tree several times before anything"},{"type":"text","text":" "},{"type":"text","text":"reaches the terminal:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout measurement"}]},{"text":" — containers call ","type":"text"},{"type":"codeVoice","code":"sizeThatFits"},{"text":" (or render to","type":"text"},{"text":" ","type":"text"},{"text":"measure) arbitrarily often to negotiate sizes, and ","type":"text"},{"type":"codeVoice","code":"RenderLoop"},{"text":" ","type":"text"},{"text":"performs a full sizing pass on the first frame to discover the app","type":"text"},{"text":" ","type":"text"},{"text":"header height. None of these traversals produce the frame’s output.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}]},{"text":" — the pass whose buffer becomes (or may","type":"text"},{"text":" ","type":"text"},{"text":"become) the frame’s terminal output. A frame can evaluate more than","type":"text"},{"text":" ","type":"text"},{"text":"one candidate: when the header height turns out different from the","type":"text"},{"text":" ","type":"text"},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RenderPhase"},{"type":"text","text":" makes this distinction explicit on "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"so that effect sites can tell sizing work apart from output work."}]},{"level":2,"text":"Invariants","type":"heading","anchor":"Invariants"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"text":"no effect may reach live runtime state","type":"text"}]},{"type":"text","text":": no lifecycle"},{"type":"text","text":" "},{"type":"text","text":"or task mounting, no focus or handler registration, no state, cache,"},{"type":"text","text":" "},{"type":"text","text":"preference, header, status-bar, or terminal mutation. Bodies must be"},{"type":"text","text":" "},{"type":"text","text":"evaluable arbitrarily often without observable consequences."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","isActive":true},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"candidate"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Committing is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" after the final candidate is known."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Classifying an effect","type":"heading","anchor":"Classifying-an-effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When writing or reviewing an effect site, ask one question:"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"“Does the effect outlive the frame?”","type":"text"}]}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"No","type":"text"}]},{"text":" (key handlers, preference values, status-bar items, header","type":"text"},{"text":" ","type":"text"},{"text":"buffer, focus registrations): write it into the current pass’s scratch","type":"text"},{"text":" ","type":"text"},{"text":"collector. The final pass’s collector replaces the live state wholesale;","type":"text"},{"text":" ","type":"text"},{"text":"discarded passes are simply dropped.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Yes"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"onDisappear"},{"text":" actions, ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" mounts, ","type":"text"},{"type":"codeVoice","code":"onChange"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"onPreferenceChange"},{"text":" actions, GC liveness): record it. The frame","type":"text"},{"text":" ","type":"text"},{"text":"commit diffs the final records against persistent runtime state and","type":"text"},{"text":" ","type":"text"},{"text":"applies the difference exactly once.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" for where each phase begins and ends."}],"type":"paragraph"}],"type":"aside","name":"See Also","style":"note"}]}],"references":{"doc://TUIkit/SQ":{"identifier":"doc:\/\/TUIkit\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://TUIkit/SH":{"identifier":"doc:\/\/TUIkit\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://TUIkit/documentation/TUIkit":{"type":"topic","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"title":"TUIkit","kind":"symbol","url":"\/documentation\/tuikit","role":"collection","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit"},"doc://TUIkit/documentation/TUIkit/RenderPhase":{"abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"type":"topic","url":"\/documentation\/tuikit\/renderphase","navigatorTitle":[{"text":"RenderPhase","kind":"identifier"}],"title":"RenderPhase","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","role":"symbol","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/RenderContext/phase":{"role":"symbol","url":"\/documentation\/tuikit\/rendercontext\/phase","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"phase"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10TUIkitView11RenderPhaseO","kind":"typeIdentifier","text":"RenderPhase"}],"abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"title":"phase"},"doc://TUIkit/documentation/TUIkit/RenderPhase/render":{"abstract":[{"type":"text","text":"Candidate-tree evaluation for the frame’s output. Effects are"},{"type":"text","text":" "},{"type":"text","text":"recorded for the frame commit, never applied directly."}],"role":"symbol","title":"RenderPhase.render","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","url":"\/documentation\/tuikit\/renderphase\/render","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"render","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://TUIkit/s8SendableP":{"identifier":"doc:\/\/TUIkit\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"tuikit-logo.png":{"identifier":"tuikit-logo.png","alt":"TUIkit Logo","type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}]},"doc://TUIkit/documentation/TUIkit/RenderPhase/Equatable-Implementations":{"abstract":[],"role":"collectionGroup","url":"\/documentation\/tuikit\/renderphase\/equatable-implementations","title":"Equatable Implementations","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations","type":"topic"},"doc://TUIkit/documentation/TUIkit/RenderPhase/measure":{"role":"symbol","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"measure","kind":"identifier"}],"url":"\/documentation\/tuikit\/renderphase\/measure","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","abstract":[{"text":"Layout sizing. Bodies may be evaluated arbitrarily often; no effect","type":"text"},{"text":" ","type":"text"},{"text":"may reach live runtime state.","type":"text"}],"title":"RenderPhase.measure"}}}