{"abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Layout measurement","type":"text"}],"type":"strong"},{"type":"text","text":" — containers call "},{"code":"sizeThatFits","type":"codeVoice"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}],"type":"strong"},{"text":" — the pass whose buffer becomes (or may","type":"text"},{"text":" ","type":"text"},{"text":"become) the frame’s terminal output. A frame can evaluate more than","type":"text"},{"text":" ","type":"text"},{"text":"one candidate: when the header height turns out different from the","type":"text"},{"text":" ","type":"text"},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"code":"RenderPhase","type":"codeVoice"},{"text":" makes this distinction explicit on ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}]},{"anchor":"Invariants","level":2,"type":"heading","text":"Invariants"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"In "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","type":"reference","isActive":true},{"type":"text","text":", "},{"inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}],"type":"strong"},{"type":"text","text":": no lifecycle"},{"type":"text","text":" "},{"type":"text","text":"or task mounting, no focus or handler registration, no state, cache,"},{"type":"text","text":" "},{"type":"text","text":"preference, header, status-bar, or terminal mutation. Bodies must be"},{"type":"text","text":" "},{"type":"text","text":"evaluable arbitrarily often without observable consequences."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","type":"reference"},{"text":", effects belong to a ","type":"text"},{"inlineContent":[{"text":"candidate","type":"text"}],"type":"emphasis"},{"text":" tree. They must not be","type":"text"},{"text":" ","type":"text"},{"text":"applied to live runtime state during traversal either, because the","type":"text"},{"text":" ","type":"text"},{"text":"candidate may still be discarded by a correction pass. Instead they are","type":"text"},{"text":" ","type":"text"},{"text":"recorded and applied exactly once when the frame commits (see the","type":"text"},{"text":" ","type":"text"},{"text":"classification rule below).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Committing is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" after the final candidate is known."}]}]}],"type":"unorderedList"},{"anchor":"Classifying-an-effect","level":2,"type":"heading","text":"Classifying an effect"},{"type":"paragraph","inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"“Does the effect outlive the frame?”"}],"type":"strong"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No"}]},{"text":" (key handlers, preference values, status-bar items, header","type":"text"},{"text":" ","type":"text"},{"text":"buffer, focus registrations): write it into the current pass’s scratch","type":"text"},{"text":" ","type":"text"},{"text":"collector. The final pass’s collector replaces the live state wholesale;","type":"text"},{"text":" ","type":"text"},{"text":"discarded passes are simply dropped.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Yes","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":" actions, "},{"type":"codeVoice","code":".task"},{"type":"text","text":" mounts, "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"onPreferenceChange"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This mirrors SwiftUI’s model, where per-update values are recomputed and","type":"text"},{"text":" ","type":"text"},{"text":"replaced with each committed tree, while lifetime effects derive from the","type":"text"},{"text":" ","type":"text"},{"text":"identity diff between committed trees.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" for where each phase begins and ends."}]}],"style":"note","type":"aside","name":"See Also"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"anchor":"Enumeration-Cases","title":"Enumeration Cases"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"kind":"symbol","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"type":"conformsTo","title":"Conforms To"}],"variants":[{"paths":["\/documentation\/tuikit\/renderphase"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"roleHeading":"Enumeration","externalID":"s:10TUIkitView11RenderPhaseO","navigatorTitle":[{"kind":"identifier","text":"