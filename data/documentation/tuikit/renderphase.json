{"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"roleHeading":"Enumeration","modules":[{"name":"TUIkit"}],"role":"symbol","symbolKind":"enum","navigatorTitle":[{"text":"RenderPhase","kind":"identifier"}],"externalID":"s:10TUIkitView11RenderPhaseO","title":"RenderPhase"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","interfaceLanguage":"swift"},"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"]}],"variants":[{"paths":["\/documentation\/tuikit\/renderphase"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single frame may traverse the view tree several times before anything"},{"type":"text","text":" "},{"type":"text","text":"reaches the terminal:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Layout measurement","type":"text"}],"type":"strong"},{"type":"text","text":" — containers call "},{"type":"codeVoice","code":"sizeThatFits"},{"type":"text","text":" (or render to"},{"type":"text","text":" "},{"type":"text","text":"measure) arbitrarily often to negotiate sizes, and "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" "},{"type":"text","text":"performs a full sizing pass on the first frame to discover the app"},{"type":"text","text":" "},{"type":"text","text":"header height. None of these traversals produce the frame’s output."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Candidate-tree evaluation","type":"text"}]},{"type":"text","text":" — the pass whose buffer becomes (or may"},{"type":"text","text":" "},{"type":"text","text":"become) the frame’s terminal output. A frame can evaluate more than"},{"type":"text","text":" "},{"type":"text","text":"one candidate: when the header height turns out different from the"},{"type":"text","text":" "},{"type":"text","text":"estimate, a correction pass re-evaluates the tree and the earlier"},{"type":"text","text":" "},{"type":"text","text":"candidate is discarded."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"RenderPhase","type":"codeVoice"},{"text":" makes this distinction explicit on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","type":"reference"},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}]},{"anchor":"Invariants","type":"heading","level":2,"text":"Invariants"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"In "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure"},{"type":"text","text":", "},{"type":"strong","inlineContent":[{"text":"no effect may reach live runtime state","type":"text"}]},{"type":"text","text":": no lifecycle"},{"type":"text","text":" "},{"type":"text","text":"or task mounting, no focus or handler registration, no state, cache,"},{"type":"text","text":" "},{"type":"text","text":"preference, header, status-bar, or terminal mutation. Bodies must be"},{"type":"text","text":" "},{"type":"text","text":"evaluable arbitrarily often without observable consequences."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","isActive":true,"type":"reference"},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"text":"candidate","type":"text"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Committing is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" a phase of this enum: no view body is ever","type":"text"},{"text":" ","type":"text"},{"text":"evaluated while the frame commits. The commit is an explicit step in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RenderLoop.render()"},{"text":" after the final candidate is known.","type":"text"}]}]}]},{"anchor":"Classifying-an-effect","type":"heading","level":2,"text":"Classifying an effect"},{"type":"paragraph","inlineContent":[{"text":"When writing or reviewing an effect site, ask one question:","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"“Does the effect outlive the frame?”"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No"}],"type":"strong"},{"type":"text","text":" (key handlers, preference values, status-bar items, header"},{"type":"text","text":" "},{"type":"text","text":"buffer, focus registrations): write it into the current pass’s scratch"},{"type":"text","text":" "},{"type":"text","text":"collector. The final pass’s collector replaces the live state wholesale;"},{"type":"text","text":" "},{"type":"text","text":"discarded passes are simply dropped."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Yes"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":" actions, "},{"type":"codeVoice","code":".task"},{"type":"text","text":" mounts, "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"onPreferenceChange"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This mirrors SwiftUI’s model, where per-update values are recomputed and","type":"text"},{"text":" ","type":"text"},{"text":"replaced with each committed tree, while lifetime effects derive from the","type":"text"},{"text":" ","type":"text"},{"text":"identity diff between committed trees.","type":"text"}]},{"type":"aside","style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true,"type":"reference"},{"text":", and the frame choreography comment on","type":"text"},{"text":" ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" for where each phase begins and ends.","type":"text"}]}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"The evaluation phase of the current render pass.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"topicSections":[{"generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/ren