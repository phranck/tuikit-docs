{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"metadata":{"navigatorTitle":[{"kind":"identifier","text":"RenderPhase"}],"externalID":"s:10TUIkitView11RenderPhaseO","symbolKind":"enum","title":"RenderPhase","role":"symbol","modules":[{"name":"TUIkit"}],"roleHeading":"Enumeration","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RenderPhase"}]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/SQ","doc:\/\/TUIkit\/SH","doc:\/\/TUIkit\/s8SendableP"],"type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/renderphase"]}],"abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}],"topicSections":[{"anchor":"Enumeration-Cases","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render"],"title":"Enumeration Cases","generated":true},{"anchor":"Default-Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/Equatable-Implementations"],"title":"Default Implementations","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderPhase","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A single frame may traverse the view tree several times before anything","type":"text"},{"text":" ","type":"text"},{"text":"reaches the terminal:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout measurement"}],"type":"strong"},{"text":" — containers call ","type":"text"},{"code":"sizeThatFits","type":"codeVoice"},{"text":" (or render to","type":"text"},{"text":" ","type":"text"},{"text":"measure) arbitrarily often to negotiate sizes, and ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" ","type":"text"},{"text":"performs a full sizing pass on the first frame to discover the app","type":"text"},{"text":" ","type":"text"},{"text":"header height. None of these traversals produce the frame’s output.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Candidate-tree evaluation"}]},{"text":" — the pass whose buffer becomes (or may","type":"text"},{"text":" ","type":"text"},{"text":"become) the frame’s terminal output. A frame can evaluate more than","type":"text"},{"text":" ","type":"text"},{"text":"one candidate: when the header height turns out different from the","type":"text"},{"text":" ","type":"text"},{"text":"estimate, a correction pass re-evaluates the tree and the earlier","type":"text"},{"text":" ","type":"text"},{"text":"candidate is discarded.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"code":"RenderPhase","type":"codeVoice"},{"text":" makes this distinction explicit on ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"so that effect sites can tell sizing work apart from output work.","type":"text"}]},{"type":"heading","level":2,"anchor":"Invariants","text":"Invariants"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/measure","type":"reference"},{"text":", ","type":"text"},{"inlineContent":[{"type":"text","text":"no effect may reach live runtime state"}],"type":"strong"},{"text":": no lifecycle","type":"text"},{"text":" ","type":"text"},{"text":"or task mounting, no focus or handler registration, no state, cache,","type":"text"},{"text":" ","type":"text"},{"text":"preference, header, status-bar, or terminal mutation. Bodies must be","type":"text"},{"text":" ","type":"text"},{"text":"evaluable arbitrarily often without observable consequences.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","type":"reference"},{"type":"text","text":", effects belong to a "},{"type":"emphasis","inlineContent":[{"text":"candidate","type":"text"}]},{"type":"text","text":" tree. They must not be"},{"type":"text","text":" "},{"type":"text","text":"applied to live runtime state during traversal either, because the"},{"type":"text","text":" "},{"type":"text","text":"candidate may still be discarded by a correction pass. Instead they are"},{"type":"text","text":" "},{"type":"text","text":"recorded and applied exactly once when the frame commits (see the"},{"type":"text","text":" "},{"type":"text","text":"classification rule below)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Committing is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" a phase of this enum: no view body is ever"},{"type":"text","text":" "},{"type":"text","text":"evaluated while the frame commits. The commit is an explicit step in"},{"type":"text","text":" "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" after the final candidate is known."}]}]}]},{"type":"heading","level":2,"anchor":"Classifying-an-effect","text":"Classifying an effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When writing or reviewing an effect site, ask one question:"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"“Does the effect outlive the frame?”"}],"type":"strong"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No","type":"text"}],"type":"strong"},{"text":" (key handlers, preference values, status-bar items, header","type":"text"},{"text":" ","type":"text"},{"text":"buffer, focus registrations): write it into the current pass’s scratch","type":"text"},{"text":" ","type":"text"},{"text":"collector. The final pass’s collector replaces the live state wholesale;","type":"text"},{"text":" ","type":"text"},{"text":"discarded passes are simply dropped.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Yes","type":"text"}]},{"type":"text","text":" ("},{"code":"onAppear","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"onDisappear","type":"codeVoice"},{"type":"text","text":" actions, "},{"code":".task","type":"codeVoice"},{"type":"text","text":" mounts, "},{"code":"onChange","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"onPreferenceChange","type":"codeVoice"},{"type":"text","text":" actions, GC liveness): record it. The frame"},{"type":"text","text":" "},{"type":"text","text":"commit diffs the final records against persistent runtime state and"},{"type":"text","text":" "},{"type":"text","text":"applies the difference exactly once."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"This mirrors SwiftUI’s model, where per-update values are recomputed and"},{"type":"text","text":" "},{"type":"text","text":"replaced with each committed tree, while lifetime effects derive from the"},{"type":"text","text":" "},{"type":"text","text":"identity diff between committed trees."}],"type":"paragraph"},{"name":"See Also","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase"},{"type":"text","text":", and the frame choreography comment on"},{"type":"text","text":" "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":" for where each phase begins and ends."}]}],"type":"aside"}]}],"references":{"doc://TUIkit/documentation/TUIkit/RenderPhase/render":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"render"}],"kind":"symbol","type":"topic","abstract":[{"text":"Candidate-tree evaluation for the frame’s output. Effects are","type":"text"},{"text":" ","type":"text"},{"text":"recorded for the frame commit, never applied directly.","type":"text"}],"url":"\/documentation\/tuikit\/renderphase\/render","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderPhase\/render","title":"RenderPhase.render","role":"symbol"},"doc://TUIkit/documentation/TUIkit":{"images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","url":"\/documentation\/tuikit","kind":"symbol","type":"topic","role":"collection","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"title":"TUIkit"},"doc://TUIkit/documentation/TUIkit/RenderContext/phase":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext\/phase","url":"\/documentation\/tuikit\/rendercontext\/phase","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"phase","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10TUIkitView11RenderPhaseO","text":"RenderPhase","kind":"typeIdentifier"}],"title":"phase","abstract":[{"type":"text","text":"The evaluation phase of the current render pass."}]},"doc://TUIkit/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/TUIkit\/SQ"},"doc://TUIkit/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/TUIkit\/s8SendableP