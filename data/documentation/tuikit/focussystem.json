{"metadata":{"title":"Focus System","role":"article","roleHeading":"Article","modules":[{"name":"TUIkit"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"seeAlsoSections":[{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"FocusManager","type":"codeVoice"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true}]},{"type":"text","text":": Protocol that views adopt to receive focus"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"}]},{"type":"text","text":": Lightweight state object that views use to query and request focus"}]}]}]},{"type":"heading","level":2,"text":"How Focus Works","anchor":"How-Focus-Works"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"type":"heading","level":2,"text":"The Focusable Protocol","anchor":"The-Focusable-Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that want to receive focus conform to ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"focusID","type":"codeVoice"}]},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"canBeFocused","type":"codeVoice"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusReceived()"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"text":": Called when this element loses focus (default: no-op)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}]},{"text":": Handle a key event while focused; return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if consumed","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"code":"canBeFocused","type":"codeVoice"},{"text":" (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"onFocusReceived()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"onFocusLost()","type":"codeVoice"},{"text":" (both no-ops). Only ","type":"text"},{"code":"focusID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" must be implemented.","type":"text"}]},{"type":"heading","level":2,"text":"Using FocusState","anchor":"Using-FocusState"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"text":" is the user-facing API for checking and requesting focus inside a view:","type":"text"}]},{"type":"codeListing","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Built-in views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true,"type":"reference"},{"text":" create their own ","type":"text"},{"code":"FocusState","type":"codeVoice"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}]},{"type":"heading","level":2,"text":"Navigation Keys","anchor":"Navigation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" responds to these keys during dispatch:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next element"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]]]},{"type":"heading","level":2,"text":"FocusRegistration Helper","anchor":"FocusRegistration-Helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Persist a focus ID","type":"text"}]},{"text":" via ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":" so it remains stable across renders","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Register"}]},{"type":"text","text":" the handler with the "},{"type":"codeVoice","code":"FocusManager"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Query"}]},{"text":" whether this view currently has focus","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom views that implement "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"type":"text","text":" typically do not need "},{"code":"FocusRegistration","type":"codeVoice"},{"type":"text","text":" directly. It is used by the framework’s "},{"code":"_*Core","type":"codeVoice"},{"type":"text","text":" views (e.g. "},{"code":"_ButtonCore","type":"codeVoice"},{"type":"text","text":", "},{"code":"_ListCore","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"heading","level":2,"text":"Focus Indicator","anchor":"Focus-Indicator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"text":"highlight background","type":"text"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing accent background"}]},{"type":"text","text":" when the row is both focused and selected."}]},{"type":"heading","level":2,"text":"Focus in the Event Loop","anchor":"Focus-in-the-Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true},{"type":"text","text":"):"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"A key event arrives from stdin","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 3 (default bindings) handles quit, theme cycling, etc.","type":"text"}]}]}]}]}],"kind":"article","sections":[],"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"references":{"doc://TUIkit/documentation/TUIkit/Button":{"abstract":[{"type":"text","text":"An interactive button that triggers an action when pressed."}],"url":"\/documentation\/tuikit\/button","navigatorTitle":[{"text":"Button","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Button","kind":"identifier"}],"title":"Button","role":"symbol"},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"kind":"symbol","type":"