{"variants":[{"paths":["\/documentation\/tuikit\/focussystem"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"FocusManager","type":"codeVoice"}],"type":"strong"},{"text":": Tracks which element is focused, handles navigation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true}],"type":"strong"},{"type":"text","text":": Protocol that views adopt to receive focus"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference","isActive":true}],"type":"strong"},{"text":": Lightweight state object that views use to query and request focus","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"How Focus Works","anchor":"How-Focus-Works"},{"inlineContent":[{"type":"text","text":"Every frame, the "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The Focusable Protocol","anchor":"The-Focusable-Protocol"},{"inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"focusID","type":"codeVoice"}]},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"canBeFocused","type":"codeVoice"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element gains focus (default: no-op)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"type":"text","text":": Called when this element loses focus (default: no-op)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"strong"},{"text":": Handle a key event while focused; return ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if consumed","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Using FocusState","anchor":"Using-FocusState"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}],"type":"paragraph"},{"syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Built-in views like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":" create their own "},{"code":"FocusState","type":"codeVoice"},{"type":"text","text":" internally: you only need it when building custom focusable views."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Navigation Keys","anchor":"Navigation-Keys"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]]],"type":"table","header":"row"},{"level":2,"type":"heading","text":"FocusRegistration Helper","anchor":"FocusRegistration-Helper"},{"inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"code":"FocusRegistration","type":"codeVoice"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"text":" via ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" so it remains stable across renders","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Register","type":"text"}]},{"type":"text","text":" the handler with the "},{"type":"codeVoice","code":"FocusManager"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Query","type":"text"}],"type":"strong"},{"type":"text","text":" whether this view currently has focus"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Focus Indicator","anchor":"Focus-Indicator"},{"inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"text":" for the focused item. Text fields use ","type":"text"},{"type":"strong","inlineContent":[{"text":"pulsing vertical bars","type":"text"}]},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"type":"strong","inlineContent":[{"text":"highlight background","type":"text"}]},{"text":" for the focused row, with a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing accent background"}]},{"text":" when the row is both focused and selected.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Focus in the Event Loop","anchor":"Focus-in-the-Event-Loop"},{"inlineContent":[{"text":"Focus dispatch happens in Layer 2 of the key event pipeline (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle"},{"text":"):","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A key event arrives from stdin"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 1 (status bar) gets first chance to handle it"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"type":"codeVoice","code":"FocusManager"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}],"type":"paragraph"}]}],"type":"orderedList"}],"kind":"content"}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"anchor":"Guides","title":"Guides"}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Focus System"},"references":{"doc://TUIkit/documentation/TUIkit/FocusState":{"url":"\/documentation\/tuikit\/focusstate","navigatorTitle":[{"kind":"identifier","text":"FocusState"}],"kind":"symbol","role":"symbol","title":"FocusState","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FocusState"}],"type":"topic","abstract":[{"text":"Tracks focus state for a specific element.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"abstract":[{"text":"Customize the visual appearance of