{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"FocusManager"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"}]},{"text":": Protocol that views adopt to receive focus","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Lightweight state object that views use to query and request focus","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"How-Focus-Works","level":2,"text":"How Focus Works"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"type":"heading","anchor":"The-Focusable-Protocol","level":2,"text":"The Focusable Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"focusID"}],"type":"strong"},{"text":": Unique identifier for this focusable element","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"canBeFocused","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"type":"text","text":": Called when this element loses focus (default: no-op)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"strong"},{"text":": Handle a key event while focused; return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if consumed","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}]},{"type":"heading","anchor":"Using-FocusState","level":2,"text":"Using FocusState"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"type":"codeListing","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":" create their own "},{"type":"codeVoice","code":"FocusState"},{"type":"text","text":" internally: you only need it when building custom focusable views."}]},{"type":"heading","anchor":"Navigation-Keys","level":2,"text":"Navigation Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" responds to these keys during dispatch:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]]]},{"type":"heading","anchor":"FocusRegistration-Helper","level":2,"text":"FocusRegistration Helper"},{"type":"paragraph","inlineContent":[{"text":"Built-in interactive views use the internal ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" helper to avoid boilerplate. It handles three tasks in one call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persist a focus ID"}]},{"text":" via ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" so it remains stable across renders","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Register"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Query","type":"text"}]},{"type":"text","text":" whether this view currently has focus"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Custom views that implement ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"},{"text":" typically do not need ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" directly. It is used by the framework’s ","type":"text"},{"code":"_*Core","type":"codeVoice"},{"text":" views (e.g. ","type":"text"},{"code":"_ButtonCore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_ListCore","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","anchor":"Focus-Indicator","level":2,"text":"Focus Indicator"},{"type":"paragraph","inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"text":" for the focused item. Text fields use ","type":"text"},{"type":"strong","inlineContent":[{"text":"pulsing vertical bars","type":"text"}]},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background"}]},{"text":" for the focused row, with a ","type":"text"},{"type":"strong","inlineContent":[{"text":"pulsing accent background","type":"text"}]},{"text":" when the row is both focused and selected.","type":"text"}]},{"type":"heading","anchor":"Focus-in-the-Event-Loop","level":2,"text":"Focus in the Event Loop"},{"type":"paragraph","inlineContent":[{"text":"Focus dispatch happens in Layer 2 of the key event pipeline (see ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true,"type":"reference"},{"text":"):","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A key event arrives from stdin","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 2: "},{"code":"KeyEventDispatcher","type":"codeVoice"},{"type":"text","text":" dispatches to the focused view’s "},{"code":"handleKeyEvent(_:)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"code":"FocusManager","type":"codeVoice"}],"type":"paragraph"}]},{"conte