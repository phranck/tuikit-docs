{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"FocusManager","type":"codeVoice"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true}],"type":"strong"},{"text":": Protocol that views adopt to receive focus","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference","isActive":true}]},{"type":"text","text":": Lightweight state object that views use to query and request focus"}]}]}]},{"anchor":"How-Focus-Works","text":"How Focus Works","type":"heading","level":2},{"inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}],"type":"paragraph"},{"anchor":"The-Focusable-Protocol","text":"The Focusable Protocol","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"focusID"}]},{"text":": Unique identifier for this focusable element","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"canBeFocused","type":"codeVoice"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"onFocusReceived()"}],"type":"strong"},{"type":"text","text":": Called when this element gains focus (default: no-op)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"onFocusLost()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element loses focus (default: no-op)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}]},{"text":": Handle a key event while focused; return ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if consumed","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}],"type":"paragraph"},{"anchor":"Using-FocusState","type":"heading","level":2,"text":"Using FocusState"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"type":"codeListing","syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"type":"text","text":" create their own "},{"type":"codeVoice","code":"FocusState"},{"type":"text","text":" internally: you only need it when building custom focusable views."}]},{"anchor":"Navigation-Keys","type":"heading","level":2,"text":"Navigation Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]]]},{"anchor":"FocusRegistration-Helper","type":"heading","level":2,"text":"FocusRegistration Helper"},{"type":"paragraph","inlineContent":[{"text":"Built-in interactive views use the internal ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" helper to avoid boilerplate. It handles three tasks in one call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Persist a focus ID","type":"text"}],"type":"strong"},{"type":"text","text":" via "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" so it remains stable across renders"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Register"}]},{"type":"text","text":" the handler with the "},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Query"}]},{"text":" whether this view currently has focus","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Focus Indicator","anchor":"Focus-Indicator","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"inlineContent":[{"type":"text","text":"highlight background bar"}],"type":"strong"},{"type":"text","text":" for the focused item. Text fields use "},{"inlineContent":[{"text":"pulsing vertical bars","type":"text"}],"type":"strong"},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"inlineContent":[{"type":"text","text":"highlight background"}],"type":"strong"},{"type":"text","text":" for the focused row, with a "},{"inlineContent":[{"type":"text","text":"pulsing accent background"}],"type":"strong"},{"type":"text","text":" when the row is both focused and selected."}],"type":"paragraph"},{"text":"Focus in the Event Loop","anchor":"Focus-in-the-Event-Loop","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true},{"type":"text","text":"):"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A key event arrives from stdin","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 1 (status bar) gets first chance to handle it"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 2: "},{"type":"codeVoice","code":"KeyEventDispatcher"},{"type":"text","text":" dispatches to the focused view’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"}]}]},{"content":[{"inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"code":"FocusManager","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}],"type":"paragraph"}]}],"type":"orderedList"}],"kind":"content"}],"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"kind":"article","metadata":{"roleHeading":"Article","title":"Focus System","role":"article","modules":[{"name":"TUIkit"}]},"sections":[],"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"references":{"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"title":"Theming Guide","type":"topic","kind":"article","role":"article","url":"\/documentation\/tuikit\/themingguide","abstract":[{"text":"Customize the visual appearance of your TUIkit application with palettes.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"title":"Keyboard Shortcuts","type":"topic","abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"kind":"article","role":"collectionGroup","url":"\/documentation\/tuiki