,"text":" "},{"kind":"identifier","text":"Menu"}],"title":"Menu","url":"\/documentation\/tuikit\/menu","role":"symbol"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"role":"article","type":"topic","kind":"article","url":"\/documentation\/tuikit\/statusbarguide","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","title":"Status Bar","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/Focusable":{"title":"Focusable","navigatorTitle":[{"text":"Focusable","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","role":"symbol","url":"\/documentation\/tuikit\/focusable","abstract":[{"type":"text","text":"A protocol for views that can receive focus."}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Focusable","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/Preferences":{"title":"Preferences","kind":"article","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","url":"\/documentation\/tuikit\/preferences"},"doc://TUIkit/documentation/TUIkit/Button":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","role":"symbol","title":"Button","navigatorTitle":[{"text":"Button","kind":"identifier"}],"abstract":[{"text":"An interactive button that triggers an action when pressed.","type":"text"}],"url":"\/documentation\/tuikit\/button","type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Button","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"role":"article","title":"Appearance and Colors","kind":"article","abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"url":"\/documentation\/tuikit\/appearanceandcolors","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","type":"topic"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"role":"collectionGroup","abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"title":"Custom Views","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","kind":"article","url":"\/documentation\/tuikit\/customviews","type":"topic"},"doc://TUIkit/documentation/TUIkit":{"type":"topic","title":"TUIkit","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","role":"collection","kind":"symbol","url":"\/documentation\/tuikit"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","url":"\/documentation\/tuikit\/themingguide","role":"article","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"title":"Theming Guide","kind":"article","type":"topic"},"tuikit-logo.png":{"identifier":"tuikit-logo.png","type":"image","alt":"TUIkit Logo","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}]},"doc://TUIkit/documentation/TUIkit/StateManagement":{"title":"State Management","kind":"article","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","url":"\/documentation\/tuikit\/statemanagement","type":"topic","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}]}}}