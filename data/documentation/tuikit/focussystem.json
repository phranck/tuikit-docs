{"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"FocusManager","type":"codeVoice"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Protocol that views adopt to receive focus","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true}]},{"text":": Lightweight state object that views use to query and request focus","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"How Focus Works","level":2,"anchor":"How-Focus-Works"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"type":"heading","text":"The Focusable Protocol","level":2,"anchor":"The-Focusable-Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that want to receive focus conform to ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"focusID","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"canBeFocused"}],"type":"strong"},{"text":": Whether focus can move to this element (default: ","type":"text"},{"type":"codeVoice","code":"true"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusReceived()"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"onFocusLost()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element loses focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"handleKeyEvent(_:)","type":"codeVoice"}]},{"text":": Handle a key event while focused; return ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if consumed","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"type":"codeVoice","code":"canBeFocused"},{"text":" (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"onFocusReceived()"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"onFocusLost()"},{"text":" (both no-ops). Only ","type":"text"},{"type":"codeVoice","code":"focusID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"text":" must be implemented.","type":"text"}]},{"type":"heading","text":"Using FocusState","level":2,"anchor":"Using-FocusState"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"type":"codeListing","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"type":"text","text":" create their own "},{"type":"codeVoice","code":"FocusState"},{"type":"text","text":" internally: you only need it when building custom focusable views."}]},{"type":"heading","text":"Navigation Keys","level":2,"anchor":"Navigation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" responds to these keys during dispatch:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]],"header":"row"},{"type":"heading","text":"FocusRegistration Helper","level":2,"anchor":"FocusRegistration-Helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persist a focus ID"}]},{"type":"text","text":" via "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" so it remains stable across renders"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Register"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Query","type":"text"}],"type":"strong"},{"type":"text","text":" whether this view currently has focus"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}]},{"type":"heading","text":"Focus Indicator","level":2,"anchor":"Focus-Indicator"},{"type":"paragraph","inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"text":" for the focused item. Text fields use ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background"}]},{"text":" for the focused row, with a ","type":"text"},{"type":"strong","inlineContent":[{"text":"pulsing accent background","type":"text"}]},{"text":" when the row is both focused and selected.","type":"text"}]},{"type":"heading","text":"Focus in the Event Loop","level":2,"anchor":"Focus-in-the-Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true},{"type":"text","text":"):"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"A key event arrives from stdin"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 1 (status bar) gets first chance to handle it"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Layer 2: ","type":"text"},{"type":"codeVoice","code":"KeyEventDispatcher"},{"text":" dispatches to the focused view’s ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not consumed, navigation keys (Tab, arrows) are handled by "},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}]}]}]}],"kind":"content"}],"metadata":{"role":"article","modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"Focus System"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/StateManagement":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","title":"State Management","kind":"article","type":"topic","url":"\/documentation\/tuikit\/statemanagement","role":"article","abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","role":"article","type":"topic","abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}