{"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"FocusManager","type":"codeVoice"}],"type":"strong"},{"text":": Tracks which element is focused, handles navigation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"}]},{"type":"text","text":": Protocol that views adopt to receive focus"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true}],"type":"strong"},{"type":"text","text":": Lightweight state object that views use to query and request focus"}]}]}],"type":"unorderedList"},{"anchor":"How-Focus-Works","level":2,"type":"heading","text":"How Focus Works"},{"inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}],"type":"paragraph"},{"anchor":"The-Focusable-Protocol","level":2,"type":"heading","text":"The Focusable Protocol"},{"inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"focusID"}],"type":"strong"},{"text":": Unique identifier for this focusable element","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"canBeFocused","type":"codeVoice"}]},{"text":": Whether focus can move to this element (default: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"onFocusLost()","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Called when this element loses focus (default: no-op)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"handleKeyEvent(_:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Handle a key event while focused; return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if consumed"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}],"type":"paragraph"},{"anchor":"Using-FocusState","level":2,"type":"heading","text":"Using FocusState"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"]},{"inlineContent":[{"text":"Built-in views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true,"type":"reference"},{"text":" create their own ","type":"text"},{"code":"FocusState","type":"codeVoice"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}],"type":"paragraph"},{"anchor":"Navigation-Keys","level":2,"type":"heading","text":"Navigation Keys"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous element","type":"text"}],"type":"paragraph"}]]]},{"anchor":"FocusRegistration-Helper","level":2,"type":"heading","text":"FocusRegistration Helper"},{"inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"code":"FocusRegistration","type":"codeVoice"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"type":"text","text":" via "},{"code":"StateStorage","type":"codeVoice"},{"type":"text","text":" so it remains stable across renders"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Register","type":"text"}]},{"type":"text","text":" the handler with the "},{"type":"codeVoice","code":"FocusManager"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Query"}]},{"type":"text","text":" whether this view currently has focus"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}],"type":"paragraph"},{"anchor":"Focus-Indicator","level":2,"type":"heading","text":"Focus Indicator"},{"inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"type":"strong","inlineContent":[{"text":"highlight background bar","type":"text"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"text":"highlight background","type":"text"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"text":"pulsing accent background","type":"text"}]},{"type":"text","text":" when the row is both focused and selected."}],"type":"paragraph"},{"anchor":"Focus-in-the-Event-Loop","level":2,"type":"heading","text":"Focus in the Event Loop"},{"inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle"},{"type":"text","text":"):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A key event arrives from stdin","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not consumed, navigation keys (Tab, arrows) are handled by "},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}],"type":"paragraph"}]}],"type":"orderedList"}]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"title":"Focus System","roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}]},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"type":"topic","title":"Palette Reference","url":"\/documentation\/tuikit\/palettereference","kind":"article","role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"title":"List and Table Components","kind":"article","abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"url":"\/documentation\/tuikit\/listandtable","role":"a