{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"FocusManager"}],"type":"strong"},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true}]},{"text":": Protocol that views adopt to receive focus","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference","isActive":true}]},{"type":"text","text":": Lightweight state object that views use to query and request focus"}]}]}]},{"type":"heading","text":"How Focus Works","level":2,"anchor":"How-Focus-Works"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"type":"heading","text":"The Focusable Protocol","level":2,"anchor":"The-Focusable-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"type":"text","text":":"}]},{"code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"focusID"}],"type":"strong"},{"type":"text","text":": Unique identifier for this focusable element"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"canBeFocused"}],"type":"strong"},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"type":"text","text":": Called when this element loses focus (default: no-op)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"handleKeyEvent(_:)","type":"codeVoice"}]},{"type":"text","text":": Handle a key event while focused; return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if consumed"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}]},{"type":"heading","text":"Using FocusState","level":2,"anchor":"Using-FocusState"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"type":"text","text":" create their own "},{"code":"FocusState","type":"codeVoice"},{"type":"text","text":" internally: you only need it when building custom focusable views."}]},{"type":"heading","text":"Navigation Keys","level":2,"anchor":"Navigation-Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]],"header":"row"},{"type":"heading","text":"FocusRegistration Helper","level":2,"anchor":"FocusRegistration-Helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Persist a focus ID","type":"text"}],"type":"strong"},{"text":" via ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" so it remains stable across renders","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Register"}]},{"type":"text","text":" the handler with the "},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Query","type":"text"}]},{"type":"text","text":" whether this view currently has focus"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Custom views that implement ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"},{"text":" typically do not need ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" directly. It is used by the framework’s ","type":"text"},{"code":"_*Core","type":"codeVoice"},{"text":" views (e.g. ","type":"text"},{"code":"_ButtonCore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_ListCore","type":"codeVoice"},{"text":").","type":"text"}]},{"type":"heading","text":"Focus Indicator","level":2,"anchor":"Focus-Indicator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"text":"pulsing accent background","type":"text"}]},{"type":"text","text":" when the row is both focused and selected."}]},{"type":"heading","text":"Focus in the Event Loop","level":2,"anchor":"Focus-in-the-Event-Loop"},{"type":"paragraph","inlineContent":[{"text":"Focus dispatch happens in Layer 2 of the key event pipeline (see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle"},{"text":"):","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"A key event arrives from stdin","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 1 (status bar) gets first chance to handle it"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 3 (default bindings) handles quit, theme cycling, etc.","type":"text"}]}]}]}]}],"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/tuikit\/focussystem"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"role":"article","title":"Focus System"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"anchor":"Guides"}],"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"references":{"doc://TUIkit/documentation/TUIkit/FocusState":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","url":"\/documentation\/tuikit\/focusstate","abstract":[{"text":"Tracks focus state for a specific element.","type":"text"}],"title":"FocusState","navigatorTitle":[{"kind":"identifier","text":"FocusState"}],"type":"topic","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FocusState"}]},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"role":"article","type":"topic","title":"Layout System","url":"\/documentation\/tuikit\/layoutsystem","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","kind":"article"},"doc://TUIkit/documentation/TUIkit/PaletteReference":{"url":"\/documentation\/tuikit\/palettereference","role":"collectionGroup","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"type":"topic","title":"Palette Reference"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"kind":"article","role":"collectionGroup","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"title":"Keyboard Shortcuts","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","url":"\/documentation\/tuikit\/keyboardshortcuts"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"role":"article","title":"List and Table Components","url":"\/documentation\/tuikit\/listandtable","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","type":"topic"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"url":"\/documentation\/tuikit\/themingguide","role":"article","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","type":"topic","title":"Theming Guide"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"title":"State Management","url":"\/documentation\/tuikit\/statemanagement","kind":"article","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","role":"article