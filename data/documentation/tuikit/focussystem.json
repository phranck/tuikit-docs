{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"Focus System","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"FocusManager","type":"codeVoice"}],"type":"strong"},{"text":": Tracks which element is focused, handles navigation","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true}]},{"type":"text","text":": Protocol that views adopt to receive focus"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference","isActive":true}]},{"type":"text","text":": Lightweight state object that views use to query and request focus"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"How-Focus-Works","text":"How Focus Works"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every frame, the "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered."}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"level":2,"type":"heading","anchor":"The-Focusable-Protocol","text":"The Focusable Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that want to receive focus conform to ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"focusID"}]},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"canBeFocused"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"code":"true","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element gains focus (default: no-op)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusLost()","type":"codeVoice"}]},{"type":"text","text":": Called when this element loses focus (default: no-op)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"strong"},{"type":"text","text":": Handle a key event while focused; return "},{"code":"true","type":"codeVoice"},{"type":"text","text":" if consumed"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}]},{"level":2,"type":"heading","anchor":"Using-FocusState","text":"Using FocusState"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"text":" is the user-facing API for checking and requesting focus inside a view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views like "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true},{"type":"text","text":" create their own "},{"code":"FocusState","type":"codeVoice"},{"type":"text","text":" internally: you only need it when building custom focusable views."}]},{"level":2,"type":"heading","anchor":"Navigation-Keys","text":"Navigation Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" responds to these keys during dispatch:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]]},{"level":2,"type":"heading","anchor":"FocusRegistration-Helper","text":"FocusRegistration Helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Persist a focus ID","type":"text"}],"type":"strong"},{"text":" via ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":" so it remains stable across renders","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Register"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Query","type":"text"}],"type":"strong"},{"text":" whether this view currently has focus","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom views that implement "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"},{"type":"text","text":" typically do not need "},{"code":"FocusRegistration","type":"codeVoice"},{"type":"text","text":" directly. It is used by the framework’s "},{"code":"_*Core","type":"codeVoice"},{"type":"text","text":" views (e.g. "},{"code":"_ButtonCore","type":"codeVoice"},{"type":"text","text":", "},{"code":"_ListCore","type":"codeVoice"},{"type":"text","text":")."}]},{"level":2,"type":"heading","anchor":"Focus-Indicator","text":"Focus Indicator"},{"type":"paragraph","inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"inlineContent":[{"type":"text","text":"highlight background bar"}],"type":"strong"},{"text":" for the focused item. Text fields use ","type":"text"},{"inlineContent":[{"text":"pulsing vertical bars","type":"text"}],"type":"strong"},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"inlineContent":[{"type":"text","text":"highlight background"}],"type":"strong"},{"text":" for the focused row, with a ","type":"text"},{"inlineContent":[{"text":"pulsing accent background","type":"text"}],"type":"strong"},{"text":" when the row is both focused and selected.","type":"text"}]},{"text":"Focus in the Event Loop","level":2,"type":"heading","anchor":"Focus-in-the-Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true},{"type":"text","text":"):"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A key event arrives from stdin"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 2: "},{"type":"codeVoice","code":"KeyEventDispatcher"},{"type":"text","text":" dispatches to the focused view’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}]}]}],"type":"orderedList"}]}],"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides"}],"references":{"doc://TUIkit/documentation/TUIkit/StateManagement":{"role":"article","url":"\/documentation\/tuikit\/statemanagement","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"kind":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","title":"State Management"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"kind":"article","role":"collectionGroup","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal byte