{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"FocusManager","type":"codeVoice"}],"type":"strong"},{"text":": Tracks which element is focused, handles navigation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference"}]},{"type":"text","text":": Protocol that views adopt to receive focus"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"}]},{"text":": Lightweight state object that views use to query and request focus","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"How-Focus-Works","text":"How Focus Works","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle."}]},{"anchor":"The-Focusable-Protocol","text":"The Focusable Protocol","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"focusID","type":"codeVoice"}]},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"canBeFocused","type":"codeVoice"}],"type":"strong"},{"text":": Whether focus can move to this element (default: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"type":"text","text":": Called when this element loses focus (default: no-op)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"strong"},{"text":": Handle a key event while focused; return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if consumed","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"code":"canBeFocused","type":"codeVoice"},{"text":" (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"onFocusReceived()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"onFocusLost()","type":"codeVoice"},{"text":" (both no-ops). Only ","type":"text"},{"code":"focusID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" must be implemented.","type":"text"}]},{"anchor":"Using-FocusState","text":"Using FocusState","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"syntax":"swift","type":"codeListing","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"]},{"type":"paragraph","inlineContent":[{"text":"Built-in views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true,"type":"reference"},{"text":" create their own ","type":"text"},{"code":"FocusState","type":"codeVoice"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}]},{"anchor":"Navigation-Keys","text":"Navigation Keys","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" responds to these keys during dispatch:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]],"type":"table"},{"anchor":"FocusRegistration-Helper","text":"FocusRegistration Helper","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persist a focus ID"}]},{"type":"text","text":" via "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" so it remains stable across renders"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Register"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Query","type":"text"}]},{"type":"text","text":" whether this view currently has focus"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}]},{"anchor":"Focus-Indicator","text":"Focus Indicator","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"text":" for the focused item. Text fields use ","type":"text"},{"type":"strong","inlineContent":[{"text":"pulsing vertical bars","type":"text"}]},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background"}]},{"text":" for the focused row, with a ","type":"text"},{"type":"strong","inlineContent":[{"text":"pulsing accent background","type":"text"}]},{"text":" when the row is both focused and selected.","type":"text"}]},{"anchor":"Focus-in-the-Event-Loop","text":"Focus in the Event Loop","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","type":"reference","isActive":true},{"type":"text","text":"):"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A key event arrives from stdin","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not consumed, navigation keys (Tab, arrows) are handled by "},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}]}]}],"type":"orderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Focus System","modules":[{"name":"TUIkit"}]},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"references":{"doc://TUIkit/documentation/TUIkit":{"role":"collection","images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","type":"topic","title":"TUIkit","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"url":"\/documentation\/tuikit","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/AppLifecycle":{"role":"article","abstract":[{"text":"Understand how a TUIkit application starts, runs, and shuts down.","type":"text"}]