{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"FocusManager","type":"codeVoice"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference"}]},{"text":": Protocol that views adopt to receive focus","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"}],"type":"strong"},{"type":"text","text":": Lightweight state object that views use to query and request focus"}]}]}],"type":"unorderedList"},{"type":"heading","text":"How Focus Works","anchor":"How-Focus-Works","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every frame, the "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle."}]},{"type":"heading","text":"The Focusable Protocol","anchor":"The-Focusable-Protocol","level":2},{"type":"paragraph","inlineContent":[{"text":"Views that want to receive focus conform to ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"focusID"}],"type":"strong"},{"text":": Unique identifier for this focusable element","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"canBeFocused","type":"codeVoice"}],"type":"strong"},{"text":": Whether focus can move to this element (default: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element gains focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"type":"text","text":": Called when this element loses focus (default: no-op)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}]},{"type":"text","text":": Handle a key event while focused; return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if consumed"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"code":"canBeFocused","type":"codeVoice"},{"type":"text","text":" ("},{"code":"true","type":"codeVoice"},{"type":"text","text":"), "},{"code":"onFocusReceived()","type":"codeVoice"},{"type":"text","text":", and "},{"code":"onFocusLost()","type":"codeVoice"},{"type":"text","text":" (both no-ops). Only "},{"code":"focusID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"type":"text","text":" must be implemented."}]},{"type":"heading","level":2,"anchor":"Using-FocusState","text":"Using FocusState"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"type":"codeListing","syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"]},{"type":"paragraph","inlineContent":[{"text":"Built-in views like ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"text":" create their own ","type":"text"},{"type":"codeVoice","code":"FocusState"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}]},{"type":"heading","level":2,"anchor":"Navigation-Keys","text":"Navigation Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" responds to these keys during dispatch:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next element"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next element"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]]]},{"type":"heading","level":2,"anchor":"FocusRegistration-Helper","text":"FocusRegistration Helper"},{"type":"paragraph","inlineContent":[{"text":"Built-in interactive views use the internal ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" helper to avoid boilerplate. It handles three tasks in one call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"text":" via ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":" so it remains stable across renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Register"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Query","type":"text"}],"type":"strong"},{"type":"text","text":" whether this view currently has focus"}]}]}]},{"inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"heading","text":"Focus Indicator","level":2,"anchor":"Focus-Indicator"},{"inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"inlineContent":[{"type":"text","text":"highlight background bar"}],"type":"strong"},{"text":" for the focused item. Text fields use ","type":"text"},{"inlineContent":[{"type":"text","text":"pulsing vertical bars"}],"type":"strong"},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"inlineContent":[{"type":"text","text":"highlight background"}],"type":"strong"},{"text":" for the focused row, with a ","type":"text"},{"inlineContent":[{"type":"text","text":"pulsing accent background"}],"type":"strong"},{"text":" when the row is both focused and selected.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Focus in the Event Loop","level":2,"anchor":"Focus-in-the-Event-Loop"},{"inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true},{"type":"text","text":"):"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A key event arrives from stdin"}]}]},{"content":[{"inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 2: "},{"type":"codeVoice","code":"KeyEventDispatcher"},{"type":"text","text":" dispatches to the focused view’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}],"type":"paragraph"}]}]}]}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"Focus System","role":"article"},"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"anchor":"Guides","title":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"type":"topic","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","url":"\/documentation\/tuikit\/palettereference","abstract":[{"text":"A visual reference for all built-in color palettes with their exact color values.","type":"text"}],"title":"Palette Reference","role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/Button":{"type":"topic","title":"Button","role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","abstract":[{"type":"text","text":"An interactive button that triggers an action when pressed."}],"fragments":[