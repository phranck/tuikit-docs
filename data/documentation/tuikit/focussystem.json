{"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"anchor":"Guides","title":"Guides"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"FocusManager"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"}]},{"type":"text","text":": Protocol that views adopt to receive focus"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"}],"type":"strong"},{"type":"text","text":": Lightweight state object that views use to query and request focus"}],"type":"paragraph"}]}]},{"type":"heading","text":"How Focus Works","anchor":"How-Focus-Works","level":2},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle."}]},{"type":"heading","text":"The Focusable Protocol","anchor":"The-Focusable-Protocol","level":2},{"type":"paragraph","inlineContent":[{"text":"Views that want to receive focus conform to ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"text":":","type":"text"}]},{"code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"focusID"}]},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"canBeFocused","type":"codeVoice"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"onFocusReceived()"}],"type":"strong"},{"text":": Called when this element gains focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}],"type":"strong"},{"type":"text","text":": Called when this element loses focus (default: no-op)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"handleKeyEvent(_:)","type":"codeVoice"}]},{"text":": Handle a key event while focused; return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if consumed","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"type":"codeVoice","code":"canBeFocused"},{"text":" (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"onFocusReceived()"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"onFocusLost()"},{"text":" (both no-ops). Only ","type":"text"},{"type":"codeVoice","code":"focusID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"text":" must be implemented.","type":"text"}]},{"type":"heading","text":"Using FocusState","anchor":"Using-FocusState","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"text":" is the user-facing API for checking and requesting focus inside a view:","type":"text"}]},{"code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Built-in views like ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true},{"text":" create their own ","type":"text"},{"code":"FocusState","type":"codeVoice"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}]},{"type":"heading","text":"Navigation Keys","anchor":"Navigation-Keys","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]],"type":"table","header":"row"},{"type":"heading","text":"FocusRegistration Helper","anchor":"FocusRegistration-Helper","level":2},{"type":"paragraph","inlineContent":[{"text":"Built-in interactive views use the internal ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" helper to avoid boilerplate. It handles three tasks in one call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"type":"text","text":" via "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" so it remains stable across renders"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[