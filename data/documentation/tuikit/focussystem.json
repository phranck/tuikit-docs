{"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides"}],"kind":"article","variants":[{"paths":["\/documentation\/tuikit\/focussystem"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"FocusManager"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"}]},{"text":": Protocol that views adopt to receive focus","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference"}],"type":"strong"},{"type":"text","text":": Lightweight state object that views use to query and request focus"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"How-Focus-Works","text":"How Focus Works"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"type":"heading","level":2,"anchor":"The-Focusable-Protocol","text":"The Focusable Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"focusID","type":"codeVoice"}]},{"type":"text","text":": Unique identifier for this focusable element"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"canBeFocused","type":"codeVoice"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"onFocusReceived()"}],"type":"strong"},{"type":"text","text":": Called when this element gains focus (default: no-op)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"onFocusLost()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element loses focus (default: no-op)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}]},{"text":": Handle a key event while focused; return ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" if consumed","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}]},{"type":"heading","level":2,"anchor":"Using-FocusState","text":"Using FocusState"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference"},{"text":" is the user-facing API for checking and requesting focus inside a view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"]},{"type":"paragraph","inlineContent":[{"text":"Built-in views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true,"type":"reference"},{"text":" create their own ","type":"text"},{"code":"FocusState","type":"codeVoice"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}]},{"type":"heading","level":2,"anchor":"Navigation-Keys","text":"Navigation Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" responds to these keys during dispatch:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]],"header":"row"},{"type":"heading","anchor":"FocusRegistration-Helper","level":2,"text":"FocusRegistration Helper"},{"inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"code":"FocusRegistration","type":"codeVoice"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"text":" via ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" so it remains stable across renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Register","type":"text"}]},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Query"}],"type":"strong"},{"type":"text","text":" whether this view currently has focus"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Custom views that implement "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference"},{"type":"text","text":" typically do not need "},{"code":"FocusRegistration","type":"codeVoice"},{"type":"text","text":" directly. It is used by the framework’s "},{"code":"_*Core","type":"codeVoice"},{"type":"text","text":" views (e.g. "},{"code":"_ButtonCore","type":"codeVoice"},{"type":"text","text":", "},{"code":"_ListCore","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"heading","anchor":"Focus-Indicator","level":2,"text":"Focus Indicator"},{"inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"inlineContent":[{"text":"highlight background bar","type":"text"}],"type":"strong"},{"text":" for the focused item. Text fields use ","type":"text"},{"inlineContent":[{"text":"pulsing vertical bars","type":"text"}],"type":"strong"},{"text":" (caps) around the input area. Lists and tables use a ","type":"text"},{"inlineContent":[{"type":"text","text":"highlight background"}],"type":"strong"},{"text":" for the focused row, with a ","type":"text"},{"inlineContent":[{"text":"pulsing accent background","type":"text"}],"type":"strong"},{"text":" when the row is both focused and selected.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Focus-in-the-Event-Loop","level":2,"text":"Focus in the Event Loop"},{"inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true,"type":"reference"},{"type":"text","text":"):"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"A key event arrives from stdin"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not consumed, navigation keys (Tab, arrows) are handled by ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}]}]}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Focus System","modules":[{"name":"TUIkit"}],"role":"article"},"references":{"doc://TUIkit/documentation/TUIkit/FocusState":{"url":"\/documentation\/tuikit\/focusstate","navigatorTitle":[{"kind":"identifier","text":"FocusState"}],"role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FocusState"}],"kind":"symbol","title":"FocusState","abstract":[{"type":"text","text":"Tracks focus state for a specific element."}],"type":"topic"},"doc://TUIkit/documentation/TUIkit/Menu":{"role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","abstract":[{"type":"text","text":"A vertic