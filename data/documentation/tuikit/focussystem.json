{"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides"}],"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"Focus System","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/focussystem"]}],"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"FocusManager","type":"codeVoice"}]},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true}]},{"text":": Protocol that views adopt to receive focus","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"}]},{"type":"text","text":": Lightweight state object that views use to query and request focus"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"How Focus Works","level":2,"anchor":"How-Focus-Works","type":"heading"},{"inlineContent":[{"type":"text","text":"Every frame, the "},{"code":"FocusManager","type":"codeVoice"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle."}],"type":"paragraph"},{"text":"The Focusable Protocol","level":2,"anchor":"The-Focusable-Protocol","type":"heading"},{"inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"focusID"}]},{"type":"text","text":": Unique identifier for this focusable element"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"canBeFocused"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}]},{"text":": Called when this element gains focus (default: no-op)","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"onFocusLost()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element loses focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"handleKeyEvent(_:)","type":"codeVoice"}]},{"type":"text","text":": Handle a key event while focused; return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if consumed"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A default extension provides sensible defaults for "},{"type":"codeVoice","code":"canBeFocused"},{"type":"text","text":" ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"), "},{"type":"codeVoice","code":"onFocusReceived()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"onFocusLost()"},{"type":"text","text":" (both no-ops). Only "},{"type":"codeVoice","code":"focusID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" must be implemented."}],"type":"paragraph"},{"text":"Using FocusState","level":2,"anchor":"Using-FocusState","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","type":"reference","isActive":true},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}],"type":"paragraph"},{"syntax":"swift","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Built-in views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"type":"text","text":" create their own "},{"code":"FocusState","type":"codeVoice"},{"type":"text","text":" internally: you only need it when building custom focusable views."}],"type":"paragraph"},{"text":"Navigation Keys","level":2,"anchor":"Navigation-Keys","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next element"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]]]},{"text":"FocusRegistration Helper","level":2,"anchor":"FocusRegistration-Helper","type":"heading"},{"inlineContent":[{"text":"Built-in interactive views use the internal ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" helper to avoid boilerplate. It handles three tasks in one call:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"text":" via ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" so it remains stable across renders","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Register","type":"text"}]},{"text":" the handler with the ","type":"text"},{"type":"codeVoice","code":"FocusManager"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Query"}],"type":"strong"},{"type":"text","text":" whether this view currently has focus"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Custom views that implement ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true},{"text":" typically do not need ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" directly. It is used by the framework’s ","type":"text"},{"code":"_*Core","type":"codeVoice"},{"text":" views (e.g. ","type":"text"},{"code":"_ButtonCore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_ListCore","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"text":"Focus Indicator","level":2,"anchor":"Focus-Indicator","type":"heading"},{"inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"text":"highlight background","type":"text"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"typ