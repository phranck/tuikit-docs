{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"FocusManager","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Tracks which element is focused, handles navigation"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true}]},{"type":"text","text":": Protocol that views adopt to receive focus"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"}],"type":"strong"},{"text":": Lightweight state object that views use to query and request focus","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"How-Focus-Works","text":"How Focus Works","type":"heading"},{"inlineContent":[{"type":"text","text":"Every frame, the "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered."}],"type":"paragraph"},{"inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"The-Focusable-Protocol","text":"The Focusable Protocol","type":"heading"},{"inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"focusID"}],"type":"strong"},{"text":": Unique identifier for this focusable element","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"canBeFocused"}]},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}],"type":"strong"},{"text":": Called when this element gains focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"text":": Called when this element loses focus (default: no-op)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"strong"},{"text":": Handle a key event while focused; return ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" if consumed","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"type":"codeVoice","code":"canBeFocused"},{"text":" (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"onFocusReceived()"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"onFocusLost()"},{"text":" (both no-ops). Only ","type":"text"},{"type":"codeVoice","code":"focusID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"text":" must be implemented.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Using-FocusState","text":"Using FocusState","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}],"type":"paragraph"},{"code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Built-in views like "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true},{"type":"text","text":" create their own "},{"type":"codeVoice","code":"FocusState"},{"type":"text","text":" internally: you only need it when building custom focusable views."}],"type":"paragraph"},{"level":2,"anchor":"Navigation-Keys","text":"Navigation Keys","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous element","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Arrow Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next element"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous element"}]}]]],"header":"row","type":"table"},{"level":2,"anchor":"FocusRegistration-Helper","text":"FocusRegistration Helper","type":"heading"},{"inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Persist a focus ID","type":"text"}]},{"text":" via ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":" so it remains stable across renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Register","type":"text"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Query","type":"text"}]},{"type":"text","text":" whether this view currently has focus"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Custom views that implement "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"type":"text","text":" typically do not need "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" directly. It is used by the framework’s "},{"type":"codeVoice","code":"_*Core"},{"type":"text","text":" views (e.g. "},{"type":"codeVoice","code":"_ButtonCore"},{"type":"text","text":", "},{"type":"codeVoice","code":"_ListCore"},{"type":"text","text":")."}],"type":"paragraph"},{"level":2,"anchor":"Focus-Indicator","text":"Focus Indicator","type":"heading"},{"inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"type":"strong","inlineContent":[{"text":"highlight background bar","type":"text"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"text":"highlight background","type":"text"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing accent background"}]},{"type":"text","text":" when the row is both focused and selected."}],"type":"paragraph"},{"level":2,"anchor":"Focus-in-the-Event-Loop","text":"Focus in the Event Loop","type":"heading"},{"inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true,"type":"reference"},{"type":"text","text":"):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A key event arrives from stdin","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 2: "},{"type":"codeVoice","code":"KeyEventDispatcher"},{"type":"text","text":" dispatches to the focused view’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not consumed, navigation keys (Tab, arrows) are handled by "},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 3 (default bindings) handles quit, theme cycling, etc.","type":"text"}]}]}],"type":"orderedList"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"role":"article","title":"Focus System"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"kind":"article","variants":[{"paths":["\/documentation\/tuikit\/focussystem"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"references":{"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"kind":"article","type":"topic","url":"\/documentation\/tuikit\/themingguide","role":"article","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"title":"Theming Guide","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide"},"doc://TUIkit/documentation/TUIkit/Preferences":{"role":"collectionGroup","url":"\/documentation\/tuikit\/preferences","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"kind":"article","title":"Preferences"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"title":"Status Bar","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","role":"article","url":"\/documentation\/tuikit\/statusbarguide"},"doc://TUIkit/documentation/TUIkit/PaletteReference":{"abstract":[{"text":"A visual reference for all built-in color palettes with their exact color values.","type":"text"}],"kind":"article","url":"\/documentation\/tuikit\/palettereference","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","title":"Palette Reference","role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/ImageDecoding":{"title":"Image Decoding","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","url":"\/documentation\/tuikit\/imagedecoding","type":"topic","role":"collectionGroup","kind":"article","abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}]},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"url":"\/documentation\/tuikit\/listandtable","type":"topic","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","title":"List and Table Components","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"kind":"article"},"doc://TUIkit/documentation/TUIkit":{"type":"topic","url":"\/documentation\/tuikit","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"role":"collection","title":"TUIkit","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"identifier":"doc: