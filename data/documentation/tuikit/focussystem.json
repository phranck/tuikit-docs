{"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"Focus System","roleHeading":"Article"},"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"FocusManager","type":"codeVoice"}],"type":"strong"},{"text":": Tracks which element is focused, handles navigation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true}]},{"type":"text","text":": Protocol that views adopt to receive focus"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"}],"type":"strong"},{"text":": Lightweight state object that views use to query and request focus","type":"text"}]}]}]},{"text":"How Focus Works","type":"heading","level":2,"anchor":"How-Focus-Works"},{"type":"paragraph","inlineContent":[{"text":"Every frame, the ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}]},{"text":"The Focusable Protocol","type":"heading","level":2,"anchor":"The-Focusable-Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that want to receive focus conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"focusID"}],"type":"strong"},{"text":": Unique identifier for this focusable element","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"canBeFocused"}],"type":"strong"},{"type":"text","text":": Whether focus can move to this element (default: "},{"type":"codeVoice","code":"true"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"onFocusReceived()"}],"type":"strong"},{"text":": Called when this element gains focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}],"type":"strong"},{"text":": Called when this element loses focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}]},{"type":"text","text":": Handle a key event while focused; return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if consumed"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"code":"canBeFocused","type":"codeVoice"},{"text":" (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"), ","type":"text"},{"code":"onFocusReceived()","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"onFocusLost()","type":"codeVoice"},{"text":" (both no-ops). Only ","type":"text"},{"code":"focusID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" must be implemented.","type":"text"}]},{"text":"Using FocusState","type":"heading","level":2,"anchor":"Using-FocusState"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}]},{"type":"codeListing","code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":" create their own "},{"code":"FocusState","type":"codeVoice"},{"type":"text","text":" internally: you only need it when building custom focusable views."}]},{"text":"Navigation Keys","type":"heading","level":2,"anchor":"Navigation-Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" responds to these keys during dispatch:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next element"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next element"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]]],"header":"row"},{"text":"FocusRegistration Helper","type":"heading","level":2,"anchor":"FocusRegistration-Helper"},{"type":"paragraph","inlineContent":[{"text":"Built-in interactive views use the internal ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" helper to avoid boilerplate. It handles three tasks in one call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Persist a focus ID"}],"type":"strong"},{"text":" via ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":" so it remains stable across renders","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Register","type":"text"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Query"}]},{"type":"text","text":" whether this view currently has focus"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Custom views that implement ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"},{"text":" typically do not need ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" directly. It is used by the framework’s ","type":"text"},{"code":"_*Core","type":"codeVoice"},{"text":" views (e.g. ","type":"text"},{"code":"_ButtonCore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_ListCore","type":"codeVoice"},{"text":").","type":"text"}]},{"text":"Focus Indicator","type":"heading","level":2,"anchor":"Focus-Indicator"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The visual indicator depends on the view type. Buttons and similar controls use a "},{"type":"strong","inlineContent":[{"text":"highlight background bar","type":"text"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"text":"pulsing accent background","type":"text"}]},