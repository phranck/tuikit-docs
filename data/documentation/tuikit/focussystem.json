{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/tuikit\/focussystem"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"kind":"article","seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true}],"metadata":{"roleHeading":"Article","role":"article","title":"Focus System","modules":[{"name":"TUIkit"}]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit provides a focus system that lets users move between interactive views (buttons, menus, text fields) using Tab, Shift+Tab, or arrow keys. The system consists of three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"FocusManager"}],"type":"strong"},{"text":": Tracks which element is focused, handles navigation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","type":"reference","isActive":true}],"type":"strong"},{"text":": Protocol that views adopt to receive focus","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState"}]},{"type":"text","text":": Lightweight state object that views use to query and request focus"}]}]}],"type":"unorderedList"},{"anchor":"How-Focus-Works","level":2,"text":"How Focus Works","type":"heading"},{"inlineContent":[{"type":"text","text":"Every frame, the "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" is cleared and interactive views re-register themselves during rendering. This means focus registrations are always in sync with the current view tree: removed views are automatically unregistered."}],"type":"paragraph"},{"inlineContent":[{"text":"The focus order follows the rendering order: the first focusable view rendered is first in the Tab cycle.","type":"text"}],"type":"paragraph"},{"anchor":"The-Focusable-Protocol","level":2,"text":"The Focusable Protocol","type":"heading"},{"inlineContent":[{"text":"Views that want to receive focus conform to ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["public protocol Focusable: AnyObject {","    var focusID: String { get }","    var canBeFocused: Bool { get }","    func onFocusReceived()","    func onFocusLost()","    func handleKeyEvent(_ event: KeyEvent) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"focusID"}]},{"type":"text","text":": Unique identifier for this focusable element"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"canBeFocused","type":"codeVoice"}],"type":"strong"},{"text":": Whether focus can move to this element (default: ","type":"text"},{"code":"true","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"onFocusReceived()","type":"codeVoice"}]},{"type":"text","text":": Called when this element gains focus (default: no-op)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"onFocusLost()"}]},{"text":": Called when this element loses focus (default: no-op)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"handleKeyEvent(_:)"}]},{"type":"text","text":": Handle a key event while focused; return "},{"type":"codeVoice","code":"true"},{"type":"text","text":" if consumed"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A default extension provides sensible defaults for ","type":"text"},{"type":"codeVoice","code":"canBeFocused"},{"text":" (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), ","type":"text"},{"type":"codeVoice","code":"onFocusReceived()"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"onFocusLost()"},{"text":" (both no-ops). Only ","type":"text"},{"type":"codeVoice","code":"focusID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"text":" must be implemented.","type":"text"}],"type":"paragraph"},{"anchor":"Using-FocusState","level":2,"text":"Using FocusState","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","isActive":true,"type":"reference"},{"type":"text","text":" is the user-facing API for checking and requesting focus inside a view:"}],"type":"paragraph"},{"code":["let focusState = FocusState(id: \"my-button\", focusManager: context.environment.focusManager)","","\/\/ Check if this element is currently focused","if focusState.isFocused {","    \/\/ render with focus indicator","}","","\/\/ Programmatically request focus","focusState.requestFocus()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Built-in views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true,"type":"reference"},{"text":" create their own ","type":"text"},{"code":"FocusState","type":"codeVoice"},{"text":" internally: you only need it when building custom focusable views.","type":"text"}],"type":"paragraph"},{"anchor":"Navigation-Keys","level":2,"text":"Navigation Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" responds to these keys during dispatch:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous element"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Arrow Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next element","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Arrow Up \/ Left","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous element","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"FocusRegistration-Helper","level":2,"text":"FocusRegistration Helper","type":"heading"},{"inlineContent":[{"type":"text","text":"Built-in interactive views use the internal "},{"type":"codeVoice","code":"FocusRegistration"},{"type":"text","text":" helper to avoid boilerplate. It handles three tasks in one call:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persist a focus ID"}]},{"type":"text","text":" via "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" so it remains stable across renders"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Register"}],"type":"strong"},{"text":" the handler with the ","type":"text"},{"code":"FocusManager","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Query"}]},{"text":" whether this view currently has focus","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Custom views that implement ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable","isActive":true,"type":"reference"},{"text":" typically do not need ","type":"text"},{"code":"FocusRegistration","type":"codeVoice"},{"text":" directly. It is used by the framework’s ","type":"text"},{"code":"_*Core","type":"codeVoice"},{"text":" views (e.g. ","type":"text"},{"code":"_ButtonCore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"_ListCore","type":"codeVoice"},{"text":").","type":"text"}]},{"level":2,"type":"heading","anchor":"Focus-Indicator","text":"Focus Indicator"},{"type":"paragraph","inlineContent":[{"text":"The visual indicator depends on the view type. Buttons and similar controls use a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"highlight background bar"}]},{"type":"text","text":" for the focused item. Text fields use "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing vertical bars"}]},{"type":"text","text":" (caps) around the input area. Lists and tables use a "},{"type":"strong","inlineContent":[{"text":"highlight background","type":"text"}]},{"type":"text","text":" for the focused row, with a "},{"type":"strong","inlineContent":[{"type":"text","text":"pulsing accent background"}]},{"type":"text","text":" when the row is both focused and selected."}]},{"level":2,"type":"heading","anchor":"Focus-in-the-Event-Loop","text":"Focus in the Event Loop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus dispatch happens in Layer 2 of the key event pipeline (see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","isActive":true},{"type":"text","text":"):"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A key event arrives from stdin"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 1 (status bar) gets first chance to handle it","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Layer 2: ","type":"text"},{"code":"KeyEventDispatcher","type":"codeVoice"},{"text":" dispatches to the focused view’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not consumed, navigation keys (Tab, arrows) are handled by "},{"type":"codeVoice","code":"FocusManager"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Layer 3 (default bindings) handles quit, theme cycling, etc."}],"type":"paragraph"}]}]}],"kind":"content"}],"references":{"doc://TUIkit/documentation/TUIkit/Menu":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Menu"}],"navigatorTitle":[{"kind":"identifier","text":"Menu"}],"role":"symbol","url":"\/documentation\/tuikit\/menu","abstract":[{"text":"A vertical menu displaying a list of selectable items.","type":"text"}],"title":"Menu","type":"topic"},"doc://TUIkit/documentation/TUIkit/FocusState":{"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"