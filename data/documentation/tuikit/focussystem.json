ikit\/themingguide","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","title":"Theming Guide","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"url":"\/documentation\/tuikit\/statusbarguide","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","abstract":[{"type":"text","text":"Configure the shortcut bar at the bottom of the terminal."}],"role":"article","kind":"article","title":"Status Bar","type":"topic"},"doc://TUIkit/documentation/TUIkit/Button":{"title":"Button","url":"\/documentation\/tuikit\/button","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Button"}],"role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","abstract":[{"text":"An interactive button that triggers an action when pressed.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"Button"}],"kind":"symbol"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"url":"\/documentation\/tuikit\/layoutsystem","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","role":"article","title":"Layout System","type":"topic"},"doc://TUIkit/documentation/TUIkit/Preferences":{"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"role":"collectionGroup","url":"\/documentation\/tuikit\/preferences","kind":"article","title":"Preferences","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","type":"topic"}}}