e the"},{"type":"text","text":" "},{"type":"text","text":"render context and therefore cannot read "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":". A static"},{"type":"text","text":" "},{"type":"text","text":"reference is the only way to reach the service from those call sites."}],"type":"paragraph"},{"inlineContent":[{"text":"The same pattern is used by ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" for the same reason.","type":"text"},{"text":" ","type":"text"},{"text":"For tests, create a fresh instance instead of using ","type":"text"},{"code":"current","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["NotificationService.current.post(\"Done!\")"],"syntax":"swift","type":"codeListing"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit","doc:\/\/TUIkit\/documentation\/TUIkit\/NotificationService"]]},"sections":[],"references":{"tuikit-logo.png":{"alt":"TUIkit Logo","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"identifier":"tuikit-logo.png","type":"image"},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"type":"topic","url":"\/documentation\/tuikit","kind":"symbol","title":"TUIkit","role":"collection"},"doc://TUIkit/documentation/TUIkit/NotificationService":{"title":"NotificationService","navigatorTitle":[{"text":"NotificationService","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NotificationService","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NotificationService","kind":"identifier"}],"url":"\/documentation\/tuikit\/notificationservice","role":"symbol","kind":"symbol","type":"topic","abstract":[{"text