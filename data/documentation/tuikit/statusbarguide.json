{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items."}]},{"type":"paragraph","inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two status bar styles: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","type":"reference"},{"text":" (single-line, shortcuts only) and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","type":"reference"},{"text":" (bordered with title support).","type":"text"}]},{"type":"heading","text":"Architecture","level":2,"anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar system has three parts:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Manages the item stack, style, and event handling","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference"}],"type":"strong"},{"text":": A single shortcut entry (key + label + action)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","isActive":true}],"type":"strong"},{"type":"text","text":": The view that renders items into a "},{"isActive":true,"type":"refer