{"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"TUIkit provides two status bar styles: "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","type":"reference"},{"type":"text","text":" (single-line, shortcuts only) and "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","type":"reference"},{"type":"text","text":" (bordered with title support)."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Architecture","anchor":"Architecture"},{"inlineContent":[{"type":"text","text":"The status bar system has three parts:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","isActive":true,"type":"reference"}]},{"type":"text","text":": Manages the item stack, style, and event handling"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"}],"type":"strong"},{"text":": A single shortcut entry (key + label + action)","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar"}],"type":"strong"},{"text":": The view that renders items into a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Defining Status Bar Items","anchor":"Defining-Status-Bar-Items"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"statusBarItems"},{"type":"text","text":" modifier on your views to register shortcuts:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"]},{"inlineContent":[{"text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar.","type":"text"}],"type":"paragraph"},{"text":"Shortcut Display Symbols","level":2,"anchor":"Shortcut-Display-Symbols","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true,"type":"reference"},{"text":" to keep displayed shortcut symbols consistent:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Display","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default quit display","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"ty