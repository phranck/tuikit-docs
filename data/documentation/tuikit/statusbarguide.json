{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"title":"Status Bar","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide"},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"anchor":"Guides"}],"variants":[{"paths":["\/documentation\/tuikit\/statusbarguide"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"TUIkit provides two status bar styles: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact"},{"type":"text","text":" (single-line, shortcuts only) and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered"},{"type":"text","text":" (bordered with title support)."}],"type":"paragraph"},{"text":"Architecture","type":"heading","level":2,"anchor":"Architecture"},{"inlineContent":[{"type":"text","text":"The status bar system has three parts:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","isActive":true,"type":"reference"}]},{"type":"text","text":": Manages the item stack, style, and event handling"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"}]},{"text":": A single shortcut entry (key + label + action)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","isActive":true,"type":"reference"}]},{"text":": The view that renders items into a ","type":"text"},{"type":"codeVoice","code":"FrameBuffer"}]}]}]},{"text":"Defining Status Bar Items","type":"heading","level":2,"anchor":"Defining-Status-Bar-Items"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"statusBarItems"},{"type":"text","text":" modifier on your views to register shortcuts:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"]},{"inlineContent":[{"text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar.","type":"text"}],"type":"paragraph"},{"text":"Shortcut Display Symbols","type":"heading","level":2,"anchor":"Shortcut-Display-Symbols"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"type":"text","text":" to keep displayed shortcut symbols consistent:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Display"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default quit display","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↵","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↑"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↑↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Vertical navigation"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ctrl(\"q\")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"⌃q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ctrl+Q display"}],"type":"paragraph"}]]]},{"inlineContent":[{"code":"Shortcut","type":"codeVoice"},{"text":" defines how the item is displayed. If you do not pass ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StatusBarItem","type":"codeVoice"},{"text":" derives a trigger key from the shortcut string where possible.","type":"text"}],"type":"paragraph"},{"text":"Context Stack","type":"heading","level":2,"anchor":"Context-Stack"},{"inlineContent":[{"type":"text","text":"Status bar items use a "},{"type":"strong","inlineContent":[{"text":"context stack","type":"text"}]},{"type":"text","text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"inlineContent":[{"type":"text","text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string."}],"type":"paragraph"},{"text":"System Items","type":"heading","level":2,"anchor":"System-Items"},{"inlineContent":[{"type":"text","text":"TUIkit registers built-in system items automatically:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exit the application"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next border appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"These appear on the right side of the status bar. Only ","type":"text"},{"code":"q quit","type":"codeVoice"},{"text":" is shown by default. Enable ","type":"text"},{"code":"a appearance","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"t theme","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"View\/statusBarSystemItems(theme:appearance:)","type":"codeVoice"},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"text":"Overriding `q quit`","type":"heading","level":3,"anchor":"Overriding-q-quit"},{"inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"code":"q","type":"codeVoice"},{"type":"text","text":" overrides the built-in quit binding for that view context:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            closeEditor()","        }","    }"]},{"inlineContent":[{"type":"text","text":"This works because status bar items with actions are handled before the default quit binding. The built-in "},{"type":"codeVoice","code":"q quit"},{"type":"text","text":" system item is also removed from the display when a user item uses the same shortcut string."}],"type":"paragraph"},{"text":"Changing the global quit shortcut","type":"heading","level":3,"anchor":"Changing-the-global-quit-shortcut"},{"inlineContent":[{"type":"text","text":"Change the built-in quit key through "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    @Environment(\\.statusBar) private var statusBar","","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .task {","            statusBar.quitShortcut = .escape","        }","    }","}"]},{"inlineContent":[{"text":"Available presets include ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/q","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/escape","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/ctrlQ","type":"reference","isActive":true},{"text":", and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/ctrlC","type":"reference","isActive":true},{"text":". You can also create a fully custom ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Hiding the status bar completely","type":"heading","level":3,"anchor":"Hiding-the-status-bar-completely"},{"inlineContent":[{"type":"text","text":"Hide all system items and do not register any user items:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ContentView()","    .statusBarSystemItems(theme: false, appearance: false)"]},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.showSystemItems = false"]},{"inlineContent":[{"text":"When there are no active items left, the status bar height becomes zero and it is not rendered.","type":"text"}],"type":"paragraph"},{"text":"Status Bar Styles","type":"heading","level":2,"anchor":"Status-Bar-Styles"},{"inlineContent":[{"text":"Two styles are available:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","isActive":true}]},{"text":": Items rendered as ","type":"text"},{"code":"key Label","type":"codeVoice"},{"text":" pairs in a single line, no border","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered"}],"type":"strong"},{"text":": Items inside a bordered container","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Set the style during app configuration or at runtime via the status bar state."}],"type":"paragraph"},{"text":"Event Dispatch Priority","type":"heading","level":2,"anchor":"Event-Dispatch-Priority"},{"inlineContent":[{"type":"text","text":"Status bar items are dispatched in "},{"inlineContent":[{"type":"text","text":"Layer 1"}],"type":"strong"},{"type":"text","text":" of the key event pipeline: they take priority over view-registered handlers and default bindings. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle"},{"type":"text","text":" for the full dispatch order."}],"type":"paragraph"}],"kind":"con