{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar is hidden automatically when there are no active user items and no visible system items."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two status bar styles: "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","isActive":true},{"type":"text","text":" (single-line, shortcuts only) and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","isActive":true},{"type":"text","text":" (bordered with title support)."}]},{"type":"heading","text":"Architecture","level":2,"anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"text":"The status bar system has three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","type":"reference"}],"type":"strong"},{"type":"text","text":": Manages the item stack, style, and event handling"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"}],"type":"strong"},{"text":": A single shortcut entry (key + label + action)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","isActive":true,"type":"reference"}]},{"type":"text","text":": The view that renders items into a "},{"code":"FrameBuffer","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"heading","text":"Defining Status Bar Items","level":2,"anchor":"Defining-Status-Bar-Items"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"statusBarItems","type":"codeVoice"},{"text":" modifier on your views to register shortcuts:","type":"text"}]},{"code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar."}]},{"type":"heading","text":"Shortcut Display Symbols","level":2,"anchor":"Shortcut-Display-Symbols"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference"},{"text":" to keep displayed shortcut symbols consistent:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Display"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default quit display"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"