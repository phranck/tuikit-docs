ype":"heading","level":2,"text":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar system has three parts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","type":"reference","isActive":true}],"type":"strong"},{"text":": Manages the item stack, style, and event handling","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"}]},{"type":"text","text":": A single shortcut entry (key + label + action)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar"}]},{"type":"text","text":": The view that renders items into a "},{"type":"codeVoice","code":"FrameBuffer"}]}]}]},{"anchor":"Defining-Status-Bar-Items","type":"heading","level":2,"text":"Defining Status Bar Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"statusBarItems"},{"type":"text","text":" modifier on your views to register shortcuts:"}]},{"code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar."}]},{"level":2,"anchor":"Shortcut-Display-Symbols","text":"Shortcut Display Symbols","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc: