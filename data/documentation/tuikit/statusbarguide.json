{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"TUIkit provides two status bar styles: ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","isActive":true,"type":"reference"},{"text":" (single-line, shortcuts only) and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","isActive":true,"type":"reference"},{"text":" (bordered with title support).","type":"text"}],"type":"paragraph"},{"anchor":"Architecture","text":"Architecture","level":2,"type":"heading"},{"inlineContent":[{"text":"The status bar system has three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState"}],"type":"strong"},{"text":": Manages the item stack, style, and event handling","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"}],"type":"strong"},{"text":": A single shortcut entry (key + label + action)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar"}],"type":"strong"},{"type":"text","text":": The view that renders items into a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true}]}]}],"type":"unorderedList"},{"anchor":"Defining-Status-Bar-Items","text":"Defining Status Bar Items","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"statusBarItems"},{"type":"text","text":" modifier on your views to register shortcuts:"}],"type":"paragraph"},{"syntax":"swift","code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar."}],"type":"paragraph"},{"anchor":"Shortcut-Display-Symbols","text":"Shortcut Display Symbols","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true,"type":"reference"},{"text":" to keep displayed shortcut symbols consistent:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Display"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default quit display"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⎋"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"code":"⇥","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↑","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↑↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Vertical navigation"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ctrl(\"q\")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"⌃q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ctrl+Q display"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":"Shortcut"},{"type":"text","text":" defines how the item is displayed. If you do not pass "},{"type":"codeVoice","code":"key:"},{"type":"text","text":", "},{"type":"codeVoice","code":"StatusBarItem"},{"type":"text","text":" derives a trigger key from the shortcut string where possible."}],"type":"paragraph"},{"anchor":"Context-Stack","text":"Context Stack","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Status bar items use a "},{"type":"strong","inlineContent":[{"type":"text","text":"context stack"}]},{"type":"text","text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:"}],"type":"paragraph"},{"syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string."}],"type":"paragraph"},{"anchor":"System-Items","text":"System Items","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit registers built-in system items automatically:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exit the application","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next border appearance"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"These appear on the right side of the status bar. Only ","type":"text"},{"code":"q quit","type":"codeVoice"},{"text":" is shown by default. Enable ","type":"text"},{"code":"a appearance","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"t theme","type":"codeVoice"},{"text":" with the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/statusBarSystemItems(theme:appearance:)","type":"reference","isActive":true},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"anchor":"Overriding-q-quit","text":"Overriding `q quit`","level":3,"type":"heading"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" overrides the built-in quit binding for that view context:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            closeEditor()","        }","    }"],"type":"codeListing"},{"inlineContent":[{"text":"This works because status bar items with actions are handled before the default quit binding. The built-in ","type":"text"},{"type":"codeVoice","code":"q quit"},{"text":" system item is also removed from the display when a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"anchor":"Changing-the-global-quit-shortcut","text":"Changing the global quit shortcut","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Change the built-in quit key through "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    @Environment(\\.statusBar) private var statusBar","","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .task {","            statusBar.quitShortcut = .escape","        }","    }","}"],"ty