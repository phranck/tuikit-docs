{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","type":"reference"},{"text":" (bordered with title support).","type":"text"}]},{"level":2,"text":"Architecture","type":"heading","anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"text":"The status bar system has three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","isActive":true}]},{"text":": Manages the item stack, style, and event handling","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"}]},{"type":"text","text":": A single shortcut entry (key + label + action)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","isActive":true}]},{"text":": The view that renders items into a ","type":"text"},{"type":"codeVoice","code":"FrameBuffer"}]}]}]},{"level":2,"text":"Defining Status Bar Items","type":"heading","anchor":"Defining-Status-Bar-Items"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"statusBarItems","type":"codeVoice"},{"text":" modifier on your views to register shortcuts:","type":"text"}]},{"code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar."}]},{"level":2,"text":"Shortcut Display Symbols","type":"heading","anchor":"Shortcut-Display-Symbols"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference","isActive":true},{"text":" to keep displayed shortcut symbols consistent:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Display","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default quit display"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↵","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter \/ Return","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⎋"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↑"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↓","type":"codeVoice"}],"type":"paragraph"}]