{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items."}],"type":"paragraph"},{"inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"TUIkit provides two status bar styles: ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","isActive":true},{"text":" (single-line, shortcuts only) and ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","isActive":true},{"text":" (bordered with title support).","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Architecture","type":"heading","text":"Architecture"},{"inlineContent":[{"text":"The status bar system has three parts:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","type":"reference"}],"type":"strong"},{"type":"text","text":": Manages the item stack, style, and event handling"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"}],"type":"strong"},{"text":": A single shortcut entry (key + label + action)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar"}]},{"text":": The view that renders items into a ","type":"text"},{"type":"codeVoice","code":"FrameBuffer"}],"type":"paragraph"}]}]},{"level":2,"anchor":"Defining-Status-Bar-Items","type":"heading","text":"Defining Status Bar Items"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"statusBarItems"},{"text":" modifier on your views to register shortcuts:","type":"text"}],"type":"paragraph"},{"code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar."}],"type":"paragraph"},{"level":2,"anchor":"Shortcut-Display-Symbols","type":"heading","text":"Shortcut Display Symbols"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"type":"text","text":" to keep displayed shortcut symbols consistent:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Display"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default quit display","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↵","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⎋"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↑"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↑↓"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Vertical navigation","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ctrl(\"q\")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⌃q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Ctrl+Q display","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":"Shortcut"},{"type":"text","text":" defines how the item is displayed. If you do not pass "},{"type":"codeVoice","code":"key:"},{"type":"text","text":", "},{"type":"codeVoice","code":"StatusBarItem"},{"type":"text","text":" derives a trigger key from the shortcut string where possible."}],"type":"paragraph"},{"level":2,"anchor":"Context-Stack","type":"heading","text":"Context Stack"},{"inlineContent":[{"type":"text","text":"Status bar items use a "},{"type":"strong","inlineContent":[{"type":"text","text":"context stack"}]},{"type":"text","text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"System-Items","type":"heading","text":"System Items"},{"inlineContent":[{"type":"text","text":"TUIkit registers built-in system items automatically:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next border appearance"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next color theme"}]}]]],"type":"table"},{"inlineContent":[{"text":"These appear on the right side of the status bar. Only ","type":"text"},{"code":"q quit","type":"codeVoice"},{"text":" is shown by default. Enable ","type":"text"},{"code":"a appearance","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"t theme","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"View\/statusBarSystemItems(theme:appearance:)","type":"codeVoice"},{"text":" modifier.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Overriding-q-quit","type":"heading","text":"Overriding `q quit`"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" overrides the built-in quit binding for that view context:","type":"text"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            closeEditor()","        }","    }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This works because status bar items with actions are handled before the default quit binding. The built-in ","type":"text"},{"code":"q quit","type":"codeVoice"},{"text":" system item is also removed from the display when a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Changing-the-global-quit-shortcut","type":"heading","text":"Changing the global quit shortcut"},{"inlineContent":[{"text":"Change the built-in quit key through ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @Environment(\\.statusBar) private var statusBar","","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .task {","            statusBar.quitShortcut = .escape","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Available presets include ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/q"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/escape"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/ctrlQ"},{"text":", and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/ctrlC"},{"text":". You can also create a fully custom ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Hiding-the-status-bar-completely","type":"heading","text":"Hiding the status bar completely"},{"inlineContent":[{"type":"text","text":"Hide all system items and do not register any user items:"}],"type":"paragraph"},{"code":["ContentView()","    .statusBarSystemItems(theme: false, appearance: false)"],"type":"codeListing","syntax":"swift"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.showSystemItems = false"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When there are no active items left, the status bar height becomes zero and it is not rendered.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Status-Bar-Styles","type":"heading","text":"Status Bar Styles"},{"inlineContent":[{"text":"Two styles are available:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact"}]},{"type":"text","text":": Items rendered as "},{"type":"codeVoice","code":"key Label"},{"type":"text","text":" pairs in a single line, no border"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","isActive":true}],"type":"strong"},{"text":": Items inside a bordered container","type":"text"}]}]}]},{"inlineContent":[{"text":"Set the style during app configuration or at runtime via the status bar state.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Event-Dispatch-Priority","type":"heading","text":"Event Dispatch Priority"},{"inlineContent":[{"text":"Status bar items are dispatched in ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Layer 1"}]},{"text":" of the key event pipeline: they take priority over view-registered handlers and default bindings. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","type":"reference","isActive":true},{"text":" for the full dispatch order.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statusbarguide"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"