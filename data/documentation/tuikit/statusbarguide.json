{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items."}]},{"type":"paragraph","inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two status bar styles: ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","isActive":true},{"text":" (single-line, shortcuts only) and ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","isActive":true},{"text":" (bordered with title support).","type":"text"}]},{"type":"heading","level":2,"text":"Architecture","anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar system has three parts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState"}]},{"text":": Manages the item stack, style, and event handling","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"}]},{"text":": A single shortcut entry (key + label + action)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar"}],"type":"strong"},{"type":"text","text":": The view that renders items into a "},{"code":"FrameBuffer","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Defining Status Bar Items","anchor":"Defining-Status-Bar-Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"statusBarItems"},{"type":"text","text":" modifier on your views to register shortcuts:"}]},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar.","type":"text"}]},{"type":"heading","level":2,"text":"Shortcut Display Symbols","anchor":"Shortcut-Display-Symbols"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference","isActive":true},{"text":" to keep displayed shortcut symbols consistent:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Display","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default quit display"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter \/ Return","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↑","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↑↓"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Vertical navigation"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.ctrl(\"q\")","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"⌃q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ctrl+Q display"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut"},{"type":"text","text":" defines how the item is displayed. If you do not pass "},{"type":"codeVoice","code":"key:"},{"type":"text","text":", "},{"type":"codeVoice","code":"StatusBarItem"},{"type":"text","text":" derives a trigger key from the shortcut string where possible."}]},{"type":"heading","level":2,"text":"Context Stack","anchor":"Context-Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Status bar items use a "},{"inlineContent":[{"type":"text","text":"context stack"}],"type":"strong"},{"type":"text","text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:"}]},{"type":"codeListing","syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string."}]},{"type":"heading","level":2,"text":"System Items","anchor":"System-Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit registers built-in system items automatically:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Label","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exit the application"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next border appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These appear on the right side of the status bar. Only "},{"type":"codeVoice","code":"q quit"},{"type":"text","text":" is shown by default. Enable "},{"type":"codeVoice","code":"a appearance"},{"type":"text","text":" and "},{"type":"codeVoice","code":"t theme"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"View\/statusBarSystemItems(theme:appearance:)"},{"type":"text","text":" modifier."}]},{"type":"heading","level":3,"text":"Overriding `q quit`","anchor":"Overriding-q-quit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" overrides the built-in quit binding for that view context:"}]},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            closeEditor()","        }","    }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This works because status bar items with actions are handled before the default quit binding. The built-in "},{"type":"codeVoice","code":"q quit"},{"type":"text","text":" system item is also removed from the display when a user item uses the same shortcut string."}]},{"type":"heading","level":3,"text":"Changing the global quit shortcut","anchor":"Changing-the-global-quit-shortcut"},{"type":"paragraph","inlineContent":[{"text":"Change the built-in quit key through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    @Environment(\\.statusBar) private var statusBar","","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .task {","            statusBar.quitShortcut = .escape","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Available presets include ","type":"text"},