{"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items."}]},{"type":"paragraph","inlineContent":[{"text":"The status bar is hidden automatically when there are no active user items and no visible system items.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two status bar styles: ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","type":"reference","isActive":true},{"text":" (single-line, shortcuts only) and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","type":"reference","isActive":true},{"text":" (bordered with title support).","type":"text"}]},{"level":2,"type":"heading","text":"Architecture","anchor":"Architecture"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar system has three parts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState"}]},{"text":": Manages the item stack, style, and event handling","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference","isActive":true}],"type":"strong"},{"text":": A single shortcut entry (key + label + action)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","type":"reference"}],"type":"strong"},{"text":": The view that renders items into a