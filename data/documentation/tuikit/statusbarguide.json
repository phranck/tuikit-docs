text stack"}]},{"text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"text":"System Items","level":2,"anchor":"System-Items","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit registers built-in system items automatically:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Label","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exit the application","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next border appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"These appear on the right side of the status bar. Only "},{"type":"codeVoice","code":"q quit"},{"type":"text","text":" is shown by default. Enable "},{"type":"codeVoice","code":"a appearance"},{"type":"text","text":" and "},{"type":"codeVoice","code":"t theme"},{"type":"text","text":" with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/statusBarSystemItems(theme:appearance:)"},{"type":"text","text":" modifier."}],"type":"paragraph"},{"level":3,"text":"Overriding `q quit`","type":"heading","anchor":"Overriding-q-quit"},{"inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"code":"q","type":"codeVoice"},{"type":"text","text":" overrides the built-in quit binding for that view context:"}],"type":"paragraph"},{"syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            closeEditor()","        }","    }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This works because status bar items with actions are handled before the default quit binding. The built-in "},{"type":"codeVoice","code":"q quit"},{"type":"text","text":" system item is also removed from the display when a user item uses the same shortcut string."}],"type":"paragraph"},{"level":3,"text":"Changing the global quit shortcut","type":"heading","anchor":"Changing-the-global-quit-shortcut"},{"inlineContent":[{"type":"text","text":"Change the built-in quit key through "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    @Environment(\\.statusBar) private var statusBar","","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .task {","            statusBar.quitShortcut = .escape","        }","    }","}"],"ty