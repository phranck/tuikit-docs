Items"},{"type":"paragraph","inlineContent":[{"text":"TUIkit registers built-in system items automatically:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exit the application"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next border appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These appear on the right side of the status bar. Only "},{"type":"codeVoice","code":"q quit"},{"type":"text","text":" is shown by default. Enable "},{"type":"codeVoice","code":"a appearance"},{"type":"text","text":" and "},{"type":"codeVoice","code":"t theme"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"View\/statusBarSystemItems(theme:appearance:)"},{"type":"text","text":" modifier."}]},{"level":3,"text":"Overriding `q quit`","type":"heading","anchor":"Overriding-q-quit"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" overrides the built-in quit binding for that view context:"}]},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {"