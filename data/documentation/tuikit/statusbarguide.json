{"abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The status bar is a row at the bottom of the terminal that shows keyboard shortcuts and contextual information. It updates every frame while it has active items."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The status bar is hidden automatically when there are no active user items and no visible system items."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"TUIkit provides two status bar styles: "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","type":"reference","isActive":true},{"type":"text","text":" (single-line, shortcuts only) and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","type":"reference","isActive":true},{"type":"text","text":" (bordered with title support)."}],"type":"paragraph"},{"text":"Architecture","level":2,"type":"heading","anchor":"Architecture"},{"inlineContent":[{"text":"The status bar system has three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","isActive":true}],"type":"strong"},{"text":": Manages the item stack, style, and event handling","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"}]},{"type":"text","text":": A single shortcut entry (key + label + action)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","isActive":true}],"type":"strong"},{"type":"text","text":": The view that renders items into a "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"}]}]}],"type":"unorderedList"},{"text":"Defining Status Bar Items","level":2,"type":"heading","anchor":"Defining-Status-Bar-Items"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"statusBarItems"},{"type":"text","text":" modifier on your views to register shortcuts:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"My App\")","}",".statusBarItems {","    StatusBarItem(shortcut: \"n\", label: \"new\") {","        \/\/ handle \"n\" key press","    }","    StatusBarItem(shortcut: \"d\", label: \"delete\") {","        \/\/ handle \"d\" key press","    }","}"]},{"inlineContent":[{"text":"Items are registered per frame during rendering. When a view is removed from the tree, its items automatically disappear from the status bar.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Shortcut Display Symbols","level":2,"anchor":"Shortcut-Display-Symbols"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference"},{"text":" to keep displayed shortcut symbols consistent:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Display"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default quit display"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⎋"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↑"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}],"type":"paragraph"}],[{"inlineContent":[{"code":"↑↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Vertical navigation","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.ctrl(\"q\")","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"⌃q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Ctrl+Q display","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"code":"Shortcut","type":"codeVoice"},{"text":" defines how the item is displayed. If you do not pass ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StatusBarItem","type":"codeVoice"},{"text":" derives a trigger key from the shortcut string where possible.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Context Stack","type":"heading","anchor":"Context-Stack"},{"inlineContent":[{"text":"Status bar items use a ","type":"text"},{"inlineContent":[{"text":"context stack","type":"text"}],"type":"strong"},{"text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:","type":"text"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":2,"text":"System Items","type":"heading","anchor":"System-Items"},{"inlineContent":[{"text":"TUIkit registers built-in system items automatically:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exit the application","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next border appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"These appear on the right side of the status bar. Only "},{"code":"q quit","type":"codeVoice"},{"type":"text","text":" is shown by default. Enable "},{"code":"a appearance","type":"codeVoice"},{"type":"text","text":" and "},{"code":"t theme","type":"codeVoice"},{"type":"text","text":" with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/statusBarSystemItems(theme:appearance:)"},{"type":"text","text":" modifier."}],"type":"paragraph"},{"level":3,"text":"Overriding `q quit`","type":"heading","anchor":"Overriding-q-quit"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" overrides the built-in quit binding for that view context:","type":"text"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            closeEditor()","        }","    }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This works because status bar items with actions are handled before the default quit binding. The built-in "},{"code":"q quit","type":"codeVoice"},{"type":"text","text":" system item is also removed from the display when a user item uses the same shortcut string."}],"type":"paragraph"},{"level":3,"text":"Changing the global quit shortcut","type":"heading","anchor":"Changing-the-global-quit-shortcut"},{"inlineContent":[{"type":"text","text":"Change the built-in quit key through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @Environment(\\.statusBar) private var statusBar","","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","        .task {","            statusBar.quitShortcut = .escape","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Available presets include "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/q","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/escape","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/ctrlQ","isActive":true},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut\/ctrlC","isActive":true},{"type":"text","text":". You can also create a fully custom "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitShortcut","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"Hiding the status bar completely","type":"heading","anchor":"Hiding-the-status-bar-completely"},{"inlineContent":[{"type":"text","text":"Hide all system items and do not register any user items:"}],"type":"paragraph"},{"code":["ContentView()","    .statusBarSystemItems(theme: false, appearance: false)"],"type":"codeListing","syntax":"swift"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.showSystemItems = false"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When there are no active items left, the status bar height becomes zero and it is not rendered."}],"type":"paragraph"},{"level":2,"text":"Status Bar Styles","type":"heading","anchor":"Status-Bar-Styles"},{"inlineContent":[{"type":"text","text":"Two styles are available:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/compact","isActive":true}],"type":"strong"},{"text":": Items rendered as ","type":"text"},{"code":"key Label","type":"codeVoice"},{"text":" pairs in a single line, no border","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarStyle\/bordered","type":"reference","isActive":true}],"type":"strong"},{"type":"text","text":": Items inside a bordered container"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Set the style during app configuration or at runtime via the status bar state."}],"type":"paragraph"},{"level":2,"text":"Event Dispatch Priority","type":"heading","anchor":"Event-Dispatch-Priority"},{"inlineContent":[{"text":"Status bar items are dispatched in ","type":"text"},{"inlineContent":[{"type":"text","text":"Layer 1"}],"type":"strong"},{"text":" of the key event pipeline: they take priority over view-registered handlers and default bindings. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","type":"reference"},{"text":" for the full dispatch order.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"paths":["\/documentation\/tuikit\/statusbarguide"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"title":"Status Bar","roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","d