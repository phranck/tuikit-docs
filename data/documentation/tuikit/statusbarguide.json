t","type":"codeVoice"},{"text":" defines how the item is displayed. If you do not pass ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":", ","type":"text"},{"code":"StatusBarItem","type":"codeVoice"},{"text":" derives a trigger key from the shortcut string where possible.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Context Stack","type":"heading","anchor":"Context-Stack"},{"inlineContent":[{"type":"text","text":"Status bar items use a "},{"type":"strong","inlineContent":[{"text":"context stack","type":"text"}]},{"type":"text","text":". Context-specific items can temporarily replace global items, for example while a dialog is visible:"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Delete file?\")","} footer: {","    ButtonRow {","        Button(\"Delete\") { delete() }","        Button(\"Cancel\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { delete() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The topmost context replaces global user items in the display. System items remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":2,"text":"System Items","type":"heading","anchor":"System-Items"},{"inlineContent":[{"text":"TUIkit registers built-in system items automatically:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exit the application","type":"text"}],"type":"paragraph"}]],[[{"