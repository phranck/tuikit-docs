{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit is a Swift package that lets you create terminal user interfaces with a declarative, SwiftUI-like syntax. This guide walks you through setting up a project and building a simple app.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Adding-TUIkit-to-Your-Project","text":"Adding TUIkit to Your Project","type":"heading"},{"inlineContent":[{"text":"Add TUIkit as a dependency in your ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ swift-tools-version: 6.0","import PackageDescription","","let package = Package(","    name: \"MyTUIApp\",","    platforms: [.macOS(.v10_15)],","    dependencies: [","        .package(url: \"https:\/\/github.com\/phranck\/TUIkit.git\", from: \"0.1.0\"),","    ],","    targets: [","        .executableTarget(","            name: \"MyTUIApp\",","            dependencies: [\"TUIkit\"]","        ),","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Creating-Your-First-App","text":"Creating Your First App","type":"heading"},{"inlineContent":[{"text":"Create a ","type":"text"},{"code":"main.swift","type":"codeVoice"},{"text":" file with the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true,"type":"reference"},{"text":" protocol as your entry point:","type":"text"}],"type":"paragraph"},{"code":["import TUIkit","","@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            ContentView()","        }","    }","}","","struct ContentView: View {","    var body: some View {","        VStack {","            Text(\"Welcome to TUIkit!\")","                .bold()","                .foregroundColor(.cyan)","","            Spacer()","","            Text(\"Press 'q' to quit\")","                .dim()","        }","    }","}"],"syntax":"swift",