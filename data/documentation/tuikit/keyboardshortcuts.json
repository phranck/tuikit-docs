{"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"anchor":"Input-Types","title":"Input Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"]},{"anchor":"Focus","title":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"]},{"anchor":"Status-Bar","title":"Status Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"TUIkit"}],"title":"Keyboard Shortcuts"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"kind":"article","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"keyboard-event-dispatch.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Additionally, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"text":" any of these layers: it always terminates the application.","type":"text"}]},{"text":"Available Keys","type":"heading","anchor":"Available-Keys","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}]},{"text":"Character Keys","type":"heading","anchor":"Character-Keys","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}]},{"code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"type":"text","text":" has "},{"type":"codeVoice","code":"shift: true"},{"type":"text","text":" set automatically."}]},{"text":"Special Keys","type":"heading","anchor":"Special-Keys","level":3},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter \/ Return","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Forward delete","type":"text"}]}]]],"header":"row","type":"table"},{"anchor":"Arrow-Keys","level":3,"type":"heading","text":"Arrow Keys"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".down","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".left","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Navigation-Keys","level":3,"type":"heading","text":"Navigation Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"header":"row","type":"table"},{"anchor":"Key-Events-and-Modifiers","level":2,"type":"heading","text":"Key Events and Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"type":"text","text":" combines a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" with modifier flags:"}]},{"type":"codeListing","syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"]},{"type":"paragraph","inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ctrl+letter"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Shift","type":"text"}],"type":"strong"},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}]},{"text":"Registering Key Handlers","level":2,"anchor":"Registering-Key-Handlers","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"text":"Handle All Keys","level":3,"anchor":"Handle-All-Keys","type":"heading"},{"syntax":"swift","type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"text":"Handle Specific Keys","level":3,"anchor":"Handle-Specific-Keys","type":"heading"},{"syntax":"swift","type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"text":"Handle a Single Key","level":3,"anchor":"Handle-a-Single-Key","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}]},{"syntax":"swift","type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"text":"Handler Priority","level":3,"anchor":"Handler-Priority","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"syntax":"swift","type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}]},{"text":"Focus Navigation","level":2,"anchor":"Focus-Navigation","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" dispatches key events in three steps:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}],"type":"paragraph"}]}],"type":"orderedList"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"For more details, see ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference","isActive":true},{"text":".","type":"text"}]},{"text":"Default Bindings","level":2,"anchor":"Default-Bindings","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Quit Behavior","level":3,"anchor":"Quit-Behavior","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"text":"Behavior","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".always","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" only quits when no status bar context is pushed","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"code":"q","type":"codeVoice"},{"type":"text","text":" will be blocked until the user dismisses it:"}]},{"syntax":"swift","type":"codeListing","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"text":"Changing the built-in quit key","level":3,"anchor":"Changing-the-built-in-quit-key","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","type":"reference","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"text":"Overriding `q` in a local view context","level":3,"anchor":"Overriding-q-in-a-local-view-context","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"syntax":"swift","type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"text":"Status Bar Shortcuts","level":2,"anchor":"Status-Bar-Shortcuts","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"text":"Display Symbols","level":3,"anchor":"Display-Symbols","type":"heading"},{"syntax":"swift","type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"text":"Common Symbols","level":3,"anchor":"Common-Symbols","type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⇤","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.shiftTab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌫"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌦"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Delete"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"␣"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.space","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Space","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"←"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"→"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowRight"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↑↓"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Vertical arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Horizontal arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑↓←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌃"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Control modifier"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇧"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shift modifier"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Option \/ Alt","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Shortcut Helpers","level":3,"anchor":"Shortcut-Helpers","type":"heading"},{"syntax":"swift","type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"text":"Common Shortcut Letters","level":3,"anchor":"Common-Shortcut-Letters","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}],"type":"paragraph"}],[{"inlineContent":[{"code":"n","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"c"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"o"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Automatic Key Matching","level":3,"anchor":"Automatic-Key-Matching","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"code":"⎋","type":"codeVoice"},{"text":", ","type":"text"},{"code":"↵","type":"codeVoice"},{"text":", ","type":"text"},{"code":"⇥","type":"codeVoice"},{"text":") map to their corresponding ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" values","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"text":"Status Bar Context Stack","level":2,"anchor":"Status-Bar-Context-Stack","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}]},{"text":"System Items","level":3,"anchor":"System-Items","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"quit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"900"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit the application","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","typ