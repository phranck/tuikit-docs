{"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"title":"Keyboard Shortcuts","roleHeading":"API Collection","role":"collectionGroup"},"topicSections":[{"title":"Input Types","anchor":"Input-Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"]},{"title":"Focus","anchor":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"]},{"title":"Status Bar","anchor":"Status-Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" any of these layers: it always terminates the application."}],"type":"paragraph"},{"level":2,"text":"Available Keys","anchor":"Available-Keys","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Character Keys","anchor":"Character-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"code":".character(Character)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"type":"text","text":" has "},{"type":"codeVoice","code":"shift: true"},{"type":"text","text":" set automatically."}],"type":"paragraph"},{"level":3,"text":"Special Keys","anchor":"Special-Keys","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Return"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forward delete"}]}]]],"type":"table"},{"level":3,"text":"Arrow Keys","anchor":"Arrow-Keys","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".up","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".down"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow down","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".right","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]],"type":"table"},{"level":3,"text":"Navigation Keys","anchor":"Navigation-Keys","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".home","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Home"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".end","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"End","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageUp"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Page Up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageDown"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Page Down"}],"type":"paragraph"}]]],"type":"table"},{"level":2,"text":"Key Events and Modifiers","anchor":"Key-Events-and-Modifiers","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true,"type":"reference"},{"text":" combines a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true,"type":"reference"},{"text":" with modifier flags:","type":"text"}],"type":"paragraph"},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Ctrl+letter"}],"type":"strong"},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Alt+key"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Shift","type":"text"}]},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Registering-Key-Handlers","type":"heading","text":"Registering Key Handlers","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":".onKeyPress()","type":"codeVoice"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"anchor":"Handle-All-Keys","type":"heading","text":"Handle All Keys","level":3},{"type":"codeListing","syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"anchor":"Handle-Specific-Keys","type":"heading","text":"Handle Specific Keys","level":3},{"type":"codeListing","syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"anchor":"Handle-a-Single-Key","type":"heading","text":"Handle a Single Key","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"anchor":"Handler-Priority","type":"heading","text":"Handler Priority","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"text":"reverse registration order","type":"text"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}]},{"anchor":"Focus-Navigation","type":"heading","text":"Focus Navigation","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" dispatches key events in three steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focused element delegation"}]},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"For more details, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference"},{"text":".","type":"text"}]},{"anchor":"Default-Bindings","type":"heading","text":"Default Bindings","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit application","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true,"type":"reference"},{"type":"text","