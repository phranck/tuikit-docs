{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}],"type":"paragraph"},{"inlineContent":[{"identifier":"keyboard-event-dispatch.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Available Keys","anchor":"Available-Keys"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true,"type":"reference"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Character Keys","anchor":"Character-Keys"},{"inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"code":".character(Character)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"]},{"inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true,"type":"reference"},{"type":"text","text":" has "},{"type":"codeVoice","code":"shift: true"},{"type":"text","text":" set automatically."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Special Keys","anchor":"Special-Keys"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".escape"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Forward delete","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Arrow Keys","level":3,"type":"heading","anchor":"Arrow-Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".up"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]]],"type":"table","header":"row"},{"text":"Navigation Keys","level":3,"type":"heading","anchor":"Navigation-Keys"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".home","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Home"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".end","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"End","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".pageUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Page Up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".pageDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Page Down"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Key Events and Modifiers","level":2,"type":"heading","anchor":"Key-Events-and-Modifiers"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"type":"text","text":" combines a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ctrl+letter"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"text":": Detected from ESC prefix sequences (","type":"text"},{"code":"ESC","type":"codeVoice"},{"text":" followed by the key byte).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Shift","type":"text"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}],"type":"paragraph"}]}]},{"anchor":"Registering-Key-Handlers","type":"heading","level":2,"text":"Registering Key Handlers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":".onKeyPress()","type":"codeVoice"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"anchor":"Handle-All-Keys","type":"heading","level":3,"text":"Handle All Keys"},{"type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift"},{"anchor":"Handle-Specific-Keys","type":"heading","level":3,"text":"Handle Specific Keys"},{"type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift"},{"anchor":"Handle-a-Single-Key","type":"heading","level":3,"text":"Handle a Single Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}]},{"type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift"},{"anchor":"Handler-Priority","type":"heading","level":3,"text":"Handler Priority"},{"type":"paragraph","inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"type":"strong","inlineContent":[{"text":"reverse registration order","type":"text"}]},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}]},{"type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}]},{"anchor":"Focus-Navigation","type":"heading","level":2,"text":"Focus Navigation"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" dispatches key events in three steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}],"type":"strong"},{"type":"text","text":": cycles focus between elements (wraps around)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}]}]}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Up \/ Left","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down \/ Right","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more details, see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true},{"type":"text","text":"."}]},{"anchor":"Default-Bindings","type":"heading","level":2,"text":"Default Bindings"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit application","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true,"type":"reference"},{"text":" allows it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Always active","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Quit-Behavior","type":"heading","level":3,"text":"Quit Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Behavior","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".always"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".rootOnly","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" only quits when no status bar context is pushed","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}]},{"type":"codeListing","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift"},{"anchor":"Changing-the-built-in-quit-key","type":"heading","level":3,"text":"Changing the built-in quit key"},{"type":"paragraph","inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"anchor":"Overriding-q-in-a-local-view-context","type":"heading","level":3,"text":"Overriding `q` in a local view context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"anchor":"Status-Bar-Shortcuts","type":"heading","level":2,"text":"Status Bar Shortcuts"},{"type":"paragraph","inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true,"type":"reference"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}]},{"anchor":"Display-Symbols","type":"heading","level":3,"text":"Display Symbols"},{"type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift"},{"anchor":"Common-Symbols","type":"heading","level":3,"text":"Common Symbols"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Symbol"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⇤","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌫","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌦"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Delete"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"␣","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Space"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↑"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"←","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowLeft","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"→"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Vertical arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"←→"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Horizontal arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑↓←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌃"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Control modifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇧"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shift modifier"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Option \/ Alt","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Shortcut-Helpers","type":"heading","level":3,"text":"Shortcut Helpers"},{"type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift"},{"anchor":"Common-Shortcut-Letters","type":"heading","level":3,"text":"Common Shortcut Letters"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"n"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"c"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"o","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Automatic-Key-Matching","type":"heading","level":3,"text":"Automatic Key Matching"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"code":"⎋","type":"codeVoice"},{"text":", ","type":"text"},{"code":"↵","type":"codeVoice"},{"text":", ","type":"text"},{"code":"⇥","type":"codeVoice"},{"text":") map to their corresponding ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" values","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"code":"\"↑↓\"","type":"codeVoice"},{"type":"text","text":") match "},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}]},{"type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift"},{"anchor":"Status-Bar-Context-Stack","type":"heading","level":2,"text":"Status Bar Context Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}]},{"anchor":"System-Items","type":"heading","level":3,"text":"System Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"text":"quit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"900"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"910"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle border appearance"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"text":"920","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}]},{"type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system it