{"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides","generated":true}],"metadata":{"modules":[{"name":"TUIkit"}],"title":"Keyboard Shortcuts","roleHeading":"API Collection","role":"collectionGroup"},"topicSections":[{"title":"Input Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types"},{"title":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus"},{"title":"Status Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Bar"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"text":"Available Keys","anchor":"Available-Keys","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}]},{"text":"Character Keys","anchor":"Character-Keys","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"type":"codeVoice","code":".character(Character)"},{"text":":","type":"text"}]},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"type":"codeVoice","code":"KeyEvent"},{"type":"text","text":" has "},{"type":"codeVoice","code":"shift: true"},{"type":"text","text":" set automatically."}]},{"text":"Special Keys","anchor":"Special-Keys","type":"heading","level":3},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Return"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".delete"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forward delete"}]}]]],"type":"table"},{"level":3,"type":"heading","text":"Arrow Keys","anchor":"Arrow-Keys"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".up"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".down","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".right","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]],"type":"table"},{"level":3,"anchor":"Navigation-Keys","text":"Navigation Keys","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".end"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"type":"table"},{"level":2,"anchor":"Key-Events-and-Modifiers","text":"Key Events and Modifiers","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"KeyEvent"},{"type":"text","text":" combines a "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ctrl+letter"}]},{"type":"text","text":": Detected from ASCII control codes (0x01–0x1A). For example, "},{"code":"Ctrl+C","type":"codeVoice"},{"type":"text","text":" produces byte "},{"code":"0x03","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"code":"ESC","type":"codeVoice"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Shift","type":"text"}]},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Registering-Key-Handlers","text":"Registering Key Handlers","type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":".onKeyPress()","type":"codeVoice"},{"text":" modifier to handle keyboard events in your views:","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Handle-All-Keys","text":"Handle All Keys","type":"heading"},{"code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handle-Specific-Keys","text":"Handle Specific Keys","type":"heading"},{"code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handle-a-Single-Key","text":"Handle a Single Key","type":"heading"},{"inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}],"type":"paragraph"},{"code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handler-Priority","text":"Handler Priority","type":"heading"},{"inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}],"type":"paragraph"},{"code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift","type":"codeListing"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}]}],"name":"Important","type":"aside"},{"level":2,"anchor":"Focus-Navigation","text":"Focus Navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focused element delegation"}]},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Arrow key fallback","type":"text"}],"type":"strong"},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}],"type":"orderedList"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Up \/ Left","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down \/ Right","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"For more details, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Default-Bindings","text":"Default Bindings","type":"heading"},{"inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference"},{"text":" allows it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Always active","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":3,"anchor":"Quit-Behavior","text":"Quit Behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference"},{"type":"text","text":" enum controls when "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is allowed to quit:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".always","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]],"type":"table"},{"inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Changing-the-built-in-quit-key","text":"Changing the built-in quit key","type":"heading"},{"inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}],"type":"paragraph"},{"level":3,"anchor":"Overriding-q-in-a-local-view-context","text":"Overriding `q` in a local view context","type":"heading"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}],"type":"paragraph"},{"level":2,"anchor":"Status-Bar-Shortcuts","text":"Status Bar Shortcuts","type":"heading"},{"inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Display-Symbols","text":"Display Symbols","type":"heading"},{"code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Common-Symbols","text":"Common Symbols","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇤","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shiftTab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌫"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌦","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}]}],[{"type":"paragraph","inlineContent":[{"text":"Delete","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"␣"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Space"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow down","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowRight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}]}],[{"type":"paragraph","inlineContent":[{"text":"Vertical arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌃","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.control"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.option","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Option \/ Alt"}]}]]],"type":"table"},{"level":3,"anchor":"Shortcut-Helpers","text":"Shortcut Helpers","type":"heading"},{"code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Common-Shortcut-Letters","text":"Common Shortcut Letters","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"n"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]],"type":"table"},{"level":3,"anchor":"Automatic-Key-Matching","text":"Automatic Key Matching","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference","isActive":true},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"type":"codeVoice","code":"key:"},{"text":" parameter is given:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"type":"codeVoice","code":"\"q\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"y\""},{"text":") map to ","type":"text"},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"code":"\"↑↓\"","type":"codeVoice"},{"type":"text","text":") match "},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Status-Bar-Context-Stack","text":"Status Bar Context Stack","type":"heading"},{"inlineContent":[{"text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"System-Items","text":"System Items","type":"heading"},{"inlineContent":[{"text":"Three system items are shown by default:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Shortcut"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Order"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"quit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"900"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit the application","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"910"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle border appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"920"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle color theme","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}],"type":"paragraph"},{"code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When all system items are hidden and there are no active user items, the status bar is hidden completely.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts"},"references":{"doc://TUIkit/documentation/TUIkit/StatusBarItemProtocol":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusBarItemProtocol","kind":"identifier"}],"title":"StatusBarItemProtocol","role":"symbol","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A protocol for items that can be di