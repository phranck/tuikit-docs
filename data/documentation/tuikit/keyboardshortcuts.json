{"kind":"article","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","title":"Guides","generated":true}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"code":"Ctrl+C","type":"codeVoice"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"text":"Available Keys","type":"heading","level":2,"anchor":"Available-Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}]},{"text":"Character Keys","type":"heading","level":3,"anchor":"Character-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}]},{"code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true,"type":"reference"},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}]},{"text":"Special Keys","type":"heading","level":3,"anchor":"Special-Keys"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".escape"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Forward delete"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","text":"Arrow Keys","level":3,"anchor":"Arrow-Keys"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".up","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".right","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]],"header":"row"},{"type":"heading","text":"Navigation Keys","level":3,"anchor":"Navigation-Keys"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".home","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".end"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageUp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}]]],"header":"row"},{"type":"heading","text":"Key Events and Modifiers","level":2,"anchor":"Key-Events-and-Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","type":"reference","isActive":true},{"text":" combines a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference","isActive":true},{"text":" with modifier flags:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"]},{"type":"paragraph","inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ctrl+letter","type":"text"}]},{"type":"text","text":": Detected from ASCII control codes (0x01–0x1A). For example, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" produces byte "},{"type":"codeVoice","code":"0x03"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Alt+key"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}]}]}]},{"level":2,"text":"Registering Key Handlers","anchor":"Registering-Key-Handlers","type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":".onKeyPress()","type":"codeVoice"},{"text":" modifier to handle keyboard events in your views:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Handle All Keys","anchor":"Handle-All-Keys","type":"heading"},{"code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Handle Specific Keys","anchor":"Handle-Specific-Keys","type":"heading"},{"code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Handle a Single Key","anchor":"Handle-a-Single-Key","type":"heading"},{"inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}],"type":"paragraph"},{"code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Handler Priority","anchor":"Handler-Priority","type":"heading"},{"inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}],"type":"paragraph"},{"code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}],"style":"important","name":"Important","type":"aside"},{"level":2,"text":"Focus Navigation","anchor":"Focus-Navigation","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" dispatches key events in three steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}],"type":"strong"},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"For more details, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Default Bindings","anchor":"Default-Bindings","type":"heading"},{"inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit application","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":3,"text":"Quit Behavior","anchor":"Quit-Behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference"},{"type":"text","text":" enum controls when "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is allowed to quit:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Behavior"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".always","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" quits from any screen (default)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".rootOnly"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Changing the built-in quit key","anchor":"Changing-the-built-in-quit-key","type":"heading"},{"inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This changes both the Layer 4 quit binding and the displayed system item.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Overriding `q` in a local view context","anchor":"Overriding-q-in-a-local-view-context","type":"heading"},{"inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}],"type":"paragraph"},{"level":2,"text":"Status Bar Shortcuts","anchor":"Status-Bar-Shortcuts","type":"heading"},{"inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Display Symbols","anchor":"Display-Symbols","type":"heading"},{"code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Common Symbols","anchor":"Common-Symbols","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Symbol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⎋","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇤","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shiftTab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌫","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Delete"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"␣"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.space","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Space"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↓"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowLeft","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertical arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"text":"Horizontal arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓←→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsAll"}]}],[{"type":"paragraph","inlineContent":[{"text":"All arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌃"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.control"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Option \/ Alt"}]}]]],"type":"table","header":"row"},{"level":3,"text":"Shortcut Helpers","anchor":"Shortcut-Helpers","type":"heading"},{"code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Common Shortcut Letters","anchor":"Common-Shortcut-Letters","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"y","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"n"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"o","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"level":3,"text":"Automatic Key Matching","anchor":"Automatic-Key-Matching","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"code":"⎋","type":"codeVoice"},{"type":"text","text":", "},{"code":"↵","type":"codeVoice"},{"type":"text","text":", "},{"code":"⇥","type":"codeVoice"},{"type":"text","text":") map to their corresponding "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"type":"text","text":" values"}]}]},{"content":[{"inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"y\"","type":"codeVoice"},{"text":") map to ","type":"text"},{"code":".character(thatChar)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Status Bar Context Stack","anchor":"Status-Bar-Context-Stack","type":"heading"},{"inlineContent":[{"text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":3,"text":"System Items","anchor":"System-Items","type":"heading"},{"inlineContent":[{"type":"text","text":"Three system items are shown by default:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Shortcut","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"text":"quit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"text":"appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"910","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle border appearance"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"text":"920","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle color theme"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}],"type":"paragraph"},{"code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When all system items are hidden and there are no active user items, the status bar is hidden completely.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Keyboard Shortcuts","modules":[{"name":"TUIkit"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types","title":"Input Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus","title":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Ba