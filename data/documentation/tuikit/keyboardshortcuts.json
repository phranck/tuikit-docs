{"topicSections":[{"anchor":"Input-Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"title":"Input Types"},{"anchor":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"title":"Focus"},{"anchor":"Status-Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"title":"Status Bar"}],"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"metadata":{"roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Keyboard Shortcuts"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"keyboard-event-dispatch.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"text":"Available Keys","type":"heading","anchor":"Available-Keys","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}],"type":"paragraph"},{"text":"Character Keys","type":"heading","anchor":"Character-Keys","level":3},{"inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"code":"KeyEvent","type":"codeVoice"},{"type":"text","text":" has "},{"code":"shift: true","type":"codeVoice"},{"type":"text","text":" set automatically."}],"type":"paragraph"},{"text":"Special Keys","type":"heading","anchor":"Special-Keys","level":3},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter \/ Return","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".delete"}]}],[{"type":"paragraph","inlineContent":[{"text":"Forward delete","type":"text"}]}]]]},{"text":"Arrow Keys","type":"heading","anchor":"Arrow-Keys","level":3},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".down","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".left","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".right","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow right","type":"text"}],"type":"paragraph"}]]]},{"text":"Navigation Keys","type":"heading","anchor":"Navigation-Keys","level":3},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".end"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}]]]},{"text":"Key Events and Modifiers","type":"heading","anchor":"Key-Events-and-Modifiers","level":2},{"inlineContent":[{"type":"text","text":"A "},{"code":"KeyEvent","type":"codeVoice"},{"type":"text","text":" combines a "},{"code":"Key","type":"codeVoice"},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ctrl+letter","type":"text"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Alt+key"}],"type":"strong"},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shift"}],"type":"strong"},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}]},{"text":"Registering Key Handlers","type":"heading","anchor":"Registering-Key-Handlers","level":2},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}],"type":"paragraph"},{"text":"Handle All Keys","type":"heading","anchor":"Handle-All-Keys","level":3},{"code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"type":"codeListing","syntax":"swift"},{"text":"Handle Specific Keys","type":"heading","anchor":"Handle-Specific-Keys","level":3},{"code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"type":"codeListing","syntax":"swift"},{"text":"Handle a Single Key","type":"heading","anchor":"Handle-a-Single-Key","level":3},{"inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}],"type":"paragraph"},{"code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"type":"codeListing","syntax":"swift"},{"text":"Handler Priority","type":"heading","anchor":"Handler-Priority","level":3},{"inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"type":"strong","inlineContent":[{"text":"reverse registration order","type":"text"}]},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}],"type":"paragraph"},{"code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}]},{"text":"Focus Navigation","type":"heading","anchor":"Focus-Navigation","level":2},{"inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" dispatches key events in three steps:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Focused element delegation","type":"text"}]},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Arrow key fallback","type":"text"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}]}]]]},{"inlineContent":[{"type":"text","text":"For more details, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Default Bindings","type":"heading","anchor":"Default-Bindings","level":2},{"inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit application","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true,"type":"reference"},{"text":" allows it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]]},{"text":"Quit Behavior","type":"heading","anchor":"Quit-Behavior","level":3},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" enum controls when "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is allowed to quit:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Behavior"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".always"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".rootOnly","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" only quits when no status bar context is pushed"}],"type":"paragraph"}]]]},{"inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"code":"q","type":"codeVoice"},{"type":"text","text":" will be blocked until the user dismisses it:"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"type":"codeListing","syntax":"swift"},{"text":"Changing the built-in quit key","type":"heading","anchor":"Changing-the-built-in-quit-key","level":3},{"inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This changes both the Layer 4 quit binding and the displayed system item.","type":"text"}],"type":"paragraph"},{"text":"Overriding `q` in a local view context","type":"heading","anchor":"Overriding-q-in-a-local-view-context","level":3},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}],"type":"paragraph"},{"text":"Status Bar Shortcuts","type":"heading","anchor":"Status-Bar-Shortcuts","level":2},{"inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}],"type":"paragraph"},{"text":"Display Symbols","type":"heading","anchor":"Display-Symbols","level":3},{"code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"type":"codeListing","syntax":"swift"},{"text":"Common Symbols","type":"heading","anchor":"Common-Symbols","level":3},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⇥","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇤"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌫"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌦","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Delete","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"␣","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Space","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"←"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↑↓"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Vertical arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"←→"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Horizontal arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑↓←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsAll"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌃"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Control modifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇧"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift modifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌥","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Option \/ Alt"}],"type":"paragraph"}]]]},{"text":"Shortcut Helpers","type":"heading","anchor":"Shortcut-Helpers","level":3},{"code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"type":"codeListing","syntax":"swift"},{"text":"Common Shortcut Letters","type":"heading","anchor":"Common-Shortcut-Letters","level":3},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"n"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"c"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}],"type":"paragraph"}],[{"inlineContent":[{"code":"o","type":"codeVoice"}],"type":"paragraph"}]]]},{"text":"Automatic Key Matching","type":"heading","anchor":"Automatic-Key-Matching","level":3},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"y\"","type":"codeVoice"},{"text":") map to ","type":"text"},{"code":".character(thatChar)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}]},{"code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"type":"codeListing","syntax":"swift"},{"text":"Status Bar Context Stack","type":"heading","anchor":"Status-Bar-Context-Stack","level":2},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"text":"System Items","type":"heading","anchor":"System-Items","level":3},{"inlineContent":[{"type":"text","text":"Three system items are shown by default:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Order","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"900"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"910"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle border appearance"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"920"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]]},{"inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}],"type":"paragraph"},{"code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When all system items are hidden and there are no active user items, the status bar is hidden completely.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/FocusState":{"type":"topic","title":"FocusState","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","kind":"symbol","role":"symbol","abstract":[{"text":"Tracks focus state for a specific element.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"FocusState"}],"url":"\/documentation\/tuikit\/focu