{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"text":"Available Keys","type":"heading","level":2,"anchor":"Available-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}]},{"text":"Character Keys","type":"heading","level":3,"anchor":"Character-Keys"},{"type":"paragraph","inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"code":".character(Character)","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"type":"codeVoice","code":"KeyEvent"},{"text":" has ","type":"text"},{"type":"codeVoice","code":"shift: true"},{"text":" set automatically.","type":"text"}]},{"text":"Special Keys","type":"heading","level":3,"anchor":"Special-Keys"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape key"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Forward delete"}],"type":"paragraph"}]]]},{"text":"Arrow Keys","type":"heading","level":3,"anchor":"Arrow-Keys"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".up"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".down"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow down","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]]},{"text":"Navigation Keys","type":"heading","level":3,"anchor":"Navigation-Keys"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]]},{"text":"Key Events and Modifiers","type":"heading","level":2,"anchor":"Key-Events-and-Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"KeyEvent"},{"type":"text","text":" combines a "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" with modifier flags:"}]},{"syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Ctrl+letter"}],"type":"strong"},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}],"type":"paragraph"}]}]},{"text":"Registering Key Handlers","type":"heading","level":2,"anchor":"Registering-Key-Handlers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"text":"Handle All Keys","type":"heading","level":3,"anchor":"Handle-All-Keys"},{"syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"type":"codeListing"},{"anchor":"Handle-Specific-Keys","type":"heading","level":3,"text":"Handle Specific Keys"},{"syntax":"swift","type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"anchor":"Handle-a-Single-Key","type":"heading","level":3,"text":"Handle a Single Key"},{"inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"anchor":"Handler-Priority","type":"heading","level":3,"text":"Handler Priority"},{"inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}],"type":"aside","style":"important"},{"anchor":"Focus-Navigation","type":"heading","level":2,"text":"Focus Navigation"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" dispatches key events in three steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focused element delegation"}]},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}]}]}],"type":"orderedList"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"For more details, see ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Default-Bindings","type":"heading","level":2,"text":"Default Bindings"},{"inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference"},{"text":" allows it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Quit Behavior","level":3,"type":"heading","anchor":"Quit-Behavior"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference","isActive":true},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".always"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"text":" quits from any screen (default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":".rootOnly"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"type":"codeVoice","code":"q"},{"type":"text","text":" will be blocked until the user dismisses it:"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"type":"codeListing","syntax":"swift"},{"text":"Changing the built-in quit key","level":3,"type":"heading","anchor":"Changing-the-built-in-quit-key"},{"inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}],"type":"paragraph"},{"text":"Overriding `q` in a local view context","level":3,"type":"heading","anchor":"Overriding-q-in-a-local-view-context"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}],"type":"paragraph"},{"text":"Status Bar Shortcuts","level":2,"type":"heading","anchor":"Status-Bar-Shortcuts"},{"inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}],"type":"paragraph"},{"text":"Display Symbols","level":3,"type":"heading","anchor":"Display-Symbols"},{"code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"type":"codeListing","syntax":"swift"},{"text":"Common Symbols","level":3,"type":"heading","anchor":"Common-Symbols"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇤"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌫"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌦","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Delete","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"␣"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Space","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"↑","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowRight"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Vertical arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌃","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.control"}]}],[{"type":"paragraph","inlineContent":[{"text":"Control modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇧","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌥"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Option \/ Alt"}]}]]],"type":"table"},{"type":"heading","anchor":"Shortcut-Helpers","level":3,"text":"Shortcut Helpers"},{"syntax":"swift","type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"type":"heading","anchor":"Common-Shortcut-Letters","level":3,"text":"Common Shortcut Letters"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]]},{"type":"heading","anchor":"Automatic-Key-Matching","level":3,"text":"Automatic Key Matching"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" values"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" individual arrow keys"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"type":"heading","anchor":"Status-Bar-Context-Stack","level":2,"text":"Status Bar Context Stack"},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"System-Items","level":3,"text":"System Items"},{"inlineContent":[{"type":"text","text":"Three system items are shown by default:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Shortcut","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Order","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"quit"}],"type":"paragraph"}],[{"inlineContent":[{"text":"900","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit the application"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"910","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle border appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"theme"}],"type":"paragraph"}],[{"inlineContent":[{"text":"920","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle color theme"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"inlineContent":[{"text":"When all system items are hidden and there are no active user items, the status bar is hidden completely.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types","title":"Input Types"}