}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"n"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"c"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"o","type":"codeVoice"}],"type":"paragraph"}]]]},{"anchor":"Automatic-Key-Matching","type":"heading","text":"Automatic Key Matching","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Arrow combinations ("},{"code":"\"↑↓\"","type":"codeVoice"},{"type":"text","text":") match "},{"type":"strong","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" individual arrow keys"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"anchor":"Status-Bar-Context-Stack","type":"heading","text":"Status Bar Context Stack","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}]},{"anchor":"System-Items","type":"heading","text":"System Items","level":3},{"type":"paragraph","inlineContent":[{"text":"Three system items are shown by default:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"text":"Order","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit the application","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"910"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"920"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts"},"references":{"keyboard-event-dispatch.png":{"type":"image","identifier":"keyboard-event-dispatch.png","alt":"Flowchart showing keyboard event dispatch through five layers: a hasTextInputFocus check gates Layer 0 (Text Input via focusManager.dispatchKeyEvent for TextField\/SecureField). Layer 1: Status Bar Items (shortcut-triggered actions). Layer 2: View Handlers (.onKeyPress modifiers, deepest view first). A second hasTextInputFocus check skips Layer 3 if text input was focused. Layer 3: Focus System (focused element delegation, Tab\/Shift+Tab, arrow key fallback). Layer 4: Default Bindings (quit, theme, appearance). Unmatched events are dropped.","variants":[{"url":"\/images\/TUIkit\/keyboard-event-dispatch.png","traits":["1x","light"]},{"url":"\/images\/TUIkit\/keyboard-event-dispatch~dark.png","traits":["1x","dark"]}]},"doc://TUIkit/documentation/TUIkit":{"type":"topic","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"title":"TUIkit","kind":"symbol","url":"\/documentation\/tuikit","role":"collection","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit"},"tuikit-logo.png":{"type":"image","alt":"TUIkit Logo","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"identifier":"tuikit-logo.png"},"doc://TUIkit/documentation/TUIkit/StatusBarItemProtocol":{"navigatorTitle":[{"text":"StatusBarItemProtocol","kind":"identifier"}],"kind":"symbol","type":"topic","url":"\/documentation\/tuikit\/statusbaritemprotocol","title":"StatusBarItemProtocol","abstract":[{"type":"text","text":"A protocol for items that can be displayed in a status bar."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusBarItemProtocol","kind":"identifier"