{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"sections":[],"metadata":{"roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Keyboard Shortcuts"},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"title":"Input Types","anchor":"Input-Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"title":"Focus","anchor":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"title":"Status Bar","anchor":"Status-Bar"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides","anchor":"Guides","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" any of these layers: it always terminates the application."}],"type":"paragraph"},{"text":"Available Keys","type":"heading","anchor":"Available-Keys","level":2},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}],"type":"paragraph"},{"text":"Character Keys","type":"heading","anchor":"Character-Keys","level":3},{"inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"code":".character(Character)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"syntax":"swift"},{"inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true,"type":"reference"},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}],"type":"paragraph"},{"text":"Special Keys","type":"heading","anchor":"Special-Keys","level":3},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Return"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".delete"}]}],[{"type":"paragraph","inlineContent":[{"text":"Forward delete","type":"text"}]}]]],"header":"row","type":"table"},{"level":3,"anchor":"Arrow-Keys","text":"Arrow Keys","type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".down"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":3,"anchor":"Navigation-Keys","text":"Navigation Keys","type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".home","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Home","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".end"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"End"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageUp"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Page Up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageDown"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Page Down","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"anchor":"Key-Events-and-Modifiers","text":"Key Events and Modifiers","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","type":"reference"},{"text":" combines a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" with modifier flags:","type":"text"}],"type":"paragraph"},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ctrl+letter","type":"text"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Alt+key","type":"text"}],"type":"strong"},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shift"}],"type":"strong"},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}]}]}],"type":"unorderedList"},{"type":"heading","text":"Registering Key Handlers","level":2,"anchor":"Registering-Key-Handlers"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":".onKeyPress()"},{"text":" modifier to handle keyboard events in your views:","type":"text"}]},{"type":"heading","text":"Handle All Keys","level":3,"anchor":"Handle-All-Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"type":"heading","text":"Handle Specific Keys","level":3,"anchor":"Handle-Specific-Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"type":"heading","text":"Handle a Single Key","level":3,"anchor":"Handle-a-Single-Key"},{"type":"paragraph","inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"type":"heading","text":"Handler Priority","level":3,"anchor":"Handler-Priority"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}]},{"type":"heading","text":"Focus Navigation","level":2,"anchor":"Focus-Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Up \/ Left","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more details, see "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","text":"Default Bindings","level":2,"anchor":"Default-Bindings"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit application","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true,"type":"reference"},{"type":"text","text":" allows it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next color theme"}]}],[{"type":"paragraph","inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle to next appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always active"}]}]]],"header":"row"},{"type":"heading","text":"Quit Behavior","level":3,"anchor":"Quit-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".always"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"text":" quits from any screen (default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"type":"heading","text":"Changing the built-in quit key","level":3,"anchor":"Changing-the-built-in-quit-key"},{"type":"paragraph","inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"type":"paragraph","inlineContent":[{"text":"This changes both the Layer 4 quit binding and the displayed system item.","type":"text"}]},{"type":"heading","text":"Overriding `q` in a local view context","level":3,"anchor":"Overriding-q-in-a-local-view-context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"type":"heading","text":"Status Bar Shortcuts","level":2,"anchor":"Status-Bar-Shortcuts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"type":"heading","text":"Display Symbols","level":3,"anchor":"Display-Symbols"},{"type":"codeListing","syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"type":"heading","text":"Common Symbols","level":3,"anchor":"Common-Symbols"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⎋","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↵"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇤","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","c