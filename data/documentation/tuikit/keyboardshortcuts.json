ical arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"All arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌃"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.option","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]],"header":"row"},{"type":"heading","text":"Shortcut Helpers","level":3,"anchor":"Shortcut-Helpers"},{"type":"codeListing","syntax":"swift","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"type":"heading","text":"Common Shortcut Letters","level":3,"anchor":"Common-Shortcut-Letters"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]],"header":"row"},{"type":"heading","text":"Automatic Key Matching","level":3,"anchor":"Automatic-Key-Matching"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference","isActive":true},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" values"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"inlineContent":[{"text":"Arrow combinations (","type":"text"},{"type":"codeVoice","code":"\"↑↓\""},{"text":") match ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"type":"heading","text":"Status Bar Context Stack","level":2,"anchor":"Status-Bar-Context-Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"type":"heading","text":"System Items","level":3,"anchor":"System-Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Shortcut","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Order","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"text":"quit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"text":"appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"910","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"text":"920","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle color theme"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}]}]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/tuikit\/keyboardshortcuts"],"traits":[{"inter