{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"code":"Ctrl+C","type":"codeVoice"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"text":"Available Keys","type":"heading","level":2,"anchor":"Available-Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}]},{"text":"Character Keys","type":"heading","level":3,"anchor":"Character-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"code":".character(Character)","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"code":"KeyEvent","type":"codeVoice"},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}]},{"text":"Special Keys","type":"heading","level":3,"anchor":"Special-Keys"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape key"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Return"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forward delete"}]}]]]},{"text":"Arrow Keys","type":"heading","level":3,"anchor":"Arrow-Keys"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".down","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]]},{"text":"Navigation Keys","type":"heading","level":3,"anchor":"Navigation-Keys"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".home"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Home","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".end","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"End","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".pageUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Page Up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageDown"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Page Down"}],"type":"paragraph"}]]]},{"text":"Key Events and Modifiers","type":"heading","level":2,"anchor":"Key-Events-and-Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"KeyEvent","type":"codeVoice"},{"type":"text","text":" combines a "},{"code":"Key","type":"codeVoice"},{"type":"text","text":" with modifier flags:"}]},{"syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Ctrl+letter"}],"type":"strong"},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" produces byte ","type":"text"},{"code":"0x03","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"text":": Detected from ESC prefix sequences (","type":"text"},{"code":"ESC","type":"codeVoice"},{"text":" followed by the key byte).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}],"type":"paragraph"}]}]},{"text":"Registering Key Handlers","type":"heading","level":2,"anchor":"Registering-Key-Handlers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"text":"Handle All Keys","type":"heading","level":3,"anchor":"Handle-All-Keys"},{"syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"type":"codeListing"},{"text":"Handle Specific Keys","type":"heading","level":3,"anchor":"Handle-Specific-Keys"},{"syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"type":"codeListing"},{"text":"Handle a Single Key","type":"heading","level":3,"anchor":"Handle-a-Single-Key"},{"type":"paragraph","inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}]},{"syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"type":"codeListing"},{"text":"Handler Priority","type":"heading","level":3,"anchor":"Handler-Priority"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"type":"codeListing"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}],"type":"paragraph"}]},{"text":"Focus Navigation","type":"heading","level":2,"anchor":"Focus-Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Focused element delegation"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}],"type":"strong"},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down \/ Right","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more details, see "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true},{"type":"text","text":"."}]},{"text":"Default Bindings","type":"heading","level":2,"anchor":"Default-Bindings"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit application","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" allows it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle to next color theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always active"}]}]]]},{"text":"Quit Behavior","type":"heading","level":3,"anchor":"Quit-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".always"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" quits from any screen (default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]]},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}]},{"syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"type":"codeListing"},{"text":"Changing the built-in quit key","type":"heading","level":3,"anchor":"Changing-the-built-in-quit-key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}]},{"syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This changes both the Layer 4 quit binding and the displayed system item.","type":"text"}]},{"text":"Overriding `q` in a local view context","type":"heading","level":3,"anchor":"Overriding-q-in-a-local-view-context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"text":"Status Bar Shortcuts","type":"heading","level":2,"anchor":"Status-Bar-Shortcuts"},{"type":"paragraph","inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}]},{"text":"Display Symbols","type":"heading","level":3,"anchor":"Display-Symbols"},{"syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"type":"codeListing"},{"text":"Common Symbols","type":"heading","level":3,"anchor":"Common-Symbols"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⎋","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇤"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shiftTab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌫"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Delete"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"␣"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.space","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Space","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↓"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓","type":"codeVoice"}]}],[{"type":