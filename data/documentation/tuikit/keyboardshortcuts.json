{"metadata":{"roleHeading":"API Collection","title":"Keyboard Shortcuts","role":"collectionGroup","modules":[{"name":"TUIkit"}]},"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"title":"Input Types","anchor":"Input-Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"title":"Focus","anchor":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"title":"Status Bar","anchor":"Status-Bar"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"title":"Guides","anchor":"Guides"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"type":"heading","anchor":"Available-Keys","level":2,"text":"Available Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}]},{"type":"heading","anchor":"Character-Keys","level":3,"text":"Character Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"code":"KeyEvent","type":"codeVoice"},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}]},{"type":"heading","anchor":"Special-Keys","level":3,"text":"Special Keys"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".delete"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Forward delete","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","anchor":"Arrow-Keys","level":3,"text":"Arrow Keys"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".down"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".left","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".right","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","anchor":"Navigation-Keys","level":3,"text":"Navigation Keys"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageUp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}]]],"header":"row"},{"type":"heading","anchor":"Key-Events-and-Modifiers","level":2,"text":"Key Events and Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"KeyEvent"},{"type":"text","text":" combines a "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" with modifier flags:"}]},{"type":"codeListing","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Ctrl+letter","type":"text"}],"type":"strong"},{"type":"text","text":": Detected from ASCII control codes (0x01–0x1A). For example, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" produces byte "},{"type":"codeVoice","code":"0x03"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Alt+key"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Shift","type":"text"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Registering-Key-Handlers","level":2,"text":"Registering Key Handlers"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":".onKeyPress()","type":"codeVoice"},{"text":" modifier to handle keyboard events in your views:","type":"text"}]},{"type":"heading","anchor":"Handle-All-Keys","level":3,"text":"Handle All Keys"},{"type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift"},{"type":"heading","anchor":"Handle-Specific-Keys","level":3,"text":"Handle Specific Keys"},{"type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift"},{"type":"heading","anchor":"Handle-a-Single-Key","level":3,"text":"Handle a Single Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}]},{"type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift"},{"type":"heading","anchor":"Handler-Priority","level":3,"text":"Handler Priority"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift"},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","anchor":"Focus-Navigation","level":2,"text":"Focus Navigation"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" dispatches key events in three steps:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Arrow key fallback","type":"text"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}]}]}],"type":"orderedList"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more details, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Default-Bindings","level":2,"text":"Default Bindings"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Q"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit application","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" allows it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle to next color theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":