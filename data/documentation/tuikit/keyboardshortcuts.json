ched.","type":"text"}]},{"anchor":"Status-Bar-Shortcuts","type":"heading","text":"Status Bar Shortcuts","level":2},{"type":"paragraph","inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true,"type":"reference"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}]},{"anchor":"Display-Symbols","type":"heading","text":"Display Symbols","level":3},{"type":"codeListing","syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"anchor":"Common-Symbols","type":"heading","text":"Common Symbols","level":3},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⎋"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↵","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⇥","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇤"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}],"type":"paragraph"}],[{"in