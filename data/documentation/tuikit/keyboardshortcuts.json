"codeVoice"},{"text":", ","type":"text"},{"code":"⇥","type":"codeVoice"},{"text":") map to their corresponding ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" values","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"type":"codeVoice","code":"\"q\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"y\""},{"text":") map to ","type":"text"},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"type":"heading","level":2,"anchor":"Status-Bar-Context-Stack","text":"Status Bar Context Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    Sta