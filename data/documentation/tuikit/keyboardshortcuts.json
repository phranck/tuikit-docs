Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Common-Shortcut-Letters","type":"heading","text":"Common Shortcut Letters"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}]}],[{"type":"paragraph","inlineContent":[{"code":"c","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}]}],[{"type":"paragraph","inlineContent":[{"code":"o","type":"codeVoice"}]}]]]},{"level":3,"anchor":"Automatic-Key-Matching","type":"heading","text":"Automatic Key Matching"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"type":"codeVoice","code":"⎋"},{"text":", ","type":"text"},{"type":"codeVoice","code":"↵"},{"text":", ","type":"text"},{"type":"codeVoice","code":"⇥"},{"text":") map to their corresponding ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" values","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"type":"codeVoice","code":"\"q\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"y\""},{"text":") map to ","type":"text"},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}]},{"code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Status-Bar-Context-Stack","type":"heading","text":"Status Bar Context Stack"},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}],"type":"paragraph"},{"level":3,"anchor":"System-Items","type":"heading","text":"System Items"},{"inlineContent":[{"text":"Three system items are shown by default:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Shortcut","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit the application","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"910"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle border appearance"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"920"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle color theme"}]}]]]},{"inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}],"type":"paragraph"},{"code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}],"type":"paragraph"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"title":"Input Types","anchor":"Input-Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"title":"Focus","anchor":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"title":"Status Bar","anchor":"Status-Bar"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides","anchor":"Guides","generated":true}],"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"references":{"doc://TUIkit/documentation/TUIkit/StatusBarItemProtocol":{"abstract":[{"text":"A protocol for items that can be displayed in a status bar.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusBarItemProtocol","kind":"identifier"}],"type":"topic","url":"\/documentation\/tuikit\/statusbaritemprotocol","navigatorTitle":[{"text":"StatusBarItemProtocol","kind":