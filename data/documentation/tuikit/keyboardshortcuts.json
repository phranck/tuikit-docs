{"topicSections":[{"title":"Input Types","anchor":"Input-Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"]},{"title":"Focus","anchor":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"]},{"title":"Status Bar","anchor":"Status-Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Keyboard Shortcuts","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Available Keys","anchor":"Available-Keys","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference","isActive":true},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}],"type":"paragraph"},{"level":3,"text":"Character Keys","anchor":"Character-Keys","type":"heading"},{"inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"type":"codeVoice","code":".character(Character)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","type":"reference","isActive":true},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Special Keys","anchor":"Special-Keys","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Return"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Forward delete","type":"text"}]}]]],"type":"table"},{"text":"Arrow Keys","anchor":"Arrow-Keys","type":"heading","level":3},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".up"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".down","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".left","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]],"type":"table"},{"text":"Navigation Keys","anchor":"Navigation-Keys","type":"heading","level":3},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".home","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}]]],"type":"table"},{"text":"Key Events and Modifiers","anchor":"Key-Events-and-Modifiers","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","type":"reference","isActive":true},{"type":"text","text":" combines a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference","isActive":true},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"]},{"inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Ctrl+letter","type":"text"}]},{"type":"text","text":": Detected from ASCII control codes (0x01–0x1A). For example, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" produces byte "},{"type":"codeVoice","code":"0x03"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Alt+key"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}],"type":"paragraph"}]}]},{"text":"Registering Key Handlers","level":2,"anchor":"Registering-Key-Handlers","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}],"type":"paragraph"},{"text":"Handle All Keys","level":3,"anchor":"Handle-All-Keys","type":"heading"},{"syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"type":"codeListing"},{"text":"Handle Specific Keys","level":3,"anchor":"Handle-Specific-Keys","type":"heading"},{"syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"type":"codeListing"},{"text":"Handle a Single Key","level":3,"anchor":"Handle-a-Single-Key","type":"heading"},{"inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"type":"codeListing"},{"text":"Handler Priority","level":3,"anchor":"Handler-Priority","type":"heading"},{"inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"text":"Focus Navigation","level":2,"anchor":"Focus-Navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" dispatches key events in three steps:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focused element delegation"}]},{"type":"text","text":": the focused element’s "},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}]},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Arrow key fallback","type":"text"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}],"type":"orderedList"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Down \/ Right"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"For more details, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Default Bindings","level":2,"anchor":"Default-Bindings","type":"heading"},{"inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"T","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Always active","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"text":"Quit Behavior","level":3,"anchor":"Quit-Behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference","isActive":true},{"type":"text","text":" enum controls when "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is allowed to quit:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".always"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" quits from any screen (default)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"text":" only quits when no status bar context is pushed","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"code":"q","type":"codeVoice"},{"type":"text","text":" will be blocked until the user dismisses it:"}],"type":"paragraph"},{"syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"type":"codeListing"},{"text":"Changing the built-in quit key","level":3,"anchor":"Changing-the-built-in-quit-key","type":"heading"},{"inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}],"type":"paragraph"},{"text":"Overriding `q` in a local view context","level":3,"anchor":"Overriding-q-in-a-local-view-context","type":"heading"},{"inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}],"type":"paragraph"},{"syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}],"type":"paragraph"},{"text":"Status Bar Shortcuts","level":2,"anchor":"Status-Bar-Shortcuts","type":"heading"},{"inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}],"type":"paragraph"},{"text":"Display Symbols","level":3,"anchor":"Display-Symbols","type":"heading"},{"syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"type":"codeListing"},{"text":"Common Symbols","level":3,"anchor":"Common-Symbols","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↵","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇥"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇤"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.shiftTab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌫"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌦","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Delete","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"␣"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Space"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↑"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↓","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"←","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowLeft","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"→"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow right","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↑↓"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Vertical arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"←→"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Horizontal arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑↓←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌃"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Control modifier"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⇧","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift modifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Option \/ Alt"}],"type":"paragraph"}]]],"type":"table"},{"text":"Shortcut Helpers","level":3,"anchor":"Shortcut-Helpers","type":"heading"},{"syntax":"swift","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"type":"codeListing"},{"text":"Common Shortcut Letters","level":3,"anchor":"Common-Shortcut-Letters","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"code":"y","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"n"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]],"type":"table"},{"text":"Automatic Key Matching","level":3,"anchor":"Automatic-Key-Matching","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"type":"codeVoice","code":"⎋"},{"text":", ","type":"text"},{"type":"codeVoice","code":"↵"},{"text":", ","type":"text"},{"type":"codeVoice","code":"⇥"},{"text":") map to their corresponding ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" values","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"y\"","type":"codeVoice"},{"text":") map to ","type":"text"},{"code":".character(thatChar)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}],"type":"unorderedList"},{"syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"type":"codeListing"},{"text":"Status Bar Context Stack","level":2,"anchor":"Status-Bar-Context-Stack","type":"heading"},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}],"type":"paragraph"},{"text":"System Items","level":3,"anchor":"System-Items","type":"heading"},{"inlineContent":[{"text":"Three system items are shown by 