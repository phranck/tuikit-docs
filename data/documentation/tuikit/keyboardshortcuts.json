{"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types","title":"Input Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus","title":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Bar","title":"Status Bar"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}]},{"type":"paragraph","inlineContent":[{"identifier":"keyboard-event-dispatch.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Additionally, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" any of these layers: it always terminates the application.","type":"text"}]},{"type":"heading","level":2,"anchor":"Available-Keys","text":"Available Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}]},{"type":"heading","level":3,"anchor":"Character-Keys","text":"Character Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"code":".character(Character)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"type":"codeVoice","code":"KeyEvent"},{"type":"text","text":" has "},{"type":"codeVoice","code":"shift: true"},{"type":"text","text":" set automatically."}]},{"type":"heading","level":3,"anchor":"Special-Keys","text":"Special Keys"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter \/ Return","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".backspace"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Forward delete"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Arrow Keys","type":"heading","anchor":"Arrow-Keys","level":3},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".up","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".down"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".right","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow right","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Navigation Keys","type":"heading","anchor":"Navigation-Keys","level":3},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".home"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageUp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"header":"row","type":"table"},{"type":"heading","text":"Key Events and Modifiers","level":2,"anchor":"Key-Events-and-Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"KeyEvent"},{"text":" combines a ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" with modifier flags:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ctrl+letter"}]},{"type":"text","text":": Detected from ASCII control codes (0x01–0x1A). For example, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" produces byte "},{"type":"codeVoice","code":"0x03"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Alt+key"}],"type":"strong"},{"text":": Detected from ESC prefix sequences (","type":"text"},{"type":"codeVoice","code":"ESC"},{"text":" followed by the key byte).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Shift","type":"text"}],"type":"strong"},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Registering-Key-Handlers","text":"Registering Key Handlers"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":".onKeyPress()"},{"text":" modifier to handle keyboard events in your views:","type":"text"}]},{"type":"heading","level":3,"anchor":"Handle-All-Keys","text":"Handle All Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"type":"heading","level":3,"anchor":"Handle-Specific-Keys","text":"Handle Specific Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"type":"heading","level":3,"anchor":"Handle-a-Single-Key","text":"Handle a Single Key"},{"type":"paragraph","inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"type":"heading","level":3,"anchor":"Handler-Priority","text":"Handler Priority"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":2,"anchor":"Focus-Navigation","text":"Focus Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" dispatches key events in three steps:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Focused element delegation"}],"type":"strong"},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}]}]}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"For more details, see ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Default-Bindings","text":"Default Bindings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]]},{"type":"heading","level":3,"anchor":"Quit-Behavior","text":"Quit Behavior"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true,"type":"reference"},{"text":" enum controls when ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" is allowed to quit:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Behavior"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".always"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" quits from any screen (default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".rootOnly"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" only quits when no status bar context is pushed","type":"text"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"type":"codeVoice","code":"q"},{"type":"text","text":" will be blocked until the user dismisses it:"}]},{"type":"codeListing","syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"type":"heading","level":3,"anchor":"Changing-the-built-in-quit-key","text":"Changing the built-in quit key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"type":"heading","level":3,"anchor":"Overriding-q-in-a-local-view-context","text":"Overriding `q` in a local view context"},{"type":"paragraph","inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}]},{"type":"heading","level":2,"anchor":"Status-Bar-Shortcuts","text":"Status Bar Shortcuts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"type":"heading","level":3,"anchor":"Display-Symbols","text":"Display Symbols"},{"type":"codeListing","syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"type":"heading","level":3,"anchor":"Common-Symbols","text":"Common Symbols"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⎋","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"