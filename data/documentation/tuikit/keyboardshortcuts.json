Voice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓←→","type":"codeVoice"}]}],[{"inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"All arrows"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌃"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Control modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇧","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift modifier","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"⌥"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Option \/ Alt"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","level":3,"text":"Shortcut Helpers","anchor":"Shortcut-Helpers"},{"type":"codeListing","syntax":"swift","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"type":"heading","level":3,"text":"Common Shortcut Letters","anchor":"Common-Shortcut-Letters"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}]}],[{"type":"paragraph","inlineContent":[{"code":"o","type":"codeVoice"}]}]]],"header":"row"},{"type":"heading","level":3,"text":"Automatic Key Matching","anchor":"Automatic-Key-Matching"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"type":"codeVoice","code":"\"q\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"y\""},{"text":") map to ","type":"text"},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"type":"heading","level":2,"text":"Status Bar Context Stack","anchor":"Status-Bar-Context-Stack"},{"type":"paragraph","inlineContent":[{"text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"type":"heading","level":3,"text":"System Items","anchor":"System-Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Shortcut","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Label","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Order","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"900"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit the application","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"910"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle border appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"920"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle color theme"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}]}]}],"references":{"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","title":"Status Bar","role":"article","url":"\/documentation\/tuikit\/statusbarguide","type":"topic","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"kind":"article"},"doc://TUIkit/documentation/TUIkit/Focusable":{"navigatorTitle":[{"text":"Focus