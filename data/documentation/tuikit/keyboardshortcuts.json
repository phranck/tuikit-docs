pe":"paragraph","inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"type":"heading","anchor":"Overriding-q-in-a-local-view-context","level":3,"text":"Overriding `q` in a local view context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"type":"heading","anchor":"Status-Bar-Shortcuts","level":2,"text":"Status Bar Shortcuts"},{"type":"paragraph","inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference","isActive":true},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}]},{"type":"heading","anchor":"Display-Symbols","level":3,"text":"Display Symbols"},{"type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift"},{"type":"heading","anchor":"Common-Symbols","level":3,"text":"Common Symbols"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↵"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇤"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌫","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Backspace","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌦","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}]}],