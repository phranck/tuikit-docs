ifier","text":"quitShortcut"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6TUIkit12QuitShortcutV","text":"QuitShortcut"}],"type":"topic","abstract":[{"type":"text","text":"The keyboard shortcut used to quit the application."}],"url":"\/documentation\/tuikit\/statusbarstate\/quitshortcut","kind":"symbol","role":"symbol","title":"quitShortcut","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},"tuikit-logo.png":{"alt":"TUIkit Logo","identifier":"tuikit-logo.png","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"type":"image"},"doc://TUIkit/documentation/TUIkit/StatusBar":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StatusBar","kind":"identifier"}],"title":"StatusBar","role":"symbol","type":"topic","kind":"symbol","abstract":[{"text":"A status bar that displays at the bottom of the terminal.","type":"text"}],"url":"\/documentation\/tuikit\/statusbar","navigatorTitle":[{"text":"StatusBar","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","title":"TUIkit","role":"collection","url":"\/documentation\/tuikit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}]},"keyboard-event-dispatch.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/keyboard-event-dispatch.png"},{"traits":["1x","dark"],"url":"\/images\/TUIkit\/keyboard-event-dispatch~dark.png"}],"type":"image","identifier":"keyboard-event-dispatch.png","alt":"Flowchart showing keyboard event dispatch through five layers: a hasTextInputFocus check gates Layer 0 (Text Input via focusManager.dispatchKeyEvent for TextField\/SecureField). Layer 1