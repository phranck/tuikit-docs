:"text","text":"Shift"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}]}]}],"type":"unorderedList"},{"level":2,"text":"Registering Key Handlers","type":"heading","anchor":"Registering-Key-Handlers"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}],"type":"paragraph"},{"level":3,"text":"Handle All Keys","type":"heading","anchor":"Handle-All-Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"level":3,"text":"Handle Specific Keys","type":"heading","anchor":"Handle-Specific-Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"level":3,"text":"Handle a Single Key","type":"heading","anchor":"Handle-a-Single-Key"},{"inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"level":3,"text":"Handler Priority","type":"heading","anchor":"Handler-Priority"},{"inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"text":"reverse registration order","type":"text"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}]},{"level":2,"text":"Focus Navigation","type":"heading","anchor":"Focus-Navigation"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Focused element delegation","type":"text"}]},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Arrow key fallback","type":"text"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}],"type":"paragraph"}]}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"For more details, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Default Bindings","type":"heading","anchor":"Default-Bindings"},{"inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit application"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference"},{"type":"text","text":" allows it"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"T","type"