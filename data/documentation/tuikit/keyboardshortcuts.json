{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"anchor":"Guides","title":"Guides"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Available Keys","anchor":"Available-Keys"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true,"type":"reference"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Character Keys","anchor":"Character-Keys"},{"inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"]},{"inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true},{"text":" has ","type":"text"},{"type":"codeVoice","code":"shift: true"},{"text":" set automatically.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Special Keys","anchor":"Special-Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape key"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter \/ Return","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forward delete"}]}]]],"type":"table","header":"row"},{"text":"Arrow Keys","type":"heading","anchor":"Arrow-Keys","level":3},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow up","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".down"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".left","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".right"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Navigation Keys","type":"heading","anchor":"Navigation-Keys","level":3},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".home","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}]]],"type":"table","header":"row"},{"text":"Key Events and Modifiers","type":"heading","anchor":"Key-Events-and-Modifiers","level":2},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true,"type":"reference"},{"type":"text","text":" combines a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true,"type":"reference"},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"]},{"inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Ctrl+letter"}],"type":"strong"},{"type":"text","text":": Detected from ASCII control codes (0x01–0x1A). For example, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" produces byte "},{"type":"codeVoice","code":"0x03"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shift"}],"type":"strong"},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}]}]}]},{"level":2,"text":"Registering Key Handlers","anchor":"Registering-Key-Handlers","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":".onKeyPress()","type":"codeVoice"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"level":3,"text":"Handle All Keys","anchor":"Handle-All-Keys","type":"heading"},{"type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift"},{"level":3,"text":"Handle Specific Keys","anchor":"Handle-Specific-Keys","type":"heading"},{"type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift"},{"level":3,"text":"Handle a Single Key","anchor":"Handle-a-Single-Key","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}]},{"type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift"},{"level":3,"text":"Handler Priority","anchor":"Handler-Priority","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"text":"reverse registration order","type":"text"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}]},{"level":2,"text":"Focus Navigation","anchor":"Focus-Navigation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focused element delegation"}]},{"type":"text","text":": the focused element’s "},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}],"type":"paragraph"}]}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"For more details, see ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference","isActive":true},{"text":".","type":"text"}]},{"level":2,"text":"Default Bindings","anchor":"Default-Bindings","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}]},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit application","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next color theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":3,"text":"Quit Behavior","anchor":"Quit-Behavior","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Behavior","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".always","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".rootOnly"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"type":"codeVoice","code":"q"},{"type":"text","text":" will be blocked until the user dismisses it:"}]},{"type":"codeListing","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift"},{"level":3,"text":"Changing the built-in quit key","anchor":"Changing-the-built-in-quit-key","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This changes both the Layer 4 quit binding and the displayed system item.","type":"text"}]},{"level":3,"text":"Overriding `q` in a local view context","anchor":"Overriding-q-in-a-local-view-context","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}]},{"type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}]},{"level":2,"text":"Status Bar Shortcuts","anchor":"Status-Bar-Shortcuts","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"level":3,"text":"Display Symbols","anchor":"Display-Symbols","type":"heading"},{"type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift"},{"level":3,"text":"Common Symbols","anchor":"Common-Symbols","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇤"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌫"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Delete"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"␣"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Space"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertical arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Horizontal arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌃"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Control modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇧","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Option \/ Alt"}]}]]],"type":"table","header":"row"},{"level":3,"text":"Shortcut Helpers","anchor":"Shortcut-Helpers","type":"heading"},{"type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift"},{"level":3,"text":"Common Shortcut Letters","anchor":"Common-Shortcut-Letters","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"n"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}]}],[{"type":"paragraph","inlineContent":[{"code":"o","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"level":3,"text":"Automatic Key Matching","anchor":"Automatic-Key-Matching","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"code":"⎋","type":"codeVoice"},{"type":"text","text":", "},{"code":"↵","type":"codeVoice"},{"type":"text","text":", "},{"code":"⇥","type":"codeVoice"},{"type":"text","text":") map to their corresponding "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true,"type":"reference"},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"code":"\"q\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"y\"","type":"codeVoice"},{"type":"text","text":") map to "},{"code":".character(thatChar)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}],"type":"paragraph"}]}]},{"type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift"},{"level":2,"text":"Status Bar Context Stack","anchor":"Status-Bar-Context-Stack","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:","type":"text"}]},{"type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}]},{"level":3,"text":"System Items","anchor":"System-Items","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Three system items are shown by default:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"text":"appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"910","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"text":"920","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle color theme"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}]},{"type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","title":"Keyboard Shortcuts","role":"collectionGroup"},"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"variants":[{"paths":["\/documentation\/tuikit\/keyboardshortcuts"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types","title":"Input Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus","title":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Ba