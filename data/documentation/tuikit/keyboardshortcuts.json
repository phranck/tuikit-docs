{"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"topicSections":[{"anchor":"Input-Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"title":"Input Types"},{"anchor":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"title":"Focus"},{"anchor":"Status-Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"title":"Status Bar"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"API Collection","title":"Keyboard Shortcuts","role":"collectionGroup","modules":[{"name":"TUIkit"}]},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"title":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}],"type":"paragraph"},{"inlineContent":[{"identifier":"keyboard-event-dispatch.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Available-Keys","type":"heading","text":"Available Keys"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}],"type":"paragraph"},{"level":3,"anchor":"Character-Keys","type":"heading","text":"Character Keys"},{"inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"code":".character(Character)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Special-Keys","type":"heading","text":"Special Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape key","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Return"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Forward delete","type":"text"}]}]]],"header":"row","type":"table"},{"level":3,"anchor":"Arrow-Keys","type":"heading","text":"Arrow Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".up","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]],"header":"row","type":"table"},{"level":3,"anchor":"Navigation-Keys","type":"heading","text":"Navigation Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".home","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Home","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".end"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageUp"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"header":"row","type":"table"},{"level":2,"anchor":"Key-Events-and-Modifiers","type":"heading","text":"Key Events and Modifiers"},{"inlineContent":[{"type":"text","text":"A "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"type":"text","text":" combines a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ctrl+letter","type":"text"}],"type":"strong"},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" produces byte ","type":"text"},{"code":"0x03","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Alt+key"}]},{"text":": Detected from ESC prefix sequences (","type":"text"},{"code":"ESC","type":"codeVoice"},{"text":" followed by the key byte).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Registering-Key-Handlers","type":"heading","text":"Registering Key Handlers"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":".onKeyPress()","type":"codeVoice"},{"type":"text","text":" modifier to handle keyboard events in your views:"}],"type":"paragraph"},{"level":3,"anchor":"Handle-All-Keys","type":"heading","text":"Handle All Keys"},{"code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handle-Specific-Keys","type":"heading","text":"Handle Specific Keys"},{"code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handle-a-Single-Key","type":"heading","text":"Handle a Single Key"},{"inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}],"type":"paragraph"},{"code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Handler-Priority","type":"heading","text":"Handler Priority"},{"inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}],"type":"paragraph"},{"code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}],"style":"important","type":"aside","name":"Important"},{"level":2,"anchor":"Focus-Navigation","type":"heading","text":"Focus Navigation"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Focused element delegation","type":"text"}]},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}],"type":"paragraph"}]}],"type":"orderedList"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the next focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"For more details, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Default-Bindings","type":"heading","text":"Default Bindings"},{"inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit application"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" allows it"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next color theme"}]}],[{"type":"paragraph","inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always active"}]}]]],"header":"row","type":"table"},{"level":3,"anchor":"Quit-Behavior","type":"heading","text":"Quit Behavior"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true,"type":"reference"},{"text":" enum controls when ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is allowed to quit:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Behavior"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".always","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".rootOnly","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"codeVoice","code":".rootOnly"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"type":"codeVoice","code":"q"},{"type":"text","text":" will be blocked until the user dismisses it:"}],"type":"paragraph"},{"code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Changing-the-built-in-quit-key","type":"heading","text":"Changing the built-in quit key"},{"inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}],"type":"paragraph"},{"level":3,"anchor":"Overriding-q-in-a-local-view-context","type":"heading","text":"Overriding `q` in a local view context"},{"inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}],"type":"paragraph"},{"code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}],"type":"paragraph"},{"level":2,"anchor":"Status-Bar-Shortcuts","type":"heading","text":"Status Bar Shortcuts"},{"inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Display-Symbols","type":"heading","text":"Display Symbols"},{"code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Common-Symbols","type":"heading","text":"Common Symbols"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⎋","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↵"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇤","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌫"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}]}],[{"type":"paragraph","inlineContent":[{"text":"Delete","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"␣","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Space"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowUp"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow down","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowLeft","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Vertical arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"text":"Horizontal arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsAll"}]}],[{"type":"paragraph","inlineContent":[{"text":"All arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌃"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.control"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌥"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]],"header":"row","type":"table"},{"level":3,"anchor":"Shortcut-Helpers","type":"heading","text":"Shortcut Helpers"},{"code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Common-Shortcut-Letters","type":"heading","text":"Common Shortcut Letters"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]],"header":"row","type":"table"},{"level":3,"anchor":"Automatic-Key-Matching","type":"heading","text":"Automatic Key Matching"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"type":"codeVoice","code":"key:"},{"text":" parameter is given:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"code":"⎋","type":"codeVoice"},{"type":"text","text":", "},{"code":"↵","type":"codeVoice"},{"type":"text","text":", "},{"code":"⇥","type":"codeVoice"},{"type":"text","text":") map to their corresponding "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}],"type":"unorderedList"},{"code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Status-Bar-Context-Stack","type":"heading","text":"Status Bar Context Stack"},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}],"type":"paragraph"},{"level":3,"anchor":"System-Items","type":"heading","text":"System Items"},{"inlineContent":[{"text":"Three system items are shown by default:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"text":"Order","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"quit","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"900"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"910"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"920"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}],"type":"paragraph"},{"code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}],"type":"paragr