ype":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"n"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"c","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"o"}],"type":"paragraph"}]]],"type":"table"},{"level":3,"text":"Automatic Key Matching","type":"heading","anchor":"Automatic-Key-Matching"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"type":"codeVoice","code":"⎋"},{"text":", ","type":"text"},{"type":"codeVoice","code":"↵"},{"text":", ","type":"text"},{"type":"codeVoice","code":"⇥"},{"text":") map to their corresponding ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" values","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}]}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"level":2,"text":"Status Bar Context Stack","type":"heading","anchor":"Status-Bar-Context-Stack"},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}],"type":"paragraph"},{"level":3,"text":"System Items","type":"heading","anchor":"System-Items"},{"inlineContent":[{"type":"text","text":"Three system items are shown by default:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Shortcut","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"900"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"appearance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"910"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"920"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/tuikit\/keyboardshortcuts"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Keyboard Shortcuts"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/