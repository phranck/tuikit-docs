"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"y","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"n"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"c","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]]},{"text":"Automatic Key Matching","type":"heading","level":3,"anchor":"Automatic-Key-Matching"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"type":"codeVoice","code":"key:"},{"text":" parameter is given:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"code":"⎋","type":"codeVoice"},{"text":", ","type":"text"},{"code":"↵","type":"codeVoice"},{"text":", ","type":"text"},{"code":"⇥","type":"codeVoice"},{"type":"text","text":") map to their corresponding "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" values"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" individual arrow keys"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}],"type":"unorderedList"},{"type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift"},{"level":2,"type":"heading","text":"Status Bar Context Stack","anchor":"Status-Bar-Context-Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"level":3,"type":"heading","text":"System Items","anchor":"System-Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Shortcut"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Label","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Order"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"quit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"900"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit the application","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"910","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle border appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"920"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle color theme"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}]},{"type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When all system items are hidden and there are no active user items, the status bar is hidden completely.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts"},"schemaVersion":{"patch":0