graph","inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Vertical arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌃","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Control modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Option \/ Alt"}]}]]],"header":"row","type":"table"},{"anchor":"Shortcut-Helpers","type":"heading","text":"Shortcut Helpers","level":3},{"syntax":"swift","type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"anchor":"Common-Shortcut-Letters","type":"heading","text":"Common Shortcut Letters","level":3},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"code":"y","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}]}],[{"type":"paragraph","inlineContent":[{"code":"o","type":"codeVoice"}]}]]]},{"anchor":"Automatic-Key-Matching","type":"heading","text":"Automatic Key Matching","level":3},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"type":"codeVoice","code":"⎋"},{"text":", ","type":"text"},{"type":"codeVoice","code":"↵"},{"text":", ","type":"text"},{"type":"codeVoice","code":"⇥"},{"text":") map to their corresponding ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" values","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"code":"\"q\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"y\"","type":"codeVoice"},{"type":"text","text":") map to "},{"code":".character(thatChar)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"both"}]},{"text":" individual arrow keys","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"anchor":"Status-Bar-Context-Stack","type":"heading","text":"Status Bar Context Stack","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}]},{"anchor":"System-Items","type":"heading","text":"System Items","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit the application","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"a","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"text":"910","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"}]}],[{"type":"paragraph","inlineContent":[{"text":"theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"920"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]}],"kind":"content"}],"references":{"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"type":"topic","url":"\/documentation\/tuikit\/layoutsystem","title":"Layout System","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"type":"topic","url":"\/documentation\/tuikit\/statemanagement","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"title":"State Management","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/FocusState":{"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","abstract":[{"type":"text","text":"Tracks focus state for a specific element."}],"role":"symbol","title":"FocusState","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FocusState","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"FocusState","kind":"identifier"}],"url":"\/documentation\/tuikit\/focusstate"},"keyboard-event-dispatch.png":{"type":"image","identifier":"keyboard-event-dispatch.png","alt":"Flowchart showing keyboard event dispatch through five layers: a hasTextInputFocus check gates Layer 0 (Text Input via focusManager.dispatchKeyEvent for TextField\/SecureField). Layer 1: Status Bar Items (shortcut-triggered actions). Layer 2: View Handlers (.onKeyPress modifiers, deepest view first). A second hasTextInputFocus check skips Layer 3 if text input was focused. Layer 3: Focus System (focused element delegation, Tab\/Shift+Tab, arrow key fallback). Layer 4: Default Bindings (quit, theme, appearance). Unmatched events are dropped.","variants":[{"url":"\/images\/TUIkit\/keyboard-event-dispatch.png","traits":["1x","light"]},{"url":"\/images\/TUIkit\/keyboard-event-dispatch~dark.png","traits":["1x","dark"]}]},"doc://TUIkit/documentation/TUIkit/StatusBarItem":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","title":"StatusBarItem","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind