{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types","title":"Input Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus","title":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Bar","title":"Status Bar"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"anchor":"Guides","title":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Keyboard Shortcuts"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"level":2,"anchor":"Available-Keys","type":"heading","text":"Available Keys"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}]},{"level":3,"anchor":"Character-Keys","type":"heading","text":"Character Keys"},{"type":"paragraph","inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"code":".character(Character)","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"type":"codeVoice","code":"KeyEvent"},{"text":" has ","type":"text"},{"type":"codeVoice","code":"shift: true"},{"text":" set automatically.","type":"text"}]},{"level":3,"anchor":"Special-Keys","type":"heading","text":"Special Keys"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".escape"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".enter"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".backspace"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Forward delete"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Arrow-Keys","text":"Arrow Keys","level":3,"type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".up","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".down","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow down","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".left","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".right","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Navigation-Keys","text":"Navigation Keys","level":3,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".end"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"type":"table"},{"anchor":"Key-Events-and-Modifiers","text":"Key Events and Modifiers","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"KeyEvent"},{"type":"text","text":" combines a "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" with modifier flags:"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing"},{"inlineContent":[{"text":"The terminal encodes modifiers differently from GUI frameworks:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Ctrl+letter"}],"type":"strong"},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" produces byte ","type":"text"},{"code":"0x03","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"text":": Detected from ESC prefix sequences (","type":"text"},{"type":"codeVoice","code":"ESC"},{"text":" followed by the key byte).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Shift","type":"text"}]},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Registering-Key-Handlers","type":"heading","level":2,"text":"Registering Key Handlers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"anchor":"Handle-All-Keys","type":"heading","level":3,"text":"Handle All Keys"},{"type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift"},{"anchor":"Handle-Specific-Keys","type":"heading","level":3,"text":"Handle Specific Keys"},{"type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift"},{"anchor":"Handle-a-Single-Key","type":"heading","level":3,"text":"Handle a Single Key"},{"type":"paragraph","inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}]},{"type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift"},{"anchor":"Handler-Priority","type":"heading","level":3,"text":"Handler Priority"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"text":"reverse registration order","type":"text"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift"},{"style":"important","type":"aside","content":[{"inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}],"type":"paragraph"}],"name":"Important"},{"anchor":"Focus-Navigation","type":"heading","level":2,"text":"Focus Navigation"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" dispatches key events in three steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"type":"text","text":": the focused element’s "},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}],"type":"strong"},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}]}]}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more details, see "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference"},{"type":"text","text":"."}]},{"anchor":"Default-Bindings","type":"heading","level":2,"text":"Default Bindings"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]]},{"anchor":"Quit-Behavior","type":"heading","level":3,"text":"Quit Behavior"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"text":" enum controls when ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" is allowed to quit:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".always","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" quits from any screen (default)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]]},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}]},{"type":"codeListing","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift"},{"anchor":"Changing-the-built-in-quit-key","type":"heading","level":3,"text":"Changing the built-in quit key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"anchor":"Overriding-q-in-a-local-view-context","type":"heading","level":3,"text":"Overriding `q` in a local view context"},{"type":"paragraph","inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}]},{"type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}]},{"anchor":"Status-Bar-Shortcuts","type":"heading","level":2,"text":"Status Bar Shortcuts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"anchor":"Display-Symbols","type":"heading","level":3,"text":"Display Symbols"},{"type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift"},{"anchor":"Common-Symbols","type":"heading","level":3,"text":"Common Symbols"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Symbol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⎋","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↵"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇤"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌫","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Delete","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"␣"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Space","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↓"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowLeft","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertical arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌃","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.control"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇧","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.option","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]]},{"anchor":"Shortcut-Helpers","type":"heading","level":3,"text":"Shortcut Helpers"},{"type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift"},{"anchor":"Common-Shortcut-Letters","type":"heading","level":3,"text":"Common Shortcut Letters"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"n","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"c"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"o"}],"type":"paragraph"}]]]},{"anchor":"Automatic-Key-Matching","type":"heading","level":3,"text":"Automatic Key Matching"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"code":"⎋","type":"codeVoice"},{"text":", ","type":"text"},{"code":"↵","type":"codeVoice"},{"text":", ","type":"text"},{"code":"⇥","type":"codeVoice"},{"text":") map to their corresponding ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" values","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"code":"\"q\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"y\"","type":"codeVoice"},{"type":"text","text":") map to "},{"code":".character(thatChar)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}]}]}]},{"type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift"},{"anchor":"Status-Bar-Context-Stack","type":"heading","level":2,"text":"Status Bar Context Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"anchor":"System-Items","type":"heading","level":3,"text":"System Items"},{"type":"paragraph","inlineContent":[{"text":"Three system items are shown by default:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"text":"Label","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{