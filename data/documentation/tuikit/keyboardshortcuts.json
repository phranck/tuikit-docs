{"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" any of these layers: it always terminates the application."}],"type":"paragraph"},{"text":"Available Keys","level":2,"type":"heading","anchor":"Available-Keys"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}],"type":"paragraph"},{"text":"Character Keys","level":3,"type":"heading","anchor":"Character-Keys"},{"inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"text":" has ","type":"text"},{"type":"codeVoice","code":"shift: true"},{"text":" set automatically.","type":"text"}],"type":"paragraph"},{"text":"Special Keys","level":3,"type":"heading","anchor":"Special-Keys"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".escape"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Escape key"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".enter"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter \/ Return","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Backspace \/ Delete backward"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Forward delete","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Arrow-Keys","level":3,"text":"Arrow Keys","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".up"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".right","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow right"}]}]]],"header":"row","type":"table"},{"anchor":"Navigation-Keys","level":3,"text":"Navigation Keys","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".home"}]}],[{"type":"paragraph","inlineContent":[{"text":"Home","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"header":"row","type":"table"},{"anchor":"Key-Events-and-Modifiers","level":2,"text":"Key Events and Modifiers","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent"},{"text":" combines a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"text":" with modifier flags:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Ctrl+letter","type":"text"}],"type":"strong"},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Alt+key","type":"text"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shift"}],"type":"strong"},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Registering Key Handlers","level":2,"type":"heading","anchor":"Registering-Key-Handlers"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":".onKeyPress()","type":"codeVoice"},{"text":" modifier to handle keyboard events in your views:","type":"text"}],"type":"paragraph"},{"text":"Handle All Keys","level":3,"type":"heading","anchor":"Handle-All-Keys"},{"syntax":"swift","type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"text":"Handle Specific Keys","level":3,"type":"heading","anchor":"Handle-Specific-Keys"},{"syntax":"swift","type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"text":"Handle a Single Key","level":3,"type":"heading","anchor":"Handle-a-Single-Key"},{"inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"text":"Handler Priority","level":3,"type":"heading","anchor":"Handler-Priority"},{"inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}]}]},{"text":"Focus Navigation","level":2,"type":"heading","anchor":"Focus-Navigation"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" dispatches key events in three steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Focused element delegation","type":"text"}]},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Tab \/ Shift+Tab","type":"text"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up \/ Left"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down \/ Right","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"For more details, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Default Bindings","level":2,"type":"heading","anchor":"Default-Bindings"},{"inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Condition","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit application","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"A"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]]},{"text":"Quit Behavior","level":3,"type":"heading","anchor":"Quit-Behavior"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference","isActive":true},{"text":" enum controls when ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" is allowed to quit:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".always"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"text":" quits from any screen (default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]]},{"inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"text":"Changing the built-in quit key","level":3,"type":"heading","anchor":"Changing-the-built-in-quit-key"},{"inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"inlineContent":[{"text":"This changes both the Layer 4 quit binding and the displayed system item.","type":"text"}],"type":"paragraph"},{"text":"Overriding `q` in a local view context","level":3,"type":"heading","anchor":"Overriding-q-in-a-local-view-context"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"type":"codeVoice","code":"q"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}],"type":"paragraph"},{"text":"Status Bar Shortcuts","level":2,"type":"heading","anchor":"Status-Bar-Shortcuts"},{"inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","type":"reference","isActive":true},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}],"type":"paragraph"},{"text":"Display Symbols","level":3,"type":"heading","anchor":"Display-Symbols"},{"syntax":"swift","type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"text":"Common Symbols","level":3,"type":"heading","anchor":"Common-Symbols"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Symbol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↵"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇤"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shiftTab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌫","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backspace"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Delete"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"␣","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.space","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Space"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow down","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertical arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsAll"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌃"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.option","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]]},{"text":"Shortcut Helpers","level":3,"type":"heading","anchor":"Shortcut-Helpers"},{"syntax":"swift","type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"text":"Common Shortcut Letters","level":3,"type":"heading","anchor":"Common-Shortcut-Letters"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}],"type":"paragraph"}],[{"inlineContent":[{"code":"n","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"c"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}],"type":"paragraph"}],[{"inlineContent":[{"code":"o","type":"codeVoice"}],"type":"paragraph"}]]]},{"text":"Automatic Key Matching","level":3,"type":"heading","anchor":"Automatic-Key-Matching"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"type":"text","text":" values"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single-character shortcuts ("},{"type":"codeVoice","code":"\"q\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"y\""},{"type":"text","text":") map to "},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}]}]}],"type":"unorderedList"},{"syntax":"swift","type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"text":"Status Bar Context Stack","level":2,"type":"heading","anchor":"Status-Bar-Context-Stack"},{"inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}],"type":"paragraph"},{"text":"System Items","level":3,"type":"heading","anchor":"System-Items"},{"inlineContent":[{"type":"text","text":"Three system items are shown by default:"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Shortcut"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Label","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Order","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"quit","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"900","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit the application"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"appearance"}],"type":"paragraph"}],[{"inlineContent":[{"text":"910","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle border appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"theme"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"920"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle color theme","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"System items appear on the right side of the status bar. They can be disabled individually:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"inlineContent":[{"te