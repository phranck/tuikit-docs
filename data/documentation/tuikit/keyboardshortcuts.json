}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↓"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow down","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow left"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsUpDown","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Vertical arrows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsLeftRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑↓←→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌃"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Control modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇧"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift modifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]],"type":"table","header":"row"},{"type":"heading","level":3,"text":"Shortcut Helpers","anchor":"Shortcut-Helpers"},{"syntax":"swift","type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"type":"heading","level":3,"text":"Common Shortcut Letters","anchor":"Common-Shortcut-Letters"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}]}],[{"type":"paragraph","inlineContent":[{"code":"c","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]],"type":"table","header":"row"},{"type":"heading","level":3,"text":"Automatic Key Matching","anchor":"Automatic-Key-Matching"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference","isActive":true},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"code":"key:","type":"codeVoice"},{"type":"text","text":" parameter is given:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"type":"codeVoice","code":"⎋"},{"text":", ","type":"text"},{"type":"codeVoice","code":"↵"},{"text":", ","type":"text"},{"type":"codeVoice","code":"⇥"},{"text":") map to their corresponding ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key"},{"text":" values","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"y\"","type":"codeVoice"},{"text":") map to ","type":"text"},{"code":".character(thatChar)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"type":"strong","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" individual arrow keys"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Multi-character non-symbol strings are informational only (no trigger key)","type":"text"}]}]}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"type":"heading","level":2,"text":"Status Bar Context Stack","anchor":"Status-Bar-Context-Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"type":"heading","level":3,"text":"System Items","anchor":"System-Items"},{"type":"paragraph","inlineContent":[{"text":"Three system items are shown by default:","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Shortcut","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Label","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Order","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"quit"}],"type":"paragraph"}],[{"inlineContent":[{"text":"900","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit the application"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"a"}],"type":"paragraph"}],[{"inlineContent":[{"text":"appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"910"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle border appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"}],"type":"paragraph"}],[{"inlineContent":[{"text":"theme","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"920","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle color theme"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"paths":["\/documentation\/tuikit\/keyboardshortcuts"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Keyboard Shortcuts","modules":[{"name":"TUIkit"}],"role":"collectionGroup","roleHeading":"API Collection"},"topicSections":[{"title":"Input Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types"},{"title":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus"},{"title":"Status Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Bar"}],"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view h