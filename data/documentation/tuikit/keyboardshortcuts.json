{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Available Keys","anchor":"Available-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}],"type":"paragraph"},{"level":3,"text":"Character Keys","anchor":"Character-Keys","type":"heading"},{"inlineContent":[{"text":"Any printable character is represented as ","type":"text"},{"code":".character(Character)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","type":"reference","isActive":true},{"type":"text","text":" has "},{"type":"codeVoice","code":"shift: true"},{"type":"text","text":" set automatically."}],"type":"paragraph"},{"level":3,"text":"Special Keys","anchor":"Special-Keys","type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".escape","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape key","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Enter \/ Return"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".backspace"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".delete","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Forward delete","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Arrow Keys","type":"heading","level":3,"anchor":"Arrow-Keys"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".down"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".left","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".right","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Navigation Keys","type":"heading","level":3,"anchor":"Navigation-Keys"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".home","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Home"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".end"}],"type":"paragraph"}],[{"inlineContent":[{"text":"End","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageUp"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Page Up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pageDown"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Page Down"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"text":"Key Events and Modifiers","type":"heading","level":2,"anchor":"Key-Events-and-Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","type":"reference","isActive":true},{"text":" combines a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference","isActive":true},{"text":" with modifier flags:","type":"text"}]},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ctrl+letter","type":"text"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" produces byte ","type":"text"},{"code":"0x03","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Alt+key"}],"type":"strong"},{"text":": Detected from ESC prefix sequences (","type":"text"},{"code":"ESC","type":"codeVoice"},{"text":" followed by the key byte).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Shift"}],"type":"strong"},{"text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys.","type":"text"}]}]}]},{"anchor":"Registering-Key-Handlers","type":"heading","level":2,"text":"Registering Key Handlers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":".onKeyPress()","type":"codeVoice"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"anchor":"Handle-All-Keys","type":"heading","level":3,"text":"Handle All Keys"},{"syntax":"swift","type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"anchor":"Handle-Specific-Keys","type":"heading","level":3,"text":"Handle Specific Keys"},{"syntax":"swift","type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"anchor":"Handle-a-Single-Key","type":"heading","level":3,"text":"Handle a Single Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}]},{"syntax":"swift","type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"anchor":"Handler-Priority","type":"heading","level":3,"text":"Handler Priority"},{"type":"paragraph","inlineContent":[{"text":"Handlers are dispatched in ","type":"text"},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}],"style":"important"},{"anchor":"Focus-Navigation","type":"heading","level":2,"text":"Focus Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" dispatches key events in three steps:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Focused element delegation"}]},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}]},{"text":": cycles focus between elements (wraps around).","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}],"type":"paragraph"}]}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Tab"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Shift+Tab"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to previous element in section (fallback)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"For more details, see ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"anchor":"Default-Bindings","type":"heading","level":2,"text":"Default Bindings"},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Quit application"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"text":" allows it","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"t","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"T","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next appearance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]]},{"type":"heading","anchor":"Quit-Behavior","level":3,"text":"Quit Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".always","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".rootOnly"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]]},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"type":"text","text":" is useful for modal dialogs: push a status bar context for the dialog, and "},{"code":"q","type":"codeVoice"},{"type":"text","text":" will be blocked until the user dismisses it:"}]},{"type":"codeListing","syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"type":"heading","anchor":"Changing-the-built-in-quit-key","level":3,"text":"Changing the built-in quit key"},{"type":"paragraph","inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"type":"heading","anchor":"Overriding-q-in-a-local-view-context","level":3,"text":"Overriding `q` in a local view context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"type":"codeVoice","code":"q"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"type":"heading","anchor":"Status-Bar-Shortcuts","level":2,"text":"Status Bar Shortcuts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"type":"heading","anchor":"Display-Symbols","level":3,"text":"Display Symbols"},{"type":"codeListing","syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"type":"heading","anchor":"Common-Symbols","level":3,"text":"Common Symbols"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Symbol","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.enter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇤"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌫"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.backspace"}]}],[{"type":"paragraph","inlineContent":[{"text":"Backspace","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⌦"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.delete","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Delete"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"␣","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Space","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↑"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow up"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"↓"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"←","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowLeft","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"→"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowRight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Vertical arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"←→"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Horizontal arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↑↓←→","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.arrowsAll","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"All arrows"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌃","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.control"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇧","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.option"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]]},{"type":"heading","anchor":"Shortcut-Helpers","level":3,"text":"Shortcut Helpers"},{"type":"codeListing","syntax":"swift","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"]},{"type":"heading","anchor":"Common-Shortcut-Letters","level":3,"text":"Common Shortcut Letters"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Constant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.yes"}]}],[{"type":"paragraph","inlineContent":[{"code":"y","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.no"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.cancel","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"c"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"o","type":"codeVoice"}]}]]]},{"type":"heading","anchor":"Automatic-Key-Matching","level":3,"text":"Automatic Key Matching"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem"},{"type":"text","text":" automatically derives the trigger key from the shortcut string when no explicit "},{"type":"codeVoice","code":"key:"},{"type":"text","text":" parameter is given:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"code":"⎋","type":"codeVoice"},{"text":", ","type":"text"},{"code":"↵","type":"codeVoice"},{"text":", ","type":"text"},{"code":"⇥","type":"codeVoice"},{"text":") map to their corresponding ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"text":" values","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"y\"","type":"codeVoice"},{"text":") map to ","type":"text"},{"code":".character(thatChar)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"]},{"type":"heading","anchor":"Status-Bar-Context-Stack","level":2,"text":"Status Bar Context Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"]},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"type":"heading","anchor":"System-Items","level":3,"text":"System Items"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shortcut"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Order"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit the application","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"appearance"}]}],[{"type":"paragraph","inlineContent":[{"text":"910","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle border appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"theme","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"920","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cycle color theme","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"System items appear on the right side of the status bar. They can be disabled individually:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your App","statusBar.showSystemItems = false       \/\/ Hide all system items","statusBar.showThemeItem = false         \/\/ Hide only theme cycling","statusBar.showAppearanceItem = false    \/\/ Hide only appearance cycling"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When all system items are hidden and there are no active user items, the status bar is hidden completely."}]}]}],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","title":"Keyboard Shortcuts","modules":[{"name":"TUIkit"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/keyboardshortcuts"]}],"abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true,"title":"Guides"}],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"anchor":"Input-Types","title":"Input Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"anchor":"Focus","title":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"anchor":"Status-Ba