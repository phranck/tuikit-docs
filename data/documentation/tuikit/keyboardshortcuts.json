rows","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌃","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Control modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇧","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shift"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift modifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌥","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.option","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Option \/ Alt","type":"text"}]}]]],"header":"row"},{"type":"heading","anchor":"Shortcut-Helpers","level":3,"text":"Shortcut Helpers"},{"type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift"},{"type":"heading","anchor":"Common-Shortcut-Letters","level":3,"text":"Common Shortcut Letters"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Constant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.quit"}],"type":"paragraph"}],[{"inlineContent":[{"code":"q","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"y"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"n","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}],"type":"paragraph"}],[{"inlineContent":[{"code":"c","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.ok"}],"type":"paragraph"}],[{"inlineContent":[{"code":"o","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","anchor":"Automatic-Key-Matching","level":3,"text":"Automatic Key Matching"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","isActive":true,"type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"code":"key:","type":"codeVoice"},{"text":" parameter is given:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Symbol shortcuts ("},{"type":"codeVoice","code":"⎋"},{"type":"text","text":", "},{"type":"codeVoice","code":"↵"},{"type":"text","text":", "},{"type":"codeVoice","code":"⇥"},{"type":"text","text":") map to their corresponding "},{"type":"codeVoice","code":"Key"},{"type":"text","text":" values"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"type":"codeVoice","code":"\"q\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"y\""},{"text":") map to ","type":"text"},{"type":"codeVoice","code":".character(thatChar)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow combinations ("},{"type":"codeVoice","code":"\"↑↓\""},{"type":"text","text":") match "},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"type":"text","text":" individual arrow keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}]}]}],"type":"unorderedList"},{"type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift"},{"type":"heading","anchor":"Status-Bar-Context-Stack","level":2,"text":"Status Bar Context Stack"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string."}]},{"type":"heading","anchor":"System-Items","level":3,"text":"System Items"},{"type":"paragraph","inlineContent":[{"text":"Three system items are shown by default:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Shortcut","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Label"}]}],[{"type":"paragraph","inlineContent":[{"text":"Order","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"quit"}]}],[{"type":"paragraph","inlineContent":[{"text":"900","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Quit the application"}]}]],[[{"type":"paragraph",