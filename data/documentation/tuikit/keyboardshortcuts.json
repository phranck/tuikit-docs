() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"level":3,"text":"Changing the built-in quit key","type":"heading","anchor":"Changing-the-built-in-quit-key"},{"inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}],"type":"paragraph"},{"level":3,"text":"Overriding `q` in a local view context","type":"heading","anchor":"Overriding-q-in-a-local-view-context"},{"inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Status Bar Shortcuts","type":"heading","anchor":"Status-Bar-Shortcuts"},{"inlineConte