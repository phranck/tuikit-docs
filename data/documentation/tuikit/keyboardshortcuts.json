on(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"type":"codeListing"},{"text":"Status Bar Shortcuts","level":2,"type":"heading","anchor":"Status-Bar-Shortcuts"},{"type":"paragraph","inlineContent":[{"text":"The status bar displays available shortcuts to the user. Use the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"},{"text":" namespace for consistent, platform-standard symbols:","type":"text"}]},{"text":"Display Symbols","level":3,"type":"heading","anchor":"Display-Symbols"},{"syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"type":"codeListing"},{"text":"Common Symbols","level":3,"type":"heading","anchor":"Common-Symbols"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"