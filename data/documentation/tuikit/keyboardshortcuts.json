{"topicSections":[{"anchor":"Input-Types","title":"Input Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Key","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"]},{"anchor":"Focus","title":"Focus","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"]},{"anchor":"Status-Bar","title":"Status Bar","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}]},{"type":"paragraph","inlineContent":[{"identifier":"keyboard-event-dispatch.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Additionally, "},{"type":"codeVoice","code":"Ctrl+C"},{"type":"text","text":" (SIGINT) is handled at the OS signal level "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" any of these layers: it always terminates the application."}]},{"type":"heading","level":2,"anchor":"Available-Keys","text":"Available Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","type":"reference","isActive":true},{"type":"text","text":" enum defines all keys that TUIkit can recognize from terminal input:"}]},{"type":"heading","level":3,"anchor":"Character-Keys","text":"Character Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Uppercase detection: when a capital letter is typed, the resulting "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true},{"type":"text","text":" has "},{"code":"shift: true","type":"codeVoice"},{"type":"text","text":" set automatically."}]},{"type":"heading","level":3,"anchor":"Special-Keys","text":"Special Keys"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".escape"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape key"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter \/ Return","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".delete"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forward delete"}]}]]],"header":"row","type":"table"},{"anchor":"Arrow-Keys","level":3,"text":"Arrow Keys","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".up","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".down","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Arrow down"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".left","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow left","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".right"}]}],[{"type":"paragraph","inlineContent":[{"text":"Arrow right","type":"text"}]}]]],"header":"row","type":"table"},{"anchor":"Navigation-Keys","level":3,"text":"Navigation Keys","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".home","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".end"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}]]],"header":"row","type":"table"},{"anchor":"Key-Events-and-Modifiers","level":2,"text":"Key Events and Modifiers","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyEvent","isActive":true},{"type":"text","text":" combines a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true},{"type":"text","text":" with modifier flags:"}]},{"syntax":"swift","code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Ctrl+letter","type":"text"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Alt+key"}],"type":"strong"},{"text":": Detected from ESC prefix sequences (","type":"text"},{"code":"ESC","type":"codeVoice"},{"text":" followed by the key byte).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Registering Key Handlers","anchor":"Registering-Key-Handlers","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":".onKeyPress()"},{"type":"text","text":" modifier to handle keyboard events in your views:"}]},{"text":"Handle All Keys","anchor":"Handle-All-Keys","type":"heading","level":3},{"type":"codeListing","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"],"syntax":"swift"},{"text":"Handle Specific Keys","anchor":"Handle-Specific-Keys","type":"heading","level":3},{"type":"codeListing","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"],"syntax":"swift"},{"text":"Handle a Single Key","anchor":"Handle-a-Single-Key","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The single-key variant always consumes the event:"}]},{"type":"codeListing","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"],"syntax":"swift"},{"text":"Handler Priority","anchor":"Handler-Priority","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"type":"strong","inlineContent":[{"type":"text","text":"reverse registration order"}]},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"],"syntax":"swift"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active.","type":"text"}]}],"type":"aside","name":"Important"},{"text":"Focus Navigation","anchor":"Focus-Navigation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" dispatches key events in three steps:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Focused element delegation"}],"type":"strong"},{"type":"text","text":": the focused element’s "},{"type":"codeVoice","code":"handleKeyEvent(_:)"},{"type":"text","text":" is called first. If it consumes the event, dispatch stops."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Arrow key fallback"}]},{"type":"text","text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1."}],"type":"paragraph"}]}],"type":"orderedList"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Shift+Tab","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the previous focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up \/ Left","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down \/ Right","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to next element in section (fallback)","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"For more details, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","isActive":true},{"text":".","type":"text"}]},{"text":"Default Bindings","anchor":"Default-Bindings","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Layer 4 provides three built-in key bindings that work without any configuration:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Condition"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Q"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Quit application","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Only when "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","isActive":true},{"type":"text","text":" allows it"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cycle to next color theme"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Only when theme cycling is enabled","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"a","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"A","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cycle to next appearance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Always active"}],"type":"paragraph"}]]]},{"text":"Quit Behavior","anchor":"Quit-Behavior","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"type":"text","text":" enum controls when "},{"type":"codeVoice","code":"q"},{"type":"text","text":" is allowed to quit:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behavior"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".always"}]}],[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" quits from any screen (default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" only quits when no status bar context is pushed"}]}]]]},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}]},{"type":"codeListing","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"],"syntax":"swift"},{"text":"Changing the built-in quit key","anchor":"Changing-the-built-in-quit-key","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default quit binding is configurable through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"text":"Overriding `q` in a local view context","anchor":"Overriding-q-in-a-local-view-context","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"A user-defined status bar item with shortcut ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" and an action intercepts the key before the default quit binding runs:","type":"text"}]},{"type":"codeListing","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the correct way to repurpose ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached.","type":"text"}]},{"text":"Status Bar Shortcuts","anchor":"Status-Bar-Shortcuts","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true,"type":"reference"},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"text":"Display Symbols","anchor":"Display-Symbols","type":"heading","level":3},{"type":"codeListing","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"],"syntax":"swift"},{"text":"Common Symbols","anchor":"Common-Symbols","type":"heading","level":3},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Symbol"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Constant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⎋"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Escape","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↵"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Enter","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⇥","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇤"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift+Tab","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌫","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.backspace","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Backspace"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌦","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.delete"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Delete","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"␣"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.space"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Space","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.arrowUp","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↓"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowDown"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"←","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowLeft"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Arrow left","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"→"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowRight"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"↑↓"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsUpDown"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Vertical arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsLeftRight"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Horizontal arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"↑↓←→","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Shortcut.arrowsAll"}],"type":"paragraph"}],[{"inlineContent":[{"text":"All arrows","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌃","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.control","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Control modifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"⇧"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.shift","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shift modifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"⌥","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Shortcut.option","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Option \/ Alt"}],"type":"paragraph"}]]]},{"text":"Shortcut Helpers","anchor":"Shortcut-Helpers","type":"heading","level":3},{"type":"codeListing","code":["\/\/ Combine modifier + key: \"⌃c\"","Shortcut.combine(.control, \"c\")","","\/\/ Ctrl+key display: \"^c\"","Shortcut.ctrl(\"c\")","","\/\/ Range display: \"1-9\"","Shortcut.range(\"1\", \"9\")"],"syntax":"swift"},{"text":"Common Shortcut Letters","anchor":"Common-Shortcut-Letters","type":"heading","level":3},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.quit","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"q"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.yes","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"y"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.no","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"n","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.cancel"}]}],[{"type":"paragraph","inlineContent":[{"code":"c","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"Shortcut.ok","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"o"}]}]]]},{"text":"Automatic Key Matching","anchor":"Automatic-Key-Matching","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","type":"reference"},{"text":" automatically derives the trigger key from the shortcut string when no explicit ","type":"text"},{"type":"codeVoice","code":"key:"},{"text":" parameter is given:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Symbol shortcuts (","type":"text"},{"type":"codeVoice","code":"⎋"},{"text":", ","type":"text"},{"type":"codeVoice","code":"↵"},{"text":", ","type":"text"},{"type":"codeVoice","code":"⇥"},{"text":") map to their corresponding ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Key","isActive":true,"type":"reference"},{"text":" values","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Single-character shortcuts (","type":"text"},{"code":"\"q\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"y\"","type":"codeVoice"},{"text":") map to ","type":"text"},{"code":".character(thatChar)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Arrow combinations (","type":"text"},{"code":"\"↑↓\"","type":"codeVoice"},{"text":") match ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"strong"},{"text":" individual arrow keys","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Multi-character non-symbol strings are informational only (no trigger key)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","code":["\/\/ Automatic: shortcut \"q\" triggers on Key.character(\"q\")","StatusBarItem(shortcut: \"q\", label: \"quit\") { quit() }","","\/\/ Explicit: override the trigger key","StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter) { select() }","","\/\/ Informational: no action, no trigger","StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")"],"syntax":"swift"},{"text":"Status Bar Context Stack","anchor":"Status-Bar-Context-Stack","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar supports a context stack for temporary shortcut overrides: useful for modals and nested navigation:"}]},{"type":"codeListing","code":["\/\/ Set global items",".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","}","","\/\/ Push context-specific items (e.g. for a dialog)",".statusBarItems(context: \"my-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\") { confirm() }","    StatusBarItem(shortcut: \"n\", label: \"no\") { cancel() }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When a context is pushed, its items replace the global items in the display. System items (quit, theme, appearance) remain visible unless a user item uses the same shortcut string.","type":"text"}]},{"text":"System Items","anchor":"System-Items","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three system items are shown by default:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Shortcut","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Label"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Order"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"q"}],"type":"paragraph"}],[{"inlineContent":