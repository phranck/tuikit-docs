{"kind":"article","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/tuikit\/keyboardshortcuts"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Keyboard Shortcuts"},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"],"title":"Input Types","anchor":"Input-Types"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/FocusState","doc:\/\/TUIkit\/documentation\/TUIkit\/Focusable"],"title":"Focus","anchor":"Focus"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBar","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarItemProtocol","doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut"],"title":"Status Bar","anchor":"Status-Bar"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides","generated":true,"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit uses a layered event dispatch system. When a key is pressed, it passes through up to five layers. The first layer that consumes the event wins: remaining layers are skipped. Layer 0 (text input) and Layer 3 (focus system) are mutually exclusive: when a text input element is focused, Layer 0 runs and Layer 3 is skipped."}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"keyboard-event-dispatch.png"}],"type":"paragraph"},{"inlineContent":[{"text":"Additionally, ","type":"text"},{"code":"Ctrl+C","type":"codeVoice"},{"text":" (SIGINT) is handled at the OS signal level ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" any of these layers: it always terminates the application.","type":"text"}],"type":"paragraph"},{"text":"Available Keys","type":"heading","level":2,"anchor":"Available-Keys"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"Key","type":"codeVoice"},{"text":" enum defines all keys that TUIkit can recognize from terminal input:","type":"text"}],"type":"paragraph"},{"text":"Character Keys","type":"heading","level":3,"anchor":"Character-Keys"},{"inlineContent":[{"type":"text","text":"Any printable character is represented as "},{"type":"codeVoice","code":".character(Character)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onKeyPress(Key.from(\"x\")) {","    \/\/ handle \"x\" key","}"]},{"inlineContent":[{"text":"Uppercase detection: when a capital letter is typed, the resulting ","type":"text"},{"code":"KeyEvent","type":"codeVoice"},{"text":" has ","type":"text"},{"code":"shift: true","type":"codeVoice"},{"text":" set automatically.","type":"text"}],"type":"paragraph"},{"text":"Special Keys","type":"heading","level":3,"anchor":"Special-Keys"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".escape","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Escape key"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".enter"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter \/ Return","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".backspace"}]}],[{"type":"paragraph","inlineContent":[{"text":"Backspace \/ Delete backward","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".delete"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Forward delete"}]}]]]},{"text":"Arrow Keys","type":"heading","anchor":"Arrow-Keys","level":3},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow up"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".down","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow down"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".left"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow left"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".right","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Arrow right"}],"type":"paragraph"}]]]},{"text":"Navigation Keys","type":"heading","anchor":"Navigation-Keys","level":3},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".home","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".end","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pageUp","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pageDown"}]}],[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}]]]},{"text":"Key Events and Modifiers","type":"heading","anchor":"Key-Events-and-Modifiers","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"KeyEvent"},{"text":" combines a ","type":"text"},{"type":"codeVoice","code":"Key"},{"text":" with modifier flags:","type":"text"}]},{"code":["public struct KeyEvent {","    public let key: Key","    public let ctrl: Bool     \/\/ Ctrl modifier","    public let alt: Bool      \/\/ Alt \/ Option modifier","    public let shift: Bool    \/\/ Shift modifier","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The terminal encodes modifiers differently from GUI frameworks:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Ctrl+letter"}]},{"text":": Detected from ASCII control codes (0x01–0x1A). For example, ","type":"text"},{"type":"codeVoice","code":"Ctrl+C"},{"text":" produces byte ","type":"text"},{"type":"codeVoice","code":"0x03"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Alt+key"}]},{"type":"text","text":": Detected from ESC prefix sequences ("},{"type":"codeVoice","code":"ESC"},{"type":"text","text":" followed by the key byte)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Shift"}]},{"type":"text","text":": Only auto-detected for uppercase letters. The terminal does not send distinct shift codes for most keys."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Registering Key Handlers","anchor":"Registering-Key-Handlers"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":".onKeyPress()","type":"codeVoice"},{"text":" modifier to handle keyboard events in your views:","type":"text"}]},{"type":"heading","level":3,"text":"Handle All Keys","anchor":"Handle-All-Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Press any key\")","    .onKeyPress { event in","        if event.key == .enter {","            doSomething()","            return true   \/\/ consumed: stops propagation","        }","        return false      \/\/ not consumed: passes to next handler","    }"]},{"type":"heading","level":3,"text":"Handle Specific Keys","anchor":"Handle-Specific-Keys"},{"type":"codeListing","syntax":"swift","code":["Text(\"Use arrow keys\")","    .onKeyPress(keys: [.up, .down]) { event in","        if event.key == .up { moveUp() }","        else { moveDown() }","        return true","    }"]},{"type":"heading","level":3,"text":"Handle a Single Key","anchor":"Handle-a-Single-Key"},{"type":"paragraph","inlineContent":[{"text":"The single-key variant always consumes the event:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Press Enter to continue\")","    .onKeyPress(.enter) {","        continueAction()","    }"]},{"type":"heading","level":3,"text":"Handler Priority","anchor":"Handler-Priority"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Handlers are dispatched in "},{"inlineContent":[{"type":"text","text":"reverse registration order"}],"type":"strong"},{"type":"text","text":": the deepest view in the tree (most recently registered) gets the event first. This means inner views can intercept events before outer views see them."}]},{"type":"codeListing","syntax":"swift","code":["VStack {","    Text(\"Outer\")","        .onKeyPress(.enter) {","            \/\/ Only reached if inner handler did NOT consume it","            print(\"outer enter\")","        }","    Text(\"Inner\")","        .onKeyPress(.enter) {","            \/\/ Gets the event FIRST","            print(\"inner enter\")","        }","}"]},{"type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"All key handlers are re-registered every render frame. If a view is not rendered (e.g. behind a conditional), its handlers are not active."}],"type":"paragraph"}],"style":"important"},{"type":"heading","level":2,"text":"Focus Navigation","anchor":"Focus-Navigation"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" dispatches key events in three steps:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Focused element delegation","type":"text"}],"type":"strong"},{"text":": the focused element’s ","type":"text"},{"code":"handleKeyEvent(_:)","type":"codeVoice"},{"text":" is called first. If it consumes the event, dispatch stops.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Tab \/ Shift+Tab"}]},{"type":"text","text":": cycles focus between elements (wraps around)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Arrow key fallback"}],"type":"strong"},{"text":": Up\/Left move to the previous element in the section, Down\/Right move to the next. This only triggers if the focused element did not consume the arrow key in step 1.","type":"text"}]}]}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus to the next focusable element (wraps around)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus to the previous focusable element (wraps around)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Up \/ Left"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move to previous element in section (fallback)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down \/ Right"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move to next element in section (fallback)"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For more details, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Default Bindings","anchor":"Default-Bindings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layer 4 provides three built-in key bindings that work without any configuration:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Condition","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit application","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Only when ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior"},{"text":" allows it","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"t"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"T"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next color theme"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Only when theme cycling is enabled"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next appearance"}]}],[{"type":"paragraph","inlineContent":[{"text":"Always active","type":"text"}]}]]],"header":"row"},{"type":"heading","level":3,"text":"Quit Behavior","anchor":"Quit-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/QuitBehavior","type":"reference","isActive":true},{"type":"text","text":" enum controls when "},{"code":"q","type":"codeVoice"},{"type":"text","text":" is allowed to quit:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Behavior","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".always"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" quits from any screen (default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".rootOnly"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"q"},{"type":"text","text":" only quits when no status bar context is pushed"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"code":".rootOnly","type":"codeVoice"},{"text":" is useful for modal dialogs: push a status bar context for the dialog, and ","type":"text"},{"code":"q","type":"codeVoice"},{"text":" will be blocked until the user dismisses it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Dialog(title: \"Confirm\") {","    Text(\"Are you sure?\")","} footer: {","    ButtonRow {","        Button(\"Yes\") { confirm() }","        Button(\"No\") { cancel() }","    }","}",".statusBarItems(context: \"confirm-dialog\") {","    StatusBarItem(shortcut: \"y\", label: \"yes\")","    StatusBarItem(shortcut: \"n\", label: \"no\")","}"]},{"type":"heading","level":3,"text":"Changing the built-in quit key","anchor":"Changing-the-built-in-quit-key"},{"type":"paragraph","inlineContent":[{"text":"The default quit binding is configurable through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState\/quitShortcut","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.statusBar) private var statusBar","","statusBar.quitShortcut = .escape","statusBar.quitShortcut = .ctrlQ","statusBar.quitShortcut = QuitShortcut(","    key: .f12,","    shortcutSymbol: Shortcut.f12,","    label: \"exit\"",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This changes both the Layer 4 quit binding and the displayed system item."}]},{"type":"heading","level":3,"text":"Overriding `q` in a local view context","anchor":"Overriding-q-in-a-local-view-context"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A user-defined status bar item with shortcut "},{"type":"codeVoice","code":"q"},{"type":"text","text":" and an action intercepts the key before the default quit binding runs:"}]},{"type":"codeListing","syntax":"swift","code":["EditorView()","    .statusBarItems {","        StatusBarItem(shortcut: \"q\", label: \"close\") {","            dismissEditor()","        }","    }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the correct way to repurpose "},{"code":"q","type":"codeVoice"},{"type":"text","text":" for a specific screen, dialog, or focus section. The matching user item handles the event in Layer 1, so Layer 4’s built-in quit binding is never reached."}]},{"type":"heading","level":2,"text":"Status Bar Shortcuts","anchor":"Status-Bar-Shortcuts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The status bar displays available shortcuts to the user. Use the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Shortcut","isActive":true},{"type":"text","text":" namespace for consistent, platform-standard symbols:"}]},{"type":"heading","level":3,"text":"Display Symbols","anchor":"Display-Symbols"},{"type":"codeListing","syntax":"swift","code":[".statusBarItems {","    StatusBarItem(shortcut: Shortcut.arrowsUpDown, label: \"nav\")","    StatusBarItem(shortcut: Shortcut.enter, label: \"select\", key: .enter)","    StatusBarItem(shortcut: Shortcut.escape, label: \"back\")","}"]},{"type":"heading","level":3,"text":"Common Symbols","anchor":"Common-Symbols"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Constant"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⎋"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.escape"}]}],[{"type":"paragraph","inlineContent":[{"text":"Escape","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"↵","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.enter","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enter","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"⇥"}]}],[{"type":"paragraph","inlineContent":[{"code":"Shortcut.tab","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Tab","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⇤","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Shortcut.shiftTab"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Shift+Tab"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"⌫","