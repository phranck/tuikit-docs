{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"A TUIkit application follows a linear lifecycle: "},{"type":"strong","inlineContent":[{"type":"text","text":"launch → setup → main loop → cleanup"}]},{"type":"text","text":". The framework handles terminal configuration, signal handling, and the render-input cycle so you can focus on building views."}],"type":"paragraph"},{"anchor":"Entry-Point","level":2,"type":"heading","text":"Entry Point"},{"inlineContent":[{"text":"Every TUIkit application starts with a type conforming to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","type":"reference"},{"text":", annotated with ","type":"text"},{"code":"@main","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    var body: some Scene {","        WindowGroup {","            Text(\"Hello, TUIkit!\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"@main","type":"codeVoice"},{"type":"text","text":" attribute tells Swift to call the static "},{"code":"main()","type":"codeVoice"},{"type":"text","text":" method provided by the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true,"type":"reference"},{"type":"text","text":" protocol. This method:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Creates an instance of your app via its parameterless "},{"code":"init()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Creates an internal ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" that owns all subsystems","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":" to enter the main loop","type":"text"}]}]}],"type":"orderedList"},{"syntax":null,"code":["@main → App.main() → Self() → AppRunner(app:) → run()"],"type":"codeListing"},{"anchor":"Subsystem-Initialization","level":2,"type":"heading","text":"Subsystem Initialization"},{"inlineContent":[{"type":"codeVoice","code":"AppRunner.init()"},{"type":"text","text":" creates a terminal session, a signal manager, and one"},{"type":"text","text":" "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":". The context is the sole owner of the application’s mutable runtime"},{"type":"text","text":" "},{"type":"text","text":"services. "},{"type":"codeVoice","code":"run()"},{"type":"text","text":" then creates the session components that consume those services:"},{"type":"text","text":" "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", "},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":null,"code":["AppRunner","├── Terminal session","├── SignalManager","└── TUIContext","    ├── AppState, StateStorage, RenderCache","    ├── LifecycleManager, KeyEventDispatcher, PreferenceStorage","    ├── LocalizationService, NotificationService, StorageBackend, RuntimeClock","    ├── FocusManager, palette and appearance managers","    ├── StatusBarState, AppHeaderState","    └── ImageLoader, URLImageCache"],"type":"codeListing"},{"inlineContent":[{"type":"image","identifier":"lifecycle-run-creates.png"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the session. "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":" owns the view-facing runtime services."},{"type":"text","text":" "},{"type":"text","text":"Dependencies flow through constructor injection and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true},{"type":"text","text":" inside"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":". The render context itself never owns or accesses a terminal."}],"type":"paragraph"},{"text":"Terminal Setup","type":"heading","level":2,"anchor":"Terminal-Setup"},{"inlineContent":[{"text":"Before the main loop starts, ","type":"text"},{"type":"codeVoice","code":"run()"},{"text":" prepares the terminal:","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Step","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"What"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Why"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"1"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Install signal handlers"}]}],[{"type":"paragraph","inlineContent":[{"text":"Catch Ctrl+C (SIGINT) and terminal resize (SIGWINCH)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter alternate screen"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Preserve the user’s existing terminal content"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Hide cursor","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Avoid cursor flicker during rendering","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"4"}]}],[{"type":"paragraph","inlineContent":[{"text":"Enable raw mode","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Disable line buffering, echo, and signal processing"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Register state observer"}]}],[{"type":"paragraph","inlineContent":[{"code":"AppState","type":"codeVoice"},{"type":"text","text":" changes trigger re-renders via "},{"code":"signals.requestRerender()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"6"}]}],[{"type":"paragraph","inlineContent":[{"text":"Register focus observer","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Focus changes reset the pulse timer and trigger re-renders","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"7"}]}],[{"type":"paragraph","inlineContent":[{"text":"Start timers","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"PulseTimer (100 ms) and CursorTimer (50 ms) for animations","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"8"}]}],[{"type":"paragraph","inlineContent":[{"text":"Render first frame","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Show the initial UI immediately"}]}]]],"header":"row"},{"text":"Raw Mode","type":"heading","level":3,"anchor":"Raw-Mode"},{"inlineContent":[{"type":"text","text":"In raw mode, the terminal delivers every keystroke immediately without waiting for Enter. TUIkit configures:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"No echo","type":"text"}],"type":"strong"},{"type":"text","text":": typed characters are not displayed"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"No canonical mode","type":"text"}],"type":"strong"},{"type":"text","text":": input is byte-by-byte, not line-by-line"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"No signal processing","type":"text"}],"type":"strong"},{"type":"text","text":": Ctrl+C is handled by TUIkit, not the OS"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"100ms read timeout"}]},{"text":": non-blocking input polling","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The original terminal settings are saved and restored during cleanup."}],"type":"paragraph"},{"text":"Main Loop","type":"heading","level":2,"anchor":"Main-Loop"},{"type":"paragraph","inlineContent":[{"text":"The main loop is synchronous and runs until shutdown:","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"lifecycle-main-loop.png","type":"image"}]},{"type":"heading","text":"Re-render Triggers","anchor":"Re-render-Triggers","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Several sources cause a new frame to be rendered, all converging on two boolean checks in the main loop:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger"}]}],[{"type":"paragraph","inlineContent":[{"text":"Path","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Main loop check","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"SIGWINCH"}]}],[{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"signalNeedsRerender","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"signalTerminalResized","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"consumeRerenderFlag()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"@State mutation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Owning runtime invalidates its subtree and notifies ","type":"text"},{"type":"codeVoice","code":"AppState"}]}],[{"type":"paragraph","inlineContent":[{"code":"consumeRerenderFlag()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"PulseTimer \/ CursorTimer"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"appState.setNeedsRender()"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"appState.needsRender"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Focus change"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"appState.setNeedsRender()"}]}],[{"type":"paragraph","inlineContent":[{"code":"appState.needsRender","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All triggers set boolean flags. The actual rendering always happens on the main thread: signal handlers never render directly."}]},{"type":"heading","text":"Signal Handling","anchor":"Signal-Handling","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SignalManager"},{"type":"text","text":" installs two POSIX signal handlers:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Signal"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Trigger"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Effect","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"SIGINT"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Ctrl+C"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Sets a shutdown flag → main loop exits"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SIGWINCH","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Terminal resize"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Sets a re-render flag → next iteration re-renders"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"Signal handlers only set ","type":"text"},{"code":"nonisolated(unsafe)","type":"codeVoice"},{"text":" boolean flags: no allocations, no locks. The main loop reads these flags each iteration and acts accordingly.","type":"text"}]},{"type":"heading","text":"Key Event Dispatch","anchor":"Key-Event-Dispatch","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the terminal delivers a key event, the "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":" dispatches it through five layers. Layer 0 and Layer 3 are mutually exclusive based on "},{"type":"codeVoice","code":"focusManager.hasTextInputFocus"},{"type":"text","text":":"}]},{"type":"heading","text":"Layer 0: Text Input (conditional)","anchor":"Layer-0-Text-Input-conditional","level":3},{"type":"paragraph","inlineContent":[{"text":"When a text input element (TextField\/SecureField) is focused, ","type":"text"},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"text":" runs first. This ensures printable characters, backspace, delete, arrows, home, end, and enter reach the text field before any other layer. Only keys the text field does not consume (Escape, Tab, unhandled Ctrl+shortcuts) fall through.","type":"text"}]},{"type":"heading","text":"Layer 1: Status Bar Items","anchor":"Layer-1-Status-Bar-Items","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarState","type":"reference","isActive":true},{"text":" checks if any status bar item matches the key. Items can match single characters, special keys (Escape, Enter), or arrow keys. If a match is found, the item’s action runs and dispatch stops.","type":"text"}]},{"type":"heading","text":"Layer 2: View-Registered Handlers","anchor":"Layer-2-View-Registered-Handlers","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"KeyEventDispatcher"},{"type":"text","text":" iterates handlers registered via "},{"type":"codeVoice","code":"onKeyPress()"},{"type":"text","text":" modifiers: in reverse order (newest first). If a handler returns "},{"code":"true","type":"codeVoice"},{"type":"text","text":", dispatch stops."}]},{"text":"Layer 3: Focus System (conditional)","anchor":"Layer-3-Focus-System-conditional","level":3,"type":"heading"},{"inlineContent":[{"text":"Skipped when text input has focus (Layer 0 already ran). Otherwise, ","type":"text"},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"text":" first delegates to the focused element’s ","type":"text"},{"code":"handleKeyEvent()","type":"codeVoice"},{"text":", then handles Tab\/Shift+Tab for focus cycling, then arrow keys as section navigation fallback.","type":"text"}],"type":"paragraph"},{"text":"Layer 4: Default Bindings","anchor":"Layer-4-Default-Bindings","level":3,"type":"heading"},{"inlineContent":[{"text":"Built-in key bindings that apply when no handler consumed the event:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Condition"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"q","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Q","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Quit application","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"statusBar.isQuitAllowed"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"t","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"T","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next palette"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"statusBar.showThemeItem"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"a"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"A"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cycle to next appearance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Always"}]}]]],"header":"row","type":"table"},{"text":"Render Pipeline","anchor":"Render-Pipeline","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each frame follows 12 steps inside "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":":"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Step"}]}],[{"type":"paragraph","inlineContent":[{"text":"What","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"1"}]}],[{"type":"paragraph","inlineContent":[{"text":"Clear per-frame state (key handlers, preferences, focus, status bar, app header)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Begin lifecycle, state, and cache tracking","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Build ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"text":" from subsystem state","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"type":"text","text":" with layout constraints"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"5","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Evaluate "},{"code":"app.body","type":"codeVoice"},{"type":"text","text":" → "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/WindowGroup","type":"reference","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"6"}]}],[{"type":"paragraph","inlineContent":[{"text":"Render view tree → ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"7"}]}],[{"type":"paragraph","inlineContent":[{"text":"Build terminal-ready output lines","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"8"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Begin buffered frame ("},{"type":"codeVoice","code":"Terminal.beginFrame()"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"9"}]}],[{"type":"paragraph","inlineContent":[{"text":"Render app header, diff and write only changed content lines","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"10"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Render status bar into same buffer"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"11","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flush entire frame in one ","type":"text"},{"type":"codeVoice","code":"write()"},{"text":" syscall (","type":"text"},{"type":"codeVoice","code":"Terminal.endFrame()"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"12"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"End lifecycle tracking (fires "},{"type":"codeVoice","code":"onDisappear"},{"type":"text","text":" for removed views)"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Steps 8–11 are the output optimization layer: line-level diffing reduces writes by ~94% for static UIs, and frame buffering reduces syscalls from ~40+ to exactly 1.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"For full details on each step, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference"},{"text":".","type":"text"}]}],"type":"aside"},{"text":"Cleanup","anchor":"Cleanup","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When the main loop exits: via Ctrl+C, the quit key, or programmatic shutdown: "},{"type":"codeVoice","code":"cleanup()"},{"type":"text","text":" restores the terminal:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Step"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"What"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Why","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"1","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Disable raw mode"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Restore original terminal settings","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Show cursor"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Make the cursor visible again"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"3"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exit alternate screen","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Restore the user’s previous terminal content"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Clear state observers","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Remove ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" observer callbacks","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"5"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Clear focus"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Remove all focus registrations"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"6"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reset TUIContext","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Clear runtime state, lifecycle, handlers, caches, notifications, and focus; synchronize app storage","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The "},{"code":"Terminal","type":"codeVoice"},{"type":"text","text":" class also has a "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" safety net that disables raw mode if it was not explicitly restored."}],"type":"paragraph"},{"text":"Subsystem Dependency Graph","anchor":"Subsystem-Dependency-Graph","level":2,"type":"heading"},{"text":"Ownership","anchor":"Ownership","level":3,"type":"heading"},{"inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal and signals. Its single ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":" owns every","type":"text"},{"text":" ","type":"text"},{"text":"mutable runtime service used by the view tree. A second runner receives a second","type":"text"},{"text":" ","type":"text"},{"text":"context, so neither application can invalidate or reuse the other’s state,","type":"text"},{"text":" ","type":"text"},{"text":"caches, focus, localization, notifications, storage, or image requests.","type":"text"}],"type":"paragraph"},{"text":"Runtime References","anchor":"Runtime-References","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"During each frame, "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" obtains a complete environment from "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"renders into a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":", then writes that buffer through the injected"},{"type":"text","text":" "},{"type":"text","text":"terminal session. "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":" receives the same context-owned focus, status"},{"type":"text","text":" "},{"type":"text","text":"bar, key dispatch, palette, and appearance services. Timers invalidate only that"},{"type":"text","text":" "},{"type":"text","text":"context’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"co