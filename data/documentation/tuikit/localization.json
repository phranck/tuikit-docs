{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"anchor":"Related-Documentation"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Key Features","anchor":"Key-Features"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type-safe keys"}]},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Persistent storage","type":"text"}],"type":"strong"},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Fallback chain"}],"type":"strong"},{"text":": Current language → English → key itself for graceful degradation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Thread-safe","type":"text"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"JSON-based","type":"text"}]},{"text":": Easy to extend with new strings and languages","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Quick Start","anchor":"Quick-Start"},{"type":"heading","level":3,"text":"Display Localized Strings","anchor":"Display-Localized-Strings"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"]},{"inlineContent":[{"text":"Or use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(localized: .button(.save))"]},{"type":"heading","level":3,"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime"},{"syntax":"swift","type":"codeListing","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"]},{"type":"heading","level":3,"text":"Supported Languages","anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".german","type":"codeVoice"},{"text":" - Deutsch","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}],"type":"paragraph"}]},{"content":[{"type"