{"sections":[],"abstract":[{"type":"text","text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Localization","modules":[{"name":"TUIkit"}],"role":"article","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"text":"Key Features","type":"heading","anchor":"Key-Features","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Fallback chain","type":"text"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Thread-safe"}],"type":"strong"},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"text":": Easy to extend with new strings and languages","type":"text"}],"type":"paragraph"}]}]},{"text":"Quick Start","type":"heading","anchor":"Quick-Start","level":2},{"text":"Display Localized Strings","type":"heading","anchor":"Display-Localized-Strings","level":3},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"]},{"inlineContent":[{"text":"Or use the ","type":"text"},{"type":"codeVoice","code":"Text(localized:)"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(localized: .button(.save))"]},{"text":"Switch Language at Runtime","type":"heading","anchor":"Switch-Language-at-Runtime","level":3},{"syntax":"swift","type":"codeListing","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"]},{"type":"heading","level":3,"text":"Supported Languages","anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}]}]}]},{"type":"heading","level":2,"text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"text":"All localized strings are available as ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support.","type":"text"}]},{"type":"heading","level":3,"text":"Key Categories","anchor":"Key-Categories"},{"type":"heading","level":4,"text":"Button Keys","anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}]},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"]},{"type":"heading","level":4,"text":"Label Keys","anchor":"Label-Keys"},{"inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"]},{"level":4,"type":"heading","text":"Error Keys","anchor":"Error-Keys"},{"inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied