st-Practices","level":2,"text":"Best Practices"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Always use type-safe keys","type":"text"}]},{"type":"text","text":": Use "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums instead of raw strings"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Keep keys organized","type":"text"}],"type":"strong"},{"text":": Group related strings by category","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Use descriptive names"}],"type":"strong"},{"type":"text","text":": Short, clear key names"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Run consistency tests","type":"text"}]},{"type":"text","text":": Always verify after adding keys"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test all languages"}]},{"type":"text","text":": Check translations look correct in each language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Handle missing strings"}]},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}]}]}]},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"inlineContent":[{"type":"text","text":"TUIkit includes comprehensive localization tests:"}],"type":"paragraph"},{"type":"heading","anchor":"LocalizationServiceTests","level":3,"text":"LocalizationServiceTests"},{"inlineContent":[{"type":"text","text":"Core functionality tests covering:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Bundle loading for all languages"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"String resolution with dot-notation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Fallback behavior","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Thread safety"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"LocalizationKeyConsistencyTests","level":3,"text":"LocalizationKeyConsistencyTests"},{"inlineContent":[{"text":"Validation tests ensuring:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every enum key exists in all translation files"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No extraneous keys in translation files","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Expected total key count","type":"text"}]}]}]},{"inlineContent":[{"text":"Run after any localization changes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","anchor":"Troubleshooting","level":2,"text":"Troubleshooting"},{"type":"heading","anchor":"String-Not-Appearing","level":3,"text":"String Not Appearing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify the key exists in ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enum","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run consistency tests to verify"}]}]}]},{"type":"heading","anchor":"Wrong-Language-Showing","level":3,"text":"Wrong Language Showing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{