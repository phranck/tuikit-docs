"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"]},{"type":"heading","level":4,"text":"Menu Keys","anchor":"Menu-Keys"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"]},{"type":"heading","level":4,"text":"Dialog Keys","anchor":"Dialog-Keys"},{"inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"]},{"type":"heading","level":4,"text":"Validation Keys","anchor":"Validation-Keys"},{"inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"type":"heading","level":2,"text":"Using Localized Strings","anchor":"Using-Localized-Strings"},{"type":"heading","level":3,"text":"LocalizedString View","anchor":"LocalizedString-View"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString