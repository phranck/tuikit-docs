{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"text":"Key Features","anchor":"Key-Features","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Type-safe keys","type":"text"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enums with IDE autocomplete","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Persistent storage","type":"text"}],"type":"strong"},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fallback chain"}],"type":"strong"},{"text":": Current language → English → key itself for graceful degradation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Thread-safe","type":"text"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"text":": Easy to extend with new strings and languages","type":"text"}]}]}],"type":"unorderedList"},{"text":"Quick Start","anchor":"Quick-Start","type":"heading","level":2},{"text":"Display Localized Strings","anchor":"Display-Localized-Strings","type":"heading","level":3},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"],"type":"codeListing"},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings.","type":"text"}]},{"level":3,"type":"heading","text":"Supported Languages","anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"text":" - Español","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"level":3,"type":"heading","text":"Key Categories","anchor":"Key-Categories"},{"level":4,"type":"heading","text":"Button Keys","anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"]},{"text":"Label Keys","type":"heading","level":4,"anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing"},{"text":"Error Keys","type":"heading","level":4,"anchor":"Error-Keys"},{"type":"paragraph","inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing"},{"text":"Placeholder Keys","type":"heading","level":4,"anchor":"Placeholder-Keys"},{"type":"paragraph","inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing"},{"text":"Menu Keys","type":"heading","level":4,"anchor":"Menu-Keys"},{"type":"paragraph","inlineContent":[{"text":"8 menu strings: file, edit, view, help, new, open, save, exit","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing"},{"text":"Dialog Keys","type":"heading","level":4,"anchor":"Dialog-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}]},{"syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing"},{"text":"Validation Keys","type":"heading","level":4,"anchor":"Validation-Keys"},{"type":"paragraph","inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing"},{"text":"Using Localized Strings","type":"heading","level":2,"anchor":"Using-Localized-Strings"},{"text":"LocalizedString View","type":"heading","level":3,"anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"type":"codeListing"},{"text":"Text View with Localization","type":"heading","level":3,"anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"type":"codeListing"},{"text":"Direct Service Access","type":"heading","level":3,"anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, read the runtime-owned service from the environment:"}]},{"syntax":"swift","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing"},{"text":"Language Switching","type":"heading","level":2,"anchor":"Language-Switching"},{"text":"Get Current Language","type":"heading","level":3,"anchor":"Get-Current-Language"},{"syntax":"swift","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"type":"codeListing"},{"text":"Change Language","type":"heading","level":3,"anchor":"Change-Language"},{"syntax":"swift","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"type":"codeListing"},{"text":"Language Persistence","type":"heading","level":3,"anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linux"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}]},{"text":"Fallback Behavior","type":"heading","level":3,"anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Try to find the key in the active language","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not found, fall back to English","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"text":"Environment Access","type":"heading","level":2,"anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"text":" is available in the view environment:","type":"text"}]},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizationService.shared"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.shared"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}]},{"text":"Adding New Keys","type":"heading","level":2,"anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}]},{"text":"1. Update LocalizationKey Enum","type":"heading","level":3,"anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing"},{"text":"2. Add to All Translation Files","type":"heading","level":3,"anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"text":":","type":"text"}]},{"syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"text":"3. Update Tests","type":"heading","level":3,"anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing"},{"text":"4. Run Consistency Tests","type":"heading","level":3,"anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"text":"Verify all keys exist in translation files:","type":"text"}]},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"text":"Adding New Languages","type":"heading","level":2,"anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"text":"To add support for a new language:","type":"text"}]},{"text":"1. Update Language Enum","type":"heading","level":3,"anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing"},{"text":"2. Create Translation File","type":"heading","level":3,"anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing"},{"text":"3. Test the New Language","type":"heading","level":3,"anchor":"3-Test-the-New-Language"},{"syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"type":"codeListing"},{"text":"4. Run Consistency Tests","type":"heading","level":3,"anchor":"4-Run-Consistency-Tests"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"text":"Design Principles","type":"heading","level":2,"anchor":"Design-Principles"},{"text":"Dot-Notation Keys","type":"heading","level":3,"anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}]},{"syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"text":"Enum Categories","type":"heading","level":3,"anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"validation.*"},{"text":" keys → ","type":"text"},{"type":"codeVoice","code":"LocalizationKey.Validation"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}]},{"text":"Thread Safety","type":"heading","level":3,"anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference","isActive":true},{"text":" uses ","type":"text"},{"code":"NSLock","type":"codeVoice"},{"text":" for thread-safe access:","type":"text"}]},{"syntax":"swift","code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"],"type":"codeListing"},{"text":"Performance Caching","type":"heading","level":3,"anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}]},{"syntax":"swift","code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"],"type":"codeListing"},{"text":"JSON File Format","type":"heading","level":2,"anchor":"JSON-File-Format"},{"text":"Structure","type":"heading","level":3,"anchor":"Structure"},{"syntax":"json","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"type":"codeListing"},{"text":"Rules","type":"heading","level":3,"anchor":"Rules"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flat structure"}]},{"text":": No nested objects (all keys are top-level)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Dot-separated keys","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"\"button.ok\"","type":"codeVoice"},{"text":", not nested objects","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UTF-8 encoding"}]},{"type":"text","text":": Required for non-Latin characters"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Valid JSON","type":"text"}]},{"text":": No trailing commas, proper escaping","type":"text"}]}]}],"type":"orderedList"},{"text":"Example","type":"heading","level":3,"anchor":"Example"},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"type":"codeListing"},{"text":"Best Practices","type":"heading","level":2,"anchor":"Best-Practices"},{"items":[{"content":[{"type":"paragraph","inlineCo