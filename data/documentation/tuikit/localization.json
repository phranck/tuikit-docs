{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"title":"Related Documentation","anchor":"Related-Documentation"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Localization"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}]},{"text":"Key Features","type":"heading","anchor":"Key-Features","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Type-safe keys","type":"text"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Persistent storage","type":"text"}],"type":"strong"},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Thread-safe","type":"text"}]},{"text":": Safe language switching from any thread at runtime","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"JSON-based"}],"type":"strong"},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"text":"Quick Start","type":"heading","anchor":"Quick-Start","level":2},{"text":"Display Localized Strings","type":"heading","anchor":"Display-Localized-Strings","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}]},{"syntax":"swift","type":"codeListing","code":["Text(localized: LocalizationKey.Button.save)"]},{"text":"Switch Language at Runtime","type":"heading","anchor":"Switch-Language-at-Runtime","level":3},{"syntax":"swift","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings.","type":"text"}],"type":"paragraph"},{"anchor":"Supported-Languages","text":"Supported Languages","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".english","type":"codeVoice"},{"type":"text","text":" - English"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"text":" - Français","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"text":" - Español","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Type-Safe-Keys","text":"Type-Safe Keys","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"anchor":"Key-Categories","text":"Key Categories","level":3,"type":"heading"},{"anchor":"Button-Keys","text":"Button Keys","level":4,"type":"heading"},{"inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing"},{"type":"heading","level":4,"text":"Label Keys","anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"]},{"type":"heading","level":4,"text":"Error Keys","anchor":"Error-Keys"},{"type":"paragraph","inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"]},{"type":"heading","level":4,"text":"Placeholder Keys","anchor":"Placeholder-Keys"},{"type":"paragraph","inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"]},{"type":"heading","level":4,"text":"Menu Keys","anchor":"Menu-Keys"},{"type":"paragraph","inlineContent":[{"text":"8 menu strings: file, edit, view, help, new, open, save, exit","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"]},{"type":"heading","level":4,"text":"Dialog Keys","anchor":"Dialog-Keys"},{"type":"paragraph","inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"]},{"type":"heading","level":4,"text":"Validation Keys","anchor":"Validation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"type":"heading","level":2,"text":"Using Localized Strings","anchor":"Using-Localized-Strings"},{"type":"heading","level":3,"text":"LocalizedString View","anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"type":"heading","level":3,"text":"Text View with Localization","anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"type":"heading","level":3,"text":"Direct Service Access","anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"heading","level":2,"text":"Language Switching","anchor":"Language-Switching"},{"type":"heading","level":3,"text":"Get Current Language","anchor":"Get-Current-Language"},{"type":"codeListing","syntax":"swift","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"type":"heading","level":3,"text":"Change Language","anchor":"Change-Language"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"type":"heading","level":3,"text":"Language Persistence","anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"type":"heading","level":3,"text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"type":"heading","level":2,"text":"Environment Access","anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LocalizationService.shared"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.shared"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}]},{"type":"heading","level":2,"text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"type":"heading","level":3,"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"type":"codeListing","syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","level":3,"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","level":3,"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","level":3,"text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","level":3,"text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"type":"codeListing","syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Design Principles","anchor":"Design-Principles"},{"type":"heading","level":3,"text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"type":"codeVoice","code":"category.key_name"},{"text":" format:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"type":"heading","level":3,"text":"Enum Categories","anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"error.*"},{"text":" keys → ","type":"text"},{"type":"codeVoice","code":"LocalizationKey.Error"}]}]},{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"code":"validation.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Validation","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Thread Safety","anchor":"Thread-Safety","type":"heading"},{"