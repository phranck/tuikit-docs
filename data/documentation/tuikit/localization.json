{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Key-Features","text":"Key Features"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Persistent storage","type":"text"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Thread-safe","type":"text"}],"type":"strong"},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"JSON-based","type":"text"}]},{"text":": Easy to extend with new strings and languages","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Quick-Start","text":"Quick Start"},{"type":"heading","level":3,"anchor":"Display-Localized-Strings","text":"Display Localized Strings"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"LocalizedString","type":"codeVoice"},{"type":"text","text":" to show localized text:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"]},{"inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"]},{"type":"heading","level":3,"anchor":"Switch-Language-at-Runtime","text":"Switch Language at Runtime"},{"type":"codeListing","syntax":"swift","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Supported Languages","anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".german","type":"codeVoice"},{"text":" - Deutsch","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}]}]}]},{"level":2,"type":"heading","text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Key Categories","anchor":"Key-Categories"},{"level":4,"type":"heading","text":"Button Keys","anchor":"Button-Keys"},{"inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"]},{"type":"heading","anchor":"Label-Keys","level":4,"text":"Label Keys"},{"inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"]},{"type":"heading","anchor":"Error-Keys","level":4,"text":"Error Keys"},{"inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"]},{"type":"heading","anchor":"Placeholder-Keys","level":4,"text":"Placeholder Keys"},{"inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"]},{"type":"heading","anchor":"Menu-Keys","level":4,"text":"Menu Keys"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"]},{"type":"heading","anchor":"Dialog-Keys","level":4,"text":"Dialog Keys"},{"inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"]},{"type":"heading","anchor":"Validation-Keys","level":4,"text":"Validation Keys"},{"inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"type":"heading","anchor":"Using-Localized-Strings","level":2,"text":"Using Localized Strings"},{"type":"heading","anchor":"LocalizedString-View","level":3,"text":"LocalizedString View"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"type":"heading","anchor":"Text-View-with-Localization","level":3,"text":"Text View with Localization"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"type":"heading","anchor":"Direct-Service-Access","level":3,"text":"Direct Service Access"},{"inlineContent":[{"type":"text","text":"For advanced use cases, read the runtime-owned service from the environment:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"heading","anchor":"Language-Switching","level":2,"text":"Language Switching"},{"type":"heading","anchor":"Get-Current-Language","level":3,"text":"Get Current Language"},{"type":"codeListing","syntax":"swift","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"type":"heading","anchor":"Change-Language","level":3,"text":"Change Language"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"type":"heading","anchor":"Language-Persistence","level":3,"text":"Language Persistence"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}]}]}]},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Fallback-Behavior","level":3,"text":"Fallback Behavior"},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not found, fall back to English"}]}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"type":"heading","anchor":"Environment-Access","level":2,"text":"Environment Access"},{"inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"LocalizationService.shared"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.shared"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Adding-New-Keys","level":2,"text":"Adding New Keys"},{"inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"1-Update-LocalizationKey-Enum","level":3,"text":"1. Update LocalizationKey Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"inlineContent":[{"type":"text","text":"Then add convenient extensions:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","anchor":"2-Add-to-All-Translation-Files","level":3,"text":"2. Add to All Translation Files"},{"inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"inlineContent":[{"text":"Similar for ","type":"text"},{"type":"codeVoice","code":"fr.json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"it.json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"es.json"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"3-Update-Tests","level":3,"text":"3. Update Tests"},{"inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","anchor":"4-Run-Consistency-Tests","level":3,"text":"4. Run Consistency Tests"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","anchor":"Adding-New-Languages","level":2,"text":"Adding New Languages"},{"inlineContent":[{"type":"text","text":"To add support for a new language:"}],"type":"paragraph"},{"type":"heading","anchor":"1-Update-Language-Enum","level":3,"text":"1. Update Language Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","anchor":"2-Create-Translation-File","level":3,"text":"2. Create Translation File"},{"inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" keys from other language files:"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","anchor":"3-Test-the-New-Language","level":3,"text":"3. Test the New Language"},{"type":"codeListing","syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"type":"heading","anchor":"4-Run-Consistency-Tests","level":3,"text":"4. Run Consistency Tests"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","anchor":"Design-Principles","level":2,"text":"Design Principles"},{"type":"heading","ancho