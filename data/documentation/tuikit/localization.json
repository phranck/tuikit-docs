{"kind":"article","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Localization"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"anchor":"Related-Documentation"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"anchor":"Key-Features","type":"heading","level":3,"text":"Key Features"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Persistent storage"}],"type":"strong"},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"text":": Safe language switching from any thread at runtime","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"JSON-based"}],"type":"strong"},{"text":": Easy to extend with new strings and languages","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Quick-Start","type":"heading","level":2,"text":"Quick Start"},{"anchor":"Display-Localized-Strings","type":"heading","level":3,"text":"Display Localized Strings"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" convenience initializer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"]},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}]},{"type":"heading","level":3,"text":"Supported Languages","anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"text":" - Deutsch","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"text":" - Français","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"text":"All localized strings are available as ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support.","type":"text"}]},{"type":"heading","level":3,"text":"Key Categories","anchor":"Key-Categories"},{"type":"heading","level":4,"text":"Button Keys","anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}]},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"]},{"type":"heading","level":4,"text":"Label Keys","anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"]},{"type":"heading","level"