":"Change Language","type":"heading","anchor":"Change-Language","level":3},{"type":"codeListing","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"syntax":"swift"},{"text":"Language Persistence","type":"heading","anchor":"Language-Persistence","level":3},{"inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"text":"Fallback Behavior","type":"heading","anchor":"Fallback-Behavior","level":3},{"inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not found, fall back to English","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}]},{"inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}],"type":"paragraph"},{"text":"Environment Access","type":"heading","anchor":"Environment-Access","level":2},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizationService.shared"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.shared"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}],"type":"paragraph"},{"text":"Adding New Keys","type":"heading","anchor":"Adding-New-Keys","level":2},{"inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}],"type":"paragraph"},{"text":"1. Update LocalizationKey Enum","type":"heading","anchor":"1-Update-LocalizationKey-Enum","level":3},{"inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Then add convenient extensions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: 