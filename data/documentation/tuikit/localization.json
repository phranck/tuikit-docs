":"Language preferences are automatically saved to:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Linux","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"level":3,"type":"heading","text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Try to find the key in the active language","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not found, fall back to English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"level":2,"type":"heading","text":"Environment Access","anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"text":" is available in the view environment:","type":"text"}]},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizationService.shared"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.shared"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}]},{"level":2,"type":"heading","text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}]},{"level":3,"type":"heading","text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"de.json","type":"text"}]},{"text":":","type":"text"}]},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Similar for ","type":"text"},{"type":"codeVoice","code":"fr.json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"it.json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"es.json"},{"text":".","type":"text"}]},{"level":3,"type":"heading","text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"type":"heading","text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"level":3,"type":"heading","text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"text":":","type":"text"}]},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"type":"text","text":" keys from other language files:"}]},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json","type":"codeListing"},{"level":3,"type":"heading","text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"type":"heading","text":"Design Principles","anchor":"Design-Principles"},{"le