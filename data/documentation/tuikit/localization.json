{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"level":3,"text":"Key Features","anchor":"Key-Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type-safe keys"}]},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"5 languages built-in"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Persistent storage","type":"text"}],"type":"strong"},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Thread-safe","type":"text"}],"type":"strong"},{"text":": Safe language switching from any thread at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"JSON-based","type":"text"}]},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Quick Start","anchor":"Quick-Start","type":"heading"},{"level":3,"text":"Display Localized Strings","anchor":"Display-Localized-Strings","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"LocalizedString"},{"type":"text","text":" to show localized text:"}],"type":"paragraph"},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Or use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"],"type":"codeListing"},{"level":3,"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","type":"heading"},{"type":"codeListing","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}]},{"type":"heading","anchor":"Supported-Languages","text":"Supported Languages","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".english","type":"codeVoice"},{"text":" - English","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".german","type":"codeVoice"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"type":"text","text":" - Español"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Type-Safe-Keys","text":"Type-Safe Keys","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"type":"heading","anchor":"Key-Categories","text":"Key Categories","level":3},{"type":"heading","anchor":"Button-Keys","text":"Button Keys","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}]},{"type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift"},{"level":4,"type":"heading","text":"Label Keys","anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift"},{"level":4,"type":"heading","text":"Error Keys","anchor":"Error-Keys"},{"t