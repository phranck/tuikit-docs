lized-Strings","text":"Using Localized Strings"},{"level":3,"type":"heading","anchor":"LocalizedString-View","text":"LocalizedString View"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"level":3,"type":"heading","anchor":"Text-View-with-Localization","text":"Text View with Localization"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"level":3,"type":"heading","anchor":"Direct-Service-Access","text":"Direct Service Access"},{"inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"level":2,"type":"heading","anchor":"Language-Switching","text":"Language Switching"},{"level":3,"type":"heading","anchor":"Get-Current-Language","text":"Get Current Language"},{"syntax":"swift","type":"codeListing","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"level":3,"type":"heading","anchor":"Change-Language","text":"Change Language"},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"level":3,"type":"heading","anchor":"Language-Persistence","text":"Language Persistence"},{"inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Fallback-Behavior","text":"Fallback Behavior"},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"inlineContent":[{"text":"If not found, fall back to English","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Environment-Access","text":"Environment Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}]},{"level":2,"type":"heading","text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}]},{"level":3,"type":"heading","text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"en.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"code":"fr.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"it.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"es.json","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"level":2,"type":"heading","text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"text":"To add support for a new language:","type":"text"}]},{"level":3,"type":"heading","text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"text":":","type":"text"}]},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing","syntax":"json"},{"level":3,"type":"heading","text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"level":2,"type":"heading","text":"Design Principles","anchor":"Design-Principles"},{"level":3,"type":"heading","text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"level":3,"type":"heading","text":"Enum Categories","anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"button.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"error.*"},{"text":" keys → ","type":"text"},{"type":"codeVoice","code":"LocalizationKey.Error"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"code":"validation.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Validation","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}]},{"level":3,"type":"heading","text":"Thread Safety","anchor":"Thread-Safety"},{"