{"kind":"article","abstract":[{"text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system.","type":"text"}],"variants":[{"paths":["\/documentation\/tuikit\/localization"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Localization","modules":[{"name":"TUIkit"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"anchor":"Key-Features","text":"Key Features","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Type-safe keys","type":"text"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Fallback chain","type":"text"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Quick-Start","text":"Quick Start","level":2,"type":"heading"},{"anchor":"Display-Localized-Strings","text":"Display Localized Strings","level":3,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Or use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"],"type":"codeListing"},{"anchor":"Switch-Language-at-Runtime","text":"Switch Language at Runtime","level":3,"type":"heading"},{"code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings.","type":"text"}],"type":"paragraph"},{"text":"Supported Languages","anchor":"Supported-Languages","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}],"type":"paragraph"}]}]},{"text":"Type-Safe Keys","anchor":"Type-Safe-Keys","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"text":"Key Categories","anchor":"Key-Categories","level":3,"type":"heading"},{"text":"Button Keys","anchor":"Button-Keys","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}],"type":"paragraph"},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift","type":"codeListing"},{"text":"Label Keys","anchor":"Label-Keys","type":"heading","level":4},{"inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing","syntax":"swift"},{"text":"Error Keys","anchor":"Error-Keys","type":"heading","level":4},{"inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing","syntax":"swift"},{"text":"Placeholder Keys","anchor":"Placeholder-Keys","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}],"type":"paragraph"},{"code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing","syntax":"swift"},{"text":"Menu Keys","anchor":"Menu-Keys","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing","syntax":"swift"},{"text":"Dialog Keys","anchor":"Dialog-Keys","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}],"type":"paragraph"},{"code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing","syntax":"swift"},{"text":"Validation Keys","anchor":"Validation-Keys","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}],"type":"paragraph"},{"code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing","syntax":"swift"},{"text":"Using Localized Strings","anchor":"Using-Localized-Strings","type":"heading","level":2},{"text":"LocalizedString View","anchor":"LocalizedString-View","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}],"type":"paragraph"},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Text View with Localization","anchor":"Text-View-with-Localization","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Direct Service Access","anchor":"Direct-Service-Access","type":"heading","level":3},{"inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}],"type":"paragraph"},{"code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Language Switching","anchor":"Language-Switching","type":"heading","level":2},{"text":"Get Current Language","anchor":"Get-Current-Language","type":"heading","level":3},{"code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Change Language","anchor":"Change-Language","type":"heading","level":3},{"code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"type":"codeListing","syntax":"swift"},{"text":"Language Persistence","anchor":"Language-Persistence","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}]}]}]},{"inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}],"type":"paragraph"},{"text":"Fallback Behavior","anchor":"Fallback-Behavior","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"inlineContent":[{"text":"If not found, fall back to English","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}]}]}]},{"inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}],"type":"paragraph"},{"text":"Environment Access","anchor":"Environment-Access","type":"heading","level":2},{"inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"type":"text","text":" is available in the view environment:"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizationService.shared"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.shared"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}],"type":"paragraph"},{"text":"Adding New Keys","anchor":"Adding-New-Keys","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"text":"2. Add to All Translation Files","type":"heading","level":3,"anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"text":":","type":"text"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"type":"text","text":":"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"text":"3. Update Tests","type":"heading","level":3,"anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"text":"4. Run Consistency Tests","type":"heading","level":3,"anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Adding New Languages","type":"heading","level":2,"anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"text":"To add support for a new language:","type":"text"}]},{"text":"1. Update Language Enum","type":"heading","level":3,"anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"text":"2. Create Translation File","type":"heading","level":3,"anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" keys from other language files:"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"text":"3. Test the New Language","type":"heading","level":3,"anchor":"3-Test-the-New-Language"},{"syntax":"swift","type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"text":"4. Run Consistency Tests","type":"heading","level":3,"anchor":"4-Run-Consistency-Tests"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Design Principles","type":"heading","level":2,"anchor":"Design-Principles"},{"text":"Dot-Notation Keys","type":"heading","level":3,"anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"text":"Enum Categories","type":"heading","level":3,"anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"items":[{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"validation.*"},{"text":" keys → ","type":"text"},{"type":"codeVoice","code":"LocalizationKey.Validation"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}]},{"text":"Thread Safety","type":"heading","level":3,"anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","isActive":true,"type":"reference"},{"text":" uses ","type":"text"},{"code":"NSLock","type":"codeVoice"},{"text":" for thread-safe access:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"]},{"text":"Performance Caching","type":"heading","level":3,"anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}]},{"syntax":"swift","type":"codeListing","code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"]},{"text":"JSON File Format","type":"heading","level":2,"anchor":"JSON-File-Format"},{"text":"Structure","type":"heading","level":3,"anchor":"Structure"},{"syntax":"json","type":"codeListing","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"]},{"text":"Rules","type":"heading","level":3,"anchor":"Rules"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Flat structure","type":"text"}]},{"type":"text","text":": No nested objects (all keys are top-level)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dot-separated keys"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"\"button.ok\""},{"type":"text","text":", not nested objects"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"UTF-8 encoding","type":"text"}]},{"type":"text","text":": Required for non-Latin characters"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Valid JSON"}]},{"text":": No trailing commas, proper escaping","type":"text"}]}]}],"type":"orderedList"},{"text":"Example","type":"heading","level":3,"anchor":"Example"},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"]},{"text":"Best Practices","type":"heading","level":2,"anchor":"Best-Practices"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Always use type-safe keys"}]},{"type":"text","text":": Use "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums instead of raw strings"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Keep keys organized"}]},{"type":"text","text":": Group related strings by category"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use descriptive names"}]},{"text":": Short, clear key names","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Run consistency tests"}]},{"type":"text","text":": Always verify after adding keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Test all languages","type":"text"}]},{"type":"text","text":": Check translations look correct in each language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Handle missing strings","type":"text"}]},{"type":"text","text":": Rely on the fallback chain for incomplete translations"}]}]}],"type":"orderedList"},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"TUIkit includes comprehensive localization tests:","type":"text"}]},{"text":"LocalizationServiceTests","type":"heading","level":3,"anchor":"LocalizationServiceTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core functionality tests covering:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle loading for all languages"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"String resolution with dot-notation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Fallback behavior","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Language switching"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"inlineContent":[{"text":"Thread safety","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"LocalizationKeyConsistencyTests","type":"heading","level":3,"anchor":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"text":"Validation tests ensuring:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Every enum key exists in all translation files"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No extraneous keys in translation files"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Expected total key count","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run after any localization changes:"}]},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Troubleshooting","type":"heading","level":2,"anchor":"Troubleshooting"},{"text":"String Not Appearing","type":"heading","level":3,"anchor":"String-Not-Appearing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the key exists in ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enum","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run consistency tests to verify","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Wrong Language Showing","type":"heading","level":3,"anchor":"Wrong-Language-Showing"},{"items":[{"content":[{"inlineContent":[{"text":"Verify ","type":"text"},{"type":"codeVoice","code":"@Environment(\\.currentLanguage)"},{"text":" reports the expected language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Confirm language is supported (en, de, fr, it, es)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check translation file exists for that language"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"JSON Syntax Errors","type":"heading","level":3,"anchor":"JSON-Syntax-Errors"},{"type":"paragraph","inlineContent":[{"text":"If translation files won’t load:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Validate JSON syntax","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check for missing commas or quotes","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure UTF-8 encoding"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No trailing commas in objects","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://TUIkit/documentation/TUIkit/AppLifecycle":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","type":"topic","role":"article","abstract":[{"text":"Understand how a TUIkit applica