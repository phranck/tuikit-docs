,{"type":"heading","level":2,"text":"Using Localized Strings","anchor":"Using-Localized-Strings"},{"type":"heading","level":3,"text":"LocalizedString View","anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"type":"heading","level":3,"text":"Text View with Localization","anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"type":"heading","level":3,"text":"Direct Service Access","anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"heading","level":2,"text":"Language Switching","anchor":"Language-Switching"},{"type":"heading","level":3,"text":"Get Current Language","anchor":"Get-Current-Language"},{"syntax":"swift","type":"codeListing","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"type":"heading","level":3,"text":"Change Language","anchor":"Change-Language"},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"type":"heading","level":3,"text":"Language Persistence","anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linux"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"type":"heading","level":3,"text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"type":"heading","level":2,"text":"Environment Access","anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}]},{"type":"heading","level":2,"text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"type":"heading","level":3,"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","level":3,"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"de.json","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","level":3,"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","level":3,"text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","level":3,"text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"syntax":"swift","type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Design Principles","anchor":"Design-Principles"},{"type":"heading","level":3,"text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"type":"codeVoice","code":"category.key_name"},{"text":" format:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"type":"heading","level":3,"text":"Enum Categories","anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"button.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"error.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Error","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"validation.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Validation"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}]},{"type":"heading","level":3,"t