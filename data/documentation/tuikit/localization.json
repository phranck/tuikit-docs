{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"role":"article","title":"Localization"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"level":3,"text":"Key Features","anchor":"Key-Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"5 languages built-in"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Fallback chain","type":"text"}],"type":"strong"},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"text":": Easy to extend with new strings and languages","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Quick Start","anchor":"Quick-Start","type":"heading"},{"level":3,"text":"Display Localized Strings","anchor":"Display-Localized-Strings","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"code":["Text(localized: LocalizationKey.Button.save)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","type":"heading"},{"code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Supported Languages","anchor":"Supported-Languages","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"text":" - English","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"text":" - Deutsch","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}]}]}],"type":"unorderedList"},{"level":2,"text":"Type-Safe Keys","anchor":"Type-Safe-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"level":3,"text":"Key Categories","anchor":"Key-Categories","type":"heading"},{"level":4,"text":"Button Keys","anchor":"Button-Keys","type":"heading"},{"inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Label Keys","anchor":"Label-Keys","type":"heading"},{"inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Error Keys","anchor":"Error-Keys","type":"heading"},{"inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Placeholder Keys","anchor":"Placeholder-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}],"type":"paragraph"},{"code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Menu Keys","anchor":"Menu-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Dialog Keys","anchor":"Dialog-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}],"type":"paragraph"},{"code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"syntax":"swift","type":"codeListing"},{"level":4,"text":"Validation Keys","anchor":"Validation-Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}],"type":"paragraph"},{"code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Using Localized Strings","anchor":"Using-Localized-Strings","type":"heading"},{"level":3,"text":"LocalizedString View","anchor":"LocalizedString-View","type":"heading"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Text View with Localization","anchor":"Text-View-with-Localization","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Direct Service Access","anchor":"Direct-Service-Access","type":"heading"},{"inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}],"type":"paragraph"},{"code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Language Switching","anchor":"Language-Switching","type":"heading"},{"level":3,"text":"Get Current Language","anchor":"Get-Current-Language","type":"heading"},{"code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Change Language","anchor":"Change-Language","type":"heading"},{"code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Language Persistence","anchor":"Language-Persistence","type":"heading"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Linux","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}],"type":"paragraph"},{"level":3,"text":"Fallback Behavior","anchor":"Fallback-Behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If not found, fall back to English","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"level":2,"text":"Environment Access","anchor":"Environment-Access","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"code":"LocalizationService.shared","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AppState.shared","type":"codeVoice"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}],"type":"paragraph"},{"level":2,"text":"Adding New Keys","anchor":"Adding-New-Keys","type":"heading"},{"inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}],"type":"paragraph"},{"level":3,"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum","type":"heading"},{"inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then add convenient extensions:"}],"type":"paragraph"},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files","type":"heading"},{"inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"3. Update Tests","anchor":"3-Update-Tests","type":"heading"},{"inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","type":"heading"},{"inlineContent":[{"text":"Verify all keys exist in translation files:","type":"text"}],"type":"paragraph"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"text":"Adding New Languages","anchor":"Adding-New-Languages","type":"heading"},{"inlineContent":[{"type":"text","text":"To add support for a new language:"}],"type":"paragraph"},{"level":3,"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum","type":"heading"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"2. Create Translation File","anchor":"2-Create-Translation-File","type":"heading"},{"inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json","type":"codeListing"},{"level":3,"text":"3. Test the New Language","anchor":"3-Test-the-New-Language","type":"heading"},{"code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","type":"heading"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"text":"Design Principles","anchor":"Design-Principles","type":"heading"},{"level":3,"text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys","type":"heading"},{"inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}],"type":"paragraph"},{"code":["button.ok","error.not_found","validation.email_invalid"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}],"type":"paragraph"},{"level":3,"text":"Enum Categories","anchor":"Enum-Categories","type":"heading"},{"inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"button.*"},{"text":" keys → ","type":"text"},{"type":"codeVoice","code":"LocalizationKey.Button"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Error","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"validation.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Validation"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}],"type":"paragraph"},{"level":3,"text":"Thread Safety","anchor":"Thread-Safety","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference","isActive":true},{"type":"text","text":" uses "},{"code":"NSLock","type":"codeVoice"},{"type":"text","text":" for thread-safe access:"}],"type":"paragraph"},{"code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Performance Caching","anchor":"Performance-Caching","type":"heading"},{"inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}],"type":"paragraph"},{"code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"JSON File Format","anchor":"JSON-File-Format","type":"heading"},{"level":3,"text":"Structure","anchor":"Structure","type":"heading"},{"code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"syntax":"json","type":"codeListing"},{"level":3,"text":"Rules","anchor":"Rules","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Flat structure","type":"text"}],"type":"strong"},{"type":"text","text":": No nested objects (all keys are top-level)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Dot-separated keys"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"\"button.ok\""},{"text":", not nested objects","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"UTF-8 encoding","type":"text"}]},{"type":"text","text":": Required for non-Latin characters"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Valid JSON","type":"text"}],"type":"strong"},{"text":": No trailing commas, proper escaping","type":"text"}]}]}],"type":"orderedList"},{"level":3,"text":"Example","anchor":"Example","type":"heading"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"syntax":"json","type":"codeListing"},{"level":2,"text":"Best Practices","anchor":"Best-Practices","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Always use type-safe keys","type":"text"}]},{"type":"text","text":": Use "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums instead of raw strings"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Keep keys organized","type":"text"}],"type":"strong"},{"text":": Group related strings by category","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Use descriptive names","type":"text"}]},{"type":"text","text":": Short, clear key names"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Run consistency tests","type":"text"}]},{"type":"text","text":": Always verify after adding keys"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Test all languages"}],"type":"strong"},{"text":": Check translations look correct in each language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Handle missing strings"}],"type":"strong"},{"type":"text","text":": Rely on the fallback chain for incomplete translations"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"inlineContent":[{"text":"TUIkit includes comprehensive localization tests:","type":"text"}],"type":"paragraph"},{"level":3,"text":"LocalizationServiceTests","anchor":"LocalizationServiceTests","type":"heading"},{"inlineContent":[{"type":"text","text":"Core functionality tests covering:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Bundle loading for all languages"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution with dot-notation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fallback behavior"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Persistence to disk","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Thread safety"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"LocalizationKeyConsistencyTests","text":"LocalizationKeyConsistencyTests","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Validation tests ensuring:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every enum key exists in all translation files","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No extraneous keys in translation files","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Expected total key count","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Run after any localization changes:"}],"type":"paragraph"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"anchor":"Troubleshooting","text":"Troubleshooting","type":"heading","level":2},{"anchor":"String-Not-Appearing","text":"String Not Appearing","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the key exists in "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enum"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Run consistency tests to verify"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Wrong-Language-Showing","text":"Wrong Language Showing","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify "},{"type":"codeVoice","code":"@Environment(\\.currentLanguage)"},{"type":"text","text":" reports the expected language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Confirm language is supported (en, de, fr, it, es)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check translation file exists for that language"}]}]}],"type":"unorderedList"},{"anchor":"JSON-Syntax-Errors","text":"JSON Syntax Errors","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"If translation files won’t load:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Validate JSON syntax","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check for missing commas or quotes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ensure UTF-8 encoding","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No trailing commas in objects","type":"text"}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"abstract":[{"text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"anchor":"Related-Documentation","title":"Related Documentation"}],"kind":"article","references":{"doc://TUIkit/documentation/TUIkit":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"role":"c