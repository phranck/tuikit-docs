calizationKey Enum","type":"heading","anchor":"1-Update-LocalizationKey-Enum","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"text":"2. Add to All Translation Files","type":"heading","anchor":"2-Add-to-All-Translation-Files","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"type":"text","text":":"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"type":"text","text":":"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"code":"fr.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"it.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"es.json","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"3. Update Tests","type":"heading","anchor":"3-Update-Tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"text":"4. Run Consistency Tests","type":"heading","anchor":"4-Run-Consistency-Tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Adding New Languages","type":"heading","anchor":"Adding-New-Languages","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"text":"1. Update Language Enum","type":"heading","anchor":"1-Update-Language-Enum","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"text":"2. Create Translation File","type":"heading","anchor":"2-Create-Translation-File","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" keys from other language files:"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"text":"3. Test the New Language","type":"heading","anchor":"3-Test-the-New-Language","level":3},{"syntax":"swift","type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"]},{"text":"4. Run Consistency Tests","type":"heading","anchor":"4-Run-Consistency-Tests","level":3},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Design Principles","type":"heading","anchor":"Design-Principles","level":2},{"text":"Dot-Notation Keys","type":"heading","anchor":"Dot-Notation-Keys","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"code":"category.key_name","type":"codeVoice"},{"type":"text","text":" format:"}]},{"syntax":null,"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"text":"Enum Categories","type":"heading","anchor":"Enum-Categories","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"t