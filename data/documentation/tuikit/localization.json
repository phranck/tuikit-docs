ntent":[{"inlineContent":[{"inlineContent":[{"text":"Thread-safe","type":"text"}],"type":"strong"},{"type":"text","text":": Safe language switching from any thread at runtime"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Quick-Start","text":"Quick Start"},{"type":"heading","level":3,"anchor":"Display-Localized-Strings","text":"Display Localized Strings"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"LocalizedString","type":"codeVoice"},{"type":"text","text":" to show localized text:"}],"type":"paragraph"},{"type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"syntax":"swift"},{"inlineContent":[{"text":"Or use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["Text(localized: LocalizationKey.Button.save)"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Switch-Language-at-Runtime","text":"Switch Language at Runtime"},{"code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings.","type":"text"}],"type":"paragraph"},{"text":"Supported Languages","type":"heading","level":3,"anchor":"Supported-Languages"},{"items":[{"content":[{"inlineContent":[{"code":".english","type":"codeVoice"},{"type":"text","text":" - English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"text":" - Deutsch","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}]}]}],"type":"unorderedList"},{"text":"Type-Safe Keys","type":"heading","level":2,"anchor":"Type-Safe-Keys"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"text":"Key Categories","type":"heading","level":3,"anchor":"Key-Categories"},{"text":"Button Keys","type":"heading","level":4,"anchor":"Button-Keys"},{"inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}],"type":"paragraph"},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing","syntax":"swift"},{"text":"Label Keys","type":"heading","anchor":"Label-Keys","level":4},{"inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift"},{"text":"Error Keys","type":"heading","anchor":"Error-Keys","level":4},{"inlineContent":[{"text":"11 error strings i