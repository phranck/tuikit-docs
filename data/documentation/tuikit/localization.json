{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"text":"Key Features","anchor":"Key-Features","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Type-safe keys","type":"text"}],"type":"strong"},{"type":"text","text":": Compile-time verified "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"text":": Current language → English → key itself for graceful degradation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Thread-safe","type":"text"}]},{"text":": Safe language switching from any thread at runtime","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}]}]}],"type":"unorderedList"},{"text":"Quick Start","anchor":"Quick-Start","level":2,"type":"heading"},{"text":"Display Localized Strings","anchor":"Display-Localized-Strings","level":3,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"syntax":"swift","code":["Text(localized: .button(.save))"],"type":"codeListing"},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","level":3,"type":"heading"},{"syntax":"swift","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"type":"codeListing"},{"level":3,"type":"heading","text":"Supported Languages","anchor":"Supported-Languages"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"text":" - English","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".german","type":"codeVoice"},{"text":" - Deutsch","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"level":3,"type":"heading","text":"Key Categories","anchor":"Key-Categories"},{"level":4,"type":"heading","text":"Button Keys","anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing"},{"level":4,"type":"heading","text":"Label Keys","anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}]},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","anchor":"Error-Keys","text":"Error Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}]},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","anchor":"Placeholder-Keys","text":"Placeholder Keys"},{"type":"paragraph","inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}]},{"code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","anchor":"Menu-Keys","text":"Menu Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}]},{"code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","anchor":"Dialog-Keys","text":"Dialog Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}]},{"code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","anchor":"Validation-Keys","text":"Validation Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}]},{"code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Using-Localized-Strings","text":"Using Localized Strings"},{"level":3,"type":"heading","anchor":"LocalizedString-View","text":"LocalizedString View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Text-View-with-Localization","text":"Text View with Localization"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}]},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Direct-Service-Access","text":"Direct Service Access"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, access the service directly:"}]},{"code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Language-Switching","text":"Language Switching"},{"level":3,"type":"heading","anchor":"Get-Current-Language","text":"Get Current Language"},{"code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Change-Language","text":"Change Language"},{"code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"Language-Persistence","text":"Language Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}]},{"level":3,"type":"heading","anchor":"Fallback-Behavior","text":"Fallback Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"level":2,"type":"heading","anchor":"Environment-Access","text":"Environment Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}]},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","anchor":"Adding-New-Keys","text":"Adding New Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"level":3,"type":"heading","anchor":"1-Update-LocalizationKey-Enum","text":"1. Update LocalizationKey Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then add convenient extensions:","type":"text"}]},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"2-Add-to-All-Translation-Files","text":"2. Add to All Translation Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"level":3,"type":"heading","anchor":"3-Update-Tests","text":"3. Update Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"level":2,"type":"heading","anchor":"Adding-New-Languages","text":"Adding New Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"level":3,"type":"heading","anchor":"1-Update-Language-Enum","text":"1. Update Language Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"text":":","type":"text"}]},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","anchor":"2-Create-Translation-File","text":"2. Create Translation File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"text":" with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"text":" keys from other language files:","type":"text"}]},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing","syntax":"json"},{"level":3,"type":