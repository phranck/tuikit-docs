":"text"}],"type":"strong"},{"text":": Always verify after adding keys","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test all languages"}]},{"type":"text","text":": Check translations look correct in each language"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Handle missing strings"}]},{"type":"text","text":": Rely on the fallback chain for incomplete translations"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"type":"heading","anchor":"Testing","text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"TUIkit includes comprehensive localization tests:","type":"text"}]},{"level":3,"type":"heading","anchor":"LocalizationServiceTests","text":"LocalizationServiceTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core functionality tests covering:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Bundle loading for all languages","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"String resolution with dot-notation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Fallback behavior"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Persistence to disk","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Thread safety","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"type":"heading","anchor":"LocalizationKeyConsistencyTests","text":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"text":"Validation tests ensuring:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every enum key exists in all translation files","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No extraneous keys in translation files"}],"ty