{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}]},{"text":"Key Features","anchor":"Key-Features","type":"heading","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Type-safe keys","type":"text"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Persistent storage","type":"text"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Fallback chain","type":"text"}],"type":"strong"},{"text":": Current language → English → key itself for graceful degradation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Thread-safe"}],"type":"strong"},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"JSON-based"}],"type":"strong"},{"type":"text","text":": Easy to extend with new strings and languages"}]}]}]},{"text":"Quick Start","anchor":"Quick-Start","type":"heading","level":2},{"text":"Display Localized Strings","anchor":"Display-Localized-Strings","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}]},{"type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" convenience initializer:"}]},{"type":"codeListing","code":["Text(localized: .button(.save))"],"syntax":"swift"},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","type":"heading","level":3},{"syntax":"swift","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"type":"codeListing"},{"anchor":"Supported-Languages","level":3,"text":"Supported Languages","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"text":" - Español","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Type-Safe-Keys","level":2,"text":"Type-Safe Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"anchor":"Key-Categories","level":3,"text":"Key Categories","type":"heading"},{"anchor":"Button-Keys","level":4,"text":"Button Keys","type":"heading"},{"inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing"},{"anchor":"Label-Keys","level":4,"text":"Label Keys","type":"heading"},{"inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing"},{"anchor":"Error-Keys","level":4,"text":"Error Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing"},{"anchor":"Placeholder-Keys","level":4,"text":"Placeholder Keys","type":"heading"},{"inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing"},{"anchor":"Menu-Keys","level":4,"text":"Menu Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing"},{"anchor":"Dialog-Keys","level":4,"text":"Dialog Keys","type":"heading"},{"inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing"},{"anchor":"Validation-Keys","level":4,"text":"Validation Keys","type":"heading"},{"inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing"},{"anchor":"Using-Localized-Strings","level":2,"text":"Using Localized Strings","type":"heading"},{"anchor":"LocalizedString-View","level":3,"text":"LocalizedString View","type":"heading"},{"inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"type":"codeListing"},{"anchor":"Text-View-with-Localization","level":3,"text":"Text View with Localization","type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"Text(localized:)"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"type":"codeListing"},{"anchor":"Direct-Service-Access","level":3,"text":"Direct Service Access","type":"heading"},{"inlineContent":[{"text":"For advanced use cases, access the service directly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"type":"codeListing"},{"anchor":"Language-Switching","level":2,"text":"Language Switching","type":"heading"},{"anchor":"Get-Current-Language","level":3,"text":"Get Current Language","type":"heading"},{"syntax":"swift","code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"type":"codeListing"},{"anchor":"Change-Language","level":3,"text":"Change Language","type":"heading"},{"syntax":"swift","code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"type":"codeListing"},{"anchor":"Language-Persistence","level":3,"text":"Language Persistence","type":"heading"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linux"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"anchor":"Fallback-Behavior","level":3,"text":"Fallback Behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Try to find the key in the active language","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If not found, fall back to English","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}],"type":"paragraph"},{"anchor":"Environment-Access","level":2,"text":"Environment Access","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"type":"codeListing"},{"anchor":"Adding-New-Keys","level":2,"text":"Adding New Keys","type":"heading"},{"inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}],"type":"paragraph"},{"anchor":"1-Update-LocalizationKey-Enum","level":3,"text":"1. Update LocalizationKey Enum","type":"heading"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Then add convenient extensions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing"},{"anchor":"2-Add-to-All-Translation-Files","level":3,"text":"2. Add to All Translation Files","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Similar for "},{"code":"fr.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"it.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"es.json","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"3-Update-Tests","level":3,"text":"3. Update Tests","type":"heading"},{"inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing"},{"anchor":"4-Run-Consistency-Tests","level":3,"text":"4. Run Consistency Tests","type":"heading"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"anchor":"Adding-New-Languages","level":2,"text":"Adding New Languages","type":"heading"},{"inlineContent":[{"text":"To add support for a new language:","type":"text"}],"type":"paragraph"},{"anchor":"1-Update-Language-Enum","level":3,"text":"1. Update Language Enum","type":"heading"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing"},{"anchor":"2-Create-Translation-File","level":3,"text":"2. Create Translation File","type":"heading"},{"inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" keys from other language files:"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing"},{"anchor":"3-Test-the-New-Language","level":3,"text":"3. Test the New Language","type":"heading"},{"syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"type":"codeListing"},{"anchor":"4-Run-Consistency-Tests","level":3,"text":"4. Run Consistency Tests","type":"heading"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"anchor":"Design-Principles","level":2,"text":"Design Principles","type":"heading"},{"anchor":"Dot-Notation-Keys","level":3,"text":"Dot-Notation Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}],"type":"paragraph"},{"syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}],"type":"paragraph"},{"anchor":"Enum-Categories","level":3,"text":"Enum Categories","type":"heading"},{"inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"error.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Error","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"code":"validation.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Validation","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}],"type":"paragraph"},{"anchor":"Thread-Safety","level":3,"text":"Thread Safety","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference"},{"text":" uses ","type":"text"},{"code":"NSLock","type":"codeVoice"},{"text":" for thread-safe access:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Safe to call from any thread","DispatchQueue.global().async {","    AppState.shared.setLanguage(.german)","}"],"type":"codeListing"},{"anchor":"Performance-Caching","level":3,"text":"Performance Caching","type":"heading"},{"inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}],"type":"paragraph"},{"syntax":"swift","code":["let text1 = service.string(for: .button(.ok))  \/\/ Loads and caches","let text2 = service.string(for: .button(.ok))  \/\/ Uses cache"],"type":"codeListing"},{"anchor":"JSON-File-Format","level":2,"text":"JSON File Format","type":"heading"},{"anchor":"Structure","level":3,"text":"Structure","type":"heading"},{"syntax":"json","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"type":"codeListing"},{"anchor":"Rules","level":3,"text":"Rules","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Flat structure"}],"type":"strong"},{"text":": No nested objects (all keys are top-level)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dot-separated keys"}],"type":"strong"},{"text":": ","type":"text"},{"code":"\"button.ok\"","type":"codeVoice"},{"text":", not nested objects","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"UTF-8 encoding"}],"type":"strong"},{"text":": Required for non-Latin characters","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Valid JSON","type":"text"}],"type":"strong"},{"text":": No trailing commas, proper escaping","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Example","level":3,"text":"Example","type":"heading"},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"type":"codeListing"},{"anchor":"Best-Practices","level":2,"text":"Best Practices","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Always use type-safe keys","type":"text"}]},{"type":"text","text":": Use "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums instead of raw strings"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Keep keys organized"}],"type":"strong"},{"text":": Group related strings by category","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Use descriptive names"}],"type":"strong"},{"text":": Short, clear key names","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Run consistency tests"}],"type":"strong"},{"text":": Always verify after adding keys","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Test all languages"}],"type":"strong"},{"text":": Check translations look correct in each language","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Handle missing strings"}],"type":"strong"},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit includes comprehensive localization tests:"}],"type":"paragraph"},{"anchor":"LocalizationServiceTests","level":3,"text":"LocalizationServiceTests","type":"heading"},{"inlineContent":[{"type":"text","text":"Core functionality tests covering:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Bundle loading for all languages"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution with dot-notation"}]}]},{"content":[{"inlineContent":[{"text":"Fallback behavior","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Language switching","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"inlineContent":[{"text":"Thread safety","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"LocalizationKeyConsistencyTests","level":3,"text":"LocalizationKeyConsistencyTests","type":"heading"},{"inlineContent":[{"text":"Validation tests ensuring:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every enum key exists in all translation files","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No extraneous keys in translation files"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Expected total key count"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Run after any localization changes:"}],"type":"paragraph"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"anchor":"Troubleshooting","level":2,"text":"Troubleshooting","type":"heading"},{"anchor":"String-Not-Appearing","level":3,"text":"String Not Appearing","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the key exists in "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enum"}]}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run consistency tests to verify","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Wrong-Language-Showing","level":3,"text":"Wrong Language Showing","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify language was set: "},{"code":"AppState.shared.currentLanguage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Confirm language is supported (en, de, fr, it, es)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check translation file exists for that language","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"JSON-Syntax-Errors","level":3,"text":"JSON Syntax Errors","type":"heading"},{"inlineContent":[{"type":"text","text":"If translation files won’t load:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Validate JSON syntax"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check for missing commas or quotes"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure UTF-8 encoding","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No trailing commas in objects"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"role":"article","title":"Localization","modules":[{"name":"TUIkit"}],"roleHeading":"Article"},"kind":"article","variants":[{"paths":["\/documentation\/tuikit\/localization"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","do