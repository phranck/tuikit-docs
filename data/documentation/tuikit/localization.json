{"sections":[],"abstract":[{"type":"text","text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system."}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"anchor":"Related-Documentation","title":"Related Documentation"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Localization","roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}]},"variants":[{"paths":["\/documentation\/tuikit\/localization"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Key Features","level":3,"anchor":"Key-Features"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type-safe keys"}]},{"type":"text","text":": Compile-time verified "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Fallback chain","type":"text"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Thread-safe","type":"text"}],"type":"strong"},{"text":": Safe language switching from any thread at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"JSON-based"}],"type":"strong"},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"type":"heading","text":"Quick Start","level":2,"anchor":"Quick-Start"},{"type":"heading","text":"Display Localized Strings","level":3,"anchor":"Display-Localized-Strings"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"]},{"inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(localized: LocalizationKey.Button.save)"]},{"type":"heading","text":"Switch Language at Runtime","level":3,"anchor":"Switch-Language-at-Runtime"},{"syntax":"swift","type":"codeListing","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}],"type":"paragraph"},{"type":"heading","text":"Supported Languages","level":3,"anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"text":" - Español","type":"text"}]}]}]},{"type":"heading","text":"Type-Safe Keys","level":2,"anchor":"Type-Safe-Keys"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"type":"heading","text":"Key Categories","level":3,"anchor":"Key-Categories"},{"type":"heading","text":"Button Keys","level":4,"anchor":"Button-Keys"},{"inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"]},{"type":"heading","text":"Label Keys","level":4,"anchor":"Label-Keys"},{"inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"]},{"type":"heading","text":"Error Keys","level":4,"anchor":"Error-Keys"},{"inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"]},{"type":"heading","text":"Placeholder Keys","level":4,"anchor":"Placeholder-Keys"},{"inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"]},{"type":"heading","text":"Menu Keys","level":4,"anchor":"Menu-Keys"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"]},{"type":"heading","text":"Dialog Keys","level":4,"anchor":"Dialog-Keys"},{"inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"]},{"type":"heading","text":"Validation Keys","level":4,"anchor":"Validation-Keys"},{"inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"type":"heading","text":"Using Localized Strings","level":2,"anchor":"Using-Localized-Strings"},{"type":"heading","text":"LocalizedString View","level":3,"anchor":"LocalizedString-View"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"type":"heading","text":"Text View with Localization","level":3,"anchor":"Text-View-with-Localization"},{"inlineContent":[{"type":"text","text":"Use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"type":"heading","text":"Direct Service Access","level":3,"anchor":"Direct-Service-Access"},{"inlineContent":[{"type":"text","text":"For advanced use cases, read the runtime-owned service from the environment:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"heading","text":"Language Switching","level":2,"anchor":"Language-Switching"},{"type":"heading","text":"Get Current Language","level":3,"anchor":"Get-Current-Language"},{"syntax":"swift","type":"codeListing","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"type":"heading","text":"Change Language","level":3,"anchor":"Change-Language"},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"type":"heading","text":"Language Persistence","level":3,"anchor":"Language-Persistence"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linux"}]},{"type":"text","text":": "},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}]}]}]},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Fallback Behavior","level":3,"anchor":"Fallback-Behavior"},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}]},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"type":"heading","text":"Environment Access","level":2,"anchor":"Environment-Access"},{"inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"code":"LocalizationService.shared","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AppState.shared","type":"codeVoice"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"code":"@Environment","type":"codeVoice"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}],"type":"paragraph"},{"type":"heading","text":"Adding New Keys","level":2,"anchor":"Adding-New-Keys"},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"type":"heading","text":"1. Update LocalizationKey Enum","level":3,"anchor":"1-Update-LocalizationKey-Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"inlineContent":[{"text":"Then add convenient extensions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","text":"2. Add to All Translation Files","level":3,"anchor":"2-Add-to-All-Translation-Files"},{"inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"3. Update Tests","level":3,"anchor":"3-Update-Tests"},{"inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","text":"4. Run Consistency Tests","level":3,"anchor":"4-Run-Consistency-Tests"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","text":"Adding New Languages","level":2,"anchor":"Adding-New-Languages"},{"inlineContent":[{"text":"To add support for a new language:","type":"text"}],"type":"paragraph"},{"type":"heading","text":"1. Update Language Enum","level":3,"anchor":"1-Update-Language-Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","text":"2. Create Translation File","level":3,"anchor":"2-Create-Translation-File"},{"inlineContent":[{"text":"Create ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"text":" with ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","text":"3. Test the New Language","level":3,"anchor":"3-Test-the-New-Language"},{"syntax":"swift","type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"type":"heading","text":"4. Run Consistency Tests","level":3,"anchor":"4-Run-Consistency-Tests"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","text":"Design Principles","level":2,"anchor":"Design-Principles"},{"type":"heading","text":"Dot-Notation Keys","level":3,"anchor":"Dot-Notation-Keys"},{"inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"]},{"inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Enum Categories","level":3,"anchor":"Enum-Categories"},{"inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"validation.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Validation"}],"type":"paragraph"}]}]},{"inlineConten