{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"text":"Key Features","anchor":"Key-Features","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Persistent storage"}],"type":"strong"},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Thread-safe"}],"type":"strong"},{"text":": Safe language switching from any thread at runtime","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"JSON-based","type":"text"}]},{"type":"text","text":": Easy to extend with new strings and languages"}]}]}],"type":"unorderedList"},{"text":"Quick Start","anchor":"Quick-Start","level":2,"type":"heading"},{"text":"Display Localized Strings","anchor":"Display-Localized-Strings","level":3,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}],"type":"paragraph"},{"code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or use the ","type":"text"},{"type":"codeVoice","code":"Text(localized:)"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"code":["Text(localized: .button(.save))"],"syntax":"swift","type":"codeListing"},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","level":3,"type":"heading"},{"type":"codeListing","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"Supported-Languages","text":"Supported Languages"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"text":" - Français","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Type-Safe-Keys","text":"Type-Safe Keys"},{"inlineContent":[{"text":"All localized strings are available as ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Key-Categories","text":"Key Categories"},{"level":4,"type":"heading","anchor":"Button-Keys","text":"Button Keys"},{"inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}],"type":"paragraph"},{"type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Label-Keys","text":"Label Keys"},{"inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}],"type":"paragraph"},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing","syntax":"swift"},{"anchor":"Error-Keys","text":"Error Keys","type":"heading","level":4},{"inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing","syntax":"swift"},{"anchor":"Placeholder-Keys","text":"Placeholder Keys","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}],"type":"paragraph"},{"code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing","syntax":"swift"},{"anchor":"Menu-Keys","text":"Menu Keys","type":"heading","level":4},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing","syntax":"swift"},{"anchor":"Dialog-Keys","text":"Dialog Keys","type":"heading","level":4},{"inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing","syntax":"swift"},{"anchor":"Validation-Keys","text":"Validation Keys","type":"heading","level":4},{"inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing","syntax":"swift"},{"anchor":"Using-Localized-Strings","text":"Using Localized Strings","type":"heading","level":2},{"anchor":"LocalizedString-View","text":"LocalizedString View","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}],"type":"paragraph"},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Text-View-with-Localization","text":"Text View with Localization","type":"heading","level":3},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Direct-Service-Access","text":"Direct Service Access","type":"heading","level":3},{"inlineContent":[{"text":"For advanced use cases, access the service directly:","type":"text"}],"type":"paragraph"},{"code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"type":"codeListing","syntax":"swift"},{"anchor":"Language-Switching","text":"Language Switching","type":"heading","level":2},{"anchor":"Get-Current-Language","text":"Get Current Language","type":"heading","level":3},{"code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"type":"codeListing","syntax":"swift"},{"anchor":"Change-Language","text":"Change Language","type":"heading","level":3},{"code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"type":"codeListing","syntax":"swift"},{"anchor":"Language-Persistence","text":"Language Persistence","type":"heading","level":3},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}],"type":"paragraph"},{"anchor":"Fallback-Behavior","text":"Fallback Behavior","type":"heading","level":3},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Try to find the key in the active language","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not found, fall back to English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"anchor":"Environment-Access","text":"Environment Access","type":"heading","level":2},{"inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"type":"text","text":" is available in the view environment:"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Adding-New-Keys","text":"Adding New Keys","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"anchor":"1-Update-LocalizationKey-Enum","text":"1. Update LocalizationKey Enum","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Then add convenient extensions:","type":"text"}],"type":"paragraph"},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"2-Add-to-All-Translation-Files","text":"2. Add to All Translation Files","type":"heading","level":3},{"inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"text":":","type":"text"}],"type":"paragraph"},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"3-Update-Tests","text":"3. Update Tests","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Add tests in "},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests","type":"heading","level":3},{"inlineContent":[{"text":"Verify all keys exist in translation files:","type":"text"}],"type":"paragraph"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"anchor":"Adding-New-Languages","text":"Adding New Languages","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"To add support for a new language:"}],"type":"paragraph"},{"anchor":"1-Update-Language-Enum","text":"1. Update Language Enum","type":"heading","level":3},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"2-Create-Translation-File","text":"2. Create Translation File","type":"heading","level":3},{"inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing","syntax":"json"},{"anchor":"3-Test-the-New-Language","text":"3. Test the New Language","type":"heading","level":3},{"code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"type":"codeListing","syntax":"swift"},{"anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests","type":"heading","level":3},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"anchor":"Design-Principles","text":"Design Principles","type":"heading","level":2},{"anchor":"Dot-Notation-Keys","text":"Dot-Notation Keys","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}],"type":"paragraph"},{"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}],"type":"paragraph"},{"anchor":"Enum-Categories","text":"Enum Categories","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Error","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"validation.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Validation","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}],"type":"paragraph"},{"anchor":"Thread-Safety","text":"Thread Safety","type":"heading","level":3},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService"},{"text":" uses ","type":"text"},{"code":"NSLock","type":"codeVoice"},{"text":" for thread-safe access:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Safe to call from any thread","DispatchQueue.global().async {","    AppState.shared.setLanguage(.german)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Performance-Caching","text":"Performance Caching","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}],"type":"paragraph"},{"code":["let text1 = service.string(for: .button(.ok))  \/\/ Loads and caches","let text2 = service.string(for: .button(.ok))  \/\/ Uses cache"],"type":"codeListing","syntax":"swift"},{"anchor":"JSON-File-Format","text":"JSON File Format","type":"heading","level":2},{"anchor":"Structure","text":"Structure","type":"heading","level":3},{"code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"type":"codeListing","syntax":"json"},{"anchor":"Rules","text":"Rules","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flat structure"}]},{"text":": No nested objects (all keys are top-level)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Dot-separated keys","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"\"button.ok\""},{"type":"text","text":", not nested objects"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"UTF-8 encoding","type":"text"}],"type":"strong"},{"text":": Required for non-Latin characters","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Valid JSON","type":"text"}],"type":"strong"},{"text":": No trailing commas, proper escaping","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Example","text":"Example","type":"heading","level":3},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"type":"codeListing","syntax":"json"},{"anchor":"Best-Practices","text":"Best Practices","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Always use type-safe keys"}],"type":"strong"},{"type":"text","text":": Use "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums instead of raw strings"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Keep keys organized","type":"text"}]},{"type":"text","text":": Group related strings by category"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use descriptive names"}]},{"type":"text","text":": Short, clear key names"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Run consistency tests"}],"type":"strong"},{"text":": Always verify after adding keys","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Test all languages"}],"type":"strong"},{"text":": Check translations look correct in each language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Handle missing strings","type":"text"}]},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Testing","text":"Testing","type":"heading","level":2},{"inlineContent":[{"type":"text",