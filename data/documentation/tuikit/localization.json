{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}]},{"type":"heading","text":"Key Features","level":3,"anchor":"Key-Features"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Type-safe keys","type":"text"}]},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"text":": Current language → English → key itself for graceful degradation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Thread-safe"}],"type":"strong"},{"text":": Safe language switching from any thread at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"JSON-based","type":"text"}],"type":"strong"},{"text":": Easy to extend with new strings and languages","type":"text"}]}]}]},{"type":"heading","text":"Quick Start","level":2,"anchor":"Quick-Start"},{"type":"heading","text":"Display Localized Strings","level":3,"anchor":"Display-Localized-Strings"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}]},{"type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}]},{"type":"codeListing","code":["Text(localized: .button(.save))"],"syntax":"swift"},{"type":"heading","text":"Switch Language at Runtime","level":3,"anchor":"Switch-Language-at-Runtime"},{"type":"codeListing","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"syntax":"swift"},{"type":"heading","text":"Supported Languages","level":3,"anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"text":" - Español","type":"text"}]}]}]},{"type":"heading","text":"Type-Safe Keys","level":2,"anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"type":"heading","text":"Key Categories","level":3,"anchor":"Key-Categories"},{"type":"heading","text":"Button Keys","level":4,"anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}]},{"type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift"},{"type":"heading","text":"Label Keys","level":4,"anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}]},{"type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift"},{"type":"heading","text":"Error Keys","level":4,"anchor":"Error-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}]},{"type":"codeListing","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"syntax":"swift"},{"type":"heading","text":"Placeholder Keys","level":4,"anchor":"Placeholder-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}]},{"type":"codeListing","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"syntax":"swift"},{"type":"heading","text":"Menu Keys","level":4,"anchor":"Menu-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}]},{"type":"codeListing","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"syntax":"swift"},{"type":"heading","text":"Dialog Keys","level":4,"anchor":"Dialog-Keys"},{"type":"paragraph","inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"syntax":"swift"},{"type":"heading","text":"Validation Keys","level":4,"anchor":"Validation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}]},{"type":"codeListing","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"syntax":"swift"},{"type":"heading","text":"Using Localized Strings","level":2,"anchor":"Using-Localized-Strings"},{"type":"heading","text":"LocalizedString View","level":3,"anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Text View with Localization","level":3,"anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"Text(localized:)"},{"text":" initializer:","type":"text"}]},{"type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Direct Service Access","level":3,"anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, access the service directly:"}]},{"type":"codeListing","code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"syntax":"swift"},{"type":"heading","text":"Language Switching","level":2,"anchor":"Language-Switching"},{"type":"heading","text":"Get Current Language","level":3,"anchor":"Get-Current-Language"},{"type":"codeListing","code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"syntax":"swift"},{"type":"heading","text":"Change Language","level":3,"anchor":"Change-Language"},{"type":"codeListing","code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"syntax":"swift"},{"type":"heading","text":"Language Persistence","level":3,"anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linux"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"type":"heading","text":"Fallback Behavior","level":3,"anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not found, fall back to English","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"type":"heading","text":"Environment Access","level":2,"anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"syntax":"swift"},{"type":"heading","text":"Adding New Keys","level":2,"anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"type":"heading","text":"1. Update LocalizationKey Enum","level":3,"anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift"},{"type":"heading","text":"2. Add to All Translation Files","level":3,"anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"de.json","type":"text"}]},{"type":"text","text":":"}]},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"type":"heading","text":"3. Update Tests","level":3,"anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift"},{"type":"heading","text":"4. Run Consistency Tests","level":3,"anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"type":"heading","text":"Adding New Languages","level":2,"anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","text":"1. Update Language Enum","level":3,"anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"2. Create Translation File","level":3,"anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json"},{"type":"heading","text":"3. Test the New Language","level":3,"anchor":"3-Test-the-New-Language"},{"type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"syntax":"swift"},{"type":"heading","text":"4. Run Consistency Tests","level":3,"anchor":"4-Run-Consistency-Tests"},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"type":"heading","text":"Design Principles","level":2,"anchor":"Design-Principles"},{"type":"heading","text":"Dot-Notation Keys","level":3,"anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"],"syntax":null},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"type":"heading","text":"Enum Categories","level":3,"anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"code":"validation.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Validation","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}]},{"type":"heading","text":"Thread Safety","level":3,"anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference","isActive":true},{"text":" uses ","type":"text"},{"code":"NSLock","type":"codeVoice"},{"text":" for thread-safe access:","type":"text"}]},{"type":"codeListing","code":["\/\/ Safe to call from any thread","DispatchQueue.global().async {","    AppState.shared.setLanguage(.german)","}"],"syntax":"swift"},{"type":"heading","text":"Performance Caching","level":3,"anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"text":"Translations are cached per language after first load:","type":"text"}]},{"type":"codeListing","code":["let text1 = service.string(for: .button(.ok))  \/\/ Loads and caches","let text2 = service.string(for: .button(.ok))  \/\/ Uses cache"],"syntax":"swift"},{"type":"heading","text":"JSON File Format","level":2,"anchor":"JSON-File-Format"},{"type":"heading","text":"Structure","level":3,"anchor":"Structure"},{"type":"codeListing","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"syntax":"json"},{"type":"heading","text":"Rules","level":3,"anchor":"Rules"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Flat structure"}],"type":"strong"},{"text":": No nested objects (all keys are top-level)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Dot-separated keys"}],"type":"strong"},{"text":": ","type":"text"},{"code":"\"button.ok\"","type":"codeVoice"},{"text":", not nested objects","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"UTF-8 encoding","type":"text"}]},{"type":"text","text":": Required for non-Latin characters"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Valid JSON"}],"type":"strong"},{"text":": No trailing commas, proper escaping","type":"text"}]}]}]},{"type":"heading","text":"Example","level":3,"anchor":"Example"},{"type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"syntax":"json"},{"type":"heading","text":"Best Practices","level":2,"anchor":"Best-Practices"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Always use type-safe keys","type":"text"}]},{"text":": Use ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enums instead of raw strings","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Keep keys organized"}]},{"text":": Group related strings by category","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Use descriptive names","type":"text"}],"type":"strong"},{"text":": Short, clear key names","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Run consistency tests"}],"type":"strong"},{"text":": Always verify after adding keys","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Test all languages","type":"text"}]},{"text":": Check translations look correct in each language","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Handle missing strings","type":"text"}],"type":"strong"},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit includes comprehensive localization tests:"}]},{"type":"heading","text":"LocalizationServiceTests","level":3,"anchor":"LocalizationServiceTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core functionality tests covering:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle loading for all languages"}]}]},{"content":[{"inlineContent":[{"text":"String resolution with dot-notation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Fallback behavior","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Language switching"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Thread safety"}],"type":"paragraph"}]}]},{"type":"heading","text":"LocalizationKeyConsistencyTests","level":3,"anchor":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"text":"Validation tests ensuring:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every enum key exists in all translation files","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No extraneous keys in translation files"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Expected total key count"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run after any localization changes:"}]},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"type":"heading","text":"Troubleshooting","level":2,"anchor":"Troubleshooting"},{"type":"heading","text":"String Not Appearing","level":3,"anchor":"String-Not-Appearing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify the key exists in ","type":"text"},{"c