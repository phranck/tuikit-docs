"type":"text"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"type":"text","text":" - Español"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"level":3,"type":"heading","text":"Key Categories","anchor":"Key-Categories"},{"level":4,"type":"heading","text":"Button Keys","anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","text":"Label Keys","anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","text":"Error Keys","anchor":"Error-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}]},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","text":"Placeholder 