{"kind":"article","sections":[],"abstract":[{"type":"text","text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}]},{"type":"heading","text":"Key Features","anchor":"Key-Features","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Fallback chain","type":"text"}],"type":"strong"},{"text":": Current language → English → key itself for graceful degradation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}]}]}]},{"type":"heading","text":"Quick Start","anchor":"Quick-Start","level":2},{"type":"heading","text":"Display Localized Strings","anchor":"Display-Localized-Strings","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"LocalizedString","type":"codeVoice"},{"text":" to show localized text:","type":"text"}]},{"type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or use the ","type":"text"},{"type":"codeVoice","code":"Text(localized:)"},{"text":" convenience initializer:","type":"text"}]},{"type":"codeListing","code":["Text(localized: .button(.save))"],"syntax":"swift"},{"type":"heading","text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","level":3},{"type":"codeListing","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"syntax":"swift"},{"type":"heading","text":"Supported Languages","anchor":"Supported-Languages","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"text":" - English","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".german","type":"codeVoice"},{"text":" - Deutsch","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Type-Safe Keys","anchor":"Type-Safe-Keys","level":2},{"type":"paragraph","inlineContent":[{"text":"All localized strings are available as ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support.","type":"text"}]},{"type":"heading","text":"Key Categories","anchor":"Key-Categories","level":3},{"type":"heading","text":"Button Keys","anchor":"Button-Keys","level":4},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift"},{"type":"heading","text":"Label Keys","anchor":"Label-Keys","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}]},{"type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift"},{"type":"heading","text":"Error Keys","anchor":"Error-Keys","level":4},{"type":"paragraph","inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"syntax":"swift"},{"type":"heading","text":"Placeholder Keys","anchor":"Placeholder-Keys","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}]},{"type":"codeListing","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"syntax":"swift"},{"type":"heading","text":"Menu Keys","anchor":"Menu-Keys","level":4},{"type":"paragraph","inlineContent":[{"text":"8 menu strings: file, edit, view, help, new, open, save, exit","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"syntax":"swift"},{"type":"heading","text":"Dialog Keys","anchor":"Dialog-Keys","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}]},{"type":"codeListing","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"syntax":"swift"},{"type":"heading","text":"Validation Keys","anchor":"Validation-Keys","level":4},{"type":"paragraph","inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"syntax":"swift"},{"type":"heading","text":"Using Localized Strings","anchor":"Using-Localized-Strings","level":2},{"type":"heading","text":"LocalizedString View","anchor":"LocalizedString-View","level":3},{"type":"paragraph","inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}]},{"type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Text View with Localization","anchor":"Text-View-with-Localization","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Direct Service Access","anchor":"Direct-Service-Access","level":3},{"type":"paragraph","inlineContent":[{"text":"For advanced use cases, access the service directly:","type":"text"}]},{"type":"codeListing","code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"syntax":"swift"},{"type":"heading","text":"Language Switching","anchor":"Language-Switching","level":2},{"type":"heading","text":"Get Current Language","anchor":"Get-Current-Language","level":3},{"type":"codeListing","code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"syntax":"swift"},{"type":"heading","text":"Change Language","anchor":"Change-Language","level":3},{"type":"codeListing","code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"syntax":"swift"},{"type":"heading","text":"Language Persistence","anchor":"Language-Persistence","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Linux"}]},{"type":"text","text":": "},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"type":"heading","text":"Fallback Behavior","anchor":"Fallback-Behavior","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Try to find the key in the active language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"type":"heading","text":"Environment Access","anchor":"Environment-Access","level":2},{"type":"paragraph","inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"type":"text","text":" is available in the view environment:"}]},{"type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"syntax":"swift"},{"type":"heading","text":"Adding New Keys","anchor":"Adding-New-Keys","level":2},{"type":"paragraph","inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}]},{"type":"heading","text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then add convenient extensions:","type":"text"}]},{"type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift"},{"type":"heading","text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files","level":3},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"text":":","type":"text"}]},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"text":":","type":"text"}]},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"code":"fr.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"it.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"es.json","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"3. Update Tests","anchor":"3-Update-Tests","level":3},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift"},{"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"type":"heading","text":"Adding New Languages","anchor":"Adding-New-Languages","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","text":"1. Update Language Enum","anchor":"1-Update-Language-Enum","level":3},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"2. Create Translation File","anchor":"2-Create-Translation-File","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" keys from other language files:"}]},{"type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json"},{"type":"heading","text":"3. Test the New Language","anchor":"3-Test-the-New-Language","level":3},{"type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"syntax":"swift"},{"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","level":3},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"type":"heading","text":"Design Principles","anchor":"Design-Principles","level":2},{"type":"heading","text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"type":"heading","text":"Enum Categories","anchor":"Enum-Categories","level":3},{"type":"paragraph","inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Error","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"validation.*"},{"text":" keys → ","type":"text"},{"type":"codeVoice","code":"LocalizationKey.Validation"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}]},{"type":"heading","text":"Thread Safety","anchor":"Thread-Safety","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService"},{"type":"text","text":" uses "},{"type":"codeVoice","code":"NSLock"},{"type":"text","text":" for thread-safe access:"}]},{"type":"codeListing","code":["\/\/ Safe to call from any thread","DispatchQueue.global().async {","    AppState.shared.setLanguage(.german)","}"],"syntax":"swift"},{"type":"heading","text":"Performance Caching","anchor":"Performance-Caching","level":3},{"type":"paragraph","inlineContent":[{"text":"Translations are cached per language after first load:","type":"text"}]},{"type":"codeListing","code":["let text1 = service.string(for: .button(.ok))  \/\/ Loads and caches","let text2 = service.string(for: .button(.ok))  \/\/ Uses cache"],"syntax":"swift"},{"type":"heading","text":"JSON File Format","anchor":"JSON-File-Format","level":2},{"type":"heading","text":"Structure","anchor":"Structure","level":3},{"type":"codeListing","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"syntax":"json"},{"type":"heading","text":"Rules","anchor":"Rules","level":3},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineConten