{"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"title":"Related Documentation"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}]},{"text":"Key Features","anchor":"Key-Features","type":"heading","level":3},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"text":": Compile-time verified ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums with IDE autocomplete","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"5 languages built-in"}],"type":"strong"},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Persistent storage","type":"text"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Fallback chain"}],"type":"strong"},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Thread-safe","type":"text"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"JSON-based","type":"text"}]},{"type":"text","text":": Easy to extend with new strings and languages"}]}]}],"type":"unorderedList"},{"text":"Quick Start","anchor":"Quick-Start","type":"heading","level":2},{"text":"Display Localized Strings","anchor":"Display-Localized-Strings","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"LocalizedString"},{"type":"text","text":" to show localized text:"}]},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}]},{"syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"],"type":"codeListing"},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","type":"heading","level":3},{"syntax":"swift","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}]},{"text":"Supported Languages","anchor":"Supported-Languages","type":"heading","level":3},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"text":" - English","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".french"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"text":" - Español","type":"text"}]}]}],"type":"unorderedList"},{"text":"Type-Safe Keys","anchor":"Type-Safe-Keys","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"text":"Key Categories","anchor":"Key-Categories","type":"heading","level":3},{"text":"Button Keys","anchor":"Button-Keys","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing"},{"text":"Label Keys","anchor":"Label-Keys","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing"},{"text":"Error Keys","anchor":"Error-Keys","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}]},{"syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing"},{"text":"Placeholder Keys","anchor":"Placeholder-Keys","type":"heading","level":4},{"type":"paragraph","inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}]},{"syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing"},{"type":"heading","level":4,"text":"Menu Keys","anchor":"Menu-Keys"},{"type":"paragraph","inlineContent":[{"text":"8 menu strings: file, edit, view, help, new, open, save, exit","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"]},{"type":"heading","level":4,"text":"Dialog Keys","anchor":"Dialog-Keys"},{"type":"paragraph","inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"]},{"type":"heading","level":4,"text":"Validation Keys","anchor":"Validation-Keys"},{"type":"paragraph","inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"type":"heading","level":2,"text":"Using Localized Strings","anchor":"Using-Localized-Strings"},{"type":"heading","level":3,"text":"LocalizedString View","anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"type":"heading","level":3,"text":"Text View with Localization","anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"type":"heading","level":3,"text":"Direct Service Access","anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"heading","level":2,"text":"Language Switching","anchor":"Language-Switching"},{"type":"heading","level":3,"text":"Get Current Language","anchor":"Get-Current-Language"},{"type":"codeListing","syntax":"swift","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"type":"heading","level":3,"text":"Change Language","anchor":"Change-Language"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"type":"heading","level":3,"text":"Language Persistence","anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Linux","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}]},{"type":"heading","level":3,"text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not found, fall back to English","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"type":"heading","level":2,"text":"Environment Access","anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"text":" is available in the view environment:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}]},{"type":"heading","level":2,"text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}]},{"type":"heading","level":3,"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"type":"codeListing","syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","level":3,"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"en.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","level":3,"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","level":3,"text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" keys from other language files:"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","level":3,"text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"type":"codeListing","syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Design Principles","anchor":"Design-Principles"},{"type":"heading","level":3,"text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"type":"heading","level":3,"text":"Enum Categories","anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"validation.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Validation"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}]},{"type":"heading","level":3,"text":"Thread Safety","anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","isActive":true},{"type":"text","text":" uses "},{"type":"codeVoice","code":"NSLock"},{"type":"text","text":" for thread-safe access:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"]},{"type":"heading","level":3,"text":"Performance Caching","anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}]},{"type":"codeListing","syntax":"swift","code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"]},{"type":"heading","level":2,"text":"JSON File Format","anchor":"JSON-File-Format"},{"type":"heading","level":3,"text":"Structure","anchor":"Structure"},{"type":"codeListing","syntax":"json","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"]},{"type":"heading","level":3,"text":"Rules","anchor":"Rules"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flat structure"}]},{"type":"text","text":": No nested objects (all keys are top-level)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dot-separated keys"}],"type":"strong"},{"type":"text","text":": "},{"code":"\"button.ok\"","type":"codeVoice"},{"type":"text","text":", not nested objects"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UTF-8 encoding"}]},{"type":"text","text":": Required for non-Latin characters"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Valid JSON","type":"text"}],"type":"strong"},{"text":": No trailing commas, proper escaping","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Example","anchor":"Example"},{"type":"codeListing","syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"]},{"type":"heading","level":2,"text":"Best Practices","anchor":"Best-Practices"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Always use type-safe keys"}],"type":"strong"},{"text":": Use ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums instead of raw strings","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Keep keys organized"}],"type":"strong"},{"type":"text","text":": Group related strings by category"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Use descriptive names","type":"text"}],"type":"strong"},{"text":": Short, clear key names","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Run consistency tests"}]},{"type":"text","text":": Always verify after adding keys"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test all languages"}]},{"type":"text","text":": Check translations look correct in each language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Handle missing strings","type":"text"}]},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"TUIkit includes comprehensive localization tests:","type":"text"}]},{"type":"heading","level":3,"text":"LocalizationServiceTests","anchor":"Locali