Strings"},{"level":3,"anchor":"LocalizedString-View","type":"heading","text":"LocalizedString View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Text-View-with-Localization","type":"heading","text":"Text View with Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" initializer:"}]},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Direct-Service-Access","type":"heading","text":"Direct Service Access"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, read the runtime-owned service from the environment:"}]},{"code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Language-Switching","type":"heading","text":"Language Switching"},{"level":3,"anchor":"Get-Current-Language","type":"heading","text":"Get Current Language"},{"code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Change-Language","type":"heading","text":"Change Language"},{"code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"Language-Persistence","type":"heading","text":"Language Persistence"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}]},{"level":3,"anchor":"Fallback-Behavior","type":"heading","text":"Fallback Behavior"},{"type":"paragraph","inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"level":2,"anchor":"Environment-Access","type":"heading","text":"Environment Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}]},{"level":2,"anchor":"Adding-New-Keys","type":"heading","text":"Adding New Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"level":3,"anchor":"1-Update-LocalizationKey-Enum","type":"heading","text":"1. Update LocalizationKey Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"text":"3. Update Tests","anchor":"3-Update-Tests","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":