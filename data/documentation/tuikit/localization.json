{"metadata":{"title":"Localization","roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}]},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"title":"Related Documentation"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization"},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}]},{"level":3,"type":"heading","text":"Key Features","anchor":"Key-Features"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Type-safe keys","type":"text"}]},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Persistent storage","type":"text"}],"type":"strong"},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Fallback chain","type":"text"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Thread-safe","type":"text"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"JSON-based"}],"type":"strong"},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"text":"Quick Start","anchor":"Quick-Start","level":2,"type":"heading"},{"text":"Display Localized Strings","anchor":"Display-Localized-Strings","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"LocalizedString","type":"codeVoice"},{"type":"text","text":" to show localized text:"}],"type":"paragraph"},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"syntax":"swift","code":["Text(localized: .button(.save))"],"type":"codeListing"},{"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime","level":3,"type":"heading"},{"syntax":"swift","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"type":"codeListing"},{"text":"Supported Languages","anchor":"Supported-Languages","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"type":"text","text":" - Français"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Type-Safe Keys","anchor":"Type-Safe-Keys","level":2,"type":"heading"},{"inlineContent":[{"text":"All localized strings are available as ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support.","type":"text"}],"type":"paragraph"},{"text":"Key Categories","anchor":"Key-Categories","level":3,"type":"heading"},{"text":"Button Keys","anchor":"Button-Keys","level":4,"type":"heading"},{"inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing"},{"text":"Label Keys","anchor":"Label-Keys","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing"},{"text":"Error Keys","anchor":"Error-Keys","level":4,"type":"heading"},{"inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing"},{"text":"Placeholder Keys","anchor":"Placeholder-Keys","level":4,"type":"heading"},{"inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing"},{"text":"Menu Keys","anchor":"Menu-Keys","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing"},{"text":"Dialog Keys","anchor":"Dialog-Keys","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing"},{"text":"Validation Keys","anchor":"Validation-Keys","level":4,"type":"heading"},{"inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing"},{"text":"Using Localized Strings","anchor":"Using-Localized-Strings","level":2,"type":"heading"},{"text":"LocalizedString View","anchor":"LocalizedString-View","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"type":"codeListing"},{"text":"Text View with Localization","anchor":"Text-View-with-Localization","level":3,"type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"type":"codeListing"},{"text":"Direct Service Access","anchor":"Direct-Service-Access","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For advanced use cases, access the service directly:"}],"type":"paragraph"},{"syntax":"swift","code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"type":"codeListing"},{"text":"Language Switching","anchor":"Language-Switching","level":2,"type":"heading"},{"text":"Get Current Language","anchor":"Get-Current-Language","level":3,"type":"heading"},{"syntax":"swift","code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"type":"codeListing"},{"text":"Change Language","anchor":"Change-Language","level":3,"type":"heading"},{"syntax":"swift","code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"type":"codeListing"},{"text":"Language Persistence","anchor":"Language-Persistence","level":3,"type":"heading"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Linux","type":"text"}]},{"type":"text","text":": "},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}],"type":"paragraph"},{"text":"Fallback Behavior","anchor":"Fallback-Behavior","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}],"type":"paragraph"},{"text":"Environment Access","anchor":"Environment-Access","level":2,"type":"heading"},{"inlineContent":[{"code":"LocalizationService","type":"codeVoice"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"type":"codeListing"},{"text":"Adding New Keys","anchor":"Adding-New-Keys","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum","level":3,"type":"heading"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then add convenient extensions:"}],"type":"paragraph"},{"syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing"},{"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"3. Update Tests","anchor":"3-Update-Tests","level":3,"type":"heading"},{"inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing"},{"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"text":"Adding New Languages","anchor":"Adding-New-Languages","level":2,"type":"heading"},{"inlineContent":[{"text":"To add support for a new language:","type":"text"}],"type":"paragraph"},{"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing"},{"text":"2. Create Translation File","anchor":"2-Create-Translation-File","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" keys from other language files:"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing"},{"text":"3. Test the New Language","anchor":"3-Test-the-New-Language","level":3,"type":"heading"},{"syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"type":"codeListing"},{"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","level":3,"type":"heading"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"text":"Design Principles","anchor":"Design-Principles","level":2,"type":"heading"},{"text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}],"type":"paragraph"},{"syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing"},{"inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}],"type":"paragraph"},{"text":"Enum Categories","anchor":"Enum-Categories","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Error","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"validation.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Validation","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This provides type safety, IDE autocomplete, and compile-time verification."}],"type":"paragraph"},{"text":"Thread Safety","anchor":"Thread-Safety","level":3,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","isActive":true,"type":"reference"},{"text":" uses ","type":"text"},{"code":"NSLock","type":"codeVoice"},{"text":" for thread-safe access:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Safe to call from any thread","DispatchQueue.global().async {","    AppState.shared.setLanguage(.german)","}"],"type":"codeListing"},{"text":"Performance Caching","anchor":"Performance-Caching","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Translations are cached per language after first load:"}],"type":"paragraph"},{"syntax":"swift","code":["let text1 = service.string(for: .button(.ok))  \/\/ Loads and caches","let text2 = service.string(for: .button(.ok))  \/\/ Uses cache"],"type":"codeListing"},{"text":"JSON File Format","anchor":"JSON-File-Format","level":2,"type":"heading"},{"text":"Structure","anchor":"Structure","level":3,"type":"heading"},{"syntax":"json","code":["{","  \"category.key\": \"English