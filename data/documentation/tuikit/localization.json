zationKeys.swift"},{"type":"text","text":":"}]},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files","level":3},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"type":"text","text":":"}]},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"type":"heading","text":"3. Update Tests","anchor":"3-Update-Tests","level":3},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"type":"heading","text":"Adding New Languages","anchor":"Adding-New-Languages","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","text":"1. Update Language Enum","anchor":"1-Update-Language-Enum","level":3},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"2. Create Translation File","anchor":"2-Create-Translation-File","level":3},{"type":"paragraph","inlineContent":[{"ty