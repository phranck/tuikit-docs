[{"text":"Expected total key count","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run after any localization changes:"}]},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"type":"heading","text":"Troubleshooting","anchor":"Troubleshooting","level":2},{"type":"heading","text":"String Not Appearing","anchor":"String-Not-Appearing","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the key exists in "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enum"}]}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run consistency tests to verify"}]}]}]},{"type":"heading","text":"Wrong Language Showing","anchor":"Wrong-Language-Showing","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify language was set: "},{"type":"codeVoice","code":"AppState.shared.currentLanguage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Confirm language is supported (en, de, fr, it, es)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check translation file exists for that language","type":"text"}]}]}]},{"type":"heading","text":"JSON Syntax Errors","anchor":"JSON-Syntax-Errors","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"If translation files won’t load:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Validate JSON syntax","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Check for missing commas or quotes"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure UTF-8 encoding"}]}]},{"content":[{"inlin