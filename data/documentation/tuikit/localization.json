lInvalid, passwordTooShort, usernameTaken, fieldRequired"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"anchor":"Using-Localized-Strings","level":2,"text":"Using Localized Strings","type":"heading"},{"anchor":"LocalizedString-View","level":3,"text":"LocalizedString View","type":"heading"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"anchor":"Text-View-with-Localization","level":3,"text":"Text View with Localization","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"anchor":"Direct-Service-Access","level":3,"text":"Direct Service Access","type":"heading"},{"inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"anchor":"Language-Switching","level":2,"text":"Language Switching","type":"heading"},{"anchor":"Get-Current-Language","level":3,"text":"Get Current Language","type":"heading"},{"syntax":"swift","type":"codeListing","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"anchor":"Change-Language","level":3,"text":"Change Language","type":"heading"},{"syntax":"swift","type":"codeListing","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"anchor":"Language-Persistence","level":3,"text":"Language Persistence","type":"heading"},{"inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"anchor":"Fallback-Behavior","level":3,"text":"Fallback Behavior","type":"heading"},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Try to find the key in the active language","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not found, fall back to English","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"anchor":"Environment-Access","level":2,"text":"Environment Access","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}],"type":"paragraph"},{"anchor":"Adding-New-Keys","level":2,"text":"Adding New Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"anchor":"1-Update-LocalizationKey-Enum","level":3,"text":"1. Update LocalizationKey Enum","type":"heading"},{"inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"inlineContent":[{"type":"text","text":"Then add convenient extensions:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"anchor":"2-Add-to-All-Translation-Files","level":3,"text":"2. Add to All Translation Files","type":"heading"},{"inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"de.json","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"3-Update-Tests","level":3,"text":"3. Update Tests","type":"heading"},{"inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"anchor":"4-Run-Consistency-Tests","level":3,"text":"4. Run Consistency Tests","type":"heading"},{"inlineContent":[{"text":"Verify all keys exist in translation files:","type":"text"}],"type":"paragraph"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"anchor":"Adding-New-Languages","level":2,"text":"Adding New Languages","type":"heading"},{"inlineContent":[{"text":"To add support for a new language:","type":"text"}],"type":"paragraph"},{"anchor":"1-Update-Language-Enum","level":3,"text":"1. Update Language Enum","type":"heading"},{"inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"anchor":"2-Create-Translation-File","level":3,"text":"2. Create Translation File","type":"heading"},{"inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"anchor":"3-Test-the-New-Language","level":3,"text":"3. Test the New Language","type":"heading"},{"syntax":"swift","type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"anchor":"4-Run-Consistency-Tests","level":3,"text":"4. Run Consistency Tests","type":"heading"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"anchor":"Design-Principles","level":2,"text":"Design Principles","type":"heading"},{"anchor":"Dot-Notation-Keys","level":3,"text":"Dot-Notation Keys","type":"heading"},{"inlineContent":[{"text":"Keys use ","type":"text"},{"type":"codeVoice","code":"category.key_name"},{"text":" format:","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"]},{"inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}],"type":"paragraph"},{"anchor":"Enum-Categories","level":3,"text":"Enum Categories","type":"heading"},{"inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"button.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"validation.*"},{"type":"text","text":" keys → 