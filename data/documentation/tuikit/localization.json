t, clear key names","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Run consistency tests","type":"text"}],"type":"strong"},{"type":"text","text":": Always verify after adding keys"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Test all languages"}],"type":"strong"},{"text":": Check translations look correct in each language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Handle missing strings"}]},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit includes comprehensive localization tests:"}]},{"type":"heading","level":3,"text":"LocalizationServiceTests","anchor":"LocalizationServiceTests"},{"type":"paragraph","inlineContent":[{"text":"Core functionality tests covering:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Bundle loading for all languages"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"String resolution with dot-notation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Fallback behavior","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Thread safety"}]}]}]},{"type":"heading","level":3,"text":"LocalizationKeyConsistencyTests","anchor":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Validation tests ensuring:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Every enum key exists in all translation files","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"No extraneous keys in translation files","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Expected total key count"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run after any localization changes:"}]},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Troubleshooting","anchor":"Troubleshooting"},{"type":"heading","level":3,"text":"String Not Appearing","anchor":"String-Not-Appearing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the key exists in "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enum"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run consistency tests to verify"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Wrong Language Showing","anchor":"Wrong-Language-Showing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify language was set: "},{"type":"codeVoice","code":"AppState.shared.currentLanguage"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Confirm language is supported (en, de, fr, it, es)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Check translation file exists for that language"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"JSON Syntax Errors","anchor":"JSON-Syntax-Errors"},{"type":"paragraph","inlineContent":[{"text":"If translation files won’t load:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Validate JSON syntax","type":"text"}]}]},{"content":[{"type":