"","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Adding New Keys","type":"heading","anchor":"Adding-New-Keys"},{"inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}],"type":"paragraph"},{"level":3,"text":"1. Update LocalizationKey Enum","type":"heading","anchor":"1-Update-LocalizationKey-Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Then add convenient extensions:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift"},{"level":3,"text":"2. Add to All Translation Files","type":"heading","anchor":"2-Add-to-All-Translation-Files"},{"inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json"},{"inlineContent":[{"text":"Similar for ","type":"text"},{"code":"fr.json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"it.json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"es.json","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"3. Update Tests","type":"heading","anchor":"3-Update-Tests"},{"inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift"},{"level":3,"text":"4. Run Consistency Tests","type":"heading","anchor":"4-Run-Consistency-Tests"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"level":2,"text":"Adding New Languages","type":"heading","anchor":"Adding-New-Languages"},{"inlineContent":[{"text":"To add support for a new language:","type":"text"}],"type":"paragraph"},{"level":3,"text":"1. Update Language Enum","type":"heading","anchor":"1-Update-Language-Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationService.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift"},{"level":3,"text":"2. Create Translation File","type":"heading","anchor":"2-Create-Translation-File"},{"inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json"},{"level":3,"text":"3. Test the New Language","type":"heading","anchor":"3-Test-the-New-Language"},{"type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"syntax":"swift"},{"level":3,"text":"4. Run Consistency 