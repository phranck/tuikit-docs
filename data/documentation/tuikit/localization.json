text":"UTF-8 encoding"}]},{"type":"text","text":": Required for non-Latin characters"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Valid JSON"}]},{"text":": No trailing commas, proper escaping","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Example","level":3,"anchor":"Example"},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"]},{"type":"heading","text":"Best Practices","level":2,"anchor":"Best-Practices"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Always use type-safe keys","type":"text"}]},{"type":"text","text":": Use "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums instead of raw strings"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Keep keys organized"}],"type":"strong"},{"text":": Group related strings by category","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use descriptive names"}]},{"type":"text","text":": Short, clear key names"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Run consistency tests"}]},{"type":"text","text":": Always verify after adding keys"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Test all languages","type":"text"}]},{"type":"text","text":": Check translations look correct in each language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Handle missing strings","type":"text"}]},{"type":"text","text":": Rely on the fallback chain for incomplete t