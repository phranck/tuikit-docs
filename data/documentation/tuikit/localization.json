{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system.","type":"text"}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"title":"Related Documentation"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains.","type":"text"}]},{"type":"heading","anchor":"Key-Features","level":3,"text":"Key Features"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Type-safe keys"}],"type":"strong"},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"5 languages built-in"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Persistent storage"}],"type":"strong"},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Fallback chain"}],"type":"strong"},{"text":": Current language → English → key itself for graceful degradation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}]}]}]},{"type":"heading","anchor":"Quick-Start","level":2,"text":"Quick Start"},{"type":"heading","anchor":"Display-Localized-Strings","level":3,"text":"Display Localized Strings"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}]},{"type":"codeListing","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" convenience initializer:"}]},{"type":"codeListing","code":["Text(localized: LocalizationKey.Button.save)"],"syntax":"swift"},{"type":"heading","anchor":"Switch-Language-at-Runtime","level":3,"text":"Switch Language at Runtime"},{"code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}]},{"level":3,"anchor":"Supported-Languages","type":"heading","text":"Supported Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".english","type":"codeVoice"},{"text":" - English","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".german","type":"codeVoice"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"type":"text","text":" - Español"}],"type":"paragraph"}]}]},{"level":2,"anchor":"Type-Safe-Keys","type":"heading","text":"Type-Safe Keys"},{"type":"paragraph","inlineContent":[{"text":"All localized strings are available as ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support.","type":"text"}]},{"level":3,"anchor":"Key-Categories","type":"heading","text":"Key Categories"},{"level":4,"anchor":"Button-Keys","type":"heading","text":"Button Keys"},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing","syntax":"swift"},{"level":4,"anchor":"Label-Keys","type":"heading","text":"Label Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing","syntax":"swift"},{"level":4,"anchor":"Error-Keys","type":"heading","text":"Error Keys"},{"type":"paragraph","inlineContent":[{"tex