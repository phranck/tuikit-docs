{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"anchor":"Key-Features","level":3,"type":"heading","text":"Key Features"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type-safe keys"}]},{"type":"text","text":": Compile-time verified "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Persistent storage","type":"text"}]},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Quick Start","anchor":"Quick-Start"},{"level":3,"type":"heading","text":"Display Localized Strings","anchor":"Display-Localized-Strings"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"LocalizedString"},{"type":"text","text":" to show localized text:"}]},{"code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}]},{"code":["Text(localized: .button(.save))"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime"},{"code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Supported Languages","anchor":"Supported-Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"inlineContent":[{"code":".french","type":"codeVoice"},{"text":" - Français","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".italian"},{"text":" - Italiano","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}]}]}]},{"level":2,"type":"heading","text":"Type-Safe Keys","anchor":"Type-Safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"level":3,"type":"heading","text":"Key Categories","anchor":"Key-Categories"},{"level":4,"type":"heading","text":"Button Keys","anchor":"Button-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}]},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Label Keys","anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Error Keys","anchor":"Error-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}]},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Placeholder Keys","anchor":"Placeholder-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}]},{"code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Menu Keys","anchor":"Menu-Keys"},{"type":"paragraph","inlineContent":[{"text":"8 menu strings: file, edit, view, help, new, open, save, exit","type":"text"}]},{"code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Dialog Keys","anchor":"Dialog-Keys"},{"type":"paragraph","inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}]},{"code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing","syntax":"swift"},{"level":4,"type":"heading","text":"Validation Keys","anchor":"Validation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}]},{"code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Using Localized Strings","anchor":"Using-Localized-Strings"},{"level":3,"type":"heading","text":"LocalizedString View","anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}]},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Text View with Localization","anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Direct Service Access","anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, access the service directly:"}]},{"code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Language Switching","anchor":"Language-Switching"},{"level":3,"type":"heading","text":"Get Current Language","anchor":"Get-Current-Language"},{"code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Change Language","anchor":"Change-Language"},{"code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Language Persistence","anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"level":3,"type":"heading","text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Try to find the key in the active language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}]},{"level":2,"type":"heading","text":"Environment Access","anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}]},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}]},{"level":3,"type":"heading","text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"text":":","type":"text"}]},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"code":"fr.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"it.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"es.json","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"level":2,"type":"heading","text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"text":"To add support for a new language:","type":"text"}]},{"level":3,"type":"heading","text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing","syntax":"json"},{"level":3,"type":"heading","text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"level":2,"type":"heading","text":"Design Principles","anchor":"Design-Principles"},{"level":3,"type":"heading","text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}]},{"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"level":3,"type":"heading","text":"Enum Categories","anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Error","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"validation.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Validation","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}]},{"level":3,"type":"heading","text":"Thread Safety","anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference","isActive":true},{"type":"text","text":" uses "},{"code":"NSLock","type":"codeVoice"},{"type":"text","text":" for thread-safe access:"}]},{"code":["\/\/ Safe to call from any thread","DispatchQueue.global().async {","    AppState.shared.setLanguage(.german)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Performance Caching","anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"text":"Translations are cached per language after first load:","type":"text"}]},{"code":["let text1 = service.string(for: .button(.ok))  \/\/ Loads and caches","let text2 = service.string(for: .button(.ok))  \/\/ Uses cache"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"JSON File Format","anchor":"JSON-File-Format"},{"level":3,"type":"heading","text":"Structure","anchor":"Structure"},{"code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"type":"codeListing","syntax":"json"},{"level":3,"type":"heading","text":"Rules","anchor":"Rules"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Flat structure","type":"text"}],"type":"strong"},{"text":": No nested objects (all keys are top-level)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Dot-separated keys","type":"text"}]},{"type":"text","text":": "},{"code":"\"button.ok\"","type":"codeVoice"},{"type":"text","text":", not nested objects"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"UTF-8 encoding","type":"text"}],"type":"strong"},{"type":"text","text":": Required for non-Latin characters"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Valid JSON","type":"text"}],"type":"strong"},{"text":": No trailing commas, proper escaping","type":"text"}]}]}]},{"level":3,"type":"heading","text":"Example","anchor":"Example"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"type":"codeListing","syntax":"json"},{"level":2,"type":"heading","text":"Best Practices","anchor":"Best-Practices"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Always use type-safe keys"}]},{"text":": Use ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums instead of raw strings","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Keep keys organized"}]},{"type":"text","text":": Group related strings by category"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Use descriptive names","type":"text"}],"type":"strong"},{"text":": Short, clear key names","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Run consistency tests"}]},{"type":"text","text":": Always verify after adding keys"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Test all languages","type":"text"}],"type":"strong"},{"text":": Check translations look correct in each language","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Handle missing strings","type":"text"}],"type":"strong"},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit includes comprehensive localization tests:"}]},{"level":3,"type":"heading","text":"LocalizationServiceTests","anchor":"LocalizationServiceTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core functionality tests covering:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle loading for all languages"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"String resolution with dot-notation","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Fallback behavior","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Persistence to disk"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Thread safety","type":"text"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"LocalizationKeyConsistencyTests","anchor":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Validation tests ensuring:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every enum key exists in all translation files"}]}]},{"content":[{"inlineContent":[{"text":"No extraneous keys in translation files","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Expected total key count","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run after any localization changes:"}]},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing","syntax":"bash"},{"level":2,"type":"heading","text":"Troubleshooting","anchor":"Troubleshooting"},{"level":3,"type":"heading","text":"String Not Appearing","anchor":"String-Not-Appearing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify the key exists in "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enum"}]}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run consistency tests to verify"}]}]}]},{"level":3,"type":"heading","text":"Wrong Language Showing","anchor":"Wrong-Language-Showing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify language was set: ","type":"text"},{"code":"AppState.shared.currentLanguage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Confirm language is supported (en, de, fr, it, es)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check translation file exists for that language"}]}]}]},{"level":3,"type":"heading","text":"JSON Syntax Errors","anchor":"JSON-Syntax-Errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If translation files won’t load:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Validate JSON syntax","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Check for missing commas or quotes"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure UTF-8 encoding"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No trailing commas in objects"}]}]}]}],"kind":"content"}],"kind":"article","metadata":{"title":"Localization","modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article"},"abstract":[{"text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"paths":["\/documentation\/tuikit\/localization"],"traits":[{"interfaceLanguage":"swift"}]}