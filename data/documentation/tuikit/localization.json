ng"},{"text":": No trailing commas, proper escaping","type":"text"}]}]}],"type":"orderedList"},{"level":3,"text":"Example","anchor":"Example","type":"heading"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"syntax":"json","type":"codeListing"},{"level":2,"text":"Best Practices","anchor":"Best-Practices","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Always use type-safe keys","type":"text"}],"type":"strong"},{"text":": Use ","type":"text"},{"code":"LocalizationKey","type":"codeVoice"},{"text":" enums instead of raw strings","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Keep keys organized"}],"type":"strong"},{"text":": Group related strings by category","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Use descriptive names","type":"text"}]},{"type":"text","text":": Short, clear key names"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Run consistency tests","type":"text"}]},{"text":": Always verify after adding keys","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test all languages"}]},{"text":": Check translations look correct in each language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Handle missing strings","type":"text"}],"type":"strong"},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit includes comprehensive localization tests:"}],"type":"paragraph"},{"leve