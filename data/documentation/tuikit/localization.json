LocalizedString-View"},{"inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"]},{"type":"heading","level":3,"text":"Text View with Localization","anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"]},{"type":"heading","level":3,"text":"Direct Service Access","anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, access the service directly:"}]},{"type":"codeListing","syntax":"swift","code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"]},{"type":"heading","level":2,"text":"Language Switching","anchor":"Language-Switching"},{"type":"heading","level":3,"text":"Get Current Language","anchor":"Get-Current-Language"},{"type":"codeListing","syntax":"swift","code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."]},{"type":"heading","level":3,"text":"Change Language","anchor":"Change-Language"},{"type":"codeListing","syntax":"swift","code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"]},{"type":"heading","level":3,"text":"Language Persistence","anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Linux","type":"text"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}]},{"type":"heading","level":3,"text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Try to find the key in the active language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If not found, fall back to English","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"type":"heading","level":2,"text":"Environment Access","anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"]},{"type":"heading","level":2,"text":"Adding New Keys","anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"type":"heading","level":3,"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"type":"codeListing","syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","level":3,"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"text":"Similar for ","type":"text"},{"type":"codeVoice","code":"fr.json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"it.json"},{"text":", ","type":"text"},{"type":"codeVoice","code":"es.json"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"3. Update Tests","anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"text":"Verify all keys exist in translation files:","type":"text"}]},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Adding New Languages","anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"type":"heading","level":3,"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","level":3,"text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"text":"all","type":"text"}]},{"type":"text","text":" keys from other language files:"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","level":3,"text":"3. Test the New Language","anchor":"3-Test-the-New-Language"},{"type":"codeListing","syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Design Principles","anchor":"Design-Principles"},{"type":"heading","level":3,"text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"type":"codeListing","syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"type":"heading","level":3,"text":"Enum Categories","anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix be