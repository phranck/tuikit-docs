ype":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Persistence to disk"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Thread safety","type":"text"}]}]}],"type":"unorderedList"},{"text":"LocalizationKeyConsistencyTests","type":"heading","level":3,"anchor":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"text":"Validation tests ensuring:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Every enum key exists in all translation files","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"No extraneous keys in translation files","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expected total key count"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Run after any localization changes:","type":"text"}]},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"text":"Troubleshooting","type":"heading","level":2,"anchor":"Troubleshooting"},{"text":"String Not Appearing","type":"heading","level":3,"anchor":"String-Not-Appearing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the key exists in "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enum"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run consistency tests to verify","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Wrong Language Showing","type":"heading","level":3,"anchor":"Wrong-Language-Showing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"code":"@Environment(\\.currentLanguage)","type":"codeVoice"},{"text":" reports the expected language","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Confirm language is supported (en, de, fr, it, es)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check translation file exists for that language"}]}]}],"type":"unorderedList"},{"text":"JSON Syntax Errors","type":"heading","level":3,"anchor":"JSON-Syntax-Errors"},{"type":"paragraph","inlineContent":[{"text":"If translation files won’t load:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Validate JSON syntax","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check for missing commas or quotes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure UTF-8 encoding"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No trailing commas in objects"}]}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}],"title":"Localization"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"],"title":"Related Documentation"}],"abstract":[{"type":"text","text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/LocalizationService":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"LocalizationService"}],"url":"\/documenta