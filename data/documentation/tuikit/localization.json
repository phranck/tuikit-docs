\/Localization\/translations\/pt.json"},{"text":" with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"text":" keys from other language files:","type":"text"}]},{"syntax":"json","type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"type":"heading","text":"3. Test the New Language","anchor":"3-Test-the-New-Language","level":3},{"syntax":"swift","type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"]},{"type":"heading","text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests","level":3},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","text":"Design Principles","anchor":"Design-Principles","level":2},{"type":"heading","text":"Dot-Notation Keys","anchor":"Dot-Notation-Keys","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"syntax":null,"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"type":"heading","text":"Enum Categories","anchor":"Enum-Categories","level":3},{"type":"paragraph","inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"Loc