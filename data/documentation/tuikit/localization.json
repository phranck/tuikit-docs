d string as a View component:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"syntax":"swift"},{"level":3,"text":"Text View with Localization","type":"heading","anchor":"Text-View-with-Localization"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"type":"codeListing","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"syntax":"swift"},{"level":3,"text":"Direct Service Access","type":"heading","anchor":"Direct-Service-Access"},{"inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift"},{"level":2,"text":"Language Switching","type":"heading","anchor":"Language-Switching"},{"level":3,"text":"Get Current Language","type":"heading","anchor":"Get-Current-Language"},{"type":"codeListing","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"syntax":"swift"},{"level":3,"text":"Change Language","type":"heading","anchor":"Change-Language"},{"type":"codeListing","code":["@Environment(\\.localizationService) 