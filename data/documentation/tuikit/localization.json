{"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"]}],"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"title":"Localization","role":"article"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}]},{"text":"Key Features","type":"heading","level":3,"anchor":"Key-Features"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Type-safe keys","type":"text"}],"type":"strong"},{"type":"text","text":": Compile-time verified "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums with IDE autocomplete"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"5 languages built-in","type":"text"}],"type":"strong"},{"text":": EN, DE, FR, IT, ES with complete translations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Persistent storage"}]},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"text":": Safe language switching from any thread at runtime","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"text":": Easy to extend with new strings and languages","type":"text"}]}]}]},{"text":"Quick Start","type":"heading","level":2,"anchor":"Quick-Start"},{"text":"Display Localized Strings","type":"heading","level":3,"anchor":"Display-Localized-Strings"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" convenience initializer:"}]},{"type":"codeListing","syntax":"swift","code":["Text(localized: LocalizationKey.Button.save)"]},{"text":"Switch Language at Runtime","type":"heading","level":3,"anchor":"Switch-Language-at-Runtime"},{"type":"codeListing","syntax":"swift","code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}]},{"type":"heading","anchor":"Supported-Languages","text":"Supported Languages","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Type-Safe-Keys","text":"Type-Safe Keys","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"type":"heading","anchor":"Key-Categories","text":"Key Categories","level":3},{"type":"heading","anchor":"Button-Keys","text":"Button Keys","level":4},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"]},{"text":"Label Keys","type":"heading","level":4,"anchor":"Label-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"]},{"text":"Error Keys","type":"heading","level":4,"anchor":"Error-Keys"},{"type":"paragraph","inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"]},{"text":"Placeholder Keys","type":"heading","level":4,"anchor":"Placeholder-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"]},{"text":"Menu Keys","type":"heading","level":4,"anchor":"Menu-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"]},{"text":"Dialog Keys","type":"heading","level":4,"anchor":"Dialog-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"]},{"text":"Validation Keys","type":"heading","level":4,"anchor":"Validation-Keys"},{"type":"paragraph","inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"]},{"text":"Using Localized Strings","type":"heading","level":2,"anchor":"Using-Localized-Strings"},{"text":"LocalizedString View","type":"heading","level":3,"anchor":"LocalizedString-View"},{"type":"paragraph","inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"]},{"text":"Text View with Localization","type":"heading","level":3,"anchor":"Text-View-with-Localization"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"]},{"text":"Direct Service Access","type":"heading","level":3,"anchor":"Direct-Service-Access"},{"type":"paragraph","inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"text":"Language Switching","type":"heading","level":2,"anchor":"Language-Switching"},{"text":"Get Current Language","type":"heading","level":3,"anchor":"Get-Current-Language"},{"type":"codeListing","syntax":"swift","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"]},{"text":"Change Language","type":"heading","level":3,"anchor":"Change-Language"},{"type":"codeListing","syntax":"swift","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"]},{"text":"Language Persistence","type":"heading","level":3,"anchor":"Language-Persistence"},{"type":"paragraph","inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"text":"Fallback Behavior","type":"heading","level":3,"anchor":"Fallback-Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Try to find the key in the active language"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"text":"Environment Access","type":"heading","level":2,"anchor":"Environment-Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizationService.shared"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.shared"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}]},{"text":"Adding New Keys","type":"heading","level":2,"anchor":"Adding-New-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"text":"1. Update LocalizationKey Enum","type":"heading","level":3,"anchor":"1-Update-LocalizationKey-Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Then add convenient extensions:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"text":"2. Add to All Translation Files","type":"heading","level":3,"anchor":"2-Add-to-All-Translation-Files"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"de.json","type":"text"}]},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"type":"paragraph","inlineContent":[{"text":"Similar for ","type":"text"},{"code":"fr.json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"it.json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"es.json","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"3. Update Tests","type":"heading","level":3,"anchor":"3-Update-Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"text":"4. Run Consistency Tests","type":"heading","level":3,"anchor":"4-Run-Consistency-Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Adding New Languages","type":"heading","level":2,"anchor":"Adding-New-Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"text":"1. Update Language Enum","type":"heading","level":3,"anchor":"1-Update-Language-Enum"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"text":"2. Create Translation File","type":"heading","level":3,"anchor":"2-Create-Translation-File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"]},{"text":"3. Test the New Language","type":"heading","level":3,"anchor":"3-Test-the-New-Language"},{"type":"codeListing","syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"]},{"text":"4. Run Consistency Tests","type":"heading","level":3,"anchor":"4-Run-Consistency-Tests"},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Design Principles","type":"heading","level":2,"anchor":"Design-Principles"},{"text":"Dot-Notation Keys","type":"heading","level":3,"anchor":"Dot-Notation-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"type":"codeListing","syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"text":"Enum Categories","type":"heading","level":3,"anchor":"Enum-Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"error.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Error","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"validation.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Validation"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}]},{"text":"Thread Safety","type":"heading","level":3,"anchor":"Thread-Safety"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference","isActive":true},{"type":"text","text":" uses "},{"type":"codeVoice","code":"NSLock"},{"type":"text","text":" for thread-safe access:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"]},{"text":"Performance Caching","type":"heading","level":3,"anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"text":"Translations are cached per language after first load:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"]},{"text":"JSON File Format","type":"heading","level":2,"anchor":"JSON-File-Format"},{"text":"Structure","type":"heading","level":3,"anchor":"Structure"},{"type":"codeListing","syntax":"json","code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"]},{"text":"Rules","type":"heading","level":3,"anchor":"Rules"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flat structure"}]},{"type":"text","text":": No nested objects (all keys are top-level)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Dot-separated keys","type":"text"}]},{"type":"text","text":": "},{"code":"\"button.ok\"","type":"codeVoice"},{"type":"text","text":", not nested objects"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"UTF-8 encoding"}],"type":"strong"},{"text":": Required for non-Latin characters","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Valid JSON"}]},{"type":"text","text":": No trailing commas, proper escaping"}],"type":"paragraph"}]}]},{"text":"Example","ty