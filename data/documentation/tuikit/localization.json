xt":"Fallback chain"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"text":": Safe language switching from any thread at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"JSON-based"}],"type":"strong"},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Quick Start","anchor":"Quick-Start"},{"type":"heading","level":3,"text":"Display Localized Strings","anchor":"Display-Localized-Strings"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"LocalizedString"},{"text":" to show localized text:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(.button(.ok))","    LocalizedString(.error(.notFound))","    LocalizedString(.dialog(.confirm))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the "},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" convenience initializer:"}]},{"type":"codeListing","syntax":"swift","code":["Text(localized: .button(.save))"]},{"type":"heading","level":3,"text":"Switch Language at Runtime","anchor":"Switch-Language-at-Runtime"},{"syntax":"swift","code":["AppState.shared.setLanguage(.german)","\/\/ UI automatically re-renders with German strings"],"type":"codeListing"},{"anchor":"Supported-Languages","text":"Supported Languages","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".english","type":"codeVoice"},{"text":" - English","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"type":"text","text":" - Deutsch"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Type-Safe-Keys","text":"Type-Safe Keys","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"anchor":"Key-Categories","text":"Key Categories","level":3,"type":"heading"},{"anchor":"Button-Keys","text":"Button Keys","level":4,"type":"heading"},{"inlineContent":[{"type":"text","text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh"}],"type":"paragraph"},{"syntax":"swift","code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing"},{"anchor":"Label-Keys","text":"Label Keys","level":4,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Error-Keys","text":"Error Keys"},{"type":"paragraph","inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Placeholder-Keys","text":"Placeholder Keys"},{"type":"paragraph","inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Menu-Keys","text":"Menu Keys"},{"type":"paragraph","inlineContent":[{"text":"8 menu strings: file, edit, view, help, new, open, save, exit","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Dialog-Keys","text":"Dialog Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}]},{"type":"codeListing","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"syntax":"swift"},{"level":4,"type":"heading","anchor":"Validation-Keys","text":"Validation Keys"},{"type":"paragraph","inlineContent":[{"text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired","type":"text"}]},{"type":"codeListing","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Using-Localized-Strings","text":"Using Localized Strings"},{"level":3,"type":"heading","anchor":"LocalizedString-View","text":"LocalizedString View"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}]},{"type