t":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}],"type":"paragraph"},{"level":3,"anchor":"Fallback-Behavior","text":"Fallback Behavior","type":"heading"},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Try to find the key in the active language","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If not found, fall back to English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"level":2,"anchor":"Environment-Access","text":"Environment Access","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Adding-New-Keys","text":"Adding New Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"level":3,"anchor":"1-Update-LocalizationKey-Enum","text":"1. Update LocalizationKey Enum","type":"heading"},{"inlineContent":[{"text":"Edit ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then add convenient extensions:"}],"type":"paragraph"},{"syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing"},{"level":3,"anchor":"2-Add-to-All-Translation-Files","text":"2. Add to All Translation Files","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"en.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Similar for "},{"code":"fr.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"it.json","type":"codeVoice"},{"type":"text","text":", "},{"code":"es.json","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"3-Update-Tests","text":"3. Update Tests","type":"heading"},{"inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing"},{"level":3,"anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests","type":"heading"},{"inlineContent":[{"text":"Verify all keys exist in translation files:","type":"text"}],"type":"paragraph"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"level":2,"anchor":"Adding-New-Languages","text":"Adding New Languages","type":"heading"},{"inlineContent":[{"type":"text","text":"To add support for a new language:"}],"type":"paragraph"},{"level":3,"anchor":"1-Update-Language-Enum","text":"1. Update Language Enum","type":"heading"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing"},{"level":3,"anchor":"2-Create-Translation-File","text":"2. Create Translation File","type":"heading"},{"inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"text":"all","type":"text"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing"},{"level":3,"anchor":"3-Test-the-New-Language","text":"3. Test the New Language","type":"heading"},{"syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"type":"codeListing"},{"level":3,"anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests","type":"heading"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"level":2,"anchor":"Design-Principles","text":"Design Principles","type":"heading"},{"level":3,"anchor":"Dot-Notation-Keys","text":"Dot-Notation Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}],"type":"paragraph"},{"syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing"},{"inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Enum-Categories","text":"Enum Categories","type":"heading"},{"inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"cod