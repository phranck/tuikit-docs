":"paragraph"},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(.button(.save))","            LocalizedString(.error(.invalidInput))","            LocalizedString(.validation(.emailInvalid))","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Text-View-with-Localization","text":"Text View with Localization","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"Text(localized:)"},{"type":"text","text":" initializer:"}],"type":"paragraph"},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Direct-Service-Access","text":"Direct Service Access","type":"heading"},{"inlineContent":[{"type":"text","text":"For advanced use cases, access the service directly:"}],"type":"paragraph"},{"code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Language-Switching","text":"Language Switching","type":"heading"},{"level":3,"anchor":"Get-Current-Language","text":"Get Current Language","type":"heading"},{"code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Change-Language","text":"Change Language","type":"heading"},{"code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Language-Persistence","text":"Language Persistence","type":"heading"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"items":