{"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"role":"article","title":"Localization"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"anchor":"Key-Features","level":3,"text":"Key Features","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type-safe keys"}]},{"type":"text","text":": Compile-time verified "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enums with IDE autocomplete"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"5 languages built-in"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Persistent storage","type":"text"}],"type":"strong"},{"text":": Language preference automatically saved and restored (XDG-compatible paths)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Fallback chain","type":"text"}]},{"type":"text","text":": Current language → English → key itself for graceful degradation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Thread-safe"}],"type":"strong"},{"text":": Safe language switching from any thread at runtime","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Quick-Start","level":2,"text":"Quick Start","type":"heading"},{"anchor":"Display-Localized-Strings","level":3,"text":"Display Localized Strings","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"LocalizedString"},{"type":"text","text":" to show localized text:"}],"type":"paragraph"},{"syntax":"swift","code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Or use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"type":"text","text":" convenience initializer:"}],"type":"paragraph"},{"code":["Text(localized: LocalizationKey.Button.save)"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Switch-Language-at-Runtime","text":"Switch Language at Runtime"},{"code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Supported-Languages","text":"Supported Languages"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".german"},{"text":" - Deutsch","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"text":" - Français","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".italian"},{"type":"text","text":" - Italiano"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".spanish"},{"type":"text","text":" - Español"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"Type-Safe-Keys","text":"Type-Safe Keys"},{"inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Key-Categories","text":"Key Categories"},{"level":4,"type":"heading","anchor":"Button-Keys","text":"Button Keys"},{"inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Label-Keys","text":"Label Keys"},{"inlineContent":[{"text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Error-Keys","text":"Error Keys"},{"inlineContent":[{"type":"text","text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied"}],"type":"paragraph"},{"code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Placeholder-Keys","text":"Placeholder Keys"},{"inlineContent":[{"text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Menu-Keys","text":"Menu Keys"},{"inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}],"type":"paragraph"},{"code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Dialog-Keys","text":"Dialog Keys"},{"inlineContent":[{"text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error","type":"text"}],"type":"paragraph"},{"code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"syntax":"swift","type":"codeListing"},{"level":4,"type":"heading","anchor":"Validation-Keys","text":"Validation Keys"},{"inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}],"type":"paragraph"},{"code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"Using-Localized-Strings","text":"Using Localized Strings"},{"level":3,"type":"heading","anchor":"LocalizedString-View","text":"LocalizedString View"},{"inlineContent":[{"type":"text","text":"Display a localized string as a View component:"}],"type":"paragraph"},{"code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Text-View-with-Localization","text":"Text View with Localization"},{"inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}],"type":"paragraph"},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Direct-Service-Access","text":"Direct Service Access"},{"inlineContent":[{"text":"For advanced use cases, read the runtime-owned service from the environment:","type":"text"}],"type":"paragraph"},{"code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"Language-Switching","text":"Language Switching"},{"level":3,"type":"heading","anchor":"Get-Current-Language","text":"Get Current Language"},{"code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Change-Language","text":"Change Language"},{"code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Language-Persistence","text":"Language Persistence"},{"inlineContent":[{"text":"Language preferences are automatically saved to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Fallback-Behavior","text":"Fallback Behavior"},{"inlineContent":[{"text":"String resolution uses a fallback chain:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Try to find the key in the active language","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Environment-Access","text":"Environment Access"},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each application runtime owns its localization service. The former","type":"text"},{"text":" ","type":"text"},{"code":"LocalizationService.shared","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.shared","type":"codeVoice"},{"text":" accessors are no longer","type":"text"},{"text":" ","type":"text"},{"text":"available. Reading the service from ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" also ensures that a language","type":"text"},{"text":" ","type":"text"},{"text":"change invalidates the correct application when multiple runtimes share a process.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Adding-New-Keys","text":"Adding New Keys"},{"inlineContent":[{"text":"To add new localized strings to the framework:","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"1-Update-LocalizationKey-Enum","text":"1. Update LocalizationKey Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then add convenient extensions:"}],"type":"paragraph"},{"code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"2-Add-to-All-Translation-Files","text":"2. Add to All Translation Files"},{"inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"en.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"3-Update-Tests","text":"3. Update Tests"},{"inlineContent":[{"text":"Add tests in ","type":"text"},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"type":"heading","anchor":"Adding-New-Languages","text":"Adding New Languages"},{"inlineContent":[{"type":"text","text":"To add support for a new language:"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"1-Update-Language-Enum","text":"1. Update Language Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"2-Create-Translation-File","text":"2. Create Translation File"},{"inlineContent":[{"text":"Create ","type":"text"},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"text":" with ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"text":" keys from other language files:","type":"text"}],"type":"paragraph"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json","type":"codeListing"},{"level":3,"type":"heading","anchor":"3-Test-the-New-Language","text":"3. Test the New Language"},{"code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"type":"heading","anchor":"Design-Principles","text":"Design Principles"},{"level":3,"type":"heading","anchor":"Dot-Notation-Keys","text":"Dot-Notation Keys"},{"inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}],"type":"paragraph"},{"code":["button.ok","error.not_found","validation.email_invalid"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Enum-Categories","text":"Enum Categories"},{"inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"button.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Button"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"error.*"},{"type":"text","text":" keys → "},{"type":"codeVoice","code":"LocalizationKey.Error"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"validation.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Validation","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"Thread-Safety","text":"Thread Safety"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","type":"reference"},{"type":"text","text":" uses "},{"code":"NSLock","type":"codeVoice"},{"type":"text","text":" for thread-safe access:"}],"type":"paragraph"},{"code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"type":"heading","anchor":"Performance-Caching","text":"Performance Caching"},{"inlineContent":[{"text":"Translations are cached per language after first load:","type":"text"}],"type":"paragraph"},{"code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","anchor":"JSON-File-Format","text":"JSON File Format"},{"level":3,"type":"heading","anchor":"Structure","text":"Structure"},{"code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"syntax":"json","type":"codeListing"},{"level":3,"type":"heading","anchor":"Rules","text":"Rules"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Flat structure"}],"type":"strong"},{"type":"text","text":": No nested objects (all keys are top-level)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Dot-separated keys"}],"type":"strong"},{"text":": ","type":"text"},{"code":"\"button.ok\"","type":"codeVoice"},{"text":", not nested objects","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"UTF-8 encoding","type":"text"}]},{"text":": Required for non-Latin characters","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Valid JSON"}]},{"type":"text","text":": No trailing commas, proper escaping"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"type":"heading","anchor":"Example","text":"Example"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"syntax":"json","type":"codeListing"},{"level":2,"type":"heading","anchor":"Best-Practices","text":"Best Practices"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Always use type-safe keys"}]},{"type":"text","text":": Use "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums instead of raw strings"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Keep keys organized"}],"type":"strong"},{"text":": Group related strings by category","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Use descriptive names"}]},{"type":"text","text":": Short, clear key names"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Run consistency tests"}],"type":"strong"},{"type":"text","text":": Always verify after adding keys"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Test all languages"}]},{"text":": Check translations look correct in each language","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Handle missing strings"}]},{"text":": Rely on the fallback chain for incomplete translations","type":"text"}]}]}],"type":"orderedList"},{"level":2,"type":"heading","anchor":"Testing","text":"Testing"},{"inlineContent":[{"text":"TUIkit includes comprehensive localization tests:","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"LocalizationServiceTests","text":"LocalizationServiceTests"},{"inlineContent":[{"type":"text","text":"Core functionality tests covering:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle loading for all languages"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution with dot-notation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Fallback behavior","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Language switching","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Thread safety"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","anchor":"LocalizationKeyConsistencyTests","text":"LocalizationKeyConsistencyTests"},{"inlineContent":[{"type":"text","text":"Validation tests ensuring:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Every enum key exists in all translation files"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"No extraneous keys in translation files"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Expected total key count"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Run after any localization changes:"}],"type":"paragraph"},{"code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash","type":"codeListing"},{"level":2,"type":"heading","anchor":"Troubleshooting","text":"Troubleshooting"},{"level":3,"type":"heading","anchor":"String-Not-Appearing","text":"String Not Appearing"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Verify the key exists in "},{"code":"LocalizationKey","type":"codeVoice"},{"type":"text","text":" enum"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Run consistency tests to verify"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","anc