lineContent":[{"type":"text","text":"Core functionality tests covering:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Bundle loading for all languages"}]}]},{"content":[{"inlineContent":[{"text":"String resolution with dot-notation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Fallback behavior"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Language switching"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Persistence to disk"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Thread safety"}],"type":"paragraph"}]}]},{"text":"LocalizationKeyConsistencyTests","type":"heading","level":3,"anchor":"LocalizationKeyConsistencyTests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Validation tests ensuring:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every enum key exists in all translation files"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"No extraneous keys in translation files"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Expected total key count"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Run after any localization changes:","type":"text"}]},{"type":"codeListing","syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"text":"Troubleshooting","type":"heading","level":2,"anchor":"Troubleshooting"},{"text":"String Not Appearing","type":"heading","level":3,"anchor":"String-Not-Appearing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Verify the key exists in ","type":"text"},{"type":"codeVoice","code":"LocalizationKey"},{"text":" enum","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check the key is in all translation JSON files","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run consistency tests to verify","type":"text"}]}]}]},{"text":"Wrong Language Showing","type":"heading","level":3,"anchor":"Wrong-Language-Showing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Verify ","type":"text"},{"code":"@Environment(\\.currentLanguage)","type":"codeVoice"},{"text":" reports the expected language","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Confirm language is supported (en, de, fr, it, es)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Check translation file exists for that language","type":"text"}],"type":"paragraph"}]}]},{"text":"JSON Syntax Errors","type":"heading","level":3,"anchor":"JSON-Syntax-Errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If translation files won’t load:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Validate JSON syntax"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Check for missing commas or quotes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ensure UTF-8 encoding"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"No trailing commas in objects"}],"type":"paragraph"}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Build multilingual terminal applications with TUIkit’s comprehensive internationalization system."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/localization"]}],"references":{"doc://TUIkit/documentation/TUIkit/Architecture":{"type":"topic","title":"Architecture","abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"role":"articl