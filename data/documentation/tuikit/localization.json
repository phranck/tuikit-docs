":"codeListing"},{"level":3,"type":"heading","text":"Performance Caching","anchor":"Performance-Caching"},{"type":"paragraph","inlineContent":[{"text":"Translations are cached per language after first load:","type":"text"}]},{"code":["let text1 = service.string(for: LocalizationKey.Button.ok)  \/\/ Loads and caches","let text2 = service.string(for: LocalizationKey.Button.ok)  \/\/ Uses cache"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"JSON File Format","anchor":"JSON-File-Format"},{"level":3,"type":"heading","text":"Structure","anchor":"Structure"},{"code":["{","  \"category.key\": \"English text\",","  \"category.another_key\": \"More text\",","  ...","}"],"syntax":"json","type":"codeListing"},{"level":3,"type":"heading","text":"Rules","anchor":"Rules"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Flat structure","type":"text"}],"type":"strong"},{"type":"text","text":": No nested objects (all keys are top-level)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Dot-separated keys","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"\"button.ok\"","type":"codeVoice"},{"text":", not nested objects","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"UTF-8 encoding"}]},{"type":"text","text":": Required for non-Latin characters"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Valid JSON","type":"text"}]},{"type":"text","text":": No trailing commas, proper escaping"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"type":"heading","text":"Example","anchor":"Example"},{"code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancel\",","  \"error.not_found\": \"Not found\",","  \"error.unicode_test\": \"Unicode: café, Ñoño, 日本語\",","  \"placeholder.enter_name\": \"Enter name...\"","}"],"syntax":"json","type":"codeListing"},{"level":2