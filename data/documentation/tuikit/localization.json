t":[{"inlineContent":[{"inlineContent":[{"text":"Linux","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The saved preference is restored when the app restarts.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"Fallback Behavior","anchor":"Fallback-Behavior"},{"inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If not found, fall back to English","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"If still not found, return the key itself as-is"}]}]}]},{"inlineContent":[{"type":"text","text":"This ensures the UI always has something to display, even with incomplete translations."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Environment Access","anchor":"Environment-Access"},{"inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"text":" is available in the view environment:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"]},{"type":"heading","level":2,"text":"Adding New Keys","anchor":"Adding-New-Keys"},{"inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}],"type":"paragraph"},{"type":"heading","level":3,"text":"1. Update LocalizationKey Enum","anchor":"1-Update-LocalizationKey-Enum"},{"inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"]},{"inlineContent":[{"text":"Then add convenient extensions:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"]},{"type":"heading","level":3,"text":"2. Add to All Translation Files","anchor":"2-Add-to-All-Translation-Files"},{"inlineContent":[{"type":"text","text":"Add the same key to all 5 translation JSON files:"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"en.json"}],"type":"strong"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"de.json"}]},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"]},{"inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":3,"text":"3. Update Tests","anchor":"3-Update-Tests"},{"inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"]},{"type":"heading","level":3,"text":"4. Run Consistency Tests","anchor":"4-Run-Consistency-Tests"},{"inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}],"type":"paragraph"},{"syntax":"bash","type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"]},{"type":"heading","level":2,"text":"Adding New Languages","anchor":"Adding-New-Languages"},{"inlineContent":[{"type":"text","text":"To add support for a new language:"}],"type":"paragraph"},{"type":"heading","level":3,"text":"1. Update Language Enum","anchor":"1-Update-Language-Enum"},{"inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"]},{"type":"heading","level":3,"text":"2. Create Translation File","anchor":"2-Create-Translation-File"},{"inlineContent":[{"text":"Create ","type":"text"},{"type":"codeVoice","code":"