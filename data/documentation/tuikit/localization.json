{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Localization","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"TUIkit provides built-in support for 5 languages: English, German, French, Italian, and Spanish. All framework strings use a type-safe, dot-notation based localization system with persistent language preferences and automatic fallback chains."}],"type":"paragraph"},{"text":"Key Features","type":"heading","anchor":"Key-Features","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Type-safe keys"}]},{"type":"text","text":": Compile-time verified "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums with IDE autocomplete"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"5 languages built-in","type":"text"}]},{"type":"text","text":": EN, DE, FR, IT, ES with complete translations"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Persistent storage","type":"text"}]},{"type":"text","text":": Language preference automatically saved and restored (XDG-compatible paths)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Fallback chain","type":"text"}],"type":"strong"},{"text":": Current language → English → key itself for graceful degradation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Thread-safe"}]},{"type":"text","text":": Safe language switching from any thread at runtime"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"JSON-based"}]},{"type":"text","text":": Easy to extend with new strings and languages"}],"type":"paragraph"}]}]},{"text":"Quick Start","type":"heading","anchor":"Quick-Start","level":2},{"text":"Display Localized Strings","type":"heading","anchor":"Display-Localized-Strings","level":3},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"LocalizedString"},{"type":"text","text":" to show localized text:"}],"type":"paragraph"},{"code":["import TUIkit","","VStack {","    LocalizedString(LocalizationKey.Button.ok)","    LocalizedString(LocalizationKey.Error.notFound)","    LocalizedString(LocalizationKey.Dialog.confirm)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or use the ","type":"text"},{"type":"codeVoice","code":"Text(localized:)"},{"text":" convenience initializer:","type":"text"}],"type":"paragraph"},{"code":["Text(localized: LocalizationKey.Button.save)"],"syntax":"swift","type":"codeListing"},{"text":"Switch Language at Runtime","type":"heading","anchor":"Switch-Language-at-Runtime","level":3},{"code":["struct LanguagePicker: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Button(\"Deutsch\") {","            localization.setLanguage(.german)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runtime-owned service invalidates only its application and the UI re-renders with German strings."}]},{"anchor":"Supported-Languages","level":3,"type":"heading","text":"Supported Languages"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".english"},{"type":"text","text":" - English"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".german","type":"codeVoice"},{"text":" - Deutsch","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".french"},{"type":"text","text":" - Français"}]}]},{"content":[{"inlineContent":[{"code":".italian","type":"codeVoice"},{"text":" - Italiano","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".spanish","type":"codeVoice"},{"text":" - Español","type":"text"}]}]}]},{"anchor":"Type-Safe-Keys","level":2,"type":"heading","text":"Type-Safe Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All localized strings are available as "},{"type":"codeVoice","code":"LocalizationKey"},{"type":"text","text":" enums organized by category. This provides compile-time safety, IDE autocomplete, and refactoring support."}]},{"anchor":"Key-Categories","level":3,"type":"heading","text":"Key Categories"},{"anchor":"Button-Keys","level":4,"type":"heading","text":"Button Keys"},{"type":"paragraph","inlineContent":[{"text":"21 button strings including: ok, cancel, yes, no, save, delete, close, apply, reset, submit, search, clear, add, remove, edit, done, next, previous, back, forward, refresh","type":"text"}]},{"code":["LocalizationKey.Button.ok","LocalizationKey.Button.cancel","LocalizationKey.Button.save"],"type":"codeListing","syntax":"swift"},{"level":4,"anchor":"Label-Keys","text":"Label Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"17 label strings including: search, name, description, value, status, error, warning, info, loading, empty, none, page, item, items, total, from, to"}]},{"syntax":"swift","code":["LocalizationKey.Label.name","LocalizationKey.Label.description","LocalizationKey.Label.status"],"type":"codeListing"},{"level":4,"anchor":"Error-Keys","text":"Error Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"11 error strings including: invalidInput, requiredField, notFound, accessDenied, networkError, unknown, invalidFormat, operationFailed, timeout, fileNotFound, permissionDenied","type":"text"}]},{"syntax":"swift","code":["LocalizationKey.Error.invalidInput","LocalizationKey.Error.notFound","LocalizationKey.Error.timeout"],"type":"codeListing"},{"level":4,"anchor":"Placeholder-Keys","text":"Placeholder Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"6 placeholder strings: search, enterText, enterValue, selectOption, enterName, chooseFile"}]},{"syntax":"swift","code":["LocalizationKey.Placeholder.search","LocalizationKey.Placeholder.enterText","LocalizationKey.Placeholder.selectOption"],"type":"codeListing"},{"level":4,"anchor":"Menu-Keys","text":"Menu Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"8 menu strings: file, edit, view, help, new, open, save, exit"}]},{"syntax":"swift","code":["LocalizationKey.Menu.file","LocalizationKey.Menu.edit","LocalizationKey.Menu.help"],"type":"codeListing"},{"level":4,"anchor":"Dialog-Keys","text":"Dialog Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"7 dialog strings: confirm, deleteConfirmation, unsavedChanges, overwriteConfirmation, exitConfirmation, success, error"}]},{"syntax":"swift","code":["LocalizationKey.Dialog.confirm","LocalizationKey.Dialog.deleteConfirmation","LocalizationKey.Dialog.unsavedChanges"],"type":"codeListing"},{"level":4,"anchor":"Validation-Keys","text":"Validation Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"4 validation strings: emailInvalid, passwordTooShort, usernameTaken, fieldRequired"}]},{"syntax":"swift","code":["LocalizationKey.Validation.emailInvalid","LocalizationKey.Validation.passwordTooShort","LocalizationKey.Validation.usernameTaken"],"type":"codeListing"},{"level":2,"anchor":"Using-Localized-Strings","text":"Using Localized Strings","type":"heading"},{"level":3,"anchor":"LocalizedString-View","text":"LocalizedString View","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Display a localized string as a View component:","type":"text"}]},{"syntax":"swift","code":["struct MyView: View {","    var body: some View {","        VStack {","            LocalizedString(LocalizationKey.Button.save)","            LocalizedString(LocalizationKey.Error.invalidInput)","            LocalizedString(LocalizationKey.Validation.emailInvalid)","        }","    }","}"],"type":"codeListing"},{"level":3,"anchor":"Text-View-with-Localization","text":"Text View with Localization","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}]},{"syntax":"swift","code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: LocalizationKey.Menu.file)","            Text(localized: LocalizationKey.Placeholder.search)","        }","    }","}"],"type":"codeListing"},{"level":3,"anchor":"Direct-Service-Access","text":"Direct Service Access","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For advanced use cases, read the runtime-owned service from the environment:"}]},{"syntax":"swift","code":["struct StatusLabel: View {","    @Environment(\\.localizationService) private var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Language-Switching","text":"Language Switching","type":"heading"},{"level":3,"anchor":"Get-Current-Language","text":"Get Current Language","type":"heading"},{"syntax":"swift","code":["struct CurrentLanguageLabel: View {","    @Environment(\\.currentLanguage) private var currentLanguage","","    var body: some View {","        Text(currentLanguage.displayName)","    }","}"],"type":"codeListing"},{"level":3,"anchor":"Change-Language","text":"Change Language","type":"heading"},{"syntax":"swift","code":["@Environment(\\.localizationService) private var localization","","Button(\"Français\") {","    localization.setLanguage(.french)","}"],"type":"codeListing"},{"level":3,"anchor":"Language-Persistence","text":"Language Persistence","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Linux","type":"text"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"~\/.config\/tuikit\/language"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"level":3,"anchor":"Fallback-Behavior","text":"Fallback Behavior","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Try to find the key in the active language"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"If not found, fall back to English","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"level":2,"anchor":"Environment-Access","text":"Environment Access","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: LocalizationKey.Button.ok))","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each application runtime owns its localization service. The former"},{"type":"text","text":" "},{"type":"codeVoice","code":"LocalizationService.shared"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.shared"},{"type":"text","text":" accessors are no longer"},{"type":"text","text":" "},{"type":"text","text":"available. Reading the service from "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" also ensures that a language"},{"type":"text","text":" "},{"type":"text","text":"change invalidates the correct application when multiple runtimes share a process."}]},{"level":2,"anchor":"Adding-New-Keys","text":"Adding New Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"level":3,"anchor":"1-Update-LocalizationKey-Enum","text":"1. Update LocalizationKey Enum","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Edit ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then add convenient extensions:"}]},{"syntax":"swift","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"type":"codeListing"},{"level":3,"anchor":"2-Add-to-All-Translation-Files","text":"2. Add to All Translation Files","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"en.json","type":"text"}]},{"type":"text","text":":"}]},{"syntax":"json","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"de.json"}],"type":"strong"},{"type":"text","text":":"}]},{"syntax":"json","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Similar for "},{"type":"codeVoice","code":"fr.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"it.json"},{"type":"text","text":", "},{"type":"codeVoice","code":"es.json"},{"type":"text","text":"."}]},{"level":3,"anchor":"3-Update-Tests","text":"3. Update Tests","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add tests in "},{"type":"codeVoice","code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"type":"codeListing"},{"level":3,"anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"level":2,"anchor":"Adding-New-Languages","text":"Adding New Languages","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"level":3,"anchor":"1-Update-Language-Enum","text":"1. Update Language Enum","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"type":"codeListing"},{"level":3,"anchor":"2-Create-Translation-File","text":"2. Create Translation File","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/translations\/pt.json"},{"type":"text","text":" with "},{"type":"strong","inlineContent":[{"type":"text","text":"all"}]},{"type":"text","text":" keys from other language files:"}]},{"syntax":"json","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"type":"codeListing"},{"level":3,"anchor":"3-Test-the-New-Language","text":"3. Test the New Language","type":"heading"},{"syntax":"swift","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: LocalizationKey.Button.ok)"],"type":"codeListing"},{"level":3,"anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests","type":"heading"},{"syntax":"bash","code":["swift test --filter LocalizationKeyConsistencyTests"],"type":"codeListing"},{"level":2,"anchor":"Design-Principles","text":"Design Principles","type":"heading"},{"level":3,"anchor":"Dot-Notation-Keys","text":"Dot-Notation Keys","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Keys use ","type":"text"},{"code":"category.key_name","type":"codeVoice"},{"text":" format:","type":"text"}]},{"syntax":null,"code":["button.ok","error.not_found","validation.email_invalid"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This organizes related strings, makes them easy to find, and matches JSON structure."}]},{"level":3,"anchor":"Enum-Categories","text":"Enum Categories","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Each JSON prefix becomes an enum category:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"button.*","type":"codeVoice"},{"text":" keys → ","type":"text"},{"code":"LocalizationKey.Button","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"code":"error.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Error","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All "},{"code":"validation.*","type":"codeVoice"},{"type":"text","text":" keys → "},{"code":"LocalizationKey.Validation","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This provides type safety, IDE autocomplete, and compile-time verification.","type":"text"}]},{"level":3,"anchor":"Thread-Safety","text":"Thread Safety","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LocalizationService","isActive":true},{"type":"text","text":" uses "},{"type":"codeVoice","code":"NSLock"},{"type":"text","text":" for thread-safe access:"}]},{"syntax":"swift","code":["\/\/ Safe to call from any thread","let service = localization","DispatchQueue.global().async {","    service.setLanguage(.german)","}"],"type":"codeListing"},{"level":3,"ancho