Content":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"~\/Library\/Application Support\/tuikit\/language"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Linux"}],"type":"strong"},{"type":"text","text":": "},{"code":"~\/.config\/tuikit\/language","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The saved preference is restored when the app restarts."}]},{"level":3,"type":"heading","anchor":"Fallback-Behavior","text":"Fallback Behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"String resolution uses a fallback chain:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Try to find the key in the active language","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"If not found, fall back to English"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If still not found, return the key itself as-is","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"This ensures the UI always has something to display, even with incomplete translations.","type":"text"}]},{"level":2,"type":"heading","anchor":"Environment-Access","text":"Environment Access"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"LocalizationService"},{"type":"text","text":" is available in the view environment:"}]},{"type":"codeListing","code":["struct MyView: View {","    @Environment(\\.localizationService) var localization","","    var body: some View {","        Text(localization.string(for: .button(.ok)))","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Adding-New-Keys","text":"Adding New Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add new localized strings to the framework:"}]},{"level":3,"type":"heading","anchor":"1-Update-LocalizationKey-Enum","text":"1. Update LocalizationKey Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"type":"codeVoice","code":"Sources\/TUIkit\/Localization\/LocalizationKeys.swift"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public enum LocalizationKey {","    public enum Button: String {","        \/\/ ... existing cases","        case myNewButton = \"button.my_new_button\"","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then add convenient extensions:","type":"text"}]},{"type":"codeListing","code":["extension LocalizedString {","    public init(_ key: LocalizationKey.Button) {","        self.init(key.rawValue)","    }","}","","extension Text {","    public init(localized key: LocalizationKey.Button) {","        self.init(localized: key.rawValue)","    }","}","","extension LocalizationService {","    public func string(for key: LocalizationKey.Button) -> String {","        string(for: key.rawValue)","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"2-Add-to-All-Translation-Files","text":"2. Add to All Translation Files"},{"type":"paragraph","inlineContent":[{"text":"Add the same key to all 5 translation JSON files:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"en.json","type":"text"}],"type":"strong"},{"text":":","type":"text"}]},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"My New Button\",","  ...","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"de.json","type":"text"}],"type":"strong"},{"type":"text","text":":"}]},{"type":"codeListing","code":["{","  \"button.my_new_button\": \"Mein neuer Button\",","  ...","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Similar for ","type":"text"},{"code":"fr.json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"it.json","type":"codeVoice"},{"text":", ","type":"text"},{"code":"es.json","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"type":"heading","anchor":"3-Update-Tests","text":"3. Update Tests"},{"type":"paragraph","inlineContent":[{"text":"Add tests in ","type":"text"},{"code":"Tests\/TUIkitTests\/LocalizationKeyConsistencyTests.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@Test(\"All button keys exist in translations\")","func allButtonKeysExist() {","    let keys = [","        LocalizationKey.Button.ok,","        LocalizationKey.Button.myNewButton,","        \/\/ ... all other button keys","    ]","","    for key in keys {","        #expect(englishTranslations[key.rawValue] != nil)","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Verify all keys exist in translation files:"}]},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"level":2,"type":"heading","anchor":"Adding-New-Languages","text":"Adding New Languages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To add support for a new language:"}]},{"level":3,"type":"heading","anchor":"1-Update-Language-Enum","text":"1. Update Language Enum"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Edit "},{"code":"Sources\/TUIkit\/Localization\/LocalizationService.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["public enum Language: String, Codable {","    case english = \"en\"","    case german = \"de\"","    case french = \"fr\"","    case italian = \"it\"","    case spanish = \"es\"","    case portuguese = \"pt\"  \/\/ NEW","","    public var displayName: String {","        switch self {","        case .english: \"English\"","        case .german: \"Deutsch\"","        case .french: \"Français\"","        case .italian: \"Italiano\"","        case .spanish: \"Español\"","        case .portuguese: \"Português\"  \/\/ NEW","        }","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"2-Create-Translation-File","text":"2. Create Translation File"},{"type":"paragraph","inlineContent":[{"text":"Create ","type":"text"},{"code":"Sources\/TUIkit\/Localization\/translations\/pt.json","type":"codeVoice"},{"text":" with ","type":"text"},{"inlineContent":[{"type":"text","text":"all"}],"type":"strong"},{"text":" keys from other language files:","type":"text"}]},{"type":"codeListing","code":["{","  \"button.ok\": \"OK\",","  \"button.cancel\": \"Cancelar\",","  ...","  \/\/ Must include ALL keys (use en.json as reference)","}"],"syntax":"json"},{"level":3,"type":"heading","anchor":"3-Test-the-New-Language","text":"3. Test the New Language"},{"type":"codeListing","code":["let service = LocalizationService()","service.setLanguage(.portuguese)","let ok = service.string(for: .button(.ok))"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"4-Run-Consistency-Tests","text":"4. Run Consistency Tests"},{"type":"codeListing","code":["swift test --filter LocalizationKeyConsistencyTests"],"syntax":"bash"},{"level":2,"type":"heading","anchor":"Design-Principles","text":"Design Principles"},{"level":3,"type":"heading","anchor":"Dot-Notation-Keys","text":"Dot-Notation Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keys use "},{"type":"codeVoice","code":"category.key_name"},{"type":"text","text":" format:"}]},{"type":"codeListing","code":["button.ok","error.not_found","validation.email_invalid"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"This organizes related strings, makes them easy to find, and matches JSON structure.","type":"text"}]},{"level":3,"type":"heading","anchor":"Enum-Categories","text":"Enum Categories"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each JSON prefix becomes an enum category:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","cod