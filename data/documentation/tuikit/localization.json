(.validation(.emailInvalid))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Text View with Localization","anchor":"Text-View-with-Localization","level":3},{"type":"paragraph","inlineContent":[{"text":"Use the ","type":"text"},{"code":"Text(localized:)","type":"codeVoice"},{"text":" initializer:","type":"text"}]},{"code":["struct MyControl: View {","    var body: some View {","        VStack {","            Text(localized: .menu(.file))","            Text(localized: .placeholder(.search))","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Direct Service Access","anchor":"Direct-Service-Access","level":3},{"type":"paragraph","inlineContent":[{"text":"For advanced use cases, access the service directly:","type":"text"}]},{"code":["let service = LocalizationService.shared","let text = service.string(for: .button(.ok))"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Language Switching","anchor":"Language-Switching","level":2},{"type":"heading","text":"Get Current Language","anchor":"Get-Current-Language","level":3},{"code":["let current = AppState.shared.currentLanguage","print(current.displayName)  \/\/ \"English\", \"Deutsch\", etc."],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Change Language","anchor":"Change-Language","level":3},{"code":["\/\/ Via AppState","AppState.shared.setLanguage(.german)","","\/\/ Or directly via service","LocalizationService.shared.setLanguage(.french)"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Language Persistence","anchor":"Language-Persistence","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Language preferences are automatically saved to:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"~\/Library\/Application Support\/tuikit\/language","type":"codeVoice"}],"type":"paragra