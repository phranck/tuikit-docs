nt += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"type":"heading","text":"Binding","level":2,"anchor":"Binding"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference"},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix on a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" property to get its binding:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let binding = Binding.constant(42)"]},{"type":"heading","text":"@Environment","level":2,"anchor":"Environment"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true},{"text":" provides values propagated down the view hierarchy:","type":"text"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Defining-Custom-Environment-Keys","level":3,"type":"heading","text":"Defining Custom Environment Keys"},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"t