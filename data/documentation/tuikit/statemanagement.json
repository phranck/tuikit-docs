{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}],"type":"paragraph"},{"anchor":"State","type":"heading","level":2,"text":"@State"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"anchor":"Binding","type":"heading","level":2,"text":"Binding"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference","isActive":true},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix on a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" property to get its binding:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let binding = Binding.constant(42)"]},{"anchor":"Environment","type":"heading","level":2,"text":"@Environment"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"type":"text","text":" provides values propagated down the view hierarchy:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"]},{"anchor":"Defining-Custom-Environment-Keys","type":"heading","level":3,"text":"Defining Custom Environment Keys"},{"syntax":"swift","type":"codeListing","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"]},{"inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"]},{"anchor":"Bindable","type":"heading","level":2,"text":"@Bindable"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Bindable"},{"type":"text","text":" derives bindings from the mutable properties of "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" "},{"type":"text","text":"model objects:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Observable","final class Profile {","    var name = \"\"","}","","struct ProfileEditor: View {","    @Bindable var profile: Profile","","    var body: some View {","        TextField(\"Name\", text: $profile.name)","    }","}"]},{"anchor":"Custom-Dynamic-Properties","type":"heading","level":2,"text":"Custom Dynamic Properties"},{"inlineContent":[{"type":"text","text":"Conform to "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/DynamicProperty","type":"reference","isActive":true},{"type":"text","text":" to compose framework wrappers inside your own"},{"type":"text","text":" "},{"type":"text","text":"property types. Nested wrappers hydrate with the owning view’s identity, and"},{"type":"text","text":" "},{"code":"update()","type":"codeVoice"},{"type":"text","text":" runs before every "},{"code":"body","type":"codeVoice"},{"type":"text","text":" evaluation."}],"type":"paragraph"},{"anchor":"AppStorage","type":"heading","level":2,"text":"@AppStorage"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. SwiftUI’s typed initializer families ("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"text":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Date","type":"codeVoice"},{"text":", raw-representable enums, and their optional","type":"text"},{"text":" ","type":"text"},{"text":"variants) are available; any other ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value works as an additive","type":"text"},{"text":" ","type":"text"},{"text":"convenience:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@AppStorage(\"username\", store: MyStorageBackend()) var username = \"Guest\""]},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" property accessed before any runtime hydrates it falls back"},{"type":"text","text":" "},{"type":"text","text":"to volatile in-memory storage: nothing reaches the file system without an"},{"type":"text","text":" "},{"type":"text","text":"owning runtime or an explicit backend."}],"type":"paragraph"},{"anchor":"Persistence-Guarantees","type":"heading","level":3,"text":"Persistence Guarantees"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","type":"reference","isActive":true},{"text":" captures an immutable snapshot for every mutation and","type":"text"},{"text":" ","type":"text"},{"text":"persists snapshots through one ordered writer, so an older state can never","type":"text"},{"text":" ","type":"text"},{"text":"overwrite a newer one. ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":" returns only after every previously","type":"text"},{"text":" ","type":"text"},{"text":"issued write has completed; the runtime flushes storage this way during","type":"text"},{"text":" ","type":"text"},{"text":"cleanup. Persistence failures are reported as ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StoragePersistenceError","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"values whose reasons are sanitized: they identify the failing step and error","type":"text"},{"text":" ","type":"text"},{"text":"code, but never contain file paths or stored content.","type":"text"}],"type":"paragraph"},{"anchor":"How-State-Survives-Re-Rendering","type":"heading","level":2,"text":"How State Survives Re-Rendering"},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"anchor":"Structural-Identity","type":"heading","level":3,"text":"Structural Identity"},{"inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"inlineContent":[{"text":"structural identity","type":"text"}],"type":"strong"},{"text":": a path like ","type":"text"},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s type name","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditional branches (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"if"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"else"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Nested modifier and runtime slots","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Persistent-State-Storage","type":"heading","level":3,"text":"Persistent State Storage"},{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in the owning runtime’s "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":", keyed by:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is constructed, it initially holds the declared default."},{"type":"text","text":" "},{"type":"text","text":"Immediately before the renderer evaluates that view’s "},{"type":"codeVoice","code":"body"},{"type":"text","text":", it binds each direct dynamic"},{"type":"text","text":" "},{"type":"text","text":"property to the persistent location at the view’s final structural identity. A reconstructed"},{"type":"text","text":" "},{"type":"text","text":"view therefore reads the stored value instead of resetting to its default."}],"type":"paragraph"},{"anchor":"Re-Render-Trigger","type":"heading","level":3,"text":"Re-Render Trigger"},{"inlineContent":[{"type":"text","text":"When a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" value changes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"StateBox","type":"codeVoice"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"code":"RenderInvalidationSink","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Observable dependencies read while evaluating "},{"type":"codeVoice","code":"body"},{"type":"text","text":" are tracked at the same committed"},{"type":"text","text":" "},{"type":"text","text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks"},{"type":"text","text":" "},{"type":"text","text":"from earlier view values become inert. Registrations are removed when their identity unmounts."}],"type":"paragraph"},{"anchor":"Garbage-Collection","type":"heading","level":3,"text":"Garbage Collection"},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"_ConditionalContent"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"},{"text":" for details on the output optimization pipeline.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","title":"Guides","generated":true}],"variants":[{"paths":["\/documentation\/tuikit\/statemanagement"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"State Management"},"references":{"doc://TUIkit/documentation/TUIkit/EnvironmentValues":{"abstract":[{"type":"text","text":"A collection of environment values propagated through the view hierarchy."}],"title":"EnvironmentValues","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","role":"symbol","url":"\/documentation\/tuikit\/environmentvalues","navigatorTitle":[{"kind":"identifier","text":"EnvironmentValues"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}]},"doc://TUIkit/documentation