{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}],"type":"paragraph"},{"level":2,"text":"@State","anchor":"State","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" for simple values owned by a single view:"}],"type":"paragraph"},{"code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Binding","anchor":"Binding","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"code":["let binding = Binding.constant(42)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"@Environment","anchor":"Environment","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference"},{"text":" provides values propagated down the view hierarchy:","type":"text"}]},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing"},{"text":"Defining Custom Environment Keys","anchor":"Defining-Custom-Environment-Keys","type":"heading","level":3},{"syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Inject values with the "},{"code":".environment()","type":"codeVoice"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing"},{"text":"@AppStorage","anchor":"AppStorage","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true,"type":"reference"},{"type":"text","text":" by default:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"type":"codeListing"},{"text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"text":"Structural Identity","anchor":"Structural-Identity","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"inlineContent":[{"type":"text","text":"structural identity"}],"type":"strong"},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s type name"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}]}]}]},{"text":"Persistent State Storage","anchor":"Persistent-State-Storage","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in the owning runtime’s "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":", keyed by:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s structural identity"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is declared, the "},{"type":"codeVoice","code":"init"},{"type":"text","text":" checks if a persistent value already"},{"type":"text","text":" "},{"type":"text","text":"exists for this position. If it does, the existing value is used instead of the default."}],"type":"paragraph"},{"text":"Re-Render Trigger","anchor":"Re-Render-Trigger","type":"heading","level":3},{"inlineContent":[{"text":"When a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" value changes:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"StateBox"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"@State.init"},{"type":"text","text":" self-hydrates from the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}]}]}]},{"text":"Garbage Collection","anchor":"Garbage-Collection","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"text":" for details on the output optimization pipeline.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"article","modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"State Management"},"kind":"article","seeAlsoSections":[{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentatio