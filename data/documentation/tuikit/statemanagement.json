 a value owned elsewhere. Use the "},{"code":"$","type":"codeVoice"},{"type":"text","text":" prefix on a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" property to get its binding:"}]},{"type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}]},{"syntax":"swift","type":"codeListing","code":["let binding = Binding.constant(42)"]},{"level":2,"type":"heading","text":"@Environment","anchor":"Environment"},{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" provides values propagated down the view hierarchy:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing"},{"anchor":"Defining-Custom-Environment-Keys","type":"heading","text":"Defining Custom Environment Keys","level":3},{"syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing"},{"anchor":"AppStorage","type":"heading","text":"@AppStorage","level":2},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"},{"type":"text","text":" persists values across app launches using "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing"},{"anchor":"How-State-Survives-Re-Rendering","type":"heading","text":"How State Survives Re-Rendering","level":2},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"anchor":"Structural-Identity","type":"heading","text":"Structural Identity","level":3},{"inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"text":": a path like ","type":"text"},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s type name","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"code":"true","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":"if","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"else","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Persistent-State-Storage","type":"heading","text":"Persistent State Storage","level":3},{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in a central "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" (owned by "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"), keyed by:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"When "},{"code":"@State var count = 0","type":"codeVoice"},{"type":"text","text":" is declared, the "},{"code":"init","type":"codeVoice"},{"type":"text","text":" checks if a persistent value already"},{"type":"text","text":" "},{"type":"text","text":"exists for this position. If it does, the existing value is used instead of the default."}],"type":"paragraph"},{"anchor":"Re-Render-Trigger","type":"heading","text":"Re-Render Trigger","level":3},{"inlineContent":[{"type":"text","text":"When a "},{"type":"codeVoice","code":"State"},{"type":"text","text":" value changes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"StateBox"},{"text":" triggers ","type":"text"},{"type":"codeVoice","code":"RenderNotifier.current"},{"text":" -> ","type":"text"},{"type":"codeVoice","code":"AppState.setNeedsRender()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The observer registered by "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" requests a re-render"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"@State.init"},{"type":"text","text":" self-hydrates from "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":", recovering persisted values"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":" output is written to the terminal"}]}]}],"type":"orderedList"},{"anchor":"Garbage-Collection","type":"heading","text":"Garbage Collection","level":3},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"code":"ConditionalView","type":"codeVoice"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"variants":[{"paths":["\/documentation\/tuikit\/statemanagement"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://TUIkit/documentation/TUIkit/Pr