{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"anchor":"State","type":"heading","level":2,"text":"@State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" for simple values owned by a single view:"}]},{"type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"syntax":"swift"},{"anchor":"Binding","type":"heading","level":2,"text":"Binding"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix on a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" property to get its binding:","type":"text"}]},{"type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}]},{"type":"codeListing","code":["let binding = Binding.constant(42)"],"syntax":"swift"},{"anchor":"Environment","type":"heading","level":2,"text":"@Environment"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"},{"text":" provides values propagated down the view hierarchy:","type":"text"}]},{"type":"codeListing","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"syntax":"swift"},{"anchor":"Defining-Custom-Environment-Keys","type":"heading","level":3,"text":"Defining Custom Environment Keys"},{"type":"codeListing","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"syntax":"swift"},{"anchor":"AppStorage","type":"heading","level":2,"text":"@AppStorage"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"},{"text":" persists values across app launches using ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"syntax":"swift"},{"anchor":"How-State-Survives-Re-Rendering","type":"heading","level":2,"text":"How State Survives Re-Rendering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}]},{"anchor":"Structural-Identity","type":"heading","level":3,"text":"Structural Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Persistent-State-Storage","type":"heading","level":3,"text":"Persistent State Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in a central "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" (owned by "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"), keyed by:"}]},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","