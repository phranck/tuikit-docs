{"metadata":{"role":"article","roleHeading":"Article","title":"State Management","modules":[{"name":"TUIkit"}]},"variants":[{"paths":["\/documentation\/tuikit\/statemanagement"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"level":2,"text":"@State","type":"heading","anchor":"State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"State"},{"type":"text","text":" for simple values owned by a single view:"}]},{"syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing"},{"level":2,"text":"Binding","type":"heading","anchor":"Binding"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Binding"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}]},{"syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}]},{"syntax":"swift","code":["let binding = Binding.constant(42)"],"type":"codeListing"},{"level":2,"text":"@Environment","type":"heading","anchor":"Environment"},{"type":"paragraph","inlineContent":[{"code":"EnvironmentValues","type":"codeVoice"},{"type":"text","text":" provides values propagated down the view hierarchy:"}]},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing"},{"level":3,"text":"Defining Custom Environment Keys","type":"heading","anchor":"Defining-Custom-Environment-Keys"},{"syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing"},{"level":2,"text":"@AppStorage","type":"heading","anchor":"AppStorage"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true},{"text":" persists values across app launches using ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing"},{"level":2,"text":"How State Survives Re-Rendering","type":"heading","anchor":"How-State-Survives-Re-Rendering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}]},{"level":3,"text":"Structural Identity","type":"heading","anchor":"Structural-Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}]}]}],"type":"unorderedList"},{"level":3,"text":"Persistent State Storage","type":"heading","anchor":"Persistent-State-Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in a central "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" (owned by "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"), keyed by:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"@State var count = 0"},{"text":" is declared, the ","type":"text"},{"type":"codeVoice","code":"init"},{"text":" checks if a persistent value already","type":"text"},{"text":" ","type":"text"},{"text":"exists for this position. If it does, the existing value is used instead of the default.","type":"text"}]},{"level":3,"text":"Re-Render Trigger","type":"heading","anchor":"Re-Render-Trigger"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"code":"State","type":"codeVoice"},{"type":"text","text":" value changes:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" triggers "},{"type":"codeVoice","code":"RenderNotifier.current"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"AppState.setNeedsRender()"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The observer registered by "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" requests a re-render"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"code":"app.body","type":"codeVoice"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"@State.init"},{"text":" self-hydrates from ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":", recovering persisted values","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The new "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":" output is written to the terminal"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":3,"text":"Garbage Col