{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"text":"@State","level":2,"anchor":"State","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}]},{"code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Binding","level":2,"anchor":"Binding","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix on a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" property to get its binding:","type":"text"}]},{"code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}]},{"code":["let binding = Binding.constant(42)"],"type":"codeListing","syntax":"swift"},{"text":"@Environment","level":2,"anchor":"Environment","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference"},{"text":" provides values propagated down the view hierarchy:","type":"text"}]},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Defining Custom Environment Keys","level":3,"anchor":"Defining-Custom-Environment-Keys","type":"heading"},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing","syntax":"swift"},{"text":"@AppStorage","level":2,"anchor":"AppStorage","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"},{"text":" persists values across app launches using the application’s","type":"text"},{"text":" ","type":"text"},{"text":"runtime-owned storage backend. TUIkit apps use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true,"type":"reference"},{"text":" by default:","type":"text"}]},{"code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}]},{"code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"type":"codeListing","syntax":"swift"},{"text":"How State Survives Re-Rendering","level":2,"anchor":"How-State-Survives-Re-Rendering","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"text":"Structural Identity","level":3,"anchor":"Structural-Identity","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditional branches (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"if","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"else","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}],"type":"paragraph"}]}]},{"text":"Persistent State Storage","level":3,"anchor":"Persistent-State-Storage","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in the owning runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", keyed by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s structural identity"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is constructed, it initially holds the declared default."},{"type":"text","text":" "},{"type":"text","text":"Immediately before the renderer evaluates that view’s "},{"type":"codeVoice","code":"body"},{"type":"text","text":", it binds each direct dynamic"},{"type":"text","text":" "},{"type":"text","text":"property to the persistent location at the view’s final structural identity. A reconstructed"},{"type":"text","text":" "},{"type":"text","text":"view therefore reads the stored value instead of resetting to its default."}]},{"text":"Re-Render Trigger","level":3,"anchor":"Re-Render-Trigger","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference","isActive":true},{"type":"text","text":" value changes:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"StateBox","type":"codeVoice"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"code":"RenderInvalidationSink","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"That runtime’s ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" notifies the observer registered by ","type":"text"},{"code":"AppRunner","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"type":"codeVoice","code":"app.body"},{"text":" fresh: reconstructing all views","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Observable dependencies read while evaluating ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" are tracked at the same committed","type":"text"},{"text":" ","type":"text"},{"text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks","type":"text"},{"text":" ","type":"text"},{"text":"from earlier view values become inert. Registrations are removed when their identity unmounts.","type":"text"}]},{"text":"Garbage Collection","level":3,"anchor":"Garbage-Collection","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","title":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","metadata":{"modules":[{"name":"TUIkit"}],"role":"article","roleHeading":"Article","title":"State Management"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"references":{"doc://TUIkit/documentation/TUIkit/State":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","url":"\/documentation\/tuikit\/state","navigatorTitle":[{"kind":"identifier","text":"State"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"State"}],"abstract":[{"type":"text","text":"A property wrapper that stores mutable stat