{"abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}],"type":"paragraph"},{"level":2,"anchor":"State","text":"@State","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"State"},{"text":" for simple values owned by a single view:","type":"text"}],"type":"paragraph"},{"code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Binding","text":"Binding","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Binding"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"code":["let binding = Binding.constant(42)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Environment","text":"@Environment","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues"},{"text":" provides values propagated down the view hierarchy:","type":"text"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Defining-Custom-Environment-Keys","text":"Defining Custom Environment Keys","type":"heading"},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"AppStorage","text":"@AppStorage","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"},{"type":"text","text":" persists values across app launches using "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"How-State-Survives-Re-Rendering","text":"How State Survives Re-Rendering","type":"heading"},{"inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Structural-Identity","text":"Structural Identity","type":"heading"},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Persistent-State-Storage","text":"Persistent State Storage","type":"heading"},{"inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in a central ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" (owned by ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":"), keyed by:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is declared, the ","type":"text"},{"code":"init","type":"codeVoice"},{"text":" checks if a persistent value already","type":"text"},{"text":" ","type":"text"},{"text":"exists for this position. If it does, the existing value is used instead of the default.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Re-Render-Trigger","text":"Re-Render Trigger","type":"heading"},{"inlineContent":[{"type":"text","text":"When a "},{"type":"codeVoice","code":"State"},{"type":"text","text":" value changes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" triggers "},{"type":"codeVoice","code":"RenderNotifier.current"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"AppState.setNeedsRender()"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The observer registered by "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" requests a re-render"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"@State.init"},{"text":" self-hydrates from ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":", recovering persisted values","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":" output is written to the terminal"}]}]}],"type":"orderedList"},{"level":3,"anchor":"Garbage-Collection","text":"Garbage Collection","type":"heading"},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"code":"ConditionalView","type":"codeVoice"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"},{"type":"text","text":" for details on the output optimization pipeline."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}],"title":"State Management"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"references":{"doc://TUIkit/documentation/TUIkit/Th