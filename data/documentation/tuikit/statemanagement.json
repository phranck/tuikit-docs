{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"text":"@State","type":"heading","level":2,"anchor":"State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" for simple values owned by a single view:"}]},{"syntax":"swift","type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"text":"Binding","type":"heading","level":2,"anchor":"Binding"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"type":"codeVoice","code":"$"},{"text":" prefix on a ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" property to get its binding:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}]},{"syntax":"swift","type":"codeListing","code":["let binding = Binding.constant(42)"]},{"text":"@Environment","type":"heading","level":2,"anchor":"Environment"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"text":" provides values propagated down the view hierarchy:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"]},{"text":"Defining Custom Environment Keys","type":"heading","level":3,"anchor":"Defining-Custom-Environment-Keys"},{"syntax":"swift","type":"codeListing","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}]},{"syntax":"swift","type":"codeListing","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"]},{"text":"@AppStorage","type":"heading","level":2,"anchor":"AppStorage"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by default:"}]},{"syntax":"swift","type":"codeListing","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}]},{"syntax":"swift","type":"codeListing","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""]},{"text":"How State Survives Re-Rendering","type":"heading","level":2,"anchor":"How-State-Survives-Re-Rendering"},{"type":"paragraph","inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"text":"Structural Identity","type":"heading","level":3,"anchor":"Structural-Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Conditional branches (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"if"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"else"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Nested modifier and runtime slots","type":"text"}]}]}]},{"text":"Persistent State Storage","type":"heading","level":3,"anchor":"Persistent-State-Storage"},{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values live in the owning runtime’s ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":", keyed by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s structural identity"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}]},{"text":"Re-Render Trigger","type":"heading","level":3,"anchor":"Re-Render-Trigger"},{"type":"paragraph","inlineContent":[{"text":"When a ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true},{"text":" value changes:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"StateBox"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"inlineContent":[{"text":"That runtime’s ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" notifies the observer registered by ","type":"text"},{"type":"codeVoice","code":"AppRunner"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Observable dependencies read while evaluating ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" are tracked at the same committed","type":"text"},{"text":" ","type":"text"},{"text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks","type":"text"},{"text":" ","type":"text"},{"text":"from earlier view values become inert. Registrations are removed when their identity unmounts.","type":"text"}]},{"text":"Garbage Collection","type":"heading","level":3,"anchor":"Garbage-Collection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}]},{"type":"paragraph","inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","isActive":true,"type":"reference"},{"text":" for details on the output optimization pipeline.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"State Management"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"kind":"article","references":{"tuikit-logo.png":{"alt":"TUIkit Logo","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"type":"image","identifier":"tuikit-logo.png"},"doc://TUIkit/documentation/TUIkit":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swi