{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}],"type":"paragraph"},{"text":"@State","anchor":"State","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing"},{"text":"Binding","anchor":"Binding","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference","isActive":true},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"code":"$","type":"codeVoice"},{"type":"text","text":" prefix on a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"syntax":"swift","code":["let binding = Binding.constant(42)"],"type":"codeListing"},{"text":"@Environment","anchor":"Environment","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true},{"text":" provides values propagated down the view hierarchy:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"]},{"level":3,"text":"Defining Custom Environment Keys","type":"heading","anchor":"Defining-Custom-Environment-Keys"},{"syntax":"swift","type":"codeListing","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"]},{"inlineContent":[{"type":"text","text":"Inject values with the "},{"code":".environment()","type":"codeVoice"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"]},{"level":2,"text":"@AppStorage","type":"heading","anchor":"AppStorage"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","type":"reference","isActive":true},{"type":"text","text":" by default:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""]},{"inlineContent":[{"type":"text","text":"An "},{"code":"@AppStorage","type":"codeVoice"},{"type":"text","text":" property accessed before any runtime hydrates it falls back"},{"type":"text","text":" "},{"type":"text","text":"to volatile in-memory storage: nothing reaches the file system without an"},{"type":"text","text":" "},{"type":"text","text":"owning runtime or an explicit backend."}],"type":"paragraph"},{"level":3,"anchor":"Persistence-Guarantees","type":"heading","text":"Persistence Guarantees"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" captures an immutable snapshot for every mutation and"},{"type":"text","text":" "},{"type":"text","text":"persists snapshots through one ordered writer, so an older state can never"},{"type":"text","text":" "},{"type":"text","text":"overwrite a newer one. "},{"type":"codeVoice","code":"synchronize()"},{"type":"text","text":" returns only after every previously"},{"type":"text","text":" "},{"type":"text","text":"issued write has completed; the runtime flushes storage this way during"},{"type":"text","text":" "},{"type":"text","text":"cleanup. Persistence failures are reported as "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StoragePersistenceError","isActive":true},{"type":"text","text":" "},{"type":"text","text":"values whose reasons are sanitized: they identify the failing step and error"},{"type":"text","text":" "},{"type":"text","text":"code, but never contain file paths or stored content."}],"type":"paragraph"},{"level":2,"anchor":"How-State-Survives-Re-Rendering","type":"heading","text":"How State Survives Re-Rendering"},{"inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Structural-Identity","type":"heading","text":"Structural Identity"},{"inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"text":": a path like ","type":"text"},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditional branches (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"if","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"else","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"Persistent-State-Storage","type":"heading","text":"Persistent State Storage"},{"inlineContent":[{"type":"text","text":"All "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" values live in the owning runtime’s "},{"code":"StateStorage","type":"codeVoice"},{"type":"text","text":", keyed by:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Re-Render-Trigger","type":"heading","text":"Re-Render Trigger"},{"inlineContent":[{"text":"When a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"text":" value changes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"code":"StateBox","type":"codeVoice"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"code":"RenderInvalidationSink","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}]}]},{"content":[{"inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Observable dependencies read while evaluating ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" are tracked at the same committed","type":"text"},{"text":" ","type":"text"},{"text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks","type":"text"},{"text":" ","type":"text"},{"text":"from earlier view values become inert. Registrations are removed when their identity unmounts.","type":"text"}]},{"type":"heading","anchor":"Garbage-Collection","text":"Garbage Collection","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"_ConditionalContent"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}]}]}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"State Management","modules":[{"name":"TUIkit"}]},"variants":[{"paths":["\/documentation\/tuikit\/statemanagement"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"url":"\/documentation\/tuikit\/palettereference","title":"Palette Reference","abstract":[{"text":"A visual reference for all built-in color palettes with their exact color values.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","role":"collectionGroup","type":"topic","kind":"article"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","url":"\/documentation\/tuikit\/focussystem","title":"Focus System","type":"topic","role":"article","abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"kind":"article"},"doc://TUIkit/documentation/TUIkit/State":{"type":"topic","