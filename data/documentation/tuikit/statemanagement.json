{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}],"type":"paragraph"},{"anchor":"State","level":2,"type":"heading","text":"@State"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"State"},{"type":"text","text":" for simple values owned by a single view:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"anchor":"Binding","level":2,"type":"heading","text":"Binding"},{"inlineContent":[{"type":"codeVoice","code":"Binding"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let binding = Binding.constant(42)"]},{"anchor":"Environment","level":2,"type":"heading","text":"@Environment"},{"inlineContent":[{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" provides values propagated down the view hierarchy:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"]},{"anchor":"Defining-Custom-Environment-Keys","level":3,"type":"heading","text":"Defining Custom Environment Keys"},{"syntax":"swift","type":"codeListing","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"]},{"inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"]},{"anchor":"AppStorage","level":2,"type":"heading","text":"@AppStorage"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"},{"type":"text","text":" persists values across app launches using "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"anchor":"How-State-Survives-Re-Rendering","level":2,"type":"heading","text":"How State Survives Re-Rendering"},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"anchor":"Structural-Identity","level":3,"type":"heading","text":"Structural Identity"},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Persistent-State-Storage","level":3,"type":"heading","text":"Persistent State Storage"},{"inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in a central ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" (owned by ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":"), keyed by:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is declared, the "},{"type":"codeVoice","code":"init"},{"type":"text","text":" checks if a persistent value already"},{"type":"text","text":" "},{"type":"text","text":"exists for this position. If it does, the existing value is used instead of the default."}],"type":"paragraph"},{"anchor":"Re-Render-Trigger","level":3,"type":"heading","text":"Re-Render Trigger"},{"inlineContent":[{"type":"text","text":"When a "},{"type":"codeVoice","code":"State"},{"type":"text","text":" value changes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"StateBox","type":"codeVoice"},{"type":"text","text":" triggers "},{"code":"RenderNotifier.current","type":"codeVoice"},{"type":"text","text":" -> "},{"code":"AppState.setNeedsRender()","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"The observer registered by ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" requests a re-render","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"@State.init"},{"text":" self-hydrates from ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":", recovering persisted values","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new "},{"code":"FrameBuffer","type":"codeVoice"},{"type":"text","text":" output is written to the terminal"}]}]}],"type":"orderedList"},{"anchor":"Garbage-Collection","level":3,"type":"heading","text":"Garbage Collection"},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"article","metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"TUIkit"}],"title":"State Management"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides","generated":true,"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/Pr