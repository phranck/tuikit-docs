,{"text":" persists values across app launches using ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"level":3,"text":"Structural Identity","anchor":"Structural-Identity","type":"heading"},{"inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"inlineContent":[{"text":"structural identity","type":"text"}],"type":"strong"},{"text":": a path like ","type":"text"},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Conditional branches (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"if"},{"text":"\/","type":"text"},{"type":"codeVoice","cod