xt"}],"type":"paragraph"},{"type":"codeListing","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"AppStorage","text":"@AppStorage"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"syntax":"swift"},{"type":"heading","text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}]},{"type":"heading","text":"Structural Identity","anchor":"Structural-Identity","level":3},{"type":"paragraph","inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"text":": a path like ","type":"text"},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Its position among s