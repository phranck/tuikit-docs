},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}]},{"type":"heading","level":3,"anchor":"Structural-Identity","text":"Structural Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"type":"text","text":": a path like "},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s type name","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditional branches (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"if","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"else","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Nested modifier and runtime slots","type":"text"}]}]}]},{"type":"heading","level":3,"anchor":"Persistent-State-Storage","text":"Persistent State Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" values live in the owning runtime’s "},{"code":"StateStorage","type":"codeVoice"},{"type":"text","text":", keyed by:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s structural identity"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}]},{"type":"heading","level":3,"anchor":"Re-Render-Trigger","text":"Re-Render Trigger"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference","isActive":true},{"type":"text","text":" value changes:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"StateBox","type":"codeVoice"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"code":"RenderInvalidationSink","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"That runtime’s ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" notifies the observer registered by ","type":"text"},{"type":"codeVoice","code":"AppRunner"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"type":"codeVoice","code":"StateStorage"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"isActive":true,"identifier":"do