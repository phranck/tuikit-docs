{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"anchor":"State","type":"heading","text":"@State","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" for simple values owned by a single view:"}]},{"code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Binding","type":"heading","text":"Binding","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"code":"$","type":"codeVoice"},{"type":"text","text":" prefix on a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" property to get its binding:"}]},{"code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}]},{"code":["let binding = Binding.constant(42)"],"type":"codeListing","syntax":"swift"},{"anchor":"Environment","type":"heading","text":"@Environment","level":2},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"type":"text","text":" provides values propagated down the view hierarchy:"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Defining-Custom-Environment-Keys","type":"heading","text":"Defining Custom Environment Keys","level":3},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Inject values with the ","type":"text"},{"type":"codeVoice","code":".environment()"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing","syntax":"swift"},{"anchor":"Bindable","type":"heading","text":"@Bindable","level":2},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Bindable","isActive":true,"type":"reference"},{"text":" derives bindings from the mutable properties of ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"model objects:","type":"text"}],"type":"paragraph"},{"code":["@Observable","final class Profile {","    var name = \"\"","}","","struct ProfileEditor: View {","    @Bindable var profile: Profile","","    var body: some View {","        TextField(\"Name\", text: $profile.name)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Custom-Dynamic-Properties","type":"heading","text":"Custom Dynamic Properties","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/DynamicProperty"},{"type":"text","text":" to compose framework wrappers inside your own"},{"type":"text","text":" "},{"type":"text","text":"property types. Nested wrappers hydrate with the owning view’s identity, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"update()"},{"type":"text","text":" runs before every "},{"type":"codeVoice","code":"body"},{"type":"text","text":" evaluation."}]},{"type":"heading","level":2,"text":"@AppStorage","anchor":"AppStorage"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by"},{"type":"text","text":" "},{"type":"text","text":"default. SwiftUI’s typed initializer families ("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"URL"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data"},{"type":"text","text":", "},{"type":"codeVoice","code":"Date"},{"type":"text","text":", raw-representable enums, and their optional"},{"type":"text","text":" "},{"type":"text","text":"variants) are available; any other "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value works as an additive"},{"type":"text","text":" "},{"type":"text","text":"convenience:"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}]},{"type":"codeListing","syntax":"swift","code":["@AppStorage(\"username\", store: MyStorageBackend()) var username = \"Guest\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" property accessed before any runtime hydrates it falls back"},{"type":"text","text":" "},{"type":"text","text":"to volatile in-memory storage: nothing reaches the file system without an"},{"type":"text","text":" "},{"type":"text","text":"owning runtime or an explicit backend."}]},{"type":"heading","level":3,"text":"Persistence Guarantees","anchor":"Persistence-Guarantees"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"text":" captures an immutable snapshot for every mutation and","type":"text"},{"text":" ","type":"text"},{"text":"persists snapshots through one ordered writer, so an older state can never","type":"text"},{"text":" ","type":"text"},{"text":"overwrite a newer one. ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":" returns only after every previously","type":"text"},{"text":" ","type":"text"},{"text":"issued write has completed; the runtime flushes storage this way during","type":"text"},{"text":" ","type":"text"},{"text":"cleanup. Persistence failures are reported as ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StoragePersistenceError","isActive":true},{"text":" ","type":"text"},{"text":"values whose reasons are sanitized: they identify the failing step and error","type":"text"},{"text":" ","type":"text"},{"text":"code, but never contain file paths or stored content.","type":"text"}]},{"type":"heading","level":2,"text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering"},{"type":"paragraph","inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"type":"heading","level":3,"text":"Structural Identity","anchor":"Structural-Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"inlineContent":[{"type":"text","text":"structural identity"}],"type":"strong"},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s type name"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"code":"true","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":"if","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"else","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Nested modifier and runtime slots","type":"text"}]}]}]},{"type":"heading","level":3,"text":"Persistent State Storage","anchor":"Persistent-State-Storage"},{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in the owning runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", keyed by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s structural identity"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"@State var count = 0"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}]},{"type":"heading","level":3,"text":"Re-Render Trigger","anchor":"Re-Render-Trigger"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference"},{"type":"text","text":" value changes:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"StateBox"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"That runtime’s ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" notifies the observer registered by ","type":"text"},{"code":"AppRunner","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"type":"codeVoice","code":"app.body"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observable dependencies read while evaluating "},{"type":"codeVoice","code":"body"},{"type":"text","text":" are tracked at the same committed"},{"type":"text","text":" "},{"type":"text","text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks"},{"type":"text","text":" "},{"type":"text","text":"from earlier view values become inert. Registrations are removed when their identity unmounts."}]},{"type":"heading","level":3,"text":"Garbage Collection","anchor":"Garbage-Collection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"_ConditionalContent"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}]},{"type":"paragraph","inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"text":" for details on the output optimization pipeline.","type":"text"}]}],"kind":"content"}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"metadata":{"modules":[{"name":"TUIkit"}],"title":"State Management","roleHeading":"Article","role":"article"},"references":{"doc://TUIkit/documentation/TUIkit/EnvironmentValues":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","title":"EnvironmentValues","navigatorTitle":[{"kind":"identifier","text":"EnvironmentValues"}],"abstract":[{"type":"text","text":"A collection of environment values propagated through the view hierarchy."}],"url":"\/documentation\/tuikit\/environmentvalues","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}],"type":"topic"},"doc://TUIkit/documentation