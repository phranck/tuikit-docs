e":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"anchor":"Structural-Identity","text":"Structural Identity","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"text":": a path like ","type":"text"},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"inlineContent":[{"text":"Conditional branches (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"if"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"else"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Persistent-State-Storage","text":"Persistent State Storage","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in a central "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" (owned by "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"), keyed by:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"@State var count = 0"},{"text":" is declared, the ","type":"text"},{"type":"codeVoice","code":"init"},{"text":" checks if a persistent value already","type":"text"},{"text":" ","type":"text"},{"text":"exists for this position. If it does, the existing value is used instead of the default.","type":"text"}]},{"anchor":"Re-Render-Trigger","text":"Re-Render Trigger","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"type":"codeVoice","code":"State"},{"type":"text","text":" value changes:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"code":"StateBox","type":"codeVoice"},{"type":"text","text":" triggers "},{"code":"RenderNotifier.current","type":"codeVoice"},{"type":"text","text":" -> "},{"code":"AppState.setNeedsRender()","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The observer registered by ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" requests a re-render","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"@State.init","type":"codeVoice"},{"text":" self-hydrates from ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", recovering persisted values","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The new ","type":"text"},{"code":"FrameBuffer","type":"codeVoice"},{"text":" output is written to the terminal","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Garbage-Collection","text":"Garbage Collection","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state","type":"text"},{"text":" ","type":"text"},{"text":"automatically cleaned up at the end of each render pass. ","type":"text"},{"type":"codeVoice","code":"ConditionalView"},{"text":" also immediately","type":"text"},{"text":" ","type":"text"},{"text":"invalidates the inactive branch’s state to prevent stale values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"},{"text":" for details on the output optimization pipeline.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"title":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"State Management","modules":[{"name":"TUIkit"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://TUIkit/documentation/TUIkit/St