text":"Structural Identity","anchor":"Structural-Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s type name"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Persistent State Storage","anchor":"Persistent-State-Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" values live in the owning runtime’s "},{"code":"StateStorage","type":"codeVoice"},{"type":"text","text":", keyed by:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is constructed, it initially holds the declared default."},{"type":"text","text":" "},{"type":"text","text":"Immediately before the renderer evaluates that view’s "},{"type":"codeVoice","code":"body"},{"type":"text","text":", it binds each direct dynamic"},{"type":"text","text":" "},{"type":"text","text":"property to the persistent location at the view’s final structural identity. A reconstructed"},{"type":"text","text":" "},{"type":"text","text":"view therefore reads the stored value instead of resetting to its default."}]},{"type":"heading","level":3,"text":"Re-Render Trigger","anchor":"Re-Render-Trigger"},{"type":"paragraph","inlineContent":[{"text":"When a ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true},{"text":" value changes:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"StateBox","type":"codeVoice"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"code":"RenderInvalidationSink","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}]}]},{"content":[{"inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineConten