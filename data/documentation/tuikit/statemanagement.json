ucted from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"type":"heading","level":3,"anchor":"Structural-Identity","text":"Structural Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"type":"text","text":": a path like "},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"code":"true","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":"if","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"else","type":"codeVoice"},{"type":"text","text":")"}]}]}]},{"type":"heading","level":3,"anchor":"Persistent-State-Storage","text":"Persistent State Storage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in a central "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":" (owned by "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"), keyed by:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s structural identity"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is declared, the ","type":"text"},{"code":"init","type":"codeVoice"},{"text":" checks if a persistent value already","type":"text"},{"text":" ","type":"text"},{"text":"exists for this position. If it does, the existing value is used instead of the default.","type":"text"}]},{"type":"heading","level":3,"anchor":"Re-Render-Trigger","text":"Re-Render Trigger"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"code":"State","type":"codeVoice"},{"type":"text","text":" value changes:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"StateBox","type":"codeVoice"},{"text":" triggers ","type":"text"},{"code":"RenderNotifier.current","type":"codeVoice"},{"text":" -> ","type":"text"},{"code":"AppState.setNeedsRender()","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The observer registered by ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" requests a re-render","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"@State.init","type":"codeVoice"},{"text":" self-hydrates from ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", recovering persisted values","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The new "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":" output is written to the terminal"}]}]}]},{"type":"heading","level":3,"anchor":"Garbage-Collection","text":"Garbage Collection"},{"type":"paragraph","inlineContent":[{"text":"Vie