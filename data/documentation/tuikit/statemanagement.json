            }","        }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Binding","type":"heading","text":"Binding"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"code":"$","type":"codeVoice"},{"type":"text","text":" prefix on a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"syntax":"swift","code":["let binding = Binding.constant(42)"],"type":"codeListing"},{"level":2,"anchor":"Environment","type":"heading","text":"@Environment"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true},{"type":"text","text":" provides values propagated down the view hierarchy:"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing"},{"text":"Defining Custom Environment Keys","anchor":"Defining-Custom-Environment-Keys","level":3,"type":"heading"},{"syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Inject values with the ","type":"text"},{"type":"codeVoice","code":".environment()"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing"},{"text":"@AppStorage","anchor":"AppStorage","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"},{"text":" persists values across app launches using the application’s","type":"text"},{"text":" ","type":"text"},{"text":"runtime-owned storage backend. TUIkit apps use ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"text":" by default:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" property accessed before any runtime hydrates it falls back"},{"type":"text","text":" "},{"type":"text","text":"to volatile in-memory storage: nothing reaches the file system without an"},{"type":"text","text":" "},{"type":"text","text":"owning runtime or an explicit backend."}],"type":"paragraph"},{"text":"Persistence Guarantees","anchor":"Persistence-Guarantees","level":3,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true,"type":"reference"},{"text":" captures an immutable snapshot for every mutation and","type":"text"},{"text":" ","type":"text"},{"text":"persists snapshots through one ordered writer, so an older state can never","type":"text"},{"text":" ","type":"text"},{"text":"overwrite a newer one. ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":" returns only after every previously","type":"text"},{"text":" ","type":"text"},{"text":"issued write has completed; the runtime flushes storage this way during","type":"text"},{"text":" ","type":"text"},{"text":"cleanup. Persistence failures are reported as ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StoragePersistenceError","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"values whose reasons are sanitized: they identify the failing step and error","type":"text"},{"text":" ","type":"text"},{"text":"code, but never contain file paths or stored content.","type":"text"}],"type":"paragraph"},{"text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","level":2,"type":"heading"},{"inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}],"type":"paragraph"},{"text":"Structural Identity","anchor":"Structural-Identity","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s type name","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"code":"true","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":"if","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"else","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}]}]}],"type":"unorderedList"},{"text":"Persistent State Storage","anchor":"Persistent-State-Storage","level":3,"type":"heading"},{"inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in the owning runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", keyed by:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}],"type":"paragraph"},{"text":"Re-Render Trigger","anchor":"Re-Render-Trigger","level":3,"type":"heading"},{"inlineContent":[{"text":"When a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference","isActive":true},{"text":" value changes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}]}]},{"content":[{"inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The owning runtime clears the affected cached subtree and writes the new "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Observable dependencies read while evaluating ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" are tracked at the same committed","type":"text"},{"text":" ","type":"text"},{"text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks","type":"text"},{"text":" ","type":"text"},{"text":"from earlier view values become inert. Registrations are removed when their identity unmounts.","type":"text"}],"type":"paragraph"},{"text":"Garbage Collection","anchor":"Garbage-Collection","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"},{"text":" for details on the output optimization pipeline.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"title":"Status Bar","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","url":"\/documentation\/tuikit\/statusbarguide","abstract":[{"type":"text","text":"Configure the shortcut bar at the bottom of the terminal."}],"kind":"article","type":"topic","role":"article"},"doc://TUIkit/documentation/TUIkit/JSONFileStorage":{"type":"topic","abstract":[{"type":"text","text":"A storage backend that persists data to a JSON file."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"JSONFileStorage","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","url":"\/documentation\/tuikit\/jsonfilestorage","navigatorTitle":[{"t