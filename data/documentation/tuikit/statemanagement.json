{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"State Management","roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}]},{"text":"@State","type":"heading","anchor":"State","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"text":" for simple values owned by a single view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"text":"Binding","type":"heading","anchor":"Binding","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}]},{"type":"codeListing","syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let binding = Binding.constant(42)"]},{"text":"@Environment","type":"heading","anchor":"Environment","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"type":"text","text":" provides values propagated down the view hierarchy:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"]},{"text":"Defining Custom Environment Keys","type":"heading","anchor":"Defining-Custom-Environment-Keys","level":3},{"type":"codeListing","syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"]},{"text":"@AppStorage","type":"heading","anchor":"AppStorage","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage"},{"type":"text","text":" by default:"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" property accessed before any runtime hydrates it falls back"},{"type":"text","text":" "},{"type":"text","text":"to volatile in-memory storage: nothing reaches the file system without an"},{"type":"text","text":" "},{"type":"text","text":"owning runtime or an explicit backend."}]},{"text":"Persistence Guarantees","type":"heading","anchor":"Persistence-Guarantees","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true,"type":"reference"},{"text":" captures an immutable snapshot for every mutation and","type":"text"},{"text":" ","type":"text"},{"text":"persists snapshots through one ordered writer, so an older state can never","type":"text"},{"text":" ","type":"text"},{"text":"overwrite a newer one. ","type":"text"},{"code":"synchronize()","type":"codeVoice"},{"text":" returns only after every previously","type":"text"},{"text":" ","type":"text"},{"text":"issued write has completed; the runtime flushes storage this way during","type":"text"},{"text":" ","type":"text"},{"text":"cleanup. Persistence failures are reported as ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StoragePersistenceError","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"values whose reasons are sanitized: they identify the failing step and error","type":"text"},{"text":" ","type":"text"},{"text":"code, but never contain file paths or stored content.","type":"text"}]},{"text":"How State Survives Re-Rendering","type":"heading","anchor":"How-State-Survives-Re-Rendering","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}]},{"text":"Structural Identity","type":"heading","anchor":"Structural-Identity","level":3},{"type":"paragraph","inlineContent":[{"text":"Each view in the tree has a ","type":"text"},{"inlineContent":[{"text":"structural identity","type":"text"}],"type":"strong"},{"text":": a path like ","type":"text"},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This path is built automatically during rendering based on:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s type name","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}]}]}]},{"text":"Persistent State Storage","type":"heading","anchor":"Persistent-State-Storage","level":3},{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in the owning runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", keyed by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s structural identity"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"@State var count = 0"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"type":"codeVoice","code":"body"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}]},{"text":"Re-Render Trigger","type":"heading","anchor":"Re-Render-Trigger","level":3},{"type":"paragraph","inlineContent":[{"text":"When a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" value changes:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"StateBox"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"That runtime’s ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" notifies the observer registered by ","type":"text"},{"code":"AppRunner","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"code":"StateStorage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The owning runtime clears the affected cached subtree and writes the new "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Observable dependencies read while evaluating "},{"type":"codeVoice","code":"body"},{"type":"text","text":" are tracked at the same committed"},{"type":"text","text":" "},{"type":"text","text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks"},{"type":"text","text":" "},{"type":"text","text":"from earlier view values become inert. Registrations are removed when their identity unmounts."}]},{"text":"Garbage Collection","type":"heading","anchor":"Garbage-Collection","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","title":"Guides","generated":true}],"references":{"doc://TUIkit/documentation/TUIkit/FocusSystem":{"role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","title":"Focus System","url":"\/documentation\/tuikit\/focussystem","kind":"article","type":"topic","abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}]},"doc://TUIkit/documentation/TUIkit/State":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","url":"\/documentation\/tuikit\/state","abstract":[{"type":"text","text":"A property wrapper that stores mutable state for a view."}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"identifier"}],"kind":"symbol","type":"topic","navigatorTitle":[{"text":"State","kind":"ident