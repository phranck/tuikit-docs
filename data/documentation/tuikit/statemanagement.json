se"},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"Persistent-State-Storage","text":"Persistent State Storage"},{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in a central ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":" (owned by ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":"), keyed by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s structural identity"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"@State var count = 0"},{"text":" is declared, the ","type":"text"},{"type":"codeVoice","code":"init"},{"text":" checks if a persistent value already","type":"text"},{"text":" ","type":"text"},{"text":"exists for this position. If it does, the existing value is used instead of the default.","type":"text"}]},{"type":"heading","level":3,"anchor":"Re-Render-Trigger","text":"Re-Render Trigger"},{"type":"paragraph","inlineContent":[{"text":"When a ","type":"text"},{"code":"State","type":"codeVoice"},{"text":" value changes:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" triggers "},{"type":"codeVoice","code":"RenderNotifier.current"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"AppState.setNeedsRender()"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The observer registered by ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" requests a re-render","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{