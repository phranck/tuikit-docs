:{"kind":"symbol","title":"JSONFileStorage","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"JSONFileStorage"}],"navigatorTitle":[{"kind":"identifier","text":"JSONFileStorage"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","url":"\/documentation\/tuikit\/jsonfilestorage","abstract":[{"type":"text","text":"A storage backend that persists data to a JSON file."}]},"doc://TUIkit/documentation/TUIkit/Preferences":{"title":"Preferences","kind":"article","abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","role":"collectionGroup","url":"\/documentation\/tuikit\/preferences"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","kind":"article","role":"article","type":"topic","url":"\/documentation\/tuikit\/listandtable","title":"List and Table Components","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"url":"\/documentation\/tuikit\/statusbarguide","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","role":"article","kind":"article","title":"Status Bar","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}]}}}