{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"kind":"article","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}],"type":"paragraph"},{"anchor":"State","level":2,"type":"heading","text":"@State"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"Binding","level":2,"type":"heading","text":"Binding"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let binding = Binding.constant(42)"],"type":"codeListing"},{"anchor":"Environment","level":2,"type":"heading","text":"@Environment"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"},{"text":" provides values propagated down the view hierarchy:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing"},{"anchor":"Defining-Custom-Environment-Keys","level":3,"type":"heading","text":"Defining Custom Environment Keys"},{"syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing"},{"anchor":"AppStorage","level":2,"type":"heading","text":"@AppStorage"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by default:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}],"type":"paragraph"},{"syntax":"swift","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"type":"codeListing"},{"anchor":"How-State-Survives-Re-Rendering","level":2,"type":"heading","text":"How State Survives Re-Rendering"},{"inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}],"type":"paragraph"},{"anchor":"Structural-Identity","level":3,"type":"heading","text":"Structural Identity"},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditional branches (","type":"text"},{"code":"true","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"if","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"else","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Persistent-State-Storage","level":3,"type":"heading","text":"Persistent State Storage"},{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in the owning runtime’s "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":", keyed by:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"When "},{"code":"@State var count = 0","type":"codeVoice"},{"type":"text","text":" is declared, the "},{"code":"init","type":"codeVoice"},{"type":"text","text":" checks if a persistent value already"},{"type":"text","text":" "},{"type":"text","text":"exists for this position. If it does, the existing value is used instead of the default."}],"type":"paragraph"},{"anchor":"Re-Render-Trigger","level":3,"type":"heading","text":"Re-Render Trigger"},{"inlineContent":[{"text":"When a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"text":" value changes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"@State.init"},{"type":"text","text":" self-hydrates from the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}]}]},{"content":[{"inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Garbage-Collection","level":3,"type":"heading","text":"Garbage Collection"},{"inlineContent":[{"text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state","type":"text"},{"text":" ","type":"text"},{"text":"automatically cleaned up at the end of each render pass. ","type":"text"},{"type":"codeVoice","code":"ConditionalView"},{"text":" also immediately","type":"text"},{"text":" ","type":"text"},{"text":"invalidates the inactive branch’s state to prevent stale values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}],"type":"paragraph"}]}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"State Management","modules":[{"name":"TUIkit"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"seeAlsoSec