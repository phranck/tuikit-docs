{"kind":"article","metadata":{"roleHeading":"Article","title":"State Management","modules":[{"name":"TUIkit"}],"role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"type":"heading","level":2,"anchor":"State","text":"@State"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"State"},{"type":"text","text":" for simple values owned by a single view:"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Binding","text":"Binding"},{"type":"paragraph","inlineContent":[{"code":"Binding","type":"codeVoice"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"code":"$","type":"codeVoice"},{"type":"text","text":" prefix on a "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" property to get its binding:"}]},{"type":"codeListing","syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}]},{"type":"codeListing","syntax":"swift","code":["let binding = Binding.constant(42)"]},{"type":"heading","level":2,"anchor":"Environment","text":"@Environment"},{"type":"paragraph","inlineContent":[{"code":"EnvironmentValues","type":"codeVoice"},{"text":" provi