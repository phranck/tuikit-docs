{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"type":"heading","level":2,"anchor":"State","text":"@State"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Binding","text":"Binding"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix on a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" property to get its binding:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let binding = Binding.constant(42)"]},{"type":"heading","level":2,"anchor":"Environment","text":"@Environment"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"type":"text","text":" provides values propagated down the view hierarchy:"}]},{"type":"codeListing","syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"]},{"type":"heading","level":3,"anchor":"Defining-Custom-Environment-Keys","text":"Defining Custom Environment Keys"},{"type":"codeListing","syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"]},{"type":"heading","level":2,"anchor":"AppStorage","text":"@AppStorage"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","type":"reference","isActive":true},{"type":"text","text":" by default:"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}]},{"type":"codeListing","syntax":"swift","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""]},{"type":"heading","level":2,"anchor":"How-State-Survives-Re-Rendering","text":"How State Survives Re-Rendering"},{"type":"paragraph","inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"type":"heading","level":3,"anchor":"Structural-Identity","text":"Structural Identity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"text":"structural identity","type":"text"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"code":"true","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":"if","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"else","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}]}]}]},{"type":"heading","level":3,"anchor":"Persistent-State-Storage","text":"Persistent State Storage"},{"type":"paragraph","inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in the owning runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", keyed by:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The property’s declaration index within the view (0, 1, 2, …)"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}]},{"type":"heading","level":3,"anchor":"Re-Render-Trigger","text":"Re-Render Trigger"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true},{"type":"text","text":" value changes:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"type":"codeVoice","code":"RenderInvalidationSink"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Observable dependencies read while evaluating ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" are tracked at the same committed","type":"text"},{"text":" ","type":"text"},{"text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks","type":"text"},{"text":" ","type":"text"},{"text":"from earlier view values become inert. Registrations are removed when their identity unmounts.","type":"text"}]},{"type":"heading","level":3,"anchor":"Garbage-Collection","text":"Garbage Collection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"State Management","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/RenderCycle":{"kind":"article","abstract":[{"type":"text","text":"Understand how TUIkit turns your view tree into terminal output: one frame at a time."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","title":"Render Cycle","url":"\/documentation\/tuikit\/rendercycle","type":"topic","role":"article"},"doc://TUIkit/documentation/TUIk