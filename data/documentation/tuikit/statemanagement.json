:" -> ","type":"text"},{"code":"AppState.setNeedsRender()","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The observer registered by "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" requests a re-render"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"@State.init"},{"text":" self-hydrates from ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":", recovering persisted values","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The new ","type":"text"},{"code":"FrameBuffer","type":"codeVoice"},{"text":" output is written to the terminal","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Garbage Collection","anchor":"Garbage-Collection","level":3},{"type":"paragraph","inlineContent":[{"text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state","type":"text"},{"text":" ","type":"text"},{"text":"automatically cleaned up at the end of each render pass. ","type":"text"},{"code":"ConditionalView","type":"codeVoice"},{"text":" also immediately","type":"text"},{"text":" ","type":"text"},{"text":"invalidates the inactive branch’s state to prevent stale values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"type":"text","text":" for details on the output optimization pipeline."}]}]}],"references":{"doc://TUIkit/documentation/TUIkit/Li