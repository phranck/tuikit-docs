{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered."}]},{"text":"@State","anchor":"State","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" for simple values owned by a single view:"}]},{"syntax":"swift","type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"text":"Binding","anchor":"Binding","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}]},{"code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Create constant bindings for previews or static values:","type":"text"}]},{"code":["let binding = Binding.constant(42)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"@Environment","anchor":"Environment","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"},{"text":" provides values propagated down the view hierarchy:","type":"text"}]},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Defining Custom Environment Keys","anchor":"Defining-Custom-Environment-Keys","type":"heading"},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"@AppStorage","anchor":"AppStorage","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by default:"}]},{"code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}]},{"code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"An ","type":"text"},{"code":"@AppStorage","type":"codeVoice"},{"text":" property accessed before any runtime hydrates it falls back","type":"text"},{"text":" ","type":"text"},{"text":"to volatile in-memory storage: nothing reaches the file system without an","type":"text"},{"text":" ","type":"text"},{"text":"owning runtime or an explicit backend.","type":"text"}]},{"level":3,"text":"Persistence Guarantees","anchor":"Persistence-Guarantees","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage"},{"text":" captures an immutable snapshot for every mutation and","type":"text"},{"text":" ","type":"text"},{"text":"persists snapshots through one ordered writer, so an older state can never","type":"text"},{"text":" ","type":"text"},{"text":"overwrite a newer one. ","type":"text"},{"type":"codeVoice","code":"synchronize()"},{"text":" returns only after every previously","type":"text"},{"text":" ","type":"text"},{"text":"issued write has completed; the runtime flushes storage this way during","type":"text"},{"text":" ","type":"text"},{"text":"cleanup. Persistence failures are reported as ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StoragePersistenceError"},{"text":" ","type":"text"},{"text":"values whose reasons are sanitized: they identify the failing step and error","type":"text"},{"text":" ","type":"text"},{"text":"code, but never contain file paths or stored content.","type":"text"}]},{"level":2,"text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}]},{"level":3,"text":"Structural Identity","anchor":"Structural-Identity","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Nested modifier and runtime slots","type":"text"}]}]}]},{"level":3,"text":"Persistent State Storage","anchor":"Persistent-State-Storage","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in the owning runtime’s "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":", keyed by:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}]},{"level":3,"text":"Re-Render Trigger","anchor":"Re-Render-Trigger","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" value changes:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The owning runtime clears the affected cached subtree and writes the new ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Observable dependencies read while evaluating ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" are tracked at the same committed","type":"text"},{"text":" ","type":"text"},{"text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks","type":"text"},{"text":" ","type":"text"},{"text":"from earlier view values become inert. Registrations are removed when their identity unmounts.","type":"text"}]},{"level":3,"text":"Garbage Collection","anchor":"Garbage-Collection","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state","type":"text"},{"text":" ","type":"text"},{"text":"automatically cleaned up at the end of each render pass. ","type":"text"},{"code":"_ConditionalContent","type":"codeVoice"},{"text":" also immediately","type":"text"},{"text":" ","type":"text"},{"text":"invalidates the inactive branch’s state to prevent stale values.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"isActive":true,"type":"reference",