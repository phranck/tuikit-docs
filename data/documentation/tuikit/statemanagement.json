{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}],"type":"paragraph"},{"level":2,"text":"@State","type":"heading","anchor":"State"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"level":2,"text":"Binding","type":"heading","anchor":"Binding"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference","isActive":true},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let binding = Binding.constant(42)"]},{"level":2,"text":"@Environment","type":"heading","anchor":"Environment"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"text":" provides values propagated down the view hierarchy:","type":"text"}]},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Defining Custom Environment Keys","type":"heading","anchor":"Defining-Custom-Environment-Keys"},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Inject values with the ","type":"text"},{"type":"codeVoice","code":".environment()"},{"text":" modifier:","type":"text"}]},{"code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"@AppStorage","type":"heading","anchor":"AppStorage"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by default:"}]},{"code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Pass an explicit backend when a property wrapper is created outside the app","type":"text"},{"text":" ","type":"text"},{"text":"runtime or needs dedicated storage:","type":"text"}]},{"type":"codeListing","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"syntax":"swift"},{"text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"text":"Structural Identity","anchor":"Structural-Identity","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"inlineContent":[{"text":"structural identity","type":"text"}],"type":"strong"},{"type":"text","text":": a path like "},{"code":"\"ContentView\/VStack.0\/Menu\"","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s type name","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Nested modifier and runtime slots","type":"text"}]}]}],"type":"unorderedList"},{"text":"Persistent State Storage","anchor":"Persistent-State-Storage","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"All "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values live in the owning runtime’s "},{"type":"codeVoice","code":"StateStorage"},{"type":"text","text":", keyed by:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The view’s structural identity","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is constructed, it initially holds the declared default."},{"type":"text","text":" "},{"type":"text","text":"Immediately before the renderer evaluates that view’s "},{"type":"codeVoice","code":"body"},{"type":"text","text":", it binds each direct dynamic"},{"type":"text","text":" "},{"type":"text","text":"property to the persistent location at the view’s final structural identity. A reconstructed"},{"type":"text","text":" "},{"type":"text","text":"view therefore reads the stored value instead of resetting to its default."}],"type":"paragraph"},{"text":"Re-Render Trigger","anchor":"Re-Render-Trigger","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"When a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference","isActive":true},{"type":"text","text":" value changes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"StateBox","type":"codeVoice"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"code":"RenderInvalidationSink","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"That runtime’s ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" notifies the observer registered by ","type":"text"},{"code":"AppRunner","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The owning runtime clears the affected cached subtree and writes the new "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Observable dependencies read while evaluating "},{"code":"body","type":"codeVoice"},{"type":"text","text":" are tracked at the same committed"},{"type":"text","text":" "},{"type":"text","text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks"},{"type":"text","text":" "},{"type":"text","text":"from earlier view values become inert. Registrations are removed when their identity unmounts."}],"type":"paragraph"},{"text":"Garbage Collection","anchor":"Garbage-Collection","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"},{"type":"text","text":" for details on the output optimization pipeline."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"State Management"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides"}],"references":{"doc://TUIkit/documentation/TUIkit/AppStorage":{"abstract":[{"type":"text","text":"A property wrapper that reads and writes to persistent storage."}],"url":"\/documentation\/tuikit\/appstorage","role":"symbol","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"topic","title":"AppStorage","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AppStorage"}],"navigatorTitle":[{"kind":"identifier","text":"AppStorage"}]},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"role":"collectionGroup","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","type":"topic","url":"\/documentation\/tuikit\/keyboardshortcuts","kind":"article","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"title":"Keyboard Shortcuts"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"title":"Layout System","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","type":"topic","role":"article","url":"\/documentation\/tuikit\/layoutsystem"},"doc://TUIkit/documentation/TUIkit/RenderCycle":{"kind":"article","url":"\/documentation\/tuikit\/rendercycle","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","abstract":[{"type":"text","text":"Understand how TUIkit turns your view tree into terminal output: one frame at a time."}],"title":"Render Cycle","role":"article","type":"topic"},"doc://TUIkit/documentation/TUIkit/FrameBuffer":{"type":"topic","navigatorTitle":[{"text":"FrameBuffer","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"A 2D terminal-cell buffer that views render into before flushing."}],"url":"\/documentation\/tuikit\/framebuffer","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","title":"FrameBuffer","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameBuffer","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/CustomViews":{"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"url":"\/documentation\/tuikit\/customviews","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","role":"collectionGroup","title":"Custom Views","kind":"article","type":"topic"},"tuikit-logo.png":{"type":"image","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"alt":"TUIkit Logo","identifier":"tuikit-logo.png"},"doc://TUIkit/documentation/TUIkit/EnvironmentValues":{"url":"\/documentation\/tuikit\/environmentvalues","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EnvironmentValues"}],"kind":"symbol","abstract":[{"text":"A collection of environment values propagated through the view hierarchy.","type":"text"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"EnvironmentValues"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","role":"symbol","title":"EnvironmentValues"},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"type":"topic","title":"TUIkit","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","role":"collection","url":"\/documentation\/tuikit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"kind":"symbol"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","type":"topic","title":"Appearance and Colors","url":"\/documentation\/tuikit\/appearanceandcolors","role":"article"},"doc://TUIkit/documentation/TUIkit/PaletteReference":{"url":"\/documentation\/tuikit\/palettereference","kind":"article","title":"Palette Reference","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference"},"doc://TUIk