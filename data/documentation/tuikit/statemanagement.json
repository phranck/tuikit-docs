{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}],"type":"paragraph"},{"text":"@State","anchor":"State","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true},{"type":"text","text":" for simple values owned by a single view:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"]},{"text":"Binding","anchor":"Binding","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true},{"type":"text","text":" provides a two-way connection to a value owned elsewhere. Use the "},{"type":"codeVoice","code":"$"},{"type":"text","text":" prefix on a "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" property to get its binding:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"]},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let binding = Binding.constant(42)"]},{"text":"@Environment","anchor":"Environment","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true},{"type":"text","text":" provides values propagated down the view hierarchy:"}],"type":"paragraph"},{"code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Defining Custom Environment Keys","level":3,"anchor":"Defining-Custom-Environment-Keys","type":"heading"},{"code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Inject values with the "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"syntax":"swift","type":"codeListing"},{"text":"@AppStorage","level":2,"anchor":"AppStorage","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"},{"text":" persists values across app launches using the application’s","type":"text"},{"text":" ","type":"text"},{"text":"runtime-owned storage backend. TUIkit apps use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage"},{"text":" by default:","type":"text"}],"type":"paragraph"},{"code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}],"type":"paragraph"},{"type":"codeListing","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"syntax":"swift"},{"type":"heading","text":"How State Survives Re-Rendering","anchor":"How-State-Survives-Re-Rendering","level":2},{"inlineContent":[{"text":"TUIkit re-evaluates the entire view tree on every frame. When ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" is called, views are","type":"text"},{"text":" ","type":"text"},{"text":"reconstructed from scratch. Despite this, ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values persist: they are never reset","type":"text"},{"text":" ","type":"text"},{"text":"to their initial value.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Structural Identity","anchor":"Structural-Identity","level":3},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view’s type name"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Its position among siblings (child index)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Conditional branches (","type":"text"},{"type":"codeVoice","code":"true"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"false"},{"text":" for ","type":"text"},{"type":"codeVoice","code":"if"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"else"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}]}]}]},{"type":"heading","text":"Persistent State Storage","anchor":"Persistent-State-Storage","level":3},{"inlineContent":[{"text":"All ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values live in the owning runtime’s ","type":"text"},{"type":"codeVoice","code":"StateStorage"},{"text":", keyed by:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The view’s structural identity","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"@State var count = 0"},{"type":"text","text":" is constructed, it initially holds the declared default."},{"type":"text","text":" "},{"type":"text","text":"Immediately before the renderer evaluates that view’s "},{"type":"codeVoice","code":"body"},{"type":"text","text":", it binds each direct dynamic"},{"type":"text","text":" "},{"type":"text","text":"property to the persistent location at the view’s final structural identity. A reconstructed"},{"type":"text","text":" "},{"type":"text","text":"view therefore reads the stored value instead of resetting to its default."}],"type":"paragraph"},{"type":"heading","text":"Re-Render Trigger","anchor":"Re-Render-Trigger","level":3},{"inlineContent":[{"type":"text","text":"When a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" value changes:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"StateBox"},{"type":"text","text":" sends a subtree invalidation to its runtime’s "},{"type":"codeVoice","code":"RenderInvalidationSink"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That runtime’s "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" notifies the observer registered by "},{"type":"codeVoice","code":"AppRunner"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The main loop re-evaluates "},{"type":"codeVoice","code":"app.body"},{"type":"text","text":" fresh: reconstructing all views"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The renderer rebinds each view’s dynamic properties to the same runtime’s "},{"type":"codeVoice","code":"StateStorage"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The owning runtime clears the affected cached subtree and writes the new "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true}]}]}]},{"inlineContent":[{"type":"text","text":"Observable dependencies read while evaluating "},{"type":"codeVoice","code":"body"},{"type":"text","text":" are tracked at the same committed"},{"type":"text","text":" "},{"type":"text","text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks"},{"type":"text","text":" "},{"type":"text","text":"from earlier view values become inert. Registrations are removed when their identity unmounts."}],"type":"paragraph"},{"type":"heading","text":"Garbage Collection","anchor":"Garbage-Collection","level":3},{"inlineContent":[{"type":"text","text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state"},{"type":"text","text":" "},{"type":"text","text":"automatically cleaned up at the end of each render pass. "},{"type":"codeVoice","code":"ConditionalView"},{"type":"text","text":" also immediately"},{"type":"text","text":" "},{"type":"text","text":"invalidates the inactive branch’s state to prevent stale values."}],"type":"paragraph"},{"inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference"},{"text":" for details on the output optimization pipeline.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"anchor":"Guides"}],"variants":[{"paths":["\/documentation\/tuikit\/statemanagement"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"role":"article","modules":[{"name":"TUIkit"}],"title":"State Management","roleHeading":"Article"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/ListAndTable":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","role":"article","type":"topic","abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"url":"\/documentation\/tuikit\/listandtable","title":"List and Table Components","kind":"article"},"doc://TUIkit/documentation/TUIkit