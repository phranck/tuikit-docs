{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"State Management","modules":[{"name":"TUIkit"}],"roleHeading":"Article"},"abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/statemanagement"]}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit provides a state management system modeled after SwiftUI. When state changes, the view tree is automatically re-rendered.","type":"text"}],"type":"paragraph"},{"text":"@State","level":2,"anchor":"State","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference"},{"text":" for simple values owned by a single view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct CounterView: View {","    @State var count = 0","","    var body: some View {","        VStack {","            Text(\"Count: \\(count)\")","            Button(\"Increment\") {","                count += 1  \/\/ Triggers re-render","            }","        }","    }","}"],"type":"codeListing"},{"text":"Binding","level":2,"anchor":"Binding","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"},{"text":" provides a two-way connection to a value owned elsewhere. Use the ","type":"text"},{"code":"$","type":"codeVoice"},{"text":" prefix on a ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" property to get its binding:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ParentView: View {","    @State var selectedIndex = 0","","    var body: some View {","        Menu(items: menuItems, selection: $selectedIndex)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Create constant bindings for previews or static values:"}],"type":"paragraph"},{"syntax":"swift","code":["let binding = Binding.constant(42)"],"type":"codeListing"},{"text":"@Environment","level":2,"anchor":"Environment","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"},{"text":" provides values propagated down the view hierarchy:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct MyView: View {","    @Environment(\\.theme) var theme","    @Environment(\\.statusBar) var statusBar","","    var body: some View {","        Text(\"Themed text\")","            .foregroundColor(theme.foreground)","    }","}"],"type":"codeListing"},{"text":"Defining Custom Environment Keys","level":3,"anchor":"Defining-Custom-Environment-Keys","type":"heading"},{"syntax":"swift","code":["struct MyCustomKey: EnvironmentKey {","    static var defaultValue: String = \"default\"","}","","extension EnvironmentValues {","    var myCustomValue: String {","        get { self[MyCustomKey.self] }","        set { self[MyCustomKey.self] = newValue }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Inject values with the ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ContentView()","    .environment(\\.myCustomValue, \"custom\")"],"type":"codeListing"},{"text":"@AppStorage","level":2,"anchor":"AppStorage","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true},{"type":"text","text":" persists values across app launches using the application’s"},{"type":"text","text":" "},{"type":"text","text":"runtime-owned storage backend. TUIkit apps use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/JSONFileStorage","isActive":true},{"type":"text","text":" by default:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsView: View {","    @AppStorage(\"username\") var username = \"Guest\"","","    var body: some View {","        Text(\"Hello, \\(username)!\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Pass an explicit backend when a property wrapper is created outside the app"},{"type":"text","text":" "},{"type":"text","text":"runtime or needs dedicated storage:"}],"type":"paragraph"},{"syntax":"swift","code":["@AppStorage(\"username\", storage: MyStorageBackend()) var username = \"Guest\""],"type":"codeListing"},{"text":"How State Survives Re-Rendering","level":2,"anchor":"How-State-Survives-Re-Rendering","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit re-evaluates the entire view tree on every frame. When "},{"type":"codeVoice","code":"body"},{"type":"text","text":" is called, views are"},{"type":"text","text":" "},{"type":"text","text":"reconstructed from scratch. Despite this, "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values persist: they are never reset"},{"type":"text","text":" "},{"type":"text","text":"to their initial value."}],"type":"paragraph"},{"text":"Structural Identity","level":3,"anchor":"Structural-Identity","type":"heading"},{"inlineContent":[{"type":"text","text":"Each view in the tree has a "},{"type":"strong","inlineContent":[{"type":"text","text":"structural identity"}]},{"type":"text","text":": a path like "},{"type":"codeVoice","code":"\"ContentView\/VStack.0\/Menu\""},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"This path is built automatically during rendering based on:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s type name"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Its position among siblings (child index)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditional branches ("},{"type":"codeVoice","code":"true"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":"if"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"else"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Nested modifier and runtime slots"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Persistent State Storage","level":3,"anchor":"Persistent-State-Storage","type":"heading"},{"inlineContent":[{"text":"All ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values live in the owning runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"},{"text":", keyed by:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The view’s structural identity"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The property’s declaration index within the view (0, 1, 2, …)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"@State var count = 0","type":"codeVoice"},{"text":" is constructed, it initially holds the declared default.","type":"text"},{"text":" ","type":"text"},{"text":"Immediately before the renderer evaluates that view’s ","type":"text"},{"code":"body","type":"codeVoice"},{"text":", it binds each direct dynamic","type":"text"},{"text":" ","type":"text"},{"text":"property to the persistent location at the view’s final structural identity. A reconstructed","type":"text"},{"text":" ","type":"text"},{"text":"view therefore reads the stored value instead of resetting to its default.","type":"text"}],"type":"paragraph"},{"text":"Re-Render Trigger","level":3,"anchor":"Re-Render-Trigger","type":"heading"},{"inlineContent":[{"type":"text","text":"When a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},{"type":"text","text":" value changes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"StateBox","type":"codeVoice"},{"text":" sends a subtree invalidation to its runtime’s ","type":"text"},{"code":"RenderInvalidationSink","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That runtime’s "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" notifies the observer registered by "},{"code":"AppRunner","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"The main loop re-evaluates ","type":"text"},{"code":"app.body","type":"codeVoice"},{"text":" fresh: reconstructing all views","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The renderer rebinds each view’s dynamic properties to the same runtime’s ","type":"text"},{"code":"StateStorage","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The owning runtime clears the affected cached subtree and writes the new "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Observable dependencies read while evaluating "},{"type":"codeVoice","code":"body"},{"type":"text","text":" are tracked at the same committed"},{"type":"text","text":" "},{"type":"text","text":"identity. Re-evaluating an identity replaces its active observation generation, so callbacks"},{"type":"text","text":" "},{"type":"text","text":"from earlier view values become inert. Registrations are removed when their identity unmounts."}],"type":"paragraph"},{"text":"Garbage Collection","level":3,"anchor":"Garbage-Collection","type":"heading"},{"inlineContent":[{"text":"Views that disappear from the tree (e.g., a conditional branch switches) have their state","type":"text"},{"text":" ","type":"text"},{"text":"automatically cleaned up at the end of each render pass. ","type":"text"},{"code":"ConditionalView","type":"codeVoice"},{"text":" also immediately","type":"text"},{"text":" ","type":"text"},{"text":"invalidates the inactive branch’s state to prevent stale values.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This is simple and predictable: the view tree is fully re-evaluated each frame (no virtual DOM), with persistent state. Terminal output is then diffed at the line level: only changed lines are written. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","type":"reference","isActive":true},{"text":" for details on the output optimization pipeline.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"kind":"article","url":"\/documentation\/tuikit\/appearanceandcolors","abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","title":"Appearance and Colors","role":"article","type":"topic"},"doc://TUIkit/docume