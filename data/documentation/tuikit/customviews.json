{"kind":"article","abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"topicSections":[{"title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"],"anchor":"Protocols"},{"title":"Supporting Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"],"anchor":"Supporting-Types"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Approach","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When to Use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complexity"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Composite View","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true,"type":"reference"},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}]}],[{"inlineContent":[{"text":"Combining existing views into reusable components","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View Modifier","type":"text"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"inlineContent":[{"type":"text","text":"composite views"}],"type":"strong"},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"anchor":"Composite-Views","type":"heading","text":"Composite Views"},{"type":"paragraph","inlineContent":[{"text":"A composite view implements the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}]},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Accepting-Child-Content","type":"heading","text":"Accepting Child Content"},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Building-Custom-Containers","type":"heading","text":"Building Custom Containers"},{"type":"paragraph","inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"text":", or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"text":":","type":"text"}]},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","  