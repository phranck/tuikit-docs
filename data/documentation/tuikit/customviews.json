{"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Approach","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When to Use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complexity"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Composite View","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"View"},{"type":"text","text":" with "},{"type":"codeVoice","code":"body"},{"type":"text","text":")"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"View Modifier"}],"type":"strong"},{"text":" (","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Medium"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Composite-Views","text":"Composite Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A composite view implements the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}]},{"syntax":"swift","type":"codeListing","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"]},{"type":"heading","level":3,"anchor":"Accepting-Child-Content","text":"Accepting Child Content"},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}]},{"syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing"},{"level":3,"type":"heading","text":"Building Custom Containers","anchor":"Building-Custom-Containers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", or "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"type":"text","text":":"}]},{"syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"View Modifiers","anchor":"View-Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" transforms an already-rendered ","type":"text"},{"code":"FrameBuffer","type":"codeVoice"},{"text":". Use this when your transformation operates on the output of any view:","type":"text"}]},{"syntax":"swift","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply it using "},{"type":"codeVoice","code":".modifier(_:)"},{"type":"text","text":":"}]},{"syntax":"swift","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"],"type":"codeListing"},{"level":3,"type":"heading","text":"Convenience Extensions","anchor":"Convenience-Extensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}]},{"syntax":"swift","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"],"type":"codeListing"},{"level":3,"type":"heading","text":"When to Use ViewModifier","anchor":"When-to-Use-ViewModifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"type":"codeVoice","code":"RenderContext"},{"type":"text","text":" gives you access to:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableWidth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum width in columns for this view","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"availableHeight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum height in rows for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Current ","type":"text"},{"type":"codeVoice","code":"EnvironmentValues"},{"text":" (palette, focus manager, etc.)","type":"text"}]}]]],"type":"table","header":"row"},{"level":2,"type":"heading","text":"Type Erasure with AnyView","anchor":"Type-Erasure-with-AnyView"},{"type":"paragraph","inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":":","type":"text"}]},{"syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"code":"some View","type":"codeVoice"},{"type":"text","text":" return types over "},{"code":"AnyView","type":"codeVoice"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"kind":"article","sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"title":"Custom Views","role":"collectionGroup"},"schemaVersion":{"m