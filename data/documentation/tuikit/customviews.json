Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View Modifier","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"text":"composite views","type":"text"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Composite-Views","type":"heading","text":"Composite Views","level":2},{"inlineContent":[{"type":"text","text":"A composite view implements the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"]},{"anchor":"Accepting-Child-Content","type":"heading","text":"Accepting Child Content","level":3},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"]},{"anchor":"Building-Custom-Containers","type":"heading","text":"Building Custom Containers","level":3},{"inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true,"type":"reference"},{"text":", or ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"anchor":"View-Modifiers","type":"heading","text":"View Modifiers","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"]},{"inlineContent":[{"type":"text","text":"Apply it using "},{"code":".modifier(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"]},{"anchor":"Convenience-Extensions","type":"heading","text":"Convenience Extensions","level":3},{"inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"I