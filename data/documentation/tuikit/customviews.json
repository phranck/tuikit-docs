,"            }","        )","    }","}"]},{"inlineContent":[{"text":"Or use the convenience method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let view = Text(\"Hello\").asAnyView()"]},{"inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","code":"AnyView"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"kind":"article","references":{"doc://TUIkit/documentation/TUIkit/Dialog":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Dialog","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","role":"symbol","type":"topic","title":"Dialog","abstract":[{"type":"text","text":"A modal dialog view with a title, customizable content, and optional footer."}],"kind":"symbol","navigatorTitle":[{"text":"Dialog","kind":"identifier"}],"url":"\/documentation\/tuikit\/dialog"},"tuikit-logo.png":{"alt":"TUIkit Logo","type":"image","identifier":"tuikit-logo.png","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}]},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"role":"article","title":"Layout System","type":"topic","kind":"article","url":"\/documentation\/tuikit\/layoutsystem","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},"do