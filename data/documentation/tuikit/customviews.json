{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Approach"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to Use"}]}],[{"type":"paragraph","inlineContent":[{"text":"Complexity","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Composite View"}],"type":"strong"},{"type":"text","text":" ("},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","type":"reference","isActive":true},{"type":"text","text":" with "},{"code":"body","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"View Modifier","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Medium","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"inlineContent":[{"type":"text","text":"composite views"}],"type":"strong"},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Composite-Views","text":"Composite Views","level":2,"type":"heading"},{"inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}],"type":"paragraph"},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" property is annotated with ","type":"text"},{"type":"codeVoice","code":"@ViewBuilder"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}],"type":"paragraph"},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Accepting-Child-Content","text":"Accepting Child Content","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Building-Custom-Containers","text":"Building Custom Containers","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true,"type":"reference"},{"type":"text","text":", or "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"syntax":"swift","type":"codeListing"},{"anchor":"View-Modifiers","text":"View Modifiers","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"type":"text","text":" transforms an already-rendered "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}],"type":"paragraph"},{"code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Apply it using ","type":"text"},{"type":"codeVoice","code":".modifier(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"],"syntax":"swift","type":"codeListing"},{"anchor":"Convenience-Extensions","text":"Convenience Extensions","level":3,"type":"heading"},{"inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" extension:","type":"text"}],"type":"paragraph"},{"code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"],"syntax":"swift","type":"codeListing"},{"anchor":"When-to-Use-ViewModifier","text":"When to Use ViewModifier","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference"},{"type":"text","text":" gives you access to:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"availableWidth"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"availableHeight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Maximum height in rows for this view"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Current ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"},{"text":" (palette, focus manager, etc.)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"Type-Erasure-with-AnyView","text":"Type Erasure with AnyView","level":2,"type":"heading"},{"inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use the convenience method:"}],"type":"paragraph"},{"code":["let view = Text(\"Hello\").asAnyView()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","code":"AnyView"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}]}],"type":"aside"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"sections":[],"metadata":{"title":"Custom Views","roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"TUIkit"}]},"topicSections":[{"anchor":"Protocols","title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"]},{"anchor":"Supporting-Types","title":"Supporting Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\