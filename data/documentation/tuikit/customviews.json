          }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Or use the convenience method:","type":"text"}],"type":"paragraph"},{"code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"code":"some View","type":"codeVoice"},{"type":"text","text":" return types over "},{"code":"AnyView","type":"codeVoice"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}],"type":"paragraph"}],"type":"aside"}]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","interfaceLanguage":"swift"},"references":{"doc://TUIkit/documentation/TUIkit/FocusSystem":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"title":"Focus System","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"kind":"article","role":"collectionGroup","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"title":"Keyboard Shortcuts","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","url":"\/documentation\/tuikit\/keyboardshortcuts"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"role":"article","title":"List and Table Components","url":"\/documentation\/tuikit\/listandtable","kind":"article","identifier":"doc:\/\/TU