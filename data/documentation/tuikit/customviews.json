{"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to Use","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Composite View"}],"type":"strong"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"text":"View Modifier","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"inlineContent":[{"type":"text","text":"composite views"}],"type":"strong"},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Composite Views","type":"heading","anchor":"Composite-Views","level":2},{"inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}],"type":"paragraph"},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}],"type":"paragraph"},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Accepting Child Content","type":"heading","anchor":"Accepting-Child-Content","level":3},{"inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}],"type":"paragraph"},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing","syntax":"swift"},{"text":"Building Custom Containers","type":"heading","anchor":"Building-Custom-Containers","level":3},{"inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference","isActive":true},{"type":"text","text":", or "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing","syntax":"swift"},{"text":"View Modifiers","type":"heading","anchor":"View-Modifiers","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"text":" transforms an already-rendered ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"text":". Use this when your transformation operates on the output of any view:","type":"text"}],"type":"paragraph"},{"code":["struct IndentModifier: ViewModifier {","    let columns: Int","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        var result = FrameBuffer(","            emptyWithWidth: max(0, columns),","            height: buffer.height","        )","        if !buffer.isEmpty {","            result.appendHorizontally(buffer)","        }","        return result","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Text(\"Indented\")","    .modifier(IndentModifier(columns: 2))"],"type":"codeListing","syntax":"swift"},{"text":"Convenience Extensions","type":"heading","anchor":"Convenience-Extensions","level":3},{"inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}],"type":"paragraph"},{"code":["extension View {","    func indented(_ columns: Int = 2) -> some View {","        modifier(IndentModifier(columns: columns))","    }","}","","\/\/ Usage","Text(\"Indented\").indented(4)"],"type":"codeListing","syntax":"swift"},{"text":"When to Use ViewModifier","type":"heading","anchor":"When-to-Use-ViewModifier","level":3},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":" gives you access to:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"availableWidth"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum width in columns for this view","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableHeight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum height in rows for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]]},{"text":"Type Erasure with AnyView","type":"heading","anchor":"Type-Erasure-with-AnyView","level":2},{"inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Or use the convenience method:","type":"text"}],"type":"paragraph"},{"code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"name":"Tip","style":"tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"code":"some View","type":"codeVoice"},{"text":" return types over ","type":"text"},{"code":"AnyView","type":"codeVoice"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}]}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Custom Views"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"topicSections":[{"title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"],"anchor":"Protocols"},{"title":"Supporting Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"],"anchor":"Supporting-Types"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\