{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"When to Use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Complexity","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Composite View"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"View"},{"type":"text","text":" with "},{"type":"codeVoice","code":"body"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"View Modifier"}],"type":"strong"},{"text":" (","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":")","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"Most custom views should be ","type":"text"},{"inlineContent":[{"text":"composite views","type":"text"}],"type":"strong"},{"text":". For buffer-level transformations, implement a custom ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Composite-Views","text":"Composite Views"},{"inlineContent":[{"type":"text","text":"A composite view implements the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"]},{"level":3,"type":"heading","anchor":"Accepting-Child-Content","text":"Accepting Child Content"},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"code":"@ViewBuilder","type":"codeVoice"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"]},{"level":3,"text":"Building Custom Containers","type":"heading","anchor":"Building-Custom-Containers"},{"inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"level":2,"text":"View Modifiers","type":"heading","anchor":"View-Modifiers"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"ViewModifier"},{"text":" transforms an already-rendered ","type":"text"},{"type":"codeVoice","code":"FrameBuffer"},{"text":". Use this when your transformation operates on the output of any view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"]},{"inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"]},{"level":3,"text":"Convenience Extensions","type":"heading","anchor":"Convenience-Extensions"},{"type":"paragraph","inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" extension:","type":"text"}]},{"syntax":"swift","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"],"type":"codeListing"},{"level":3,"anchor":"When-to-Use-ViewModifier","text":"When to Use ViewModifier","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The ","type":"text"},{"code":"RenderContext","type":"codeVoice"},{"text":" gives you access to:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableWidth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"availableHeight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum height in rows for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"code":"EnvironmentValues","type":"codeVoice"},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]],"type":"table","header":"row"},{"level":2,"anchor":"Type-Erasure-with-AnyView","text":"Type Erasure with AnyView","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":":","type":"text"}]},{"syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Or use the convenience method:","type":"text"}]},{"syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnyView"},{"type":"text","text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior."}]},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"type":"codeVoice","code":"some View"},{"text":" return types over ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}]}],"type":"aside"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"maj