":"strong"},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Medium","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"inlineContent":[{"text":"composite views","type":"text"}],"type":"strong"},{"text":". For buffer-level transformations, implement a custom ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Composite Views","anchor":"Composite-Views","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A composite view implements the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}],"type":"paragraph"},{"syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}],"type":"paragraph"},{"syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing"},{"text":"Accepting Child Content","anchor":"Accepting-Child-Content","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"]},{"level":3,"anchor":"Building-Custom-Containers","type":"heading","text":"Building Custom Containers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"type":"text","text":", or "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"level":2,"anchor":"View-Modifiers","type":"heading","text":"View Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}]},{"type":"codeListing","syntax":"swift","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply it using "},{"type":"codeVoice","code":".modifier(_:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"]},{"level":3,"anchor":"Convenience-Extensions","type":"heading","text":"Convenience Extensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}]},{"type":"codeListing","code":["extension View {","    func highlighted(_ color: Color = .red) -> some V