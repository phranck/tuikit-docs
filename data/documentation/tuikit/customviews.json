{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Custom Views"},"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides","generated":true,"anchor":"Guides"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Approach"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to Use"}]}],[{"type":"paragraph","inlineContent":[{"text":"Complexity","type":"text"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Composite View","type":"text"}]},{"type":"text","text":" ("},{"code":"View","type":"codeVoice"},{"type":"text","text":" with "},{"code":"body","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"Most custom views should be ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"text":". For buffer-level transformations, implement a custom ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Composite Views","type":"heading","anchor":"Composite-Views","level":2},{"inlineContent":[{"type":"text","text":"A composite view implements the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}],"type":"paragraph"},{"type":"codeListing","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property is annotated with "},{"code":"@ViewBuilder","type":"codeVoice"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}],"type":"paragraph"},{"type":"codeListing","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift"},{"text":"Accepting Child Content","type":"heading","anchor":"Accepting-Child-Content","level":3},{"inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift"},{"text":"Building Custom Containers","type":"heading","anchor":"Building-Custom-Containers","level":3},{"inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"syntax":"swift"},{"text":"View Modifiers","type":"heading","anchor":"View-Modifiers","level":2},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}],"type":"paragraph"},{"type":"codeListing","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"Apply it using ","type":"text"},{"type":"codeVoice","code":".modifier(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"],"syntax":"swift"},{"text":"Convenience Extensions","type":"heading","anchor":"Convenience-Extensions","level":3},{"inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extension:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"],"syntax":"swift"},{"text":"When to Use ViewModifier","type":"heading","anchor":"When-to-Use-ViewModifier","level":3},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"ViewModifier"},{"text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The ","type":"text"},{"type":"codeVoice","code":"RenderContext"},{"text":" gives you access to:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"availableWidth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Maximum width in columns for this view","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"availableHeight","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"environment","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Current "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" (palette, focus manager, etc.)"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"Type Erasure with AnyView","type":"heading","anchor":"Type-Erasure-with-AnyView","level":2},{"inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Or use the convenience method:"}],"type":"paragraph"},{"type":"codeListing","code":["let view = Text(\"Hello\").asAnyView()"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"style":"tip","type":"aside","content":[{"inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"type":"codeVoice","code":"some View"},{"text":" return types over ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}],"type":"paragraph"}],"name":"Tip"}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"type":"topic","kind":"article","title":"Palette Reference","url":"\/documentation\/tuikit\/palettereference","role":"collectionGroup","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference"},"doc://TUIkit/documentation/TUIkit/Panel":{"title":"Panel","type":"topic","kind":"symbol","url":"\/documentation\/tuikit\/panel","abstract":[{"text":"A labeled container — always has a title, optionally a footer.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Panel","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"Panel","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"kind":"symbol","