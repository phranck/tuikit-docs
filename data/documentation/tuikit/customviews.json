codeListing","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"]},{"anchor":"Accepting-Child-Content","text":"Accepting Child Content","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"type":"codeVoice","code":"@ViewBuilder"},{"text":" closure parameter:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"]},{"anchor":"Building-Custom-Containers","type":"heading","level":3,"text":"Building Custom Containers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true},{"type":"text","text":", or "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"anchor":"View-Modifiers","type":"heading","level":2,"text":"View Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}]},{"syntax":"swift","type":"codeListing","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply it using "},{"code":".modifier(_:)","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"]},{"anchor":"Convenience-Extensions","type":"heading","level":3,"text":"Convenience Extensions"},{"inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}],"type":"paragraph"},{"code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Impor