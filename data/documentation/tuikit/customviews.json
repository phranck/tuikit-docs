{"abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Guides","anchor":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Approach","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When to Use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complexity"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Composite View"}],"type":"strong"},{"type":"text","text":" ("},{"code":"View","type":"codeVoice"},{"type":"text","text":" with "},{"code":"body","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Low"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"ViewModifier"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Medium","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Most custom views should be ","type":"text"},{"inlineContent":[{"type":"text","text":"composite views"}],"type":"strong"},{"text":". For buffer-level transformations, implement a custom ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Composite Views","type":"heading","level":2,"anchor":"Composite-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A composite view implements the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}]},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Accepting Child Content","type":"heading","level":3,"anchor":"Accepting-Child-Content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"code":"@ViewBuilder","type":"codeVoice"},{"type":"text","text":" closure parameter:"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Building Custom Containers","type":"heading","level":3,"anchor":"Building-Custom-Containers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", or "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"type":"heading","level":2,"text":"View Modifiers","anchor":"View-Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}]},{"type":"codeListing","syntax":"swift","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Apply it using ","type":"text"},{"type":"codeVoice","code":".modifier(_:)"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"]},{"type":"heading","level":3,"text":"Convenience Extensions","anchor":"Convenience-Extensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}]},{"type":"codeListing","syntax":"swift","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"]},{"type":"heading","level":3,"text":"When to Use ViewModifier","anchor":"When-to-Use-ViewModifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"code":"RenderContext","type":"codeVoice"},{"type":"text","text":" gives you access to:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"availableWidth"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableHeight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]]},{"type":"heading","level":2,"text":"Type Erasure with AnyView","anchor":"Type-Erasure-with-AnyView"},{"type":"paragraph","inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"code":"AnyView","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"]},{"type":"paragraph","inlineCont