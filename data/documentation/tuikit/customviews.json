{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","interfaceLanguage":"swift"},"abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"metadata":{"role":"collectionGroup","title":"Custom Views","modules":[{"name":"TUIkit"}]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Approach"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When to Use"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Composite View"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"View"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"body"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Low","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View Modifier","type":"text"}]},{"type":"text","text":" ("},{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Composite Views","anchor":"Composite-Views","type":"heading"},{"inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" property is annotated with ","type":"text"},{"type":"codeVoice","code":"@ViewBuilder"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing"},{"level":3,"text":"Accepting Child Content","anchor":"Accepting-Child-Content","type":"heading"},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing"},{"level":3,"text":"Building Custom Containers","anchor":"Building-Custom-Containers","type":"heading"},{"inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true,"type":"reference"},{"text":", or ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true,"type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing"},{"level":2,"text":"View Modifiers","anchor":"View-Modifiers","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}],"type":"paragraph"},{"syntax":"swift","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"],"type":"codeListing"},{"level":3,"text":"Convenience Extensions","anchor":"Convenience-Extensions","type":"heading"},{"inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"type":"codeVoice","code":"View"},{"text":" extension:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"],"type":"codeListing"},{"level":3,"text":"When to Use ViewModifier","anchor":"When-to-Use-ViewModifier","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"ViewModifier","type":"codeVoice"},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"code":"RenderContext","type":"codeVoice"},{"type":"text","text":" gives you access to:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"availableWidth"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"availableHeight"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"environment"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Current ","type":"text"},{"code":"EnvironmentValues","type":"codeVoice"},{"text":" (palette, focus manager, etc.)","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"text":"Type Erasure with AnyView","anchor":"Type-Erasure-with-AnyView","type":"heading"},{"inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"code":"AnyView","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Or use the convenience method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"AnyView"},{"type":"text","text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior."}],"type":"paragraph"},{"name":"Tip","content":[{"inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"type":"codeVoice","code":"some View"},{"text":" return types over ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}],"type":"paragraph"}],"style":"tip","type":"aside"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/Card":{"abstract":[{"type":"text","text":"A padded, optionally titled container with background support."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Card"}],"url":"\/documentation\/tuikit\/card","navigatorTitle":[{"kind":"identifier","text":"Card"}],"title":"Card","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"topic"},"doc://TUIkit/documentation/TUIkit/PaletteReference":{"role":"collectionGroup","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","type":"topic","abstract":[{"text":"A visual reference for all built-in color palettes with their exact color values.","type":"text"}],"kind":"article","url":"\/documentation\/tuikit\/palettereference","title":"Palette Reference"},"tuikit-logo.png":{"identifier":"tuikit-logo.png","alt":"TUIkit Logo","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"type":"image"