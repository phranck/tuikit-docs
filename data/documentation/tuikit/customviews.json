{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"topicSections":[{"anchor":"Protocols","title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"]},{"anchor":"Supporting-Types","title":"Supporting Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"]}],"abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When to Use"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Composite View","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","type":"reference","isActive":true},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Composite-Views","level":2,"type":"heading","text":"Composite Views"},{"inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}],"type":"paragraph"},{"syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"Accepting-Child-Content","level":3,"type":"heading","text":"Accepting Child Content"},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing"},{"anchor":"Building-Custom-Containers","level":3,"type":"heading","text":"Building Custom Containers"},{"inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing"},{"anchor":"View-Modifiers","level":2,"type":"heading","text":"View Modifiers"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" transforms an already-rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}],"type":"paragraph"},{"syntax":"swift","code":["struct IndentModifier: ViewModifier {","    let columns: Int","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        var result = FrameBuffer(","            emptyWithWidth: max(0, columns),","            height: buffer.height","        )","        if !buffer.isEmpty {","            result.appendHorizontally(buffer)","        }","        return result","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Apply it using "},{"code":".modifier(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Indented\")","    .modifier(IndentModifier(columns: 2))"],"type":"codeListing"},{"anchor":"Convenience-Extensions","level":3,"type":"heading","text":"Convenience Extensions"},{"inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}],"type":"paragraph"},{"syntax":"swift","code":["extension View {","    func indented(_ columns: Int = 2) -> some View {","        modifier(IndentModifier(columns: columns))","    }","}","","\/\/ Usage","Text(\"Indented\").indented(4)"],"type":"codeListing"},{"anchor":"When-to-Use-ViewModifier","level":3,"type":"heading","text":"When to Use ViewModifier"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"text":" gives you access to:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"availableWidth"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum width in columns for this view","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableHeight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum height in rows for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]]},{"anchor":"Type-Erasure-with-AnyView","level":2,"type":"heading","text":"Type Erasure with AnyView"},{"inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Or use the convenience method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"code":"some View","type":"codeVoice"},{"type":"text","text":" return types over "},{"code":"AnyView","type":"codeVoice"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}],"type":"paragraph"}],"style":"tip","type":"aside","name":"Tip"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"metadata":{"title":"Custom Views","r