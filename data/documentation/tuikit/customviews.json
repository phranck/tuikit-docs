{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to Use","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Composite View"}],"type":"strong"},{"text":" (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Combining existing views into reusable components","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Medium"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"text":"composite views","type":"text"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Composite Views","level":2,"anchor":"Composite-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A composite view implements the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}]},{"type":"codeListing","syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"]},{"type":"heading","text":"Accepting Child Content","level":3,"anchor":"Accepting-Child-Content"},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"]},{"type":"heading","text":"Building Custom Containers","level":3,"anchor":"Building-Custom-Containers"},{"type":"paragraph","inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"type":"heading","text":"View Modifiers","level":2,"anchor":"View-Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" composes a replacement view around the content it is"},{"type":"text","text":" "},{"type":"text","text":"applied to — exactly like SwiftUI. Implement "},{"type":"codeVoice","code":"body(content:)"},{"type":"text","text":" and place the"},{"type":"text","text":" "},{"type":"text","text":"received "},{"type":"codeVoice","code":"content"},{"type":"text","text":" placeholder wherever the modified view should appear:"}]},{"type":"codeListing","syntax":"swift","code":["struct SectionCard: ViewModifier {","    let title: String","","    func body(content: Content) -> some View {","        VStack {","            Text(title).bold()","            content","        }","        .padding()","        .border()","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":", which produces a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","isActive":true,"type":"reference"},{"text":" value:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Details\")","    .modifier(SectionCard(title: \"Info\"))"]},{"type":"heading","text":"Convenience Extensions","level":3,"anchor":"Convenience-Extensions"},{"type":"paragraph","inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extension:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension View {","    func sectionCard(_ title: String) -> some View {","        modifier(SectionCard(title: title))","    }","}","","\/\/ Usage","Text(\"Details\").sectionCard(\"Info\")"]},{"type":"heading","text":"When to Use ViewModifier","level":3,"anchor":"When-to-Use-ViewModifier"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"text":" whenever a reusable decoration or wrapping applies to","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary content: cards, frames, badges, spacing conventions, environment","type":"text"},{"text":" ","type":"text"},{"text":"tweaks. Everything the modifier body sets (environment values, padding,","type":"text"},{"text":" ","type":"text"},{"text":"borders) flows into the wrapped content exactly as if it were written","type":"text"},{"text":" ","type":"text"},{"text":"inline. Procedural buffer transformations remain framework-internal; custom","type":"text"},{"text":" ","type":"text"},{"text":"modifiers compose existing views and modifiers instead.","type":"text"}]},{"type":"heading","text":"Type Erasure with AnyView","level":2,"anchor":"Type-Erasure-with-AnyView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"type":"codeListing","syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"]},{"type":"paragraph","inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","code":"AnyView"},{"type":"text","text":". Type erasure should be a last resor