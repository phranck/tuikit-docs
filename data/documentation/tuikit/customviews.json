{"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"],"anchor":"Protocols","title":"Protocols"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"],"anchor":"Supporting-Types","title":"Supporting Types"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true,"title":"Guides"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to Use","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Composite View"}],"type":"strong"},{"text":" (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true,"type":"reference"},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"View Modifier"}],"type":"strong"},{"type":"text","text":" ("},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Medium"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Composite Views","type":"heading","level":2,"anchor":"Composite-Views"},{"inlineContent":[{"type":"text","text":"A composite view implements the "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}],"type":"paragraph"},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}],"type":"paragraph"},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Accepting Child Content","type":"heading","level":3,"anchor":"Accepting-Child-Content"},{"inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}],"type":"paragraph"},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift","type":"codeListing"},{"text":"Building Custom Containers","type":"heading","level":3,"anchor":"Building-Custom-Containers"},{"inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true},{"type":"text","text":", or "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"syntax":"swift","type":"codeListing"},{"text":"View Modifiers","type":"heading","level":2,"anchor":"View-Modifiers"},{"inlineContent":[{"text":"A ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"text":" transforms an already-rendered ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":". Use this when your transformation operates on the output of any view:","type":"text"}],"type":"paragraph"},{"code":["struct IndentModifier: ViewModifier {","    let columns: Int","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        var result = FrameBuffer(","            emptyWithWidth: max(0, columns),","            height: buffer.height","        )","        if !buffer.isEmpty {","            result.appendHorizontally(buffer)","        }","        return result","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Text(\"Indented\")","    .modifier(IndentModifier(columns: 2))"],"syntax":"swift","type":"codeListing"},{"text":"Convenience Extensions","type":"heading","level":3,"anchor":"Convenience-Extensions"},{"inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extension:","type":"text"}],"type":"paragraph"},{"code":["extension View {","    func indented(_ columns: Int = 2) -> some View {","        modifier(IndentModifier(columns: columns))","    }","}","","\/\/ Usage","Text(\"Indented\").indented(4)"],"syntax":"swift","type":"codeListing"},{"text":"When to Use ViewModifier","type":"heading","level":3,"anchor":"When-to-Use-ViewModifier"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference"},{"text":" gives you access to:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableWidth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableHeight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"environment","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]],"header":"row","type":"table"},{"text":"Type Erasure with AnyView","type":"heading","level":2,"anchor":"Type-Erasure-with-AnyView"},{"inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or use the convenience method:"}],"type":"paragraph"},{"code":["let view = Text(\"Hello\").asAnyView()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}],"type":"paragraph"},{"style":"tip","name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","code":"AnyView"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}]}]}],"kind":"content"}],"kind":"article","metadata":{"roleHeading":"API Collec