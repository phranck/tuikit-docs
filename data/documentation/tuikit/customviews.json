{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to Use"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complexity"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Composite View"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true},{"type":"text","text":" with "},{"type":"codeVoice","code":"body"},{"type":"text","text":")"}]}],[{"inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"text":"composite views","type":"text"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Composite Views","anchor":"Composite-Views"},{"type":"paragraph","inlineContent":[{"text":"A composite view implements the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}]},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Accepting Child Content","anchor":"Accepting-Child-Content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Building Custom Containers","anchor":"Building-Custom-Containers"},{"type":"paragraph","inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"text":":","type":"text"}]},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"View Modifiers","anchor":"View-Modifiers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" transforms an already-rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}]},{"code":["struct IndentModifier: ViewModifier {","    let columns: Int","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        var result = FrameBuffer(","            emptyWithWidth: max(0, columns),","            height: buffer.height","        )","        if !buffer.isEmpty {","            result.appendHorizontally(buffer)","        }","        return result","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["Text(\"Indented\")","    .modifier(IndentModifier(columns: 2))"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"Convenience Extensions","anchor":"Convenience-Extensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}]},{"code":["extension View {","    func indented(_ columns: Int = 2) -> some View {","        modifier(IndentModifier(columns: columns))","    }","}","","\/\/ Usage","Text(\"Indented\").indented(4)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"When to Use ViewModifier","anchor":"When-to-Use-ViewModifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":" gives you access to:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Property"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableWidth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableHeight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum height in rows for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]],"header":"row"},{"type":"heading","level":2,"text":"Type Erasure with AnyView","anchor":"Type-Erasure-with-AnyView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","isActive":true},{"type":"text","text":":"}]},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"type":"codeVoice","code":"some View"},{"text":" return types over ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}],"type":"paragraph"}],"style":"tip","name":"Tip"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Custom Views"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"],"anchor":"Protocols","title":"Protocols"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"],"anchor":"Supporting-Types","title":"Supporting Types"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/document