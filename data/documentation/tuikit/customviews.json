{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"],"anchor":"Protocols","title":"Protocols"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"],"anchor":"Supporting-Types","title":"Supporting Types"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Approach"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to Use"}]}],[{"type":"paragraph","inlineContent":[{"text":"Complexity","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Composite View","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" with "},{"code":"body","type":"codeVoice"},{"type":"text","text":")"}]}],[{"inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"Most custom views should be ","type":"text"},{"inlineContent":[{"type":"text","text":"composite views"}],"type":"strong"},{"text":". For buffer-level transformations, implement a custom ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Composite-Views","text":"Composite Views"},{"type":"paragraph","inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}]},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property is annotated with "},{"code":"@ViewBuilder","type":"codeVoice"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Accepting-Child-Content","text":"Accepting Child Content"},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"type":"codeVoice","code":"@ViewBuilder"},{"text":" closure parameter:","type":"text"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Building-Custom-Containers","text":"Building Custom Containers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"type":"text","text":", or "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"type":"text","text":":"}]},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"View-Modifiers","text":"View Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"text":" composes a replacement view around the content it is","type":"text"},{"text":" ","type":"text"},{"text":"applied to — exactly like SwiftUI. Implement ","type":"text"},{"type":"codeVoice","code":"body(content:)"},{"text":" and place the","type":"text"},{"text":" ","type":"text"},{"text":"received ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" placeholder wherever the modified view should appear:","type":"text"}]},{"code":["struct SectionCard: ViewModifier {","    let title: String","","    func body(content: Content) -> some View {","        VStack {","            Text(title).bold()","            content","        }","        .padding()","        .border()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply it using "},{"type":"codeVoice","code":".modifier(_:)"},{"type":"text","text":", which produces a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent"},{"type":"text","text":" value:"}]},{"code":["Text(\"Details\")","    .modifier(SectionCard(title: \"Info\"))"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Convenience-Extensions","text":"Convenience Extensions"},{"type":"paragraph","inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extension:","type":"text"}]},{"code":["extension View {","    func sectionCard(_ title: String) -> some View {","        modifier(SectionCard(title: title))","    }","}","","\/\/ Usage","Text(\"Details\").sectionCard(\"Info\")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"When-to-Use-ViewModifier","text":"When to Use ViewModifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" whenever a reusable decoration or wrapping applies to"},{"type":"text","text":" "},{"type":"text","text":"arbitrary content: cards, frames, badges, spacing conventions, environment"},{"type":"text","text":" "},{"type":"text","text":"tweaks. Everything the modifier body sets (environment values, padding,"},{"type":"text","text":" "},{"type":"text","text":"borders) flows into the wrapped content exactly as if it were written"},{"type":"text","text":" "},{"type":"text","text":"inline. Procedural buffer transformations remain framework-internal; custom"},{"type":"text","text":" "},{"type":"text","text":"modifiers compose existing views and modifiers instead."}]},{"type":"heading","level":2,"anchor":"Type-Erasure-with-AnyView","text":"Type Erasure with AnyView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView"},{"type":"text","text":":"}]},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"code":"some View","type":"codeVoice"},{"text":" return types over ","type":"text"},{"code":"AnyView","type":"codeVoice"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}],"type":"paragraph"}]}],"kind":"content"}],"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"title":"Custom Views"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true,"title":"Guides"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"references":{"doc://TUIkit/documentation/TUIkit/ModifiedContent":{"url":"\/documentation\/tuikit\/modifiedcontent","abstract":[{"type":"text","text":"A value with a modifier applied to it."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","t