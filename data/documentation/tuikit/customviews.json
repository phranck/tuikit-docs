{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"title":"Custom Views","modules":[{"name":"TUIkit"}],"role":"collectionGroup","roleHeading":"API Collection"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Approach","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When to Use"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Composite View","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true,"type":"reference"},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"View Modifier","type":"text"}]},{"text":" (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Medium"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"text":"composite views","type":"text"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Composite-Views","type":"heading","level":2,"text":"Composite Views"},{"type":"paragraph","inlineContent":[{"text":"A composite view implements the ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}]},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"body"},{"text":" property is annotated with ","type":"text"},{"type":"codeVoice","code":"@ViewBuilder"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Accepting-Child-Content","type":"heading","level":3,"text":"Accepting Child Content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Building-Custom-Containers","type":"heading","level":3,"text":"Building Custom Containers"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"type":"text","text":":"}]},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing","syntax":"swift"},{"anchor":"View-Modifiers","type":"heading","level":2,"text":"View Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"text":" composes a replacement view around the content it is","type":"text"},{"text":" ","type":"text"},{"text":"applied to — exactly like SwiftUI. Implement ","type":"text"},{"type":"codeVoice","code":"body(content:)"},{"text":" and place the","type":"text"},{"text":" ","type":"text"},{"text":"received ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" placeholder wherever the modified view should appear:","type":"text"}]},{"code":["struct SectionCard: ViewModifier {","    let title: String","","    func body(content: Content) -> some View {","        VStack {","            Text(title).bold()","            content","        }","        .padding()","        .border()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apply it using ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":", which produces a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","isActive":true,"type":"reference"},{"text":" value:","type":"text"}]},{"code":["Text(\"Details\")","    .modifier(SectionCard(title: \"Info\"))"],"type":"codeListing","syntax":"swift"},{"anchor":"Convenience-Extensions","type":"heading","level":3,"text":"Convenience Extensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}]},{"code":["extension View {","    func sectionCard(_ title: String) -> some View {","        modifier(SectionCard(title: title))","    }","}","","\/\/ Usage","Text(\"Details\").sectionCard(\"Info\")"],"type":"codeListing","syntax":"swift"},{"anchor":"When-to-Use-ViewModifier","type":"heading","level":3,"text":"When to Use ViewModifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":" whenever a reusable decoration or wrapping applies to"},{"type":"text","text":" "},{"type":"text","text":"arbitrary content: cards, frames, badges, spacing conventions, environment"},{"type":"text","text":" "},{"type":"text","text":"tweaks. Everything the modifier body sets (environment values, padding,"},{"type":"text","text":" "},{"type":"text","text":"borders) flows into the wrapped content exactly as if it were written"},{"type":"text","text":" "},{"type":"text","text":"inline. Procedural buffer transformations remain framework-internal; custom"},{"type":"text","text":" "},{"type":"text","text":"modifiers compose existing views and modifiers instead."}]},{"anchor":"Type-Erasure-with-AnyView","type":"heading","level":2,"text":"Type Erasure with AnyView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you need to store views of different types in a single variable or return different view types conditionally, use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","isActive":true},{"type":"text","text":":"}]},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or use the convenience method:","type":"text"}]},{"code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","co