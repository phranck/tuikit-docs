{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/customviews"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Approach"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"When to Use","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Complexity"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Composite View","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"View","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"body","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Combining existing views into reusable components","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Low","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}]}],[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":"."}]},{"type":"heading","text":"Composite Views","anchor":"Composite-Views","level":2},{"type":"paragraph","inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}]},{"type":"codeListing","syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"body","type":"codeVoice"},{"type":"text","text":" property is annotated with "},{"code":"@ViewBuilder","type":"codeVoice"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}]},{"type":"codeListing","syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"]},{"type":"heading","text":"Accepting Child Content","anchor":"Accepting-Child-Content","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}]},{"type":"codeListing","syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"]},{"type":"heading","text":"Building Custom Containers","anchor":"Building-Custom-Containers","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference","isActive":true},{"type":"text","text":", or "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"]},{"type":"heading","text":"View Modifiers","anchor":"View-Modifiers","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" transforms an already-rendered "},{"type":"codeVoice","code":"FrameBuffer"},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}]},{"type":"codeListing","syntax":"swift","code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply it using "},{"type":"codeVoice","code":".modifier(_:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"]},{"type":"heading","text":"Convenience Extensions","anchor":"Convenience-Extensions","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"type":"codeVoice","code":"View"},{"type":"text","text":" extension:"}]},{"type":"codeListing","syntax":"swift","code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"]},{"type":"heading","text":"When to Use ViewModifier","anchor":"When-to-Use-ViewModifier","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"type":"codeVoice","code":"RenderContext"},{"type":"text","text":" gives you access to:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Property","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableWidth","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"availableHeight","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"environment"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Current "},{"code":"EnvironmentValues","type":"codeVoice"},{"type":"text","text":" (palette, focus manager, etc.)"}]}]]]},{"type":"heading","text":"Type Erasure with AnyView","anchor":"Type-Erasure-with-AnyView","level":2},{"type":"paragraph","inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"type":"codeListing","syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"]},{"type":"paragraph","inlineContent":[{"code":"AnyView","type":"codeVoice"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"type":"aside","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","code":"AnyView"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}],"type":"paragraph"}],"style":"tip"}]}],"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Custom Views"},"sections":[],"abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"references":{"doc://TUIkit/documentation/TUIkit/Card":{"url":"\/documentation\/tuikit\/card","navigatorTitle":[{"kind":"identifier","text":"Card"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","abstract":[{"type":"text","text":"A padded, optionally titled container with background support."}],"role":"symbol","kind":"symbol","title":"Card","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Card"}],"type":"topic"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"url":"\/documentation\/tuikit\/appearanceandcolors","kind":"article","title":"Appearance and Colors","abstract":[{"text":"Control border styles, visual appearances, and the color system.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","type":"topic","role":"article"},"doc://TUIkit/documentation/TUIkit/Preferences":{"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"role":"collectionGroup","url":"\/docume