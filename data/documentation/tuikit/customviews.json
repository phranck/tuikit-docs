{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Approach"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When to Use"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Complexity","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Composite View","type":"text"}]},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" with "},{"type":"codeVoice","code":"body"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Low"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"View Modifier","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Medium","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":"."}]},{"text":"Composite Views","type":"heading","anchor":"Composite-Views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A composite view implements the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}]},{"syntax":"swift","code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}]},{"syntax":"swift","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing"},{"text":"Accepting Child Content","type":"heading","anchor":"Accepting-Child-Content","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}]},{"syntax":"swift","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing"},{"text":"Building Custom Containers","type":"heading","anchor":"Building-Custom-Containers","level":3},{"type":"paragraph","inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true},{"text":", or ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true},{"text":":","type":"text"}]},{"syntax":"swift","code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing"},{"text":"View Modifiers","type":"heading","anchor":"View-Modifiers","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"text":" composes a replacement view around the content it is","type":"text"},{"text":" ","type":"text"},{"text":"applied to — exactly like SwiftUI. Implement ","type":"text"},{"type":"codeVoice","code":"body(content:)"},{"text":" and place the","type":"text"},{"text":" ","type":"text"},{"text":"received ","type":"text"},{"type":"codeVoice","code":"content"},{"text":" placeholder wherever the modified view should appear:","type":"text"}]},{"syntax":"swift","code":["struct SectionCard: ViewModifier {","    let title: String","","    func body(content: Content) -> some View {","        VStack {","            Text(title).bold()","            content","        }","        .padding()","        .border()","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply it using "},{"type":"codeVoice","code":".modifier(_:)"},{"type":"text","text":", which produces a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent"},{"type":"text","text":" value:"}]},{"syntax":"swift","code":["Text(\"Details\")","    .modifier(SectionCard(title: \"Info\"))"],"type":"codeListing"},{"text":"Convenience Extensions","type":"heading","anchor":"Convenience-Extensions","level":3},{"type":"paragraph","inlineContent":[{"text":"For a cleaner API, add a ","type":"text"},{"code":"View","type":"codeVoice"},{"text":" extension:","type":"text"}]},{"syntax":"swift","code":["extension View {","    func sectionCard(_ title: String) -> some View {","        modifier(SectionCard(title: title))","    }","}","","\/\/ Usage","Text(\"Details\").sectionCard(\"Info\")"],"type":"codeListing"},{"text":"When to Use ViewModifier","type":"heading","anchor":"When-to-Use-ViewModifier","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"text":" whenever a reusable decoration or wrapping applies to","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary content: cards, frames, badges, spacing conventions, environment","type":"text"},{"text":" ","type":"text"},{"text":"tweaks. Everything the modifier body sets (environment values, padding,","type":"text"},{"text":" ","type":"text"},{"text":"borders) flows into the wrapped content exactly as if it were written","type":"text"},{"text":" ","type":"text"},{"text":"inline. Procedural buffer transformations remain framework-internal; custom","type":"text"},{"text":" ","type":"text"},{"text":"modifiers compose existing views and modifiers instead.","type":"text"}]},{"text":"Type Erasure with AnyView","type":"heading","anchor":"Type-Erasure-with-AnyView","level":2},{"type":"paragraph","inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"syntax":"swift","code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnyView"},{"text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior.","type":"text"}]},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"code":"some View","type":"codeVoice"},{"text":" return types over ","type":"text"},{"code":"AnyView","type":"codeVoice"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}],"type":"paragraph"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/