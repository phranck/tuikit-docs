         .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property is annotated with ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:","type":"text"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Accepting Child Content","type":"heading","anchor":"Accepting-Child-Content"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"Building Custom Containers","