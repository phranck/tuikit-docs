{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit offers two ways to create custom views:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Approach","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to Use"}]}],[{"type":"paragraph","inlineContent":[{"text":"Complexity","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Composite View","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"View"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"body"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Low"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"View Modifier","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"ViewModifier"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Transforming any view’s rendered buffer (padding, background)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Medium"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Composite-Views","text":"Composite Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A composite view implements the "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property to compose existing views. This is the same pattern as SwiftUI:"}]},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}]},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Accepting-Child-Content","text":"Accepting Child Content"},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}]},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Building-Custom-Containers","text":"Building Custom Containers"},{"type":"paragraph","inlineContent":[{"text":"For richer containers, compose existing container views like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"text":", or ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"text":":","type":"text"}]},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"View-Modifiers","text":"View Modifiers"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"ViewModifier","type":"codeVoice"},{"text":" transforms an already-rendered ","type":"text"},{"code":"FrameBuffer","type":"codeVoice"},{"text":". Use this when your transformation operates on the output of any view:","type":"text"}]},{"code":["struct HighlightModifier: ViewModifier {","    let color: Color","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        \/\/ Transform each line in the buffer","        var result = FrameBuffer()","        for line in buffer.lines {","            result.appendLine(ANSIRenderer.applyPersistentBackground(to: line, color: color))","        }","        return result","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apply it using ","type":"text"},{"type":"codeVoice","code":".modifier(_:)"},{"text":":","type":"text"}]},{"code":["Text(\"Important!\")","    .modifier(HighlightModifier(color: .red))"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"Convenience-Extensions","text":"Convenience Extensions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extension:"}]},{"code":["extension View {","    func highlighted(_ color: Color = .red) -> some View {","        modifier(HighlightModifier(color: color))","    }","}","","\/\/ Usage","Text(\"Important!\").highlighted(.yellow)"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"When-to-Use-ViewModifier","text":"When to Use ViewModifier"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ViewModifier"},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"type":"codeVoice","code":"RenderContext"},{"type":"text","text":" gives you access to:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"availableWidth","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"availableHeight"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"environment","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Current "},{"type":"codeVoice","code":"EnvironmentValues"},{"type":"text","text":" (palette, focus manager, etc.)"}],"type":"paragraph"}]]]},{"type":"heading","level":2,"anchor":"Type-Erasure-with-AnyView","text":"Type Erasure with AnyView"},{"type":"paragraph","inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"type":"codeVoice","code":"AnyView"},{"text":":","type":"text"}]},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or use the convenience method:"}]},{"code":["let view = Text(\"Hello\").asAnyView()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnyView"},{"type":"text","text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior."}]},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"Prefer concrete types and ","type":"text"},{"code":"some View","type":"codeVoice"},{"text":" return types over ","type":"text"},{"code":"AnyView","type":"codeVoice"},{"text":". Type erasure should be a last resort when the type system can’t express what you need.","type":"text"}]}]}]}],"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"variants":[{"paths":["\/documentation\/tuikit\/customviews"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role