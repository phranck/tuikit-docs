{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","role":"collectionGroup","title":"Custom Views"},"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit offers two ways to create custom views:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Approach"}]}],[{"inlineContent":[{"type":"text","text":"When to Use"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Complexity"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Composite View","type":"text"}]},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" with "},{"type":"codeVoice","code":"body"},{"type":"text","text":")"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Combining existing views into reusable components"}]}],[{"inlineContent":[{"text":"Low","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View Modifier"}]},{"type":"text","text":" ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Transforming any view’s rendered buffer (padding, background)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Medium"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Most custom views should be "},{"type":"strong","inlineContent":[{"type":"text","text":"composite views"}]},{"type":"text","text":". For buffer-level transformations, implement a custom "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Composite-Views","text":"Composite Views","type":"heading"},{"inlineContent":[{"text":"A composite view implements the ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" property to compose existing views. This is the same pattern as SwiftUI:","type":"text"}],"type":"paragraph"},{"code":["struct StatusHeader: View {","    let title: String","    let version: String","","    var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}],"type":"paragraph"},{"code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Accepting-Child-Content","text":"Accepting Child Content","type":"heading"},{"inlineContent":[{"type":"text","text":"To create container-style views that accept child content, use a "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" closure parameter:"}],"type":"paragraph"},{"code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Text(\"Option B\")","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Building-Custom-Containers","text":"Building Custom Containers","type":"heading"},{"inlineContent":[{"type":"text","text":"For richer containers, compose existing container views like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", or "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct SettingsGroup<Content: View>: View {","    let title: String","    let content: Content","","    init(_ title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        Panel(title, borderStyle: .rounded, titleColor: .palette.accent) {","            content","        }","    }","}","","\/\/ Usage","SettingsGroup(\"Network\") {","    Text(\"Proxy: none\")","    Text(\"DNS: auto\")","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"View-Modifiers","text":"View Modifiers","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" transforms an already-rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":". Use this when your transformation operates on the output of any view:"}],"type":"paragraph"},{"code":["struct IndentModifier: ViewModifier {","    let columns: Int","","    func modify(buffer: FrameBuffer, context: RenderContext) -> FrameBuffer {","        var result = FrameBuffer(","            emptyWithWidth: max(0, columns),","            height: buffer.height","        )","        if !buffer.isEmpty {","            result.appendHorizontally(buffer)","        }","        return result","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Apply it using "},{"type":"codeVoice","code":".modifier(_:)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["Text(\"Indented\")","    .modifier(IndentModifier(columns: 2))"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"Convenience-Extensions","text":"Convenience Extensions","type":"heading"},{"inlineContent":[{"type":"text","text":"For a cleaner API, add a "},{"code":"View","type":"codeVoice"},{"type":"text","text":" extension:"}],"type":"paragraph"},{"code":["extension View {","    func indented(_ columns: Int = 2) -> some View {","        modifier(IndentModifier(columns: columns))","    }","}","","\/\/ Usage","Text(\"Indented\").indented(4)"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"When-to-Use-ViewModifier","text":"When to Use ViewModifier","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" when your transformation is a pure buffer-to-buffer operation: adding visual effects, changing backgrounds, or adjusting layout after rendering. The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":" gives you access to:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Property"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"availableWidth"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Maximum width in columns for this view"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"availableHeight"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Maximum height in rows for this view","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"environment","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Current "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"},{"type":"text","text":" (palette, focus manager, etc.)"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"anchor":"Type-Erasure-with-AnyView","text":"Type Erasure with AnyView","type":"heading"},{"inlineContent":[{"text":"When you need to store views of different types in a single variable or return different view types conditionally, use ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["func makeView(isCompact: Bool) -> AnyView {","    if isCompact {","        return AnyView(Text(\"Compact\"))","    } else {","        return AnyView(","            VStack {","                Text(\"Full\")","                Text(\"Layout\")","            }","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or use the convenience method:","type":"text"}],"type":"paragraph"},{"code":["let view = Text(\"Hello\").asAnyView()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"AnyView","type":"codeVoice"},{"type":"text","text":" captures the concrete view type in a closure, erasing it at the type level while preserving the rendering behavior."}],"type":"paragraph"},{"style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"Prefer concrete types and "},{"type":"codeVoice","code":"some View"},{"type":"text","text":" return types over "},{"type":"codeVoice","code":"AnyView"},{"type":"text","text":". Type erasure should be a last resort when the type system can’t express what you need."}],"type":"paragraph"}],"type":"aside"}]}],"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides"}],"variants":[{"paths":["\/documentation\/tuikit\/customviews"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","topicSections":[{"title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/View","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"],"anchor":"Protocols"},{"title":"Supporting Types","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView","doc:\/\/TUIkit\/documentation\/TUIkit\/AnyView","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"