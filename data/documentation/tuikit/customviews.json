  var body: some View {","        VStack {","            HStack {","                Text(title)","                    .bold()","                    .foregroundColor(.palette.accent)","                Spacer()","                Text(\"v\\(version)\")","                    .foregroundColor(.palette.foregroundTertiary)","            }","            Divider()","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"body"},{"type":"text","text":" property is annotated with "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" at the protocol level, so you can use all result builder features: conditionals, optionals, loops:"}]},{"type":"codeListing","code":["struct UserCard: View {","    let name: String","    let role: String?","","    var body: some View {","        Panel(title: name) {","            Text(name).bold()","            if let role {","                Text(role)","                    .foregroundColor(.palette.foregroundSecondary)","                    .italic()","            }","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Accepting Child Content","level":3,"anchor":"Accepting-Child-Content"},{"type":"paragraph","inlineContent":[{"text":"To create container-style views that accept child content, use a ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" closure parameter:","type":"text"}]},{"type":"codeListing","code":["struct Section<Content: View>: View {","    let title: String","    let content: Content","","    init(title: String, @ViewBuilder content: () -> Content) {","        self.title = title","        self.content = content()","    }","","    var body: some View {","        VStack(alignment: .leading) {","            Text(title)","                .bold()","                .underline()","            content","        }","    }","}","","\/\/ Usage","Section(title: \"Settings\") {","    Text(\"Option A\")","    Tex