{"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"kind":"article","sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","title":"Image Decoding"},"topicSections":[{"anchor":"Loading","title":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"]},{"anchor":"Data-and-Limits","title":"Data and Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","type":"reference","isActive":true},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","type":"reference","isActive":true},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}]},{"text":"Loading Data or Files","anchor":"Loading-Data-or-Files","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"]},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","isActive":true,"type":"reference"},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"text":"Resource Limits","anchor":"Resource-Limits","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true,"type":"reference"},{"type":"text","text":" when creating the loader:"}]},{"syntax":"swift","type":"codeListing","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"type":"codeVoice","code":"maxPixelCount"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"type":"codeVoice","code":"maxInputBytes"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/imagedecoding"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","type":"topic","url":"\/documentation\/tuikit\/palettereference","title":"Palette Reference","role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"title":"Custom Views",