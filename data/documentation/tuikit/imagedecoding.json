{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and","type":"text"},{"text":" ","type":"text"},{"text":"three-component color images.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the","type":"text"},{"text":" ","type":"text"},{"text":"same pixels without accessing the network.","type":"text"}]},{"type":"heading","level":2,"text":"Loading Data or Files","anchor":"Loading-Data-or-Files"},{"type":"codeListing","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","type":"reference"},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"type":"heading","level":2,"text":"Resource Limits","anchor":"Resource-Limits"},{"type":"paragraph","inlineContent":[{"text":"Configure ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true,"type":"reference"},{"text":" when creating the loader:","type":"text"}]},{"type":"codeListing","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"type":"codeVoice","code":"maxPixelCount"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}]},{"type":"paragraph","inlineContent":[{"text":"URL loading streams encoded bytes and cancels the transfer as soon as ","type":"text"},{"code":"maxInputBytes","type":"codeVoice"},{"text":" is exceeded. Cached images are revalidated against","type":"text"},{"text":" ","type":"text"},{"text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned.","type":"text"}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/do