ikit\/preferences"},"doc://TUIkit/documentation/TUIkit":{"images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"kind":"symbol","title":"TUIkit","url":"\/documentation\/tuikit","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","type":"topic","role":"collection"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"kind":"article","url":"\/documentation\/tuikit\/appearanceandcolors","abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","title":"Appearance and Colors","role":"article","type":"topic"},"doc://TUIkit/documentation/TUIkit/RGBA":{"role":"symbol","navigatorTitle":[{"text":"RGBA","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","abstract":[{"type":"text","text":"A single pixel with red, green, blue, and alpha channels."}],"kind":"symbol","title":"RGBA","type":"topic","url":"\/documentation\/tuikit\/rgba","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RGBA","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"title":"Focus System","role":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","kind":"article","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit/PlatformImageLoader":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PlatformImageLoader","kind":"identifier"}],"url":"\/documentation\/tuikit\/platformimageloader","navigatorTitle":[{"text":"PlatformImageLoader","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","title":"PlatformImageLoader","type":"topic","abstract":[{"type":"text","text":"Cross-platform image loader backed by pure Swift PNG and JPEG decoders."}],"role":"symbol","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/ImageLoadError":{"navigatorTitle":[{"text":"ImageLoadError","kind":"identifier"}],"title":"ImageLoadError","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageLoadError","kind":"identifier"}],"abstract":[{"type":"text","text":"Errors that can occur during image loading."}],"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","type":"topic","url":"\/documentation\/tuikit\/imageloaderror","role":"symbol"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"type":"topic","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","title":"List and Table Components","kind":"article","url":"\/documentation\/tuikit\/listandtable","role":"article"},"tuikit-logo.png":{"identifier":"tuikit-logo.png","alt":"TUIkit Logo","type":"image","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}]}}}