{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"},"topicSections":[{"title":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"],"anchor":"Loading"},{"title":"Data and Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"anchor":"Data-and-Limits"}],"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Image Decoding","roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"role":"collectionGroup"},"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}],"type":"paragraph"},{"text":"Loading Data or Files","level":2,"anchor":"Loading-Data-or-Files","type":"heading"},{"code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","isActive":true,"type":"reference"},{"text":" when the input cannot be read or decoded.","type":"text"}],"type":"paragraph"},{"text":"Resource Limits","level":2,"anchor":"Resource-Limits","type":"heading"},{"inlineContent":[{"type":"text","text":"Configure "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true},{"type":"text","text":" when creating the loader:"}],"type":"paragraph"},{"code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"code":"maxPixelCount","type":"codeVoice"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"type":"codeVoice","code":"maxInputBytes"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"anchor":"Guides"}],"references":{"doc://TUIkit/documentation/TUIkit/PlatformImageLoader":{"title":"PlatformImageLoader","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlatformImageLoader"}],"navigatorTitle":[{"kind":"identifier","text":"PlatformImageLoader"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","url":"\/documentation\/tuikit\/platformimageloader","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Cross-platform image loader backed by pure Swift PNG and JPEG decoders."}]},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"title":"Appearance and Colors","url":"\/documentation\/tuikit\/appearanceandcolors","type":"topic","role":"article","kind":"article","abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"title":"List and Table Components","role":"article","type":"topic","url":"\/documentation\/tuikit\/listandtable","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/Preferences":{"kind":"article","type":"topic","url":"\/documentation\/tuikit\/preferences","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","title":"Preferences","role":"collectionGroup","abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/RGBAImage":{"abstract":[{"text":"A raw image stored as a flat array of RGBA pixels in row-major order.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"RGBAImage"}],"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","url":"\/documentation\/tuikit\/rgbaimage","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RGBAImage"}],"title":"RGBAImage"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","role":"article","type":"topic","kind":"article","url":"\/documentation\/tuikit\/focussystem","title":"Focus System","abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/StateManagement":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"type":"topic","title":"State Management","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","url":"\/documentation\/tuikit\/statemanagement"},"doc://TUIkit/documentation/TUIkit/RGBA":{"abstract":[{"text":"A single pixel with red, green, blue, and alpha channels.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RGBA"}],"navigatorTitle":[{"kind":"identifier","text":"RGBA"}],"title":"RGBA","url":"\/documentation\/tuikit\/rgba","role":"symbol","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","type":"topic"},"doc://TUIkit/documentation/TUIkit":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","type":"topic","images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"title":"TUIkit","role":"collection","url":"\/documentation\/tuikit","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","kind":"article","url":"\/documentation\/tuikit\/themingguide","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"role":"article","title":"Theming Guide"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","type":"topic","abstract":[{"type":"text","text":"Configure the shortcut bar at the bottom of the terminal."}],"kind":"article","role":"article","title":"Status Bar","url":"\/documentation\/tuikit\/statusbarguide"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"title":"Custom Views","type":"topic","a