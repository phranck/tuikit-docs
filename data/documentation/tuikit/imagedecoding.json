{"abstract":[{"text":"Load static PNG and JPEG images safely on macOS and Linux.","type":"text"}],"topicSections":[{"title":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"],"anchor":"Loading"},{"title":"Data and Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"anchor":"Data-and-Limits"}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}],"type":"paragraph"},{"text":"Loading Data or Files","anchor":"Loading-Data-or-Files","level":2,"type":"heading"},{"code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Both entry points apply the same validation and return "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"},{"type":"text","text":" when the input cannot be read or decoded."}],"type":"paragraph"},{"text":"Resource Limits","anchor":"Resource-Limits","level":2,"type":"heading"},{"inlineContent":[{"text":"Configure ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","type":"reference","isActive":true},{"text":" when creating the loader:","type":"text"}],"type":"paragraph"},{"code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA","type":"text"},{"text":" ","type":"text"},{"text":"allocation before invoking a format decoder. A per-call ","type":"text"},{"code":"maxPixelCount","type":"codeVoice"},{"text":" can tighten the loader-wide pixel limit but cannot loosen it.","type":"text"},{"text":" ","type":"text"},{"text":"PNG ancillary metadata is discarded because ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"text":" has no metadata surface. This also prevents compressed text or color-profile","type":"text"},{"text":" ","type":"text"},{"text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and","type":"text"},{"text":" ","type":"text"},{"text":"malformed trailing decompressed data is rejected.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"URL loading streams encoded bytes and cancels the transfer as soon as ","type":"text"},{"code":"maxInputBytes","type":"codeVoice"},{"text":" is exceeded. Cached images are revalidated against","type":"text"},{"text":" ","type":"text"},{"text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"title":"Image Decoding"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true}],"references":{"doc://TUIkit/documentation/TUIkit/ListAndTable":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","title":"List and Table Components","kind":"article","abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"role":"article","type":"topic","url":"\/documentation\/tuikit\/listandtable"},"doc://TUIkit/documentation/TUIkit/ImageLoader":{"title":"ImageLoader","url":"\/documentation\/tui