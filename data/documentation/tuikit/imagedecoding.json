{"kind":"article","metadata":{"role":"collectionGroup","title":"Image Decoding","modules":[{"name":"TUIkit"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}]},{"anchor":"Loading-Data-or-Files","text":"Loading Data or Files","type":"heading","level":2},{"code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both entry points apply the same validation and return "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"},{"type":"text","text":" when the input cannot be read or decoded."}]},{"anchor":"Resource-Limits","text":"Resource Limits","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Configure ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true},{"text":" when creating the loader:","type":"text"}]},{"code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA","type":"text"},{"text":" ","type":"text"},{"text":"allocation before invoking a format decoder. A per-call ","type":"text"},{"type":"codeVoice","code":"maxPixelCount"},{"text":" can tighten the loader-wide pixel limit but cannot loosen it.","type":"text"},{"text":" ","type":"text"},{"text":"PNG ancillary metadata is discarded because ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","type":"reference","isActive":true},{"text":" has no metadata surface. This also prevents compressed text or color-profile","type":"text"},{"text":" ","type":"text"},{"text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and","type":"text"},{"text":" ","type":"text"},{"text":"malformed trailing decompressed data is rejected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"code":"maxInputBytes","type":"codeVoice"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"],"anchor":"Loading","title":"Loading"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"anchor":"Data-and-Limits","title":"Data and Limits"}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"generated":true,"title":"Guides","anchor":"Guides"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TUIkit/documentation/TUIkit":{"kind":"symbol","title":"TUIkit","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"role":"collection","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"url":"\/documentation\/tuikit"},"doc://TUIkit/documentation/TUIki