{"topicSections":[{"anchor":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"],"title":"Loading"},{"anchor":"Data-and-Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"title":"Data and Limits"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Image Decoding","modules":[{"name":"TUIkit"}]},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"kind":"article","sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true,"type":"reference"},{"text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and","type":"text"},{"text":" ","type":"text"},{"text":"three-component color images.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the","type":"text"},{"text":" ","type":"text"},{"text":"same pixels without accessing the network.","type":"text"}]},{"level":2,"anchor":"Loading-Data-or-Files","type":"heading","text":"Loading Data or Files"},{"type":"codeListing","syntax":"swift","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"]},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","isActive":true},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"level":2,"anchor":"Resource-Limits","type":"heading","text":"Resource Limits"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","type":"reference","isActive":true},{"type":"text","text":" when creating the loader:"}]},{"type":"codeListing","syntax":"swift","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"type":"codeVoice","code":"maxPixelCount"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"type":"codeVoice","code":"maxInputBytes"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}]}]}],"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"},"references":{"doc://TUIkit/documentation/TUIkit/ImageDecodingLimits":{"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImageDecodingLimits"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","navigatorTitle":[{"kind":"identifier","text":"ImageDecodingLimits"}],"url":"\/documentation\/tuikit\/imagedecodinglimits","type":"topic","title":"ImageDecodingLimits","abstract":