{"kind":"article","abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"seeAlsoSections":[{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"collectionGroup","title":"Image Decoding","roleHeading":"API Collection","modules":[{"name":"TUIkit"}]},"topicSections":[{"title":"Loading","anchor":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"]},{"title":"Data and Limits","anchor":"Data-and-Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"]}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and","type":"text"},{"text":" ","type":"text"},{"text":"three-component color images.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}]},{"type":"heading","anchor":"Loading-Data-or-Files","level":2,"text":"Loading Data or Files"},{"type":"codeListing","syntax":"swift","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"]},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","isActive":true},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"type":"heading","anchor":"Resource-Limits","level":2,"text":"Resource Limits"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true},{"type":"text","text":" when creating the loader:"}]},{"type":"codeListing","syntax":"swift","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"type":"codeVoice","code":"maxPixelCount"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}]},{"type":"paragraph","inlineContent":[{"text":"URL loading streams encoded bytes and cancels the transfer as soon as ","type":"text"},{"code":"maxInputBytes","type":"codeVoice"},{"text":" is exceeded. Cached images are revalidated against","type":"text"},{"text":" ","type":"text"},{"text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","interfaceLanguage":"swift"},"references":{"doc://TUIkit/documentation/TUIkit/RGBA":{"url":"\/documentation\/tuikit\/rgba","abstract":[{"type":"text","text":"A single pixel with red, green, blue, and alpha channels."}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RGBA"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RGBA"}],"kind":"symbol","title":"RGBA","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","typ