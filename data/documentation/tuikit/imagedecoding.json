{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Loading-Data-or-Files","text":"Loading Data or Files"},{"code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"},{"text":" when the input cannot be read or decoded.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Resource-Limits","text":"Resource Limits"},{"inlineContent":[{"text":"Configure ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true,"type":"reference"},{"text":" when creating the loader:","type":"text"}],"type":"paragraph"},{"code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"code":"maxPixelCount","type":"codeVoice"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true,"type":"reference"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"type":"codeVoice","code":"maxInputBytes"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}],"type":"paragraph"}]}],"sections":[],"metadata":{"roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Image Decoding"},"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"title":"Loading","anchor":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"]},{"title":"Data and Limits","anchor":"Data-and-Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/ListAndTable":{"kind":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","url":"\/documentation\/tuikit\/listandtable","role":"article","title":"List and Table Components","abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}]},"doc://TUIkit/documentation/TUIkit/CustomViews":{"abstract":[{"text":"Build your own views by comp