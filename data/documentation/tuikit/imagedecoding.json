{"sections":[],"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"title":"Guides","anchor":"Guides","generated":true}],"metadata":{"roleHeading":"API Collection","title":"Image Decoding","modules":[{"name":"TUIkit"}],"role":"collectionGroup"},"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"],"title":"Loading","anchor":"Loading"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"title":"Data and Limits","anchor":"Data-and-Limits"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","type":"reference","isActive":true},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","type":"reference","isActive":true},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}]},{"text":"Loading Data or Files","level":2,"type":"heading","anchor":"Loading-Data-or-Files"},{"type":"codeListing","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"text":"Resource Limits","level":2,"type":"heading","anchor":"Resource-Limits"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","isActive":true},{"type":"text","text":" when creating the loader:"}]},{"type":"codeListing","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"type":"codeVoice","code":"maxPixelCount"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"type":"codeVoice","code":"maxInputBytes"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}]}]}],"references":{"doc://TUIkit/documentation/TUIkit/ImageLoader":{"navigatorTitle":[{"text":"ImageLoader","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader","title":"ImageLoader","abstract":[{"type":"text","text":"Loads images from file paths or raw data and converts them to "},{"type":"codeVoice","code":"RGBAImage"},{"type":"text","text":"."}],"url":"\/documentation\/tuikit\/imageloader","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ImageLoader","kind":"identifier"}],"type":"topic"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"type":"topic","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"kind":"article","title":"Layout System","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","url":"\/documentation\/tuikit\/layoutsystem","role":"article"},"doc://TUIkit/documentation/TUIkit/Preferences":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","title":"Preferences","kind":"article","role":"collectionGroup","abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"url":"\/documentation\/tuikit\/preferences"},"doc://TUIkit/documentation/TUIkit":{"role":"collection","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","kind":"symbol","title":"TUIkit","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"url":"\/documentation\/tuikit","type":"topic"},"tuikit-logo.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"type":"image","identifier":"tuikit-logo.png","alt":"TUIkit Logo"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"role":"collectionGroup","kind":"article","url":"\/documentation\/tuikit\/customviews","title":"Custom Views","abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"doc://TUIkit/documentation/TUIkit/ImageDecodingLimits":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","kind":"symbol","navigatorTitle":[{"text":"ImageDecodingLimits","kind":"identifier"}],"title":"ImageDecodingLimits