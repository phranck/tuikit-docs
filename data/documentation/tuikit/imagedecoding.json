{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides","title":"Guides","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"type":"text","text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an"},{"type":"text","text":" "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true,"type":"reference"},{"type":"text","text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and"},{"type":"text","text":" "},{"type":"text","text":"three-component color images."}]},{"type":"paragraph","inlineContent":[{"text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the","type":"text"},{"text":" ","type":"text"},{"text":"same pixels without accessing the network.","type":"text"}]},{"type":"heading","level":2,"text":"Loading Data or Files","anchor":"Loading-Data-or-Files"},{"type":"codeListing","syntax":"swift","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"]},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","isActive":true},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"type":"heading","level":2,"text":"Resource Limits","anchor":"Resource-Limits"},{"type":"paragraph","inlineContent":[{"text":"Configure ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits"},{"text":" when creating the loader:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA"},{"type":"text","text":" "},{"type":"text","text":"allocation before invoking a format decoder. A per-call "},{"type":"codeVoice","code":"maxPixelCount"},{"type":"text","text":" can tighten the loader-wide pixel limit but cannot loosen it."},{"type":"text","text":" "},{"type":"text","text":"PNG ancillary metadata is discarded because "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage"},{"type":"text","text":" has no metadata surface. This also prevents compressed text or color-profile"},{"type":"text","text":" "},{"type":"text","text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and"},{"type":"text","text":" "},{"type":"text","text":"malformed trailing decompressed data is rejected."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"URL loading streams encoded bytes and cancels the transfer as soon as "},{"type":"codeVoice","code":"maxInputBytes"},{"type":"text","text":" is exceeded. Cached images are revalidated against"},{"type":"text","text":" "},{"type":"text","text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"TUIkit"}],"title":"Image Decoding","role":"collectionGroup","roleHeading":"API Collection"},"kind":"article","topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"],"anchor":"Loading","title":"Loading"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"anchor":"Data-and-Limits","title":"Data and Limits"}],"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/ImageLoader":{"role":"symbol","abstract":[{"type":"text","text":"Loads images from file paths or raw data and converts them to "},{"code":"RGBAImage","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/tuikit\/imageloader","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"ImageLoader"}],"navigatorTitle":[{"kind":"identifier","text":"ImageLoader"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader","kind":"symbol","title":"ImageLoader"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","type":"topic","url":"\/documentation\/tuikit\/themingguide","kind":"article","title":"Theming Guide","abstract":[{"text":"Customize the visual appearance of your TUIkit application with palettes.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"type":"topic","kind":"article","title":"Appearance and Colors","role":"article","url":"\/documentation\/tuikit\/appearanceandcolors","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","title":"Focus System","url":"\/documentation\/tuikit\/focussystem","type":"topic","abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/RGBA":{"navigatorTitle":[{"kind":"identifier","text":"RGBA"}],"url":"\/documentation\/tuikit\/rgba","role":"symbol","title":"RGBA","abstract":[{"type":"text","text":"A single pixel with red, green, blue, and alpha channels."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RGBA"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA"},"doc://TUIkit/documentation/TUIkit/PlatformImageLoader":{"type":"topic","title":"PlatformImageLoader","role":"symbol","abstract":[{"text":"Cross-platform image loader backed by pure Swift PNG and JPEG decoders.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","kind":"symbol","fragments":[{"kind":"keyword","text":"str