{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","type":"reference"},{"text":" uses vendored, namespaced pure Swift format decoders and always returns non-premultiplied 8-bit RGBA pixels in an","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","type":"reference"},{"text":". Animated images and formats other than PNG and JPEG are not supported. JPEG input is limited to 8-bit grayscale and","type":"text"},{"text":" ","type":"text"},{"text":"three-component color images.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The format decoder is independent from file and URL lifecycle code. Decoding the same bytes with the same limits therefore produces the"},{"type":"text","text":" "},{"type":"text","text":"same pixels without accessing the network."}]},{"level":2,"text":"Loading Data or Files","type":"heading","anchor":"Loading-Data-or-Files"},{"syntax":"swift","code":["let loader = PlatformImageLoader()","let fromData = try loader.loadImage(from: encodedData)","let fromFile = try loader.loadImage(from: \"\/absolute\/path\/image.png\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both entry points apply the same validation and return ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError","type":"reference","isActive":true},{"text":" when the input cannot be read or decoded.","type":"text"}]},{"level":2,"text":"Resource Limits","type":"heading","anchor":"Resource-Limits"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configure "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits"},{"type":"text","text":" when creating the loader:"}]},{"syntax":"swift","code":["let limits = ImageDecodingLimits(","    maxInputBytes: 8 * 1_024 * 1_024,","    maxDimension: 4_096,","    maxPixelCount: 12_000_000,","    maxFrameCount: 1,","    maxDecodedBytes: 48 * 1_024 * 1_024,","    maxDecompressedBytes: 48 * 1_024 * 1_024",")","let loader = PlatformImageLoader(limits: limits)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"TUIkit inspects the image header and validates encoded bytes, dimensions, pixels, frames, decompressed source samples, and the final RGBA","type":"text"},{"text":" ","type":"text"},{"text":"allocation before invoking a format decoder. A per-call ","type":"text"},{"type":"codeVoice","code":"maxPixelCount"},{"text":" can tighten the loader-wide pixel limit but cannot loosen it.","type":"text"},{"text":" ","type":"text"},{"text":"PNG ancillary metadata is discarded because ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","isActive":true},{"text":" has no metadata surface. This also prevents compressed text or color-profile","type":"text"},{"text":" ","type":"text"},{"text":"chunks from allocating outside the image decompression limit. PNG image-data chunks are fed to the decoder in bounded pieces, and","type":"text"},{"text":" ","type":"text"},{"text":"malformed trailing decompressed data is rejected.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"URL loading streams encoded bytes and cancels the transfer as soon as ","type":"text"},{"code":"maxInputBytes","type":"codeVoice"},{"text":" is exceeded. Cached images are revalidated against","type":"text"},{"text":" ","type":"text"},{"text":"the current loader’s dimensions, pixels, frame, and final allocation limits before they are returned.","type":"text"}]}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides"}],"topicSections":[{"title":"Loading","anchor":"Loading","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoader"]},{"title":"Data and Limits","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecodingLimits","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBAImage","doc:\/\/TUIkit\/documentation\/TUIkit\/RGBA","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageLoadError"],"anchor":"Data-and-Limits"}],"variants":[{"paths":["\/documentation\/tuikit\/imagedecoding"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Image Decoding"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"references":{"doc://TUIkit/documentation/TUIkit/StateManagement":{"title":"State Management","kind":"article","role":"article","url":"\/documentation\/tuikit\/statemanagement","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"type":"topic"},"doc://TUIkit/documentation/TUIkit/RGBAImage":{"title":"RGBAImage","role":"symbol","url":"\/documentation\/tuikit\/r