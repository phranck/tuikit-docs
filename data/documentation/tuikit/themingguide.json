{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit includes a full theming system with six built-in palettes inspired by classic CRT terminals. Palettes define semantic colors for backgrounds, foregrounds, accents, and UI elements.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Built-in-Palettes","text":"Built-in Palettes","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Palette"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Preset","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Inspiration","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Green","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".green"}],"type":"paragraph"}],[{"inlineContent":[{"text":"IBM 5151, Apple II","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Amber","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".amber","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"IBM 3278, Wyse 50"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Red","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".red"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Military terminals","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Violet","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".violet"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Retro sci-fi displays","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Blue","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".blue","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"VFD displays"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"White"}],"type":"paragraph"}],[{"inlin