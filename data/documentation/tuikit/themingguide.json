\/palette","type":"reference","isActive":true},{"type":"text","text":" to access the current palette’s colors:"}],"type":"paragraph"},{"code":["Text(\"Styled text\")","    .foregroundColor(.palette.foreground)","    .background(.palette.background)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or read the palette directly from the environment:","type":"text"}],"type":"paragraph"},{"code":["@Environment(\\.palette) var palette","","Text(\"Hello\").foregroundColor(palette.accent)"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Creating Custom Palettes","anchor":"Creating-Custom-Palettes"},{"inlineContent":[{"type":"text","text":"Implement the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Palette","type":"reference","isActive":true},{"type":"text","text":" protocol for a palette with just the essential colors:"}],"type":"paragraph"},{"code":["struct MyCustomPalette: Palette {","    let id = \"custom\"","    let name = \"Custom\"","","    let background = Color.hex(0x1A1A2E)","    let foreground = Color.hex(0xE0E0E0)","    let accent = Color.hex(0x00D4FF)","    let success = Color.hex(0x00FF88)","    let warning = Color.hex(0xFFCC00)","    let error = Color.hex(0xFF4444)","    let info = Color.hex(0x44AAFF)","    let border = Color.hex(0x333355)","","    \/\/ Optional: override defaults for statusBarBackground,","    \/\/ appHeaderBackground, overlayBackground,","    \/\/ foregroundSecondary, foregroundTertiary","}"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"Palette Color Properties","anchor":"Palette-Color-Properties"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backgrounds"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"background"},{"text":", ","type":"text"},{"type":"codeVoice","code":"statusBarBackground"},{"text":", ","type":"text"},{"type":"codeVoice","code":"appHeaderBackground"},{"text":", ","type":"text