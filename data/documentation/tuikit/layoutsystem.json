{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"anchor":"Guides","title":"Guides"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"text":" first ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"measure"}]},{"text":" each child, then ","type":"text"},{"type":"strong","inlineContent":[{"text":"render","type":"text"}]},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}]},{"type":"heading","text":"The Two Passes","level":2,"anchor":"The-Two-Passes"},{"type":"heading","text":"Pass 1: Measure","level":3,"anchor":"Pass-1-Measure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":". Each child responds with a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" that describes how much space it needs and whether it can flex."}]},{"type":"codeListing","code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null},{"type":"heading","text":"Pass 2: Render","level":3,"anchor":"Pass-2-Render"},{"type":"paragraph","inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}]},{"type":"codeListing","code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null},{"type":"heading","text":"ProposedSize","level":2,"anchor":"ProposedSize"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true,"type":"reference"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", meaning “use your ideal size.”","type":"text"}]},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing","syntax":"swift"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Meaning","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Minimum size","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"> 0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Available space in characters\/lines"}]}]]]},{"level":2,"anchor":"ViewSize","type":"heading","text":"ViewSize"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}]},{"code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Factory methods make common patterns concise:"}]},{"code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"The Layoutable Protocol","anchor":"The-Layoutable-Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"type":"codeVoice","code":"Layoutable"},{"text":" (which extends ","type":"text"},{"type":"codeVoice","code":"Renderable"},{"text":"):","type":"text"}]},{"code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"level":2,"text":"ChildView","type":"heading","anchor":"ChildView"},{"inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"type":"codeVoice","code":"ChildView"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"type":"codeListing"},{"inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}],"type":"paragraph"},{"level":2,"text":"How Stacks Lay Out Children","type":"heading","anchor":"How-Stacks-Lay-Out-Children"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Sum"}],"type":"strong"},{"type":"text","text":" the fixed sizes along the stack axis"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Distribute","type":"text"}],"type":"strong"},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":" each child with its allocated size"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Compose","type":"text"}],"type":"strong"},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}]},{"inlineContent":[{"text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Which Views Are Layoutable?","type":"heading","anchor":"Which-Views-Are-Layoutable"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"View"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Layoutable?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexibility"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fixed (wraps at proposed width)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexible in stack direction"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":