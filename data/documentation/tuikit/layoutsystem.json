{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]},{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":" first "},{"type":"strong","inlineContent":[{"type":"text","text":"measure"}]},{"type":"text","text":" each child, then "},{"type":"strong","inlineContent":[{"text":"render","type":"text"}]},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}]},{"type":"heading","anchor":"The-Two-Passes","level":2,"text":"The Two Passes"},{"type":"heading","anchor":"Pass-1-Measure","level":3,"text":"Pass 1: Measure"},{"type":"paragraph","inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"text":". Each child responds with a ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"]},{"type":"heading","anchor":"Pass-2-Render","level":3,"text":"Pass 2: Render"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}]},{"type":"codeListing","syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"]},{"type":"heading","anchor":"ProposedSize","level":2,"text":"ProposedSize"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true,"type":"reference"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"nil","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Available space in characters\/lines","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","anchor":"ViewSize","level":2,"text":"ViewSize"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}]},{"type":"codeListing","syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"]},{"type":"heading","anchor":"The-Layoutable-Protocol","level":2,"text":"The Layoutable Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}]},{"type":"heading","anchor":"ChildView","level":2,"text":"ChildView"},{"type":"paragraph","inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"type":"codeVoice","code":"ChildView"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildView","type":"codeVoice"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}]},{"type":"heading","anchor":"How-Stacks-Lay-Out-Children","level":2,"text":"How Stacks Lay Out Children"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":" follow this algorithm:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"type":"text","text":" a