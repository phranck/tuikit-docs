{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},"kind":"article","metadata":{"title":"Layout System","role":"article","modules":[{"name":"TUIkit"}],"roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides","generated":true,"anchor":"Guides"}],"variants":[{"paths":["\/documentation\/tuikit\/layoutsystem"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference","isActive":true},{"type":"text","text":" first "},{"type":"strong","inlineContent":[{"type":"text","text":"measure"}]},{"type":"text","text":" each child, then "},{"type":"strong","inlineContent":[{"type":"text","text":"render"}]},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}]},{"type":"heading","level":2,"anchor":"The-Two-Passes","text":"The Two Passes"},{"type":"heading","level":3,"anchor":"Pass-1-Measure","text":"Pass 1: Measure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":". Each child responds with a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" that describes how much space it needs and whether it can flex."}]},{"type":"codeListing","syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"]},{"type":"heading","level":3,"anchor":"Pass-2-Render","text":"Pass 2: Render"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}]},{"type":"codeListing","syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"]},{"type":"heading","level":2,"anchor":"ProposedSize","text":"ProposedSize"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}]},{"type":"codeListing","syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"nil","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimum size"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"> 0"}]}],[{"type":"paragraph","inlineContent":[{"text":"Available space in characters\/lines","type":"text"}]}]]]},{"type":"heading","level":2,"anchor":"ViewSize","text":"ViewSize"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}]},{"type":"codeListing","syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Factory methods make common patterns concise:"}]},{"type":"codeListing","syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"]},{"type":"heading","level":2,"anchor":"The-Layoutable-Protocol","text":"The Layoutable Protocol"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that participate in two-pass layout conform to "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" (which extends "},{"type":"codeVoice","code":"Renderable"},{"type":"text","text":"):"}]},{"type":"codeListing","syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}]},{"type":"heading","level":2,"anchor":"ChildView","text":"ChildView"},{"type":"paragraph","inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"code":"ChildView","type":"codeVoice"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}]},{"type":"heading","level":2,"anchor":"How-Stacks-Lay-Out-Children","text":"How Stacks Lay Out Children"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":" follow this algorithm:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"type":"text","text":" all children with the parent’s proposed size"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Sum"}],"type":"strong"},{"text":" the fixed sizes along the stack axis","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Distribute","type":"text"}],"type":"strong"},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":" each child with its allocated size"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Compose","type":"text"}],"type":"strong"},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}]},{"type":"heading","level":2,"anchor":"Which-Views-Are-Layoutable","text":"Which Views Are Layoutable?"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"View"}]}],[{"type":"paragraph","inlineContent":[{"text":"Layoutable?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flexibility","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUI