{"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","title":"Layout System","modules":[{"name":"TUIkit"}]},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"],"anchor":"Guides","title":"Guides"}],"variants":[{"paths":["\/documentation\/tuikit\/layoutsystem"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":" first ","type":"text"},{"type":"strong","inlineContent":[{"text":"measure","type":"text"}]},{"text":" each child, then ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"render"}]},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}],"type":"paragraph"},{"text":"The Two Passes","level":2,"anchor":"The-Two-Passes","type":"heading"},{"text":"Pass 1: Measure","level":3,"anchor":"Pass-1-Measure","type":"heading"},{"inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":". Each child responds with a "},{"type":"codeVoice","code":"ViewSize"},{"type":"text","text":" that describes how much space it needs and whether it can flex."}],"type":"paragraph"},{"syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"type":"codeListing"},{"text":"Pass 2: Render","level":3,"anchor":"Pass-2-Render","type":"heading"},{"inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}],"type":"paragraph"},{"syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"type":"codeListing"},{"text":"ProposedSize","level":2,"anchor":"ProposedSize","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"nil","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Available space in characters\/lines","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"text":"ViewSize","level":2,"anchor":"ViewSize","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ViewSize"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing"},{"text":"The Layoutable Protocol","level":2,"anchor":"The-Layoutable-Protocol","type":"heading"},{"inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"text":"ChildView","level":2,"anchor":"ChildView","type":"heading"},{"inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"code":"ChildView","type":"codeVoice"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ChildView"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}],"type":"paragraph"},{"text":"How Stacks Lay Out Children","level":2,"anchor":"How-Stacks-Lay-Out-Children","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"text":" all children with the parent’s proposed size","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Sum"}],"type":"strong"},{"text":" the fixed sizes along the stack axis","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Distribute"}],"type":"strong"},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":" each child with its allocated size"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compose"}]},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}],"type":"paragraph"},{"text":"Which Views Are Layoutable?","level":2,"anchor":"Which-Views-Are-Layoutable","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"View"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexibility"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexible in stack direction"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Both-flexible (fills available space)"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Views that are not ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" use the default implementation which renders first, then reports the buffer size as fixed.","type":"text"}],"type":"paragraph"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"references":{"doc://TUIkit/documentation/TUIkit/Image":{"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Image"}],"abstract":[{"text":"Displays an image as colored ASCII art in the terminal.","type":"text"}],"url":"\/documentation\/tuikit\/image","role":"symbol","title":"Image","navigatorTitle":[{"kind":"identifier","text":"Image"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image"},"doc://TUIkit/documentation/TUIkit/Divider":{"url":"\/documentation\/tuikit\/divider","kind":"symbol","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","abstract":[{"type":"text","text":"A visual separator between views."}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Divider"}],"navigatorTitle":[{"kind":"identifier","text":"Divider"}],"title":"Divider"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","type":"topic","url":"\/documentation\/tuikit\/themingguide","role":"article","kind":"article","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"title":"Theming Guide"},"tuikit-logo.png":{"alt":"TUIkit Logo","type":"image","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"identifier":"tuikit-logo.png"},"doc://TUIkit/documentation/TUIkit/ProgressView":{"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","navigatorTitle":[{"text":"ProgressView","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"A view tha