{"variants":[{"paths":["\/documentation\/tuikit\/layoutsystem"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","modules":[{"name":"TUIkit"}],"title":"Layout System","role":"article"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]},{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"text":" first ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"measure"}]},{"text":" each child, then ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"render"}]},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The Two Passes","anchor":"The-Two-Passes","type":"heading"},{"level":3,"text":"Pass 1: Measure","anchor":"Pass-1-Measure","type":"heading"},{"inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":". Each child responds with a "},{"type":"codeVoice","code":"ViewSize"},{"type":"text","text":" that describes how much space it needs and whether it can flex."}],"type":"paragraph"},{"syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"type":"codeListing"},{"level":3,"text":"Pass 2: Render","anchor":"Pass-2-Render","type":"heading"},{"inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"type":"codeListing"},{"level":2,"text":"ProposedSize","anchor":"ProposedSize","type":"heading"},{"inlineContent":[{"code":"ProposedSize","type":"codeVoice"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing"},{"rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Minimum size","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Available space in characters\/lines","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"text":"ViewSize","anchor":"ViewSize","type":"heading"},{"inlineContent":[{"code":"ViewSize","type":"codeVoice"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Factory methods make common patterns concise:"}],"type":"paragraph"},{"syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing"},{"level":2,"text":"The Layoutable Protocol","anchor":"The-Layoutable-Protocol","type":"heading"},{"inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"type":"codeVoice","code":"Layoutable"},{"text":" (which extends ","type":"text"},{"type":"codeVoice","code":"Renderable"},{"text":"):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"level":2,"text":"ChildView","anchor":"ChildView","type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"code":"ChildView","type":"codeVoice"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"type":"codeListing"},{"inlineContent":[{"code":"ChildView","type":"codeVoice"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}],"type":"paragraph"},{"level":2,"text":"How Stacks Lay Out Children","anchor":"How-Stacks-Lay-Out-Children","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Sum","type":"text"}]},{"text":" the fixed sizes along the stack axis","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Distribute"}]},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"text":" each child with its allocated size","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compose"}]},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}],"type":"paragraph"},{"anchor":"Which-Views-Are-Layoutable","level":2,"text":"Which Views Are Layoutable?","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"View","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Layoutable?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexible in stack direction"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both-flexible (fills available space)"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Views that are not "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" use the default implementation which renders first, then reports the buffer size as fixed."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://TUIkit/documentation/TUIkit/SecureField":{"role":"symbol","kind":"symbol","url":"\/documentation\/tuikit\/securefield","abstract":[{"text":"A control for secure text entry, where the display masks the user’s input.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","type":"topic","title":"SecureField","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SecureField"}],"navigatorTitle":[{"kind":"identifier","text":"SecureField"}]},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"type":"topic","url":"\/documentation\/tuikit\/themingguide","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","title":"Theming Guide","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"url":"\/documentation\/tuikit\/focussystem","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"role":"article","kind":"article","title":"Focus System","type":"topic"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"url":"\/documentation\/tuikit\/statemanagement","title":"State Management","role":"article","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"type":"topic","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"doc://TUIkit/documentation/TUIkit/Spacer":{"url":"\/documentation\/tuikit\/spacer","navigatorTitle":[{"text":"Spacer","kind":"identifier"}],"fragments":[{"text"