","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}]},{"syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing"},{"rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"nil","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"> 0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"ViewSize","type":"heading","anchor":"ViewSize","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}]},{"syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}]},{"syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions"