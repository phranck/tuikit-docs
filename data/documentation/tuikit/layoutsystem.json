{"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":" first "},{"type":"strong","inlineContent":[{"text":"measure","type":"text"}]},{"type":"text","text":" each child, then "},{"type":"strong","inlineContent":[{"text":"render","type":"text"}]},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}],"type":"paragraph"},{"text":"The Two Passes","anchor":"The-Two-Passes","level":2,"type":"heading"},{"text":"Pass 1: Measure","anchor":"Pass-1-Measure","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":". Each child responds with a "},{"type":"codeVoice","code":"ViewSize"},{"type":"text","text":" that describes how much space it needs and whether it can flex."}],"type":"paragraph"},{"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null,"type":"codeListing"},{"text":"Pass 2: Render","anchor":"Pass-2-Render","level":3,"type":"heading"},{"inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}],"type":"paragraph"},{"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null,"type":"codeListing"},{"text":"ProposedSize","anchor":"ProposedSize","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}],"type":"paragraph"},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"syntax":"swift","type":"codeListing"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"0"}]}],[{"type":"paragraph","inlineContent":[{"text":"Minimum size","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"> 0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Available space in characters\/lines","type":"text"}]}]]],"type":"table","header":"row"},{"level":2,"text":"ViewSize","type":"heading","anchor":"ViewSize"},{"inlineContent":[{"code":"ViewSize","type":"codeVoice"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}],"type":"paragraph"},{"code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"The Layoutable Protocol","type":"heading","anchor":"The-Layoutable-Protocol"},{"inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance.","type":"text"}],"type":"paragraph"},{"anchor":"ChildView","level":2,"text":"ChildView","type":"heading"},{"inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"code":"ChildView","type":"codeVoice"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}],"type":"paragraph"},{"code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ChildView"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}],"type":"paragraph"},{"anchor":"How-Stacks-Lay-Out-Children","level":2,"text":"How Stacks Lay Out Children","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"type":"text","text":" follow this algorithm:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Sum"}],"type":"strong"},{"text":" the fixed sizes along the stack axis","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Distribute"}]},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"text":" each child with its allocated size","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Compose","type":"text"}],"type":"strong"},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space.","type":"text"}],"type":"paragraph"},{"anchor":"Which-Views-Are-Layoutable","level":2,"text":"Which Views Are Layoutable?","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"View","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layoutable?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexibility"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fixed (wraps at proposed width)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flexible in stack direction","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both-flexible (fills available space)"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Views that are not "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" use the default implementation which renders first, then reports the buffer size as fixed."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/layoutsystem"]}],"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]},{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"]}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"Layout System","role":"article"},"identifier":{"url":"doc:\/\/TUIkit\/documen