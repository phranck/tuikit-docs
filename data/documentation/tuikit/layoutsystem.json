{"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"],"generated":true}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":" first ","type":"text"},{"inlineContent":[{"type":"text","text":"measure"}],"type":"strong"},{"text":" each child, then ","type":"text"},{"inlineContent":[{"type":"text","text":"render"}],"type":"strong"},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}],"type":"paragraph"},{"anchor":"The-Two-Passes","type":"heading","level":2,"text":"The Two Passes"},{"anchor":"Pass-1-Measure","type":"heading","level":3,"text":"Pass 1: Measure"},{"inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":". Each child responds with a "},{"type":"codeVoice","code":"ViewSize"},{"type":"text","text":" that describes how much space it needs and whether it can flex."}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"]},{"anchor":"Pass-2-Render","type":"heading","level":3,"text":"Pass 2: Render"},{"inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"]},{"anchor":"ProposedSize","type":"heading","level":2,"text":"ProposedSize"},{"inlineContent":[{"type":"codeVoice","code":"ProposedSize"},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"nil","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Minimum size","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]]},{"anchor":"ViewSize","type":"heading","level":2,"text":"ViewSize"},{"inlineContent":[{"code":"ViewSize","type":"codeVoice"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"]},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"]},{"anchor":"The-Layoutable-Protocol","type":"heading","level":2,"text":"The Layoutable Protocol"},{"inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"type":"codeVoice","code":"Layoutable"},{"text":" (which extends ","type":"text"},{"type":"codeVoice","code":"Renderable"},{"text":"):","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"]},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"anchor":"ChildView","type":"heading","level":2,"text":"ChildView"},{"inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"type":"codeVoice","code":"ChildView"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}],"type":"paragraph"},{"anchor":"How-Stacks-Lay-Out-Children","type":"heading","level":2,"text":"How Stacks Lay Out Children"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"text":" all children with the parent’s proposed size","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sum"}]},{"text":" the fixed sizes along the stack axis","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Distribute","type":"text"}]},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":" each child with its allocated size"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compose"}]},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}]}]}]},{"inlineContent":[{"text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space.","type":"text"}],"type":"paragraph"},{"anchor":"Which-Views-Are-Layoutable","type":"heading","level":2,"text":"Which Views Are Layoutable?"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"View"}]}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flexibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flexible in stack direction","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Both-flexible (fills available space)","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Views that are not ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" use the default implementation which renders first, then reports the buffer size as fixed.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/layoutsystem"]