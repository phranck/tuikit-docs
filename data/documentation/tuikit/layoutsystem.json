{"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}],"title":"Layout System"},"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","title":"Guides"}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"type":"text","text":" first "},{"type":"strong","inlineContent":[{"text":"measure","type":"text"}]},{"type":"text","text":" each child, then "},{"type":"strong","inlineContent":[{"text":"render","type":"text"}]},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The Two Passes","anchor":"The-Two-Passes"},{"level":3,"type":"heading","text":"Pass 1: Measure","anchor":"Pass-1-Measure"},{"inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference"},{"text":". Each child responds with a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference"},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}],"type":"paragraph"},{"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null,"type":"codeListing"},{"level":3,"type":"heading","text":"Pass 2: Render","anchor":"Pass-2-Render"},{"inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}],"type":"paragraph"},{"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null,"type":"codeListing"},{"level":2,"type":"heading","text":"ProposedSize","anchor":"ProposedSize"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}],"type":"paragraph"},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"syntax":"swift","type":"codeListing"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimum size"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"> 0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Available space in characters\/lines"}]}]]]},{"level":2,"type":"heading","text":"ViewSize","anchor":"ViewSize"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true,"type":"reference"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"syntax":"swift","type":"codeListing"},{"level":2,"type":"heading","text":"The Layoutable Protocol","anchor":"The-Layoutable-Protocol"},{"inlineContent":[{"type":"text","text":"Views that participate in two-pass layout conform to "},{"code":"Layoutable","type":"codeVoice"},{"type":"text","text":" (which extends "},{"code":"Renderable","type":"codeVoice"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"ChildView","anchor":"ChildView"},{"inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"code":"ChildView","type":"codeVoice"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}],"type":"paragraph"},{"code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ChildView"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"How Stacks Lay Out Children","anchor":"How-Stacks-Lay-Out-Children"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Sum","type":"text"}],"type":"strong"},{"text":" the fixed sizes along the stack axis","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Distribute"}],"type":"strong"},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":" each child with its allocated size"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Compose"}],"type":"strong"},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Which Views Are Layoutable?","anchor":"Which-Views-Are-Layoutable"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"View","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Layoutable?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexibility"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fixed (wraps at proposed width)"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier