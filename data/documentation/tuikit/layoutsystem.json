{"kind":"article","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]},{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/layoutsystem"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":" first "},{"type":"strong","inlineContent":[{"type":"text","text":"measure"}]},{"type":"text","text":" each child, then "},{"type":"strong","inlineContent":[{"text":"render","type":"text"}]},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}]},{"type":"heading","level":2,"anchor":"The-Two-Passes","text":"The Two Passes"},{"type":"heading","level":3,"anchor":"Pass-1-Measure","text":"Pass 1: Measure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"type":"text","text":". Each child responds with a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"type":"text","text":" that describes how much space it needs and whether it can flex."}]},{"type":"codeListing","code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null},{"type":"heading","level":3,"anchor":"Pass-2-Render","text":"Pass 2: Render"},{"type":"paragraph","inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}]},{"type":"codeListing","code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null},{"type":"heading","level":2,"anchor":"ProposedSize","text":"ProposedSize"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}]},{"syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"nil","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":2,"text":"ViewSize","type":"heading","anchor":"ViewSize"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true,"type":"reference"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing"},{"level":2,"text":"The Layoutable Protocol","type":"heading","anchor":"The-Layoutable-Protocol"},{"inlineContent":[{"type":"text","text":"Views that participate in two-pass layout conform to "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" (which extends "},{"type":"codeVoice","code":"Renderable"},{"type":"text","text":"):"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"]},{"type":"paragraph","inlineContent":[{"text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance.","type":"text"}]},{"text":"ChildView","type":"heading","anchor":"ChildView","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"type":"codeVoice","code":"ChildView"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}]},{"type":"codeListing","syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildView","type":"codeVoice"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}]},{"text":"How Stacks Lay Out Children","type":"heading","anchor":"How-Stacks-Lay-Out-Children","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":" follow this algorithm:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{