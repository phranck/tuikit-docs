{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/layoutsystem"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"Layout System","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},"sections":[],"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true,"title":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"type":"text","text":" first "},{"inlineContent":[{"text":"measure","type":"text"}],"type":"strong"},{"type":"text","text":" each child, then "},{"inlineContent":[{"text":"render","type":"text"}],"type":"strong"},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}]},{"type":"heading","text":"The Two Passes","level":2,"anchor":"The-Two-Passes"},{"type":"heading","text":"Pass 1: Measure","level":3,"anchor":"Pass-1-Measure"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"type":"text","text":". Each child responds with a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"type":"text","text":" that describes how much space it needs and whether it can flex."}]},{"type":"codeListing","syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"]},{"type":"heading","text":"Pass 2: Render","level":3,"anchor":"Pass-2-Render"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}]},{"type":"codeListing","syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"]},{"type":"heading","text":"ProposedSize","level":2,"anchor":"ProposedSize"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}]},{"type":"codeListing","syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","level":2,"anchor":"ViewSize","text":"ViewSize"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true,"type":"reference"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["