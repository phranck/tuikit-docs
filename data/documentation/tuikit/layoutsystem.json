{"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}],"title":"Layout System"},"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"],"anchor":"Guides","title":"Guides"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference","isActive":true},{"text":" first ","type":"text"},{"inlineContent":[{"text":"measure","type":"text"}],"type":"strong"},{"text":" each child, then ","type":"text"},{"inlineContent":[{"type":"text","text":"render"}],"type":"strong"},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}]},{"text":"The Two Passes","type":"heading","level":2,"anchor":"The-Two-Passes"},{"text":"Pass 1: Measure","type":"heading","level":3,"anchor":"Pass-1-Measure"},{"type":"paragraph","inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"code":"ProposedSize","type":"codeVoice"},{"text":". Each child responds with a ","type":"text"},{"code":"ViewSize","type":"codeVoice"},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}]},{"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null,"type":"codeListing"},{"text":"Pass 2: Render","type":"heading","level":3,"anchor":"Pass-2-Render"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}]},{"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null,"type":"codeListing"},{"text":"ProposedSize","type":"heading","level":2,"anchor":"ProposedSize"},{"type":"paragraph","inlineContent":[{"code":"ProposedSize","type":"codeVoice"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}]},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"syntax":"swift","type":"codeListing"},{"rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"ViewSize","type":"heading","level":2,"anchor":"ViewSize"},{"type":"paragraph","inlineContent":[{"code":"ViewSize","type":"codeVoice"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}]},{"code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}]},{"code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"syntax":"swift","type":"codeListing"},{"text":"The Layoutable Protocol","type":"heading","level":2,"anchor":"The-Layoutable-Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}]},{"code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance.","type":"text"}]},{"level":2,"type":"heading","text":"ChildView","anchor":"ChildView"},{"type":"paragraph","inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"code":"ChildView","type":"codeVoice"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}]},{"level":2,"type":"heading","text":"How Stacks Lay Out Children","anchor":"How-Stacks-Lay-Out-Children"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":" follow this algorithm:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"text":" all children with the parent’s proposed size","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sum"}]},{"text":" the fixed sizes along the stack axis","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Distribute"}]},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"text":" each child with its allocated size","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Compose"}],"type":"strong"},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}]},{"type":"heading","level":2,"text":"Which Views Are Layoutable?","anchor":"Which-Views-Are-Layoutable"},{"rows":[[[{"inlineContent":[{"text":"View","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fixed (wraps at proposed width)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flexible in stack direction","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","ty