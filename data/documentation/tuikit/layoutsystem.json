{"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":" first ","type":"text"},{"inlineContent":[{"text":"measure","type":"text"}],"type":"strong"},{"text":" each child, then ","type":"text"},{"inlineContent":[{"type":"text","text":"render"}],"type":"strong"},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The Two Passes","type":"heading","anchor":"The-Two-Passes"},{"level":3,"text":"Pass 1: Measure","type":"heading","anchor":"Pass-1-Measure"},{"type":"paragraph","inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"type":"codeVoice","code":"ProposedSize"},{"text":". Each child responds with a ","type":"text"},{"type":"codeVoice","code":"ViewSize"},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"]},{"type":"heading","text":"Pass 2: Render","anchor":"Pass-2-Render","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}]},{"type":"codeListing","syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"]},{"type":"heading","text":"ProposedSize","anchor":"ProposedSize","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ProposedSize"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", meaning “use your ideal size.”","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum size"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Available space in characters\/lines","type":"text"}],"type":"paragraph"}]]]},{"type":"heading","text":"ViewSize","anchor":"ViewSize","level":2},{"type":"paragraph","inlineContent":[{"code":"ViewSize","type":"codeVoice"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"]},{"type":"heading","text":"The Layoutable Protocol","anchor":"The-Layoutable-Protocol","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that participate in two-pass layout conform to "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" (which extends "},{"type":"codeVoice","code":"Renderable"},{"type":"text","text":"):"}]},{"type":"codeListing","syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}]},{"type":"heading","text":"ChildView","anchor":"ChildView","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"code":"ChildView","type":"codeVoice"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}]},{"type":"codeListing","syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}]},{"type":"heading","text":"How Stacks Lay Out Children","anchor":"How-Stacks-Lay-Out-Children","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":" follow this algorithm:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Sum","type":"text"}]},{"text":" the fixed sizes along the stack axis","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Distribute"}],"type":"strong"},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"text":" each child with its allocated size","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Compose","type":"text"}]},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}]}]}]},{"inlineContent":[{"text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space.","type":"text"}],"type":"paragraph"},{"text":"Which Views Are Layoutable?","type":"heading","level":2,"anchor":"Which-Views-Are-Layoutable"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"View"}]}],[{"type":"paragraph","inlineContent":[{"text":"Layoutable?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexibility"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flexible in stack direction","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Width-flexible"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"text":"Width-flexible","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Both-flexible (fills available space)"}]}]]]},{"inlineContent":[{"type":"text","text":"Views that are not "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" use the default implementation which renders first, then reports the buffer size as fixed."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"metadata":{"title":"Layout System","roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TU