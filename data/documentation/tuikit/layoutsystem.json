{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Layout System"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation"},{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference","isActive":true},{"type":"text","text":" first "},{"inlineContent":[{"text":"measure","type":"text"}],"type":"strong"},{"type":"text","text":" each child, then "},{"inlineContent":[{"text":"render","type":"text"}],"type":"strong"},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"The-Two-Passes","text":"The Two Passes"},{"type":"heading","level":3,"anchor":"Pass-1-Measure","text":"Pass 1: Measure"},{"inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true,"type":"reference"},{"text":". Each child responds with a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true,"type":"reference"},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"]},{"type":"heading","level":3,"anchor":"Pass-2-Render","text":"Pass 2: Render"},{"inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"]},{"type":"heading","level":2,"anchor":"ProposedSize","text":"ProposedSize"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", meaning “use your ideal size.”"}],"type":"paragraph"},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing","syntax":"swift"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Minimum size","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"> 0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Available space in characters\/lines","type":"text"}]}]]]},{"anchor":"ViewSize","type":"heading","text":"ViewSize","level":2},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing","syntax":"swift"},{"anchor":"The-Layoutable-Protocol","type":"heading","text":"The Layoutable Protocol","level":2},{"inlineContent":[{"type":"text","text":"Views that participate in two-pass layout conform to "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" (which extends "},{"type":"codeVoice","code":"Renderable"},{"type":"text","text":"):"}],"type":"paragraph"},{"code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"anchor":"ChildView","level":2,"text":"ChildView","type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"type":"codeVoice","code":"ChildView"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ChildView"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}],"type":"paragraph"},{"anchor":"How-Stacks-Lay-Out-Children","level":2,"text":"How Stacks Lay Out Children","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sum"}]},{"text":" the fixed sizes along the stack axis","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Distribute"}]},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"text":" each child with its allocated size","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compose"}]},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}],"type":"paragraph"},{"anchor":"Which-Views-Are-Layoutable","level":2,"text":"Which Views Are Layoutable?","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"View"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Layoutable?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fixed (wraps at proposed width)"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexible in