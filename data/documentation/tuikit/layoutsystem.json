{"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","sections":[],"metadata":{"title":"Layout System","roleHeading":"Article","role":"article","modules":[{"name":"TUIkit"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"title":"Related Documentation"},{"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides","generated":true}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":" first "},{"type":"strong","inlineContent":[{"text":"measure","type":"text"}]},{"type":"text","text":" each child, then "},{"type":"strong","inlineContent":[{"type":"text","text":"render"}]},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}]},{"text":"The Two Passes","level":2,"anchor":"The-Two-Passes","type":"heading"},{"text":"Pass 1: Measure","level":3,"anchor":"Pass-1-Measure","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":". Each child responds with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" that describes how much space it needs and whether it can flex."}]},{"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null,"type":"codeListing"},{"text":"Pass 2: Render","level":3,"anchor":"Pass-2-Render","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}]},{"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null,"type":"codeListing"},{"text":"ProposedSize","level":2,"anchor":"ProposedSize","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"type":"text","text":" represents the space a parent offers to a child. Either dimension can be "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", meaning “use your ideal size.”"}]},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"syntax":"swift","type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Minimum size","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"> 0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"type":"table"},{"level":2,"text":"ViewSize","anchor":"ViewSize","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}]},{"syntax":"swift","type":"codeListing","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Factory methods make common patterns concise:"}]},{"syntax":"swift","type":"codeListing","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"]},{"anchor":"The-Layoutable-Protocol","type":"heading","level":2,"text":"The Layoutable Protocol"},{"type":"paragraph","inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}]},{"anchor":"ChildView","type":"heading","level":2,"text":"ChildView"},{"type":"paragraph","inlineContent":[{"text":"Layout containers wrap their children in ","type":"text"},{"type":"codeVoice","code":"ChildView"},{"text":", which provides a uniform interface for measuring and rendering:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}]},{"anchor":"How-Stacks-Lay-Out-Children","type":"heading","level":2,"text":"How Stacks Lay Out Children"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":" follow this algorithm:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"text":" all children with the parent’s proposed size","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Sum","type":"text"}]},{"type":"text","text":" the fixed sizes along the stack axis"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Distribute"}]},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"text":" each child with its allocated size","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Compose","type":"text"}],"type":"strong"},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}]},{"anchor":"Which-Views-Are-Layoutable","type":"heading","level":2,"text":"Which Views Are Layoutable?"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"View"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexibility"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentatio