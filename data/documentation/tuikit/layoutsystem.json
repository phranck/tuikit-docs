{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"text":" first ","type":"text"},{"type":"strong","inlineContent":[{"text":"measure","type":"text"}]},{"text":" each child, then ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"render"}]},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}]},{"type":"heading","level":2,"text":"The Two Passes","anchor":"The-Two-Passes"},{"type":"heading","level":3,"text":"Pass 1: Measure","anchor":"Pass-1-Measure"},{"type":"paragraph","inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"type":"codeVoice","code":"ProposedSize"},{"text":". Each child responds with a ","type":"text"},{"type":"codeVoice","code":"ViewSize"},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}]},{"type":"codeListing","code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null},{"type":"heading","level":3,"text":"Pass 2: Render","anchor":"Pass-2-Render"},{"type":"paragraph","inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}]},{"type":"codeListing","code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null},{"type":"heading","level":2,"text":"ProposedSize","anchor":"ProposedSize"},{"type":"paragraph","inlineContent":[{"code":"ProposedSize","type":"codeVoice"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}]},{"syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"0"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Minimum size","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"> 0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"ViewSize","level":2,"text":"ViewSize","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ViewSize"},{"text":" is the child’s response: how much space it needs and whether it can expand.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing"},{"anchor":"The-Layoutable-Protocol","level":2,"text":"The Layoutable Protocol","type":"heading"},{"inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance.","type":"text"}]},{"type":"heading","level":2,"anchor":"ChildView","text":"ChildView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"code":"ChildView","type":"codeVoice"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}]},{"syntax":"swift","type":"codeListing","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ChildView"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}]},{"type":"heading","level":2,"anchor":"How-Stacks-Lay-Out-Children","text":"How Stacks Lay Out Children"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":" follow this algorithm:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"text":" all children with the parent’s proposed size","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Sum","type":"text"}]},{"text":" the fixed sizes along the stack axis","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Distribute"}],"type":"strong"},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":" each child with its allocated size"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Compose","type":"text"}],"type":"strong"},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space.","type":"text"}]},{"type":"heading","level":2,"anchor":"Which-Views-Are-Layoutable","text":"Which Views Are Layoutable?"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"View"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flexibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActi