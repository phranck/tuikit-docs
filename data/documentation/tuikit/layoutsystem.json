{"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/layoutsystem"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":" first ","type":"text"},{"inlineContent":[{"type":"text","text":"measure"}],"type":"strong"},{"text":" each child, then ","type":"text"},{"inlineContent":[{"type":"text","text":"render"}],"type":"strong"},{"text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment.","type":"text"}],"type":"paragraph"},{"anchor":"The-Two-Passes","text":"The Two Passes","level":2,"type":"heading"},{"anchor":"Pass-1-Measure","text":"Pass 1: Measure","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The parent proposes a size to each child via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":". Each child responds with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" that describes how much space it needs and whether it can flex."}],"type":"paragraph"},{"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"syntax":null,"type":"codeListing"},{"anchor":"Pass-2-Render","text":"Pass 2: Render","level":3,"type":"heading"},{"inlineContent":[{"text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size.","type":"text"}],"type":"paragraph"},{"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"syntax":null,"type":"codeListing"},{"anchor":"ProposedSize","text":"ProposedSize","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", meaning “use your ideal size.”","type":"text"}],"type":"paragraph"},{"code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"syntax":"swift","type":"codeListing"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Value"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"nil","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use ideal size (no constraint)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"0","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimum size"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"> 0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Available space in characters\/lines"}]}]]],"header":"row","type":"table"},{"anchor":"ViewSize","text":"ViewSize","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}],"type":"paragraph"},{"code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Factory methods make common patterns concise:","type":"text"}],"type":"paragraph"},{"code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"syntax":"swift","type":"codeListing"},{"anchor":"The-Layoutable-Protocol","text":"The Layoutable Protocol","level":2,"type":"heading"},{"inlineContent":[{"text":"Views that participate in two-pass layout conform to ","type":"text"},{"code":"Layoutable","type":"codeVoice"},{"text":" (which extends ","type":"text"},{"code":"Renderable","type":"codeVoice"},{"text":"):","type":"text"}],"type":"paragraph"},{"code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"anchor":"ChildView","text":"ChildView","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"code":"ChildView","type":"codeVoice"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}],"type":"paragraph"},{"code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"ChildView","type":"codeVoice"},{"text":" automatically detects spacers and propagates child identity for correct state management.","type":"text"}],"type":"paragraph"},{"anchor":"How-Stacks-Lay-Out-Children","text":"How Stacks Lay Out Children","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"text":" and ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"text":" follow this algorithm:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":" all children with the parent’s proposed size"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Sum"}],"type":"strong"},{"text":" the fixed sizes along the stack axis","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Distribute","type":"text"}]},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":" each child with its allocated size"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Compose","type":"text"}]},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}],"type":"orderedList"},{"inlineCont