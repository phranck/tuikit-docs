{"variants":[{"paths":["\/documentation\/tuikit\/layoutsystem"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Related-Documentation"},{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"],"generated":true,"anchor":"Guides"}],"kind":"article","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"metadata":{"role":"article","modules":[{"name":"TUIkit"}],"title":"Layout System","roleHeading":"Article"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"type":"text","text":" first "},{"inlineContent":