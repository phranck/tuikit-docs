{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/tuikit\/layoutsystem"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"Layout System","role":"article"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"],"title":"Guides","generated":true,"anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit uses a two-pass layout system inspired by SwiftUI’s layout protocol. Layout containers like "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference","isActive":true},{"type":"text","text":" first "},{"inlineContent":[{"type":"text","text":"measure"}],"type":"strong"},{"type":"text","text":" each child, then "},{"inlineContent":[{"type":"text","text":"render"}],"type":"strong"},{"type":"text","text":" them with allocated sizes. This approach enables features like flexible spacers, proportional sizing, and proper alignment."}],"type":"paragraph"},{"text":"The Two Passes","level":2,"anchor":"The-Two-Passes","type":"heading"},{"text":"Pass 1: Measure","level":3,"anchor":"Pass-1-Measure","type":"heading"},{"inlineContent":[{"text":"The parent proposes a size to each child via ","type":"text"},{"code":"ProposedSize","type":"codeVoice"},{"text":". Each child responds with a ","type":"text"},{"code":"ViewSize","type":"codeVoice"},{"text":" that describes how much space it needs and whether it can flex.","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["Parent (VStack)","  ├─ propose(width: 40, height: nil) → Text    → ViewSize(10, 1, flexible: false)","  ├─ propose(width: 40, height: nil) → Spacer  → ViewSize(0, 0, flexible: true)","  └─ propose(width: 40, height: nil) → Button  → ViewSize(12, 1, flexible: false)"],"type":"codeListing"},{"text":"Pass 2: Render","level":3,"anchor":"Pass-2-Render","type":"heading"},{"inlineContent":[{"type":"text","text":"After measuring all children, the parent distributes the remaining space among flexible children and renders each child with its final allocated size."}],"type":"paragraph"},{"syntax":null,"code":["Parent allocates:","  Text   → render(width: 40, height: 1)   \/\/ Gets full width, fixed height","  Spacer → render(width: 40, height: 8)   \/\/ Gets remaining vertical space","  Button → render(width: 40, height: 1)   \/\/ Gets full width, fixed height"],"type":"codeListing"},{"text":"ProposedSize","level":2,"anchor":"ProposedSize","type":"heading"},{"inlineContent":[{"code":"ProposedSize","type":"codeVoice"},{"text":" represents the space a parent offers to a child. Either dimension can be ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", meaning “use your ideal size.”","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ProposedSize {","    public var width: Int?","    public var height: Int?","}"],"type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Value"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"nil"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use ideal size (no constraint)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Minimum size","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"> 0","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Available space in characters\/lines"}],"type":"paragraph"}]]],"type":"table"},{"text":"ViewSize","level":2,"anchor":"ViewSize","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ViewSize"},{"type":"text","text":" is the child’s response: how much space it needs and whether it can expand."}],"type":"paragraph"},{"syntax":"swift","code":["public struct ViewSize {","    public var width: Int","    public var height: Int","    public var isWidthFlexible: Bool","    public var isHeightFlexible: Bool","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Factory methods make common patterns concise:"}],"type":"paragraph"},{"syntax":"swift","code":["ViewSize.fixed(20, 1)                    \/\/ Fixed 20x1, won't expand","ViewSize.flexible(minWidth: 0, minHeight: 0)  \/\/ Expands in both directions","ViewSize.flexibleWidth(minWidth: 5, height: 1) \/\/ Expands horizontally only"],"type":"codeListing"},{"text":"The Layoutable Protocol","level":2,"anchor":"The-Layoutable-Protocol","type":"heading"},{"inlineContent":[{"type":"text","text":"Views that participate in two-pass layout conform to "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" (which extends "},{"type":"codeVoice","code":"Renderable"},{"type":"text","text":"):"}],"type":"paragraph"},{"syntax":"swift","code":["protocol Layoutable: Renderable {","    func sizeThatFits(proposal: ProposedSize, context: RenderContext) -> ViewSize","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A default implementation renders the view and measures the resulting buffer. Custom implementations can calculate size without rendering for better performance."}],"type":"paragraph"},{"text":"ChildView","level":2,"anchor":"ChildView","type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers wrap their children in "},{"type":"codeVoice","code":"ChildView"},{"type":"text","text":", which provides a uniform interface for measuring and rendering:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ChildView {","    func measure(proposal: ProposedSize, context: RenderContext) -> ViewSize","    func render(width: Int, height: Int, context: RenderContext) -> FrameBuffer","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ChildView"},{"type":"text","text":" automatically detects spacers and propagates child identity for correct state management."}],"type":"paragraph"},{"text":"How Stacks Lay Out Children","level":2,"anchor":"How-Stacks-Lay-Out-Children","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"type":"text","text":" follow this algorithm:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"text":" all children with the parent’s proposed size","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Sum"}],"type":"strong"},{"type":"text","text":" the fixed sizes along the stack axis"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Distribute","type":"text"}],"type":"strong"},{"type":"text","text":" remaining space among flexible children (spacers, flexible text fields, etc.)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"type":"text","text":" each child with its allocated size"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compose"}]},{"text":" the rendered buffers with the specified spacing and alignment","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}],"type":"paragraph"},{"text":"Which Views Are Layoutable?","level":2,"anchor":"Which-Views-Are-Layoutable","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"View"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flexibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fixed (wraps at proposed width)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flexible in stack direction","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Width-flexible"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Width-flexible","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Image"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Both-flexible (fills available space)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"Views that are not "},{"type":"codeVoice","code":"Layoutable"},{"type":"text","text":" use the default implementation which renders first, then reports the buffer size as fixed."}],"type":"paragraph"}]}],"kind":"article","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"references":{"doc://TUIkit/documentation/TUIkit/HStack":{"url":"\/documentation\/tuikit\/hstack","abstract":[{"text":"A view that arranges its children horizontally.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HStack","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","navigatorTitle":[{"text":"HStack","kind":"identifier"}],"title":"HStack","role":"symbol","type":"topic"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"url":"\/documentation\/tuikit\/themingguide","title":"Theming Guide","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"kind":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","role":"article"},"doc://TUIkit/documentation/TUIkit/VStack":{"role":"symbol","title":"VStack","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"VStack","kind":"identifier"}],"url":"\/documentation\/tuikit\/vstack","kind":"symbol","abstract":[{"type":"text","text":"A view that arranges its children vertically."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","navigatorTitle":[{"text":"VStack","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"url":"\/documentation\/tuikit\/statusbarguide","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","type":"topic","title":"Status Bar","kind":"article","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"role":"article"},"doc://TUIkit/documentation/TUIkit":{"url":"\/documentation\/tuikit","type":"topic"