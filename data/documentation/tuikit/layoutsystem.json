nd "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":" follow this algorithm:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":" all children with the parent’s proposed size"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Sum"}]},{"type":"text","text":" the fixed sizes along the stack axis"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Distribute","type":"text"}],"type":"strong"},{"text":" remaining space among flexible children (spacers, flexible text fields, etc.)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"text":" each child with its allocated size","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Compose"}]},{"type":"text","text":" the rendered buffers with the specified spacing and alignment"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Flexible children share remaining space equally. If multiple spacers exist, they each get an equal portion of the leftover space."}]},{"level":2,"type":"heading","text":"Which Views Are Layoutable?","anchor":"Which-Views-Are-Layoutable"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"View"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Layoutable?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flexibility"}],"type":"paragraph"}]],[[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fixed (wraps at 