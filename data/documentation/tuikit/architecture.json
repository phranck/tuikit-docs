{"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/tuikit\/architecture"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","abstract":[{"text":"Understand the layer model and rendering pipeline of TUIkit.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"},"metadata":{"roleHeading":"Article","title":"Architecture","role":"article","modules":[{"name":"TUIkit"}]},"seeAlsoSections":[{"generated":true,"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain.","type":"text"}],"type":"paragraph"},{"anchor":"Layer-Model","type":"heading","text":"Layer Model","level":2},{"anchor":"1-App-Layer","type":"heading","text":"1. App Layer","level":3},{"inlineContent":[{"text":"The ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true},{"text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" manages the async event loop, terminal setup, signal handling, and event dispatching.","type":"text"}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["@main → App → AppRunner → RuntimeEventChannel"]},{"anchor":"2-View-Layer","type":"heading","text":"2. View Layer","level":3},{"inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" protocol. Views are composed declaratively using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder"},{"type":"text","text":", which supports:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditionals (","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if-else","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if let","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Loops ("},{"type":"codeVoice","code":"for-in"},{"type":"text","text":" via "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Built-in views include:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Content"}],"type":"strong"},{"text":": ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Interactive controls","type":"text"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Containers","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Data collections"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"3. Layout Layer","anchor":"3-Layout-Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":": Each child is proposed a size ("},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference"},{"type":"text","text":") and returns a "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference"},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}]},{"inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","type":"reference","isActive":true},{"type":"text","text":" for details."}],"type":"paragraph"},{"level":3,"text":"4. Modifier Layer","anchor":"4-Modifier-Layer","type":"heading"},{"inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"text":" protocol. They operate in two phases: ","type":"text"},{"code":"adjustContext(_:)","type":"codeVoice"},{"text":" modifies the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true,"type":"reference"},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"code":"modify(buffer:context:)","type":"codeVoice"},{"text":" transforms the rendered ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"]},{"level":3,"text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference","isActive":true}]},{"text":": Mutable per-view state that triggers re-renders","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"}]},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"}]},{"type":"text","text":": Values propagated down the view tree"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"}]},{"text":": Persistent key-value storage through the app runtime","type":"text"}]}]}]},{"level":3,"text":"6. Rendering Layer","anchor":"6-Rendering-Layer","type":"heading"},{"inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View tree traversal","type":"text"}]},{"text":": Each view produces a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" backed by terminal cells","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modifier application"}]},{"type":"text","text":": Modifiers transform or style cell surfaces"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout and compositing","type":"text"}]},{"type":"text","text":": Containers position, clip, and layer complete grapheme cells"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"type":"text","text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary"}]}]}],"type":"orderedList"},{"level":2,"anchor":"Package-Boundaries","type":"heading","text":"Package Boundaries"},{"inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"type":"codeVoice","code":"TUIkitImage"},{"type":"text","text":" depends on "},{"type":"codeVoice","code":"TUIkitStyling"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Event-Loop","type":"heading","text":"Event Loop"},{"inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"code":"TUIContext","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" creates "},{"code":"InputHandler","type":"codeVoice"},{"type":"text","text":", "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"code":"PulseTimer","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CursorTimer","type":"codeVoice"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}],"type":"paragraph"},{"inlineContent":[{"text":"The runner then awaits ","type":"text"},{"code":"RuntimeEventChannel","type":"codeVoice"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"code":"TUIContext.reset()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}],"type":"paragraph"},{"level":2,"anchor":"Focus-System","type":"heading","text":"Focus System"},{"inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://TUIkit/documentation/TUIkit/ZStack":{"navigatorTitle":[{"text":"ZStack","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZStack","kind":"identifier"}],"abstract":[{"text":"A view that stacks its children on top of each other (z-axis).","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","url":"\/documentation\/tuikit\/zstack","title":"ZStack","role":"symbol","type":"topic","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/Dialog":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Dialog"}],"navigatorTitle":[{"kind":"identifier","text":"Dialog"}],"url":"\/documentation\/tuikit\/dialog","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","role":"symbol","abstract":[{"text":"A modal dialog view with a title, customizable content, and optional fo