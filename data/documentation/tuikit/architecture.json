type":"reference"},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},{"type":"text","text":" for details."}]},{"type":"heading","text":"4. Modifier Layer","anchor":"4-Modifier-Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"View modifiers implement the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" protocol. They operate in two phases: "},{"type":"codeVoice","code":"adjustContext(_:)"},{"type":"text","text":" modifies the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"type":"codeVoice","code":"apply(to:context:)"},{"type":"text","text":" transforms the rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}]},{"type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift"},{"type":"heading","text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Two-way connection to a value owned elsewhere","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"}]},{"type":"text","text":": Values propagated down the view tree"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"}]},{"type":"text","text":": Persistent key-value storage via "},{"type":"codeVoice","code":"UserDefaults"}],"type":"paragraph"}]}]},{"type":"heading","text":"6. Rendering Layer","anchor":"6-Rendering-Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View tree traversal","type":"text"}]},{"text":": Each view produces a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modifier application"}]},{"type":"text","text":": Modifiers transform buffers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ANSI rendering"}]},{"type":"text","text":": The "},{"type":"codeVoice","code":"ANSIRenderer"},{"type":"text","text":" converts colors and styles to escape codes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"text":": The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":" lines are written to the terminal","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"code":"TUIkitImage","type":"codeVoice"},{"type":"text","text":" depends on "},{"code":"TUIkitStyling","type":"codeVoice"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"type":"heading","level":2,"text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" initializes all subsystems (Terminal, AppState, StatusBarState, AppHeaderState, FocusManager, ThemeManager x2, TUIContext), creates InputHandler and RenderLoop, installs POSIX signal handlers, sets up the terminal (alternate screen, raw mode), starts PulseTimer (100 ms) and CursorTimer (50 ms), registers state and focus observers, and performs an initial render before entering the main loop.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each loop iteration checks "},{"type":"codeVoice","code":"shouldShutdown"},{"type":"text","text":" (set by SIGINT), consumes the resize flag to invalidate the diff cache if SIGWINCH fired, then renders when "},{"type":"codeVoice","code":"consumeRerenderFlag()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"appState.needsRender"},{"type":"text","text":" is true. After rendering, it reads up to 128 non-blocking key events per frame and dispatches each through five handler layers. A "},{"type":"codeVoice","code":"usleep(28_000)"},{"type":"text","text":" throttles the loop to approximately 35 FPS. Asynchronous render triggers (timers, @State changes, SIGWINCH, focus changes) feed back into the render decision via "},{"type":"codeVoice","code":"appState.needsRender"},{"type":"text","text":" or "},{"type":"codeVoice","code":"signals.requestRerender()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-event-loop.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"type":"heading","level":2,"text":"Focus System","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"FocusManager","type":"codeVoice"},{"text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."