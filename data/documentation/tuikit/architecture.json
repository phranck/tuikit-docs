n\/TUIkit\/Button","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Containers","type":"text"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","isActive":true}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Data collections","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference","isActive":true}]}]}]},{"anchor":"3-Layout-Layer","type":"heading","level":3,"text":"3. Layout Layer"},{"inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"text":": Each child is proposed a size (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true,"type":"reference"},{"text":") and returns a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true,"type":"reference"},{"text":" with flexibility flags","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","type":"reference","isActive":true},{"type":"text","text":" for details."}],"type":"paragraph"},{"anchor":"4-Modifier-Layer","type":"heading","level":3,"text":"4. Modifier Layer"},{"inlineContent":[{"text":"Public view modifiers implement the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference"},{"text":" protocol with SwiftUI’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"body(content:)"},{"text":" contract: the modifier composes a replacement view around a","type":"text"},{"text":" ","type":"text"},{"text":"placeholder for the modified content, and ","type":"text"},{"type":"codeVoice","code":".modifier(_:)"},{"text":" wraps both in a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","type":"reference"},{"text":" value. Terminal-specific buffer transformations (padding","type":"text"},{"text":" ","type":"text"},{"text":"rows, background fills) run behind an internal buffer-modifier layer that","type":"text"},{"text":" ","type":"text"},{"text":"adjusts the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference"},{"text":" before rendering and transforms the rendered","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"},{"text":" afterwards.","type":"text"}],"type":"paragraph"},{"code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift","type":"codeListing"},{"text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true}]},{"text":": Two-way connection to a value owned elsewhere","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"}]},{"type":"text","text":": Values propagated down the view tree"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"6. Rendering Layer","anchor":"6-Rendering-Layer","level":3,"type":"heading"},{"inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View tree traversal"}]},{"type":"text","text":": Each view produces a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" backed by terminal cells"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"type":"text","text":": Modifiers transform or style cell surfaces"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Layout and compositing","type":"text"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Terminal output"}],"type":"strong"},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}]}]}],"type":"orderedList"},{"level":2,"anchor":"Package-Boundaries","text":"Package Boundaries","type":"heading"},{"inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Event-Loop","text":"Event Loop","type":"heading"},{"inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"code":"PulseTimer","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CursorTimer","type":"codeVoice"},{"text":" are monotonic phase calculators rather than","type":"text"},{"text":" ","type":"text"},{"text":"background timers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The runner then awaits ","type":"text"},{"code":"RuntimeEventChannel","type":"codeVoice"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"code":"TUIContext.reset()","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}],"type":"paragraph"},{"inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}],"type":"paragraph"},{"level":2,"anchor":"Focus-System","text":"Focus System","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}],"type":"paragraph"}]}],"references":{"doc://TUIkit/documentation/TUIkit/Section":{"url":"\/documentation\/tuikit\/section","navigatorTitle":[{"text":"Section","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","role":"symbol","title":"Section","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A container view that groups content with optional header and footer."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Section","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/Table":{"kind":"symbol","url":"\/documentation\/tuikit\/table","title":"Table","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Table"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Table"}],"abstract":[{"text":"A scrollable table with columns, keyboard navigation, and selection.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/EmptyView":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","navigatorTitle":[{"kind":"identifier","text":"EmptyView"}],"kind":"symbol","title":"EmptyView","abstract":[{"type":"text","text":"A view that displays no content."}],"url":"\/documentation\/tuikit\/emptyview","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EmptyView"}]},"architecture-input-dispatch.png":{"alt":"Flowchart of the 5-layer input dispatch: A hasTextInputFocus check gates Layer 0 (Text Input via focusManager.dispatchKeyEvent for TextField\/SecureField). Layer 1 Status Bar Items (statusBar.handleKeyEvent). Layer 2 View Handlers (keyEventDispatcher.dispatch, deepest view first). A second hasTextInputFocus check skips Layer 3 if text input was focused. Layer 3 Focus System (focusManager.dispatchKeyEvent: focused element delegation, Tab\/Shift+Tab, arrow key fallback). Layer 4 Default Bindings (q quit, t theme, a appearance). Unmatched events are dropped.","type":"image","identifier":"architecture-input-dispatch.png","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/architecture-input-dispatch.png"},{"traits":["1x","dark"],"url":"\/images\/TUIkit\/architecture-input-dispatch~dark.png"}]},"tuikit-logo.png":{"type":"image","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],