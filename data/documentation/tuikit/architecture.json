kit/Section":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","navigatorTitle":[{"text":"Section","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Section","kind":"identifier"}],"abstract":[{"type":"text","text":"A container view that groups content with optional header and footer."}],"type":"topic","kind":"symbol","url":"\/documentation\/tuikit\/section","title":"Section","role":"symbol"},"doc://TUIkit/documentation/TUIkit/Dialog":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","navigatorTitle":[{"kind":"identifier","text":"Dialog"}],"role":"symbol","url":"\/documentation\/tuikit\/dialog","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Dialog"}],"title":"Dialog","abstract":[{"type":"text","text":"A modal dialog view with a title, customizable content, and optional footer."}],"kind":"symbol","type":"topic"},"doc://TUIkit/documentation/TUIkit/SecureField":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SecureField","kind":"identifier"}],"type":"topic","title":"SecureField","abstract":[{"text":"A control for secure text entry, where the display masks the user’s input.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"SecureField","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","url":"\/documentation\/tuikit\/securefield"},"doc://TUIkit/documentation/TUIkit/FrameBuffer":{"title":"FrameBuffer","role":"symbol","type":"topic","abstract":[{"type":"text","text":"A 2D terminal-cell buffer that views render into before flushing."}],"navigatorTitle":[{"kind":"identifier","text":"FrameBuffer"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","url":"\/documentation\/tuikit\/framebuffer","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FrameBuffer"}]},"