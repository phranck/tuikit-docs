ctive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout"}],"type":"strong"},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}]}]}]},{"type":"heading","level":3,"text":"3. Layout Layer","anchor":"3-Layout-Layer"},{"type":"paragraph","inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":": Each child is proposed a size ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":") and returns a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true,"type":"reference"},{"text":" for details.","type":"text"}]},{"type":"heading","level":3,"text":"4. Modifier Layer","anchor":"4-Modifier-Layer"},{"type":"paragraph","inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"text":" protocol. They operate in two phases: ","type":"text"},{"code":"adjustContext(_:)","type":"codeVoice"},{"text":" modifies the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true,"type":"reference"},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"code":"modify(buffer:context:)","type":"codeVoice"},{"text":" transforms the rendered ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}]},{"type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift"},{"type":"heading","level":3,"text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true}],"type":"strong"},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"}]},{"text":": Two-way connection to a value owned elsewhere","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true}]},{"text":": Values propagated down the view tree","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"6. Rendering Layer","anchor":"6-Rendering-Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"View tree traversal","type":"text"}],"type":"strong"},{"type":"text","text":": Each view produces a "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"},{"type":"text","text":" backed by terminal cells"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modifier application"}]},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout and compositing","type":"text"}]},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Terminal output","type":"text"}],"type":"strong"},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"type":"heading","level":2,"text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"code":"TUIContext","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" creates "},{"code":"InputHandler","type":"codeVoice"},{"type":"text","text":", "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"code":"PulseTimer","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CursorTimer","type":"codeVoice"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"text":"The runner then awaits ","type":"text"},{"code":"RuntimeEventChannel","type":"codeVoice"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"type":"codeVoice","code":"TUIContext.reset()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}]},{"type":"paragraph","inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"type":"heading","level":2,"text":"Focus System","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}]}],"variants":[{"paths":["\/documentation\/tuikit\/architecture"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"metadata":{"role":"article","title":"Architecture","modules":[{"name":"TUIkit"}],"roleHeading":"Article"},"references":{"doc://TUIkit/documentation/TUIkit/ZStack":{"abstract":[{"text":"A view that stacks its children on top of each other (z-axis).","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ZStack"}],"kind":"symbol","url":"\/documentation\/tuikit\/zstack","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"ZStack"}],"title":"ZStack","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},"doc://TUIkit/documentation/TUIkit/Panel":{"title":"Panel","abstract":[{"text":"A labeled container — always has a title, optionally a footer.","type":"text"}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","role":"symbol","navigatorTitle":[{"text":"Panel","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/tuikit\/panel","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Panel","k