{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain."}]},{"type":"heading","level":2,"text":"Layer Model","anchor":"Layer-Model"},{"type":"heading","level":3,"text":"1. App Layer","anchor":"1-App-Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}]},{"syntax":null,"type":"codeListing","code":["@main → App → AppRunner → RuntimeEventChannel"]},{"type":"heading","level":3,"text":"2. View Layer","anchor":"2-View-Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" protocol. Views are composed declaratively using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder"},{"type":"text","text":", which supports:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Single and multiple child views (up to 10)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditionals (","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if-else","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if let","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views include:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Content"}]},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interactive controls"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Containers","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Data collections"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout","type":"text"}]},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"3-Layout-Layer","level":3,"text":"3. Layout Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":": Each child is proposed a size ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":") and returns a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true},{"type":"text","text":" for details."}]},{"type":"heading","anchor":"4-Modifier-Layer","level":3,"text":"4. Modifier Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"View modifiers implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":" protocol. They operate in two phases: "},{"type":"codeVoice","code":"adjustContext(_:)"},{"type":"text","text":" modifies the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"type":"codeVoice","code":"modify(buffer:context:)"},{"type":"text","text":" transforms the rendered "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}]},{"type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift"},{"type":"heading","anchor":"5-State--Environment-Layer","level":3,"text":"5. State & Environment Layer"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true}],"type":"strong"},{"text":": Mutable per-view state that triggers re-renders","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"}],"type":"strong"},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true}],"type":"strong"},{"text":": Values propagated down the view tree","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"6-Rendering-Layer","level":3,"text":"6. Rendering Layer"},{"inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"View tree traversal","type":"text"}]},{"type":"text","text":": Each view produces a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" backed by terminal cells"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"text":": Modifiers transform or style cell surfaces","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout and compositing"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Terminal output","type":"text"}]},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Package Boundaries","level":2,"type":"heading","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"type":"codeVoice","code":"TUIkitImage"},{"type":"text","text":" depends on "},{"type":"codeVoice","code":"TUIkitStyling"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"text":"Event Loop","level":2,"type":"heading","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runner then awaits "},{"code":"RuntimeEventChannel","type":"codeVoice"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"code":"TUIContext.reset()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"text":"Focus System","level":2,"type":"heading","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tuikit\/architecture"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Architecture"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"references":{"doc://TUIkit/documentation/TUIkit/EnvironmentValues":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}],"navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"url":"\/documentation\/tuikit\/environmentvalues","type":"topic","title":"EnvironmentValues","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","abstract":[{"text":"A collection of environment values propagated through the view hierarchy.","type":"text"}],"kind":"symbol"},"doc://TUIkit/documentation/TUIkit/Text":{"kind":"symbol","navigatorTitle":[{"text":"Text","kind":"identifier"}],"abstract":[{"text":"A view that displays text in the terminal.","type":"text"}],"url":"\/documentation\/tuikit\/text","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Text","kind":"identifier"}],"role":"symbol","identifier":"doc: