it\/ViewBuilder"},{"text":", which supports:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}]}]},{"content":[{"inlineContent":[{"text":"Conditionals (","type":"text"},{"type":"codeVoice","code":"if"},{"text":", ","type":"text"},{"type":"codeVoice","code":"if-else"},{"text":", ","type":"text"},{"type":"codeVoice","code":"if let"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Loops (","type":"text"},{"type":"codeVoice","code":"for-in"},{"text":" via ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true,"type":"reference"},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Built-in views include:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Content"}]},{"type":"text","text":": "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interactive controls"}]},{"text":": ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentat