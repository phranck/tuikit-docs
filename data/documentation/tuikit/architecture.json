{"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain.","type":"text"}],"type":"paragraph"},{"anchor":"Layer-Model","level":2,"type":"heading","text":"Layer Model"},{"anchor":"1-App-Layer","level":3,"type":"heading","text":"1. App Layer"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App"},{"text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" manages the async event loop, terminal setup, signal handling, and event dispatching.","type":"text"}],"type":"paragraph"},{"code":["@main → App → AppRunner → RuntimeEventChannel"],"type":"codeListing","syntax":null},{"anchor":"2-View-Layer","level":3,"type":"heading","text":"2. View Layer"},{"inlineContent":[{"text":"Every UI component conforms to the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","type":"reference","isActive":true},{"text":" protocol. Views are composed declaratively using ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","type":"reference","isActive":true},{"text":", which supports:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditionals ("},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"if-else"},{"type":"text","text":", "},{"type":"codeVoice","code":"if let"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Loops ("},{"type":"codeVoice","code":"for-in"},{"type":"text","text":" via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Built-in views include:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Content"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interactive controls"}],"type":"strong"},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Containers"}]},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Data collections","type":"text"}]},{"text":": ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Layout"}],"type":"strong"},{"type":"text","text":": "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","text":"3. Layout Layer","anchor":"3-Layout-Layer"},{"inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"type":"text","text":": Each child is proposed a size ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":") and returns a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true},{"text":" for details.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"4. Modifier Layer","anchor":"4-Modifier-Layer"},{"inlineContent":[{"text":"Public view modifiers implement the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"text":" protocol with SwiftUI’s","type":"text"},{"text":" ","type":"text"},{"code":"body(content:)","type":"codeVoice"},{"text":" contract: the modifier composes a replacement view around a","type":"text"},{"text":" ","type":"text"},{"text":"placeholder for the modified content, and ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":" wraps both in a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","type":"reference","isActive":true},{"text":" value. Terminal-specific buffer transformations (padding","type":"text"},{"text":" ","type":"text"},{"text":"rows, background fills) run behind an internal buffer-modifier layer that","type":"text"},{"text":" ","type":"text"},{"text":"adjusts the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference","isActive":true},{"text":" before rendering and transforms the rendered","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true},{"text":" afterwards.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"type":"codeListing"},{"level":3,"type":"heading","text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}],"type":"strong"},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"}],"type":"strong"},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference"}]},{"type":"text","text":": Values propagated down the view tree"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference"}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"anchor":"6-Rendering-Layer","text":"6. Rendering Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View tree traversal"}]},{"type":"text","text":": Each view produces a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true},{"type":"text","text":" backed by terminal cells"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"type":"text","text":": Modifiers transform or style cell surfaces"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Layout and compositing","type":"text"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Terminal output","type":"text"}],"type":"strong"},{"type":"text","text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"type":"heading","level":2,"text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" creates "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RuntimeAnimationScheduler"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"text":"The runner then awaits ","type":"text"},{"type":"codeVoice","code":"RuntimeEventChannel"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"code":"TUIContext.reset()","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}]},{"type":"paragraph","inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"type":"heading","level":2,"text":"Focus System","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"anchor":"Essentials","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"metadata":{"title":"Architecture","modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"references":{"doc://TUIkit/documentation/TUIkit/EmptyView":{"kind":"symbol","url":"\/documentation\/tuikit\/emptyview","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EmptyView"}],"abstract":[{"type":"text","text":"A view that displays no content."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","navigatorTitle":[{"kind":"identifier","text":"EmptyView"