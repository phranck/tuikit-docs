t\/Toggle","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Containers","type":"text"}]},{"type":"text","text":": "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true,"type":"reference"},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Data collections","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout"}]},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}]}]}]},{"text":"3. Layout Layer","level":3,"anchor":"3-Layout-Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"text":": Each child is proposed a size (","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"text":") and returns a ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"text":" with flexibility flags","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true,"type":"reference"},{"text":" for details.","type":"text"}],"type":"paragraph"},{"text":"4. Modifier Layer","level":3,"anchor":"4-Modifier-Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"View modifiers implement the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":" protocol. They operate in two phases: "},{"code":"adjustContext(_:)","type":"codeVoice"},{"type":"text","text":" modifies the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"code":"apply(to:context:)","type":"codeVoice"},{"type":"text","text":" transforms the rendered "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}],"type":"paragraph"},{"code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"type":"codeListing","syntax":"swift"},{"text":"5. State & Environment Layer","level":3,"anchor":"5-State--Environment-Layer","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true}],"type":"strong"},{"text":": Two-way connection to a value owned elsewhere","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true}]},{"text":": Values propagated down the view tree","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}]},{"text":"6. Rendering Layer","level":3,"anchor":"6-Rendering-Layer","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"View tree traversal","type":"text"}],"type":"strong"},{"text":": Each view produces a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modifier application","type":"text"}],"type":"strong"},{"text":": Modifiers transform buffers","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"ANSI rendering"}],"type":"strong"},{"type":"text","text":": The "},{"type":"codeVoice","code":"ANSIRenderer"},{"type":"text","text":" converts colors and styles to escape codes"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Terminal output","type":"text"}],"type":"strong"},{"type":"text","text":": The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" lines are written to the terminal"}]}]}]},{"anchor":"Package-Boundaries","level":2,"type":"heading","text":"Package Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"code":"TUIkitImage","type":"codeVoice"},{"type":"text","text":" depends on "},{"code":"TUIkitStyling","type":"codeVoice"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"anchor":"Event-Loop","level":2,"type":"heading","text":"Event Loop"},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"code":"TUIContext","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" creates "},{"code":"InputHandler","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":", installs POSIX signal handlers,"},{"type":"text","text":" "},{"type":"text","text":"sets up the terminal, starts "},{"code":"PulseTimer","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CursorTimer","type":"codeVoice"},{"type":"text","text":", registers state and"},{"type":"text","text":" "},{"type":"text","text":"focus observers, and performs an initial render before entering the main loop."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each loop iteration checks "},{"type":"codeVoice","code":"shouldShutdown"},{"type":"text","text":" (set by SIGINT), consumes the resize flag to invalidate the diff cache if SIGWINCH fired, then renders when "},{"type":"codeVoice","code":"consumeRerenderFlag()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"appState.needsRender"},{"type":"text","text":" is true. After rendering, it reads up to 128 non-blocking key events per frame and dispatches each through five handler layers. A "},{"type":"codeVoice","code":"usleep(28_000)"},{"type":"text","text":" throttles the loop to approximately 35 FPS. Asynchronous render triggers (timers, @State changes, SIGWINCH, focus changes) feed back into the render decision via "},{"type":"codeVoice","code":"appState.needsRender"},{"type":"text","text":" or "},{"type":"codeVoice","code":"signals.requestRerender()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-event-loop.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"anchor":"Focus-System","level":2,"type":"heading","text":"Focus System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}]}],"seeAlsoSections":[{"title":"Essentials","anchor":"Essentials","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/TextField":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","abstract":[{"text":"A control that displays an editable text interface.","type":"text"}],"role":"symbol","title":"TextField","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"TextField"}],"url":"\/documentation\/tuikit\/textfield","navigatorTitle":[{"kind":"identifier","text":"TextField"}],"kind":"symbol"},"doc://TUIkit/documentation/TUIkit/List":{"navigatorTitle":[{"kind":"identifier","text":"List"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"List"}],"abstract":[{"text":"A scrollable list with keyboard navigation and single selection.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","title":"List","role":"symbol","kind":"symbol","url":"\/documentation\/tuikit\/list","type":"topic"},"doc://TUIkit/documentation/TUIkit/Button":{"abstract":[{"type":"text","text":"An interactive button that triggers an action when pressed."}],"url":"\/documentation\/tuikit\/button","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Button","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation