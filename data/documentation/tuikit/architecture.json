{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain.","type":"text"}]},{"type":"heading","anchor":"Layer-Model","text":"Layer Model","level":2},{"type":"heading","anchor":"1-App-Layer","text":"1. App Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}]},{"type":"codeListing","code":["@main → App → AppRunner → RuntimeEventChannel"],"syntax":null},{"type":"heading","anchor":"2-View-Layer","text":"2. View Layer","level":3},{"type":"paragraph","inlineContent":[{"text":"Every UI component conforms to the ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true},{"text":" protocol. Views are composed declaratively using ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","isActive":true},{"text":", which supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Single and multiple child views (up to 10)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Conditionals (","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if-else","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if let","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"},{"text":")","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Built-in views include:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Content","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interactive controls"}]},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Containers"}]},{"text":": ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Data collections","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout","type":"text"}]},{"type":"text","text":": "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference"}]}]}]},{"type":"heading","anchor":"3-Layout-Layer","text":"3. Layout Layer","level":3},{"type":"paragraph","inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"text":": Each child is proposed a size (","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference"},{"text":") and returns a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference"},{"text":" with flexibility flags","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","type":"reference"},{"text":" for details.","type":"text"}]},{"type":"heading","anchor":"4-Modifier-Layer","text":"4. Modifier Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"View modifiers implement the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" protocol. They operate in two phases: "},{"type":"codeVoice","code":"adjustContext(_:)"},{"type":"text","text":" modifies the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"type":"codeVoice","code":"modify(buffer:context:)"},{"type":"text","text":" transforms the rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}]},{"type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift"},{"type":"heading","anchor":"5-State--Environment-Layer","text":"5. State & Environment Layer","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference"}]},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true}],"type":"strong"},{"text":": Values propagated down the view tree","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"6-Rendering-Layer","text":"6. Rendering Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View tree traversal"}]},{"type":"text","text":": Each view produces a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" backed by terminal cells"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modifier application","type":"text"}],"type":"strong"},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Layout and compositing","type":"text"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}]}]}]},{"type":"heading","anchor":"Package-Boundaries","text":"Package Boundaries","level":2},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"type":"heading","anchor":"Event-Loop","text":"Event Loop","level":2},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"code":"PulseTimer","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CursorTimer","type":"codeVoice"},{"text":" are monotonic phase calculators rather than","type":"text"},{"text":" ","type":"text"},{"text":"background timers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runner then awaits "},{"type":"codeVoice","code":"RuntimeEventChannel"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"code":"TUIContext.reset()","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"type":"heading","anchor":"Focus-System","text":"Focus System","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"kind":"article","metadata":{"modules":[{"name":"TUIkit"}],"role":"article","title":"Architecture","roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"generated":true,"title":"Essentials","anchor":"Essentials"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/RenderContext":{"type":"topic","navigatorTitle":[{"text":"RenderContext","kind":"identifier"}],"url":"\/documentation\/tuikit\/rendercontext","abstract":[{"text":"The context for rendering a view.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","title":"RenderContext","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderContext","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/LazyVStack":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazyVStack","kind":"identifier"}],"navigatorTitle":[{"text":"LazyVStack","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","abstract":[{"text":"A view that arranges its children in a line that grows vertically,","type":"text"},{"text":" ","type":"text"},{"t