ield","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Containers"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Data collections","type":"text"}]},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"3. Layout Layer","type":"heading","anchor":"3-Layout-Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"text":": Each child is proposed a size (","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"text":") and returns a ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"text":" with flexibility flags","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true},{"type":"text","text":" for details."}]},{"text":"4. Modifier Layer","type":"heading","anchor":"4-Modifier-Layer","level":3},{"type":"paragraph","inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"text":" protocol. They operate in two phases: ","type":"text"},{"type":"codeVoice","code":"adjustContext(_:)"},{"text":" modifies the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference","isActive":true},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"type":"codeVoice","code":"apply(to:context:)"},{"text":" transforms the rendered ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"]},{"type":"heading","anchor":"5-State--Environment-Layer","text":"5. State & Environment Layer","level":3},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"}]},{"text":": Mutable per-view state that triggers re-renders","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true}],"type":"strong"},{"text":": Two-way connection to a value owned elsewhere","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference"}],"type":"strong"},{"text":": Values propagated down the view tree","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference"}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}]},{"type":"heading","anchor":"6-Rendering-Layer","text":"6. Rendering Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View tree traversal"}]},{"type":"text","text":": Each view produces a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"type":"text","text":": Modifiers transform buffers"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"ANSI rendering"}],"type":"strong"},{"type":"text","text":": The "},{"type":"codeVoice","code":"ANSIRenderer"},{"type":"text","text":" converts colors and styles to escape codes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"type":"text","text":": The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" lines are written to the terminal"}]}]}]},{"text":"Package Boundaries","level":2,"type":"heading","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"type":"codeVoice","code":"TUIkitImage"},{"type":"text","text":" depends on "},{"type":"codeVoice","code":"TUIkitStyling"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","type":"reference"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}]},{"text":"Event Loop","level":2,"type":"heading","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"type":"codeVoice","code":"TUIContext"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" creates ","type":"text"},{"type":"codeVoice","code":"InputHandler"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RenderLoop"},{"text":", installs POSIX signal handlers,","type":"text"},{"text":" ","type":"text"},{"text":"sets up the terminal, starts ","type":"text"},{"type":"codeVoice","code":"PulseTimer"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"CursorTimer"},{"text":", registers state and","type":"text"},{"text":" ","type":"text"},{"text":"focus observers, and performs an initial render before entering the main loop.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each loop iteration checks ","type":"text"},{"type":"codeVoice","code":"shouldShutdown"},{"text":" (set by SIGINT), consumes the resize flag to invalidate the diff cache if SIGWINCH fired, then renders when ","type":"text"},{"type":"codeVoice","code":"consumeRerenderFlag()"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"appState.needsRender"},{"text":" is true. After rendering, it reads up to 128 non-blocking key events per frame and dispatches each through five handler layers. A ","type":"text"},{"type":"codeVoice","code":"usleep(28_000)"},{"text":" throttles the loop to approximately 35 FPS. Asynchronous render triggers (timers, @State changes, SIGWINCH, focus changes) feed back into the render decision via ","type":"text"},{"type":"codeVoice","code":"appState.needsRender"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"signals.requestRerender()"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-event-loop.png"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"text":"Focus System","level":2,"type":"heading","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"references":{"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","kind":"article","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"role":"article","url":"\/documentation\/tuikit\/layoutsystem","title":"Layout System","type":"topic"},"doc://TUIkit/documentation/TUIkit":{"kind":"symbol","role":"collection","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"url":"\/documentation\/tuikit","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","title":"TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"type":"topic"},"doc://TUIkit/documentation/TUIkit/RenderCycle":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","kind":"article","type":"topic","title":"Render Cycle","url":"\/documentation\/tuikit\/rendercycle","abstract":[{"text":"Understand how TUIkit turns your view tree into terminal output: one frame at a time.","type":"text"}],"role":"article"},"doc://TUIkit/documentation/TUIkit/Menu":{"url":"\/documentation\/tuikit\/menu","role":"symbol","abstract":[{"text":"A vertical menu displaying a list of selectable items.","type":"text"}],"navigatorTitle"