{"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Essentials","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"generated":true,"anchor":"Essentials"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain."}]},{"type":"heading","level":2,"text":"Layer Model","anchor":"Layer-Model"},{"type":"heading","level":3,"text":"1. App Layer","anchor":"1-App-Layer"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App"},{"text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" manages the async event loop, terminal setup, signal handling, and event dispatching.","type":"text"}]},{"type":"codeListing","code":["@main → App → AppRunner → RuntimeEventChannel"],"syntax":null},{"type":"heading","level":3,"text":"2. View Layer","anchor":"2-View-Layer"},{"type":"paragraph","inlineContent":[{"text":"Every UI component conforms to the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true,"type":"reference"},{"text":" protocol. Views are composed declaratively using ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","isActive":true,"type":"reference"},{"text":", which supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}]}]},{"content":[{"inlineContent":[{"text":"Conditionals (","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if-else","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if let","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"},{"text":")","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Built-in views include:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Content","type":"text"}]},{"type":"text","text":": "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","type":"reference","isActive":true}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Interactive controls"}],"type":"strong"},{"text":": ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/d