{"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain."}],"type":"paragraph"},{"level":2,"anchor":"Layer-Model","text":"Layer Model","type":"heading"},{"level":3,"anchor":"1-App-Layer","text":"1. App Layer","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","type":"reference"},{"text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" manages the main run loop, terminal setup, signal handling, and event dispatching.","type":"text"}],"type":"paragraph"},{"syntax":null,"code":["@main → App → AppRunner → Main Loop"],"type":"codeListing"},{"level":3,"anchor":"2-View-Layer","text":"2. View Layer","type":"heading"},{"inlineContent":[{"text":"Every UI component conforms to the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","type":"reference","isActive":true},{"text":" protocol. Views are composed declaratively using ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","type":"reference","isActive":true},{"text":", which supports:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Single and multiple child views (up to 10)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditionals ("},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"if-else"},{"type":"text","text":", "},{"type":"codeVoice","code":"if let"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference","isActive":true},{"text":")","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Built-in views include:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Content","type":"text"}]},{"text":": ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Interactive controls","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"type":"text","text":", "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Containers","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Data collections"}]},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"3-Layout-Layer","level":3,"text":"3. Layout Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"type":"text","text":": Each child is proposed a size ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":") and returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" with flexibility flags"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},{"type":"text","text":" for details."}]},{"type":"heading","anchor":"4-Modifier-Layer","level":3,"text":"4. Modifier Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"View modifiers implement the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"type":"text","text":" protocol. They operate in two phases: "},{"code":"adjustContext(_:)","type":"codeVoice"},{"type":"text","text":" modifies the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference","isActive":true},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"code":"apply(to:context:)","type":"codeVoice"},{"type":"text","text":" transforms the rendered "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"]},{"type":"heading","anchor":"5-State--Environment-Layer","level":3,"text":"5. State & Environment Layer"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true}],"type":"strong"},{"text":": Two-way connection to a value owned elsewhere","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true}]},{"type":"text","text":": Values propagated down the view tree"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"}],"type":"strong"},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}]},{"type":"heading","anchor":"6-Rendering-Layer","level":3,"text":"6. Rendering Layer"},{"inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View tree traversal","type":"text"}]},{"type":"text","text":": Each view produces a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"type":"text","text":": Modifiers transform buffers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"ANSI rendering","type":"text"}]},{"type":"text","text":": The "},{"type":"codeVoice","code":"ANSIRenderer"},{"type":"text","text":" converts colors and styles to escape codes"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Terminal output"}],"type":"strong"},{"text":": The ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":" lines are written to the terminal","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Package Boundaries","level":2,"anchor":"Package-Boundaries","type":"heading"},{"inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"type":"codeVoice","code":"TUIkitImage"},{"type":"text","text":" depends on "},{"type":"codeVoice","code":"TUIkitStyling"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"level":2,"text":"Event Loop","anchor":"Event-Loop","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"code":"TUIContext","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" creates "},{"code":"InputHandler","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":", installs POSIX signal handlers,"},{"type":"text","text":" "},{"type":"text","text":"sets up the terminal, starts "},{"code":"PulseTimer","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CursorTimer","type":"codeVoice"},{"type":"text","text":", registers state and"},{"type":"text","text":" "},{"type":"text","text":"focus observers, and performs an initial render before entering the main loop."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each loop iteration checks "},{"type":"codeVoice","code":"shouldShutdown"},{"type":"text","text":" (set by SIGINT), consumes the resize flag to invalidate the diff cache if SIGWINCH fired, then renders when "},{"type":"codeVoice","code":"consumeRerenderFlag()"},{"type":"text","text":" or "},{"type":"codeVoice","code":"appState.needsRender"},{"type":"text","text":" is true. After rendering, it reads up to 128 non-blocking key events per frame and dispatches each through five handler layers. A "},{"type":"codeVoice","code":"usleep(28_000)"},{"type":"text","text":" throttles the loop to approximately 35 FPS. Asynchronous render triggers (timers, @State changes, SIGWINCH, focus changes) feed back into the render decision via "},{"type":"codeVoice","code":"appState.needsRender"},{"type":"text","text":" or "},{"type":"codeVoice","code":"signals.requestRerender()"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-event-loop.png","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"level":2,"text":"Focus System","anchor":"Focus-System","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]