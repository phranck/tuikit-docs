tation\/TUIkit\/VStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}],"type":"paragraph"}]}]},{"type":"heading","text":"3. Layout Layer","level":3,"anchor":"3-Layout-Layer"},{"type":"paragraph","inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"type":"text","text":": Each child is proposed a size ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":") and returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","type":"reference"},{"text":" for details.","type":"text"}]},{"type":"heading","text":"4. Modifier Layer","level":3,"anchor":"4-Modifier-Layer"},{"type":"paragraph","inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"text":" protocol. They operate in two phases: ","type":"text"},{"code":"adjustContext(_:)","type":"codeVoice"},{"text":" modifies the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"code":"modify(buffer:context:)","type":"codeVoice"},{"text":" transforms the rendered ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}]},{"type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift"},{"type":"heading","text":"5. State & Environment Layer","level":3,"anchor":"5-State--Environment-Layer"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}],"type":"strong"},{"type":"text","text":": Mutable per-view state that triggers re-renders"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference","isActive":true}]},{"text":": Two-way connection to a value owned elsewhere","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true}]},{"type":"text","text":": Values propagated down the view tree"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}]},{"type":"heading","text":"6. Rendering Layer","level":3,"anchor":"6-Rendering-Layer"},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"View tree traversal"}],"type":"strong"},{"text":": Each view produces a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":" backed by terminal cells","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Modifier application","type":"text"}]},{"type":"text","text":": Modifiers transform or style cell surfaces"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout and compositing","type":"text"}]},{"type":"text","text":": Containers position, clip, and layer complete grapheme cells"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Terminal output","type":"text"}],"type":"strong"},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Package Boundaries","level":2,"anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"type":"codeVoice","code":"TUIkitImage"},{"text":" depends on ","type":"text"},{"type":"codeVoice","code":"TUIkitStyling"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"type":"heading","text":"Event Loop","level":2,"anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" creates "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RuntimeAnimationScheduler"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"text":"The runner then awaits ","type":"text"},{"code":"RuntimeEventChannel","type":"codeVoice"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"type":"codeVoice","code":"TUIContext.reset()"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"type":"heading","text":"Focus System","level":2,"anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"},"variants":[{"paths":["\/documentation\/tuikit\/architecture"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"modules":[{"name":"TUIkit"}],"title":"Architecture","roleHeading":"Article","role":"article"},"kind":"article","references":{"doc://TUIkit/documentation/TUIkit/ZStack":{"kind":"symbol","type":"topic","title":"ZStack","url":"\/documentation\/tuikit\/zstack","navigatorTitle":[{"text":"ZStack","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","abstract":[{"text":"A view that stacks its children on top of each other (z-axis).","type":"text"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ZStack","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/Divider":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Divider"}],"title":"Divider","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","abstract":[{"type":"text","text":"A visual separator between views."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Divider"}],"type":"topic","url":"\/documentation\/tuikit\/divider","role":"symbo