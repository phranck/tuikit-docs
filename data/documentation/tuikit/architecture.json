{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"title":"Architecture","role":"article","roleHeading":"Article","modules":[{"name":"TUIkit"}]},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain."}],"type":"paragraph"},{"anchor":"Layer-Model","type":"heading","level":2,"text":"Layer Model"},{"anchor":"1-App-Layer","type":"heading","level":3,"text":"1. App Layer"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","type":"reference","isActive":true},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}],"type":"paragraph"},{"syntax":null,"code":["@main → App → AppRunner → RuntimeEventChannel"],"type":"codeListing"},{"anchor":"2-View-Layer","type":"heading","level":3,"text":"2. View Layer"},{"inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","type":"reference","isActive":true},{"type":"text","text":" protocol. Views are composed declaratively using "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","type":"reference","isActive":true},{"type":"text","text":", which supports:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Conditionals ("},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"if-else"},{"type":"text","text":", "},{"type":"codeVoice","code":"if let"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Loops ("},{"type":"codeVoice","code":"for-in"},{"type":"text","text":" via "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true},{"type":"text","text":")"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Built-in views include:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Content"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Interactive controls","type":"text"}]},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Containers"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Data collections"}],"type":"strong"},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference"}]}]}]},{"text":"3. Layout Layer","level":3,"type":"heading","anchor":"3-Layout-Layer"},{"inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"text":": Each child is proposed a size (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"text":") and returns a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"text":" with flexibility flags","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true,"type":"reference"},{"type":"text","text":" for details."}],"type":"paragraph"},{"text":"4. Modifier Layer","level":3,"type":"heading","anchor":"4-Modifier-Layer"},{"inlineContent":[{"type":"text","text":"View modifiers implement the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","type":"reference","isActive":true},{"type":"text","text":" protocol. They operate in two phases: "},{"code":"adjustContext(_:)","type":"codeVoice"},{"type":"text","text":" modifies the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","type":"reference","isActive":true},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"code":"modify(buffer:context:)","type":"codeVoice"},{"type":"text","text":" transforms the rendered "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}],"type":"paragraph"},{"code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"type":"codeListing","syntax":"swift"},{"text":"5. State & Environment Layer","level":3,"type":"heading","anchor":"5-State--Environment-Layer"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true}],"type":"strong"},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true,"type":"reference"}]},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Values propagated down the view tree","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}],"type":"unorderedList"},{"text":"6. Rendering Layer","level":3,"type":"heading","anchor":"6-Rendering-Layer"},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View tree traversal","type":"text"}]},{"text":": Each view produces a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"},{"text":" backed by terminal cells","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modifier application"}]},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout and compositing"}]},{"type":"text","text":": Containers position, clip, and layer complete grapheme cells"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Terminal output"}],"type":"strong"},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"code":"TUIkitImage","type":"codeVoice"},{"type":"text","text":" depends on "},{"code":"TUIkitStyling","type":"codeVoice"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}]},{"type":"heading","level":2,"text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"code":"TUIContext","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" creates "},{"code":"InputHandler","type":"codeVoice"},{"type":"text","text":", "},{"code":"RenderLoop","type":"codeVoice"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"code":"PulseTimer","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CursorTimer","type":"codeVoice"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"text":"The runner then awaits ","type":"text"},{"type":"codeVoice","code":"RuntimeEventChannel"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"code":"TUIContext.reset()","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}]},{"type":"paragraph","inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"type":"heading","text":"Focus System","anchor":"Focus-System","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Understand the layer model and rendering pipeline of TUIkit.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"generated":true,"anchor":"Essentials","title":"Essentials"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/ProgressView":{"title":"ProgressView","navigatorTitle":[{"text":"ProgressView","kind":"identifier"}],"abstract":[{"text":"A view that shows the progress toward completion of a task.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","role":"symbol","url":"\/documentation\/tuikit\/progressview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProgressView","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/Card":{"navigatorTitle":[{"text":"Card","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","title":"Card","type":"topic","url":"\/documentation\/tuikit\/card","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Card","kind":"identifier"}],"abstract":[{"text":"A padded, optionally titled container with background support.","type":"text"}],"kind":"symbol"},"doc://TUIkit/documentation/TUIkit/State":{"type":"topic","kind":"symbol","role":"symbol","title":"State","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"identifier"}],"url":"\/documentation\/tuikit\/state","abstract":[{"type":"text","text":"A property wrapper that stores mutable state for a view."}],"navigatorTitle":[{"text":"State","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"},"doc://TUIkit/documentation/TUIkit/Stepper":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Stepper"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Stepper"}],"type":"topic","title":"Stepper","abstract":[{"type":"text","text":"A control that performs increment and decrement actions."}],"kind":"symbol","url":"\/documentation\/tuikit\/stepper"},"doc://TUIkit/documentation/TUIkit/Alert":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Alert","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/tuikit\/alert","abstract":[{"type":"text","text":"A modal alert view that displays a title, message, and optional action buttons."}],"navigatorTitle":[{"text":"Alert","kind":"identifier"}],"role":"symbol","type":"topic","title":"Alert"},"doc://TUIkit/documentation/TUIkit/Slider":{"title":"Slider","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Slider","kind":"identifier"}],"url":"\/documentation\/tuikit\/slider","navigatorTitle":[{"text":"Slider","kind":"identifier"}],"abstract":[{"text":"A control for selecting a value from a bounded linear range of values.","type":"text"}],"kind":"symbol","role":"symbol"},"doc://TUIkit/documentation/TUIkit/Spacer":{"role":"symbol","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"A flexible spacer that fills available space."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","navigatorTitle":[{"kind":"identifier","text":"Spacer"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Spacer"}],"title":"Spacer","url":"\/documentation\/tuikit\/spacer"},"doc://TUIkit/documentation/TUIkit/Table":{"abstract":[{"type":"text","text":"A scrollable table with columns, keyboard navigation, and selection."}],"navigatorTitle":[{"text":"Table","kind":"identifier"}],"role":"symbol","title":"Table","url":"\/documentation\/tuikit\/table","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Table","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/EnvironmentValues":{"title":"EnvironmentValues","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A collection of environment values propagated through the view hierarchy."}],"navigatorTitle":[{"text":"EnvironmentValues","kind":"identifier"}],"role":"symbol","url":"\/documentation\/tuikit\/environmentvalues","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EnvironmentValues","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/LazyVStack":{"title":"LazyVStack","navigatorTitle":[{"text":"LazyVStack","kind":"identifier"}],"abstract":[{"type":"text","text":"A view that arranges its children in a line that grows vertically,"},{"type":"text","text":" "},{"type":"text","text":"creating items only as needed."}],"role":"symbol","kind":"symbol","type":"topic","url":"\/documentation\/tuikit\/lazyvstack","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazyVStack","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},"doc://TUIkit/documentation/TUIkit/RenderCycle":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","url":"\/documentation\/tuikit\/rendercycle","abstract":[{"type":"text","text":"Understand how TUIkit turns your view tree into terminal output: one frame at a time."}],"title":"Render Cycle","role":"article","kind":"article"},"doc://TUIkit/documentation/TUIkit/ForEach":{"title":"ForEach","role":"symbol","url":"\/documentation\/tuikit\/foreach","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","kind":"symbol","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ForEach","kind":"identifier"}],"abstract":[{"type":"text","text":"A view that generates views from a collection of data."}],"navigatorTitle":[{"text":"ForEach","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/TextField":{"navigatorTitle":[{"text":"TextField","kind":"identifier"}],"url":"\/documentation\/tuikit\/textfield","title":"TextField","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","abstract":[{"text":"A control that displays an editable text interface.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TextField","kind":"identifier"}],"role":"symbol"},"doc://TUIkit/documentation/TUIkit/Menu":{"url":"\/documentation\/tuikit\/menu","navigatorTitle":[{"kind":"identifier","text":"Menu"}],"abstract":[{"type":"text","text":"A vertical menu displaying a list of selectable items."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Menu"}],"title":"Menu","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","role":"symbol"},"doc://TUIkit/documentation/TUIkit/FrameBuffer":{"abstract":[{"text":"A 2D terminal-cell buffer that views render into before flushing.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/tuikit\/framebuffer","navigatorTitle":[{"text":"FrameBuffer","kind":"identifier"}],"title":"FrameBuffer","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"FrameBuffer","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},"doc://TUIkit/documentation/TUIkit/Panel":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Panel"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Panel"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"topic","title":"Panel","abstract":[{"text":"A labeled container — always has a title, optionally a footer.","type":"text"}],"url":"\/documentation\/tuikit\/panel"},"doc://TUIkit/documentation/TUIkit/SecureField":{"navigatorTitle":[{"kind":"identifier","text":"SecureField"}],"role":"symbol","abstract":[{"type":"text","text":"A control for secure text entry, where the display masks the user’s input."}],"url":"\/documentation\/tuikit\/securefield","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","title":"SecureField","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"SecureField"}]},"doc://TUIkit/documentation/TUIkit":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","url":"\/documentation\/tuikit","role":"collection","kind":"symbol","type":"topic","title":"TUIkit","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}]},"architecture-input-dispatch.png":{"alt":"Flowchart of the 5-layer input dispatch: A hasTextInputFocus check gates Layer 0 (Text Input via focusManager.dispatchKeyEvent for TextField\/SecureField