{"metadata":{"title":"Architecture","roleHeading":"Article","modules":[{"name":"TUIkit"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Essentials","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"generated":true,"title":"Essentials"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain.","type":"text"}]},{"type":"heading","level":2,"anchor":"Layer-Model","text":"Layer Model"},{"type":"heading","level":3,"anchor":"1-App-Layer","text":"1. App Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App"},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}]},{"type":"codeListing","syntax":null,"code":["@main → App → AppRunner → RuntimeEventChannel"]},{"type":"heading","level":3,"anchor":"2-View-Layer","text":"2. View Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" protocol. Views are composed declaratively using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder"},{"type":"text","text":", which supports:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditionals ("},{"type":"codeVoice","code":"if"},{"type":"text","text":", "},{"type":"codeVoice","code":"if-else"},{"type":"text","text":", "},{"type":"codeVoice","code":"if let"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Loops ("},{"type":"codeVoice","code":"for-in"},{"type":"text","text":" via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"},{"type":"text","text":")"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Built-in views include:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Content","type":"text"}]},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Interactive controls","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Containers"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Data collections","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true},{"text":", ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Layout","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true}],"type":"paragraph"}]}]},{"level":3,"text":"3. Layout Layer","anchor":"3-Layout-Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":": Each child is proposed a size ("},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"type":"text","text":") and returns a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"type":"text","text":" with flexibility flags"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},{"type":"text","text":" for details."}],"type":"paragraph"},{"level":3,"text":"4. Modifier Layer","anchor":"4-Modifier-Layer","type":"heading"},{"inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"text":" protocol. They operate in two phases: ","type":"text"},{"type":"codeVoice","code":"adjustContext(_:)"},{"text":" modifies the ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"type":"codeVoice","code":"apply(to:context:)"},{"text":" transforms the rendered ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"type":"codeListing"},{"level":3,"text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"}]},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference","isActive":true}]},{"text":": Values propagated down the view tree","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"6. Rendering Layer","anchor":"6-Rendering-Layer","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"View tree traversal","type":"text"}],"type":"strong"},{"text":": Each view produces a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"text":": Modifiers transform buffers","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"ANSI rendering"}]},{"type":"text","text":": The "},{"type":"codeVoice","code":"ANSIRenderer"},{"type":"text","text":" converts colors and styles to escape codes"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Terminal output"}],"type":"strong"},{"text":": The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" lines are written to the terminal","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","type":"reference"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}]},{"level":2,"type":"heading","text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" creates "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RuntimeAnimationScheduler"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"text":"The runner then awaits ","type":"text"},{"type":"codeVoice","code":"RuntimeEventChannel"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"type":"codeVoice","code":"TUIContext.reset()"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}]},{"level":2,"type":"heading","text":"Focus System","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"FocusManager"},{"text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys.","type":"text"}]}],"kind":"content"}],"references":{"doc://TUIkit/documentation/TUIkit/View":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"identifier"}],"url":"\/documentation\/tuikit\/view","title":"View","type":"topic","kind":"symbol","abstract":[{"text":"The base protocol for all TUIkit views.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"View","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit":{"type":"topic","title":"TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"kind":"symbol","url":"\/documentation\/tuikit","role":"collection","images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit"},"doc://TUIkit/d