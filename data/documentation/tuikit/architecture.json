{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"],"title":"Essentials","generated":true,"anchor":"Essentials"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain."}],"type":"paragraph"},{"level":2,"text":"Layer Model","anchor":"Layer-Model","type":"heading"},{"level":3,"text":"1. App Layer","anchor":"1-App-Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","type":"reference","isActive":true},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"code":"AppRunner","type":"codeVoice"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}],"type":"paragraph"},{"syntax":null,"type":"codeListing","code":["@main → App → AppRunner → RuntimeEventChannel"]},{"level":3,"text":"2. View Layer","anchor":"2-View-Layer","type":"heading"},{"inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true},{"type":"text","text":" protocol. Views are composed declaratively using "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","isActive":true},{"type":"text","text":", which supports:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Single and multiple child views (up to 10)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Conditionals (","type":"text"},{"code":"if","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if-else","type":"codeVoice"},{"text":", ","type":"text"},{"code":"if let","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","type":"reference"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Built-in views include:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Content","type":"text"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","isActive":true}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Interactive controls","type":"text"}]},{"text":": ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Containers"}]},{"type":"text","text":": "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference"},{"type":"text","text":", "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Data collections","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true,"type":"reference"}]}]}],"type":"unorderedList"},{"level":3,"text":"3. Layout Layer","anchor":"3-Layout-Layer","type":"heading"},{"inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Measure","type":"text"}]},{"type":"text","text":": Each child is proposed a size ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":") and returns a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" with flexibility flags"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true},{"text":" for details.","type":"text"}],"type":"paragraph"},{"level":3,"text":"4. Modifier Layer","anchor":"4-Modifier-Layer","type":"heading"},{"inlineContent":[{"text":"Public view modifiers implement the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true,"type":"reference"},{"text":" protocol with SwiftUI’s","type":"text"},{"text":" ","type":"text"},{"code":"body(content:)","type":"codeVoice"},{"text":" contract: the modifier composes a replacement view around a","type":"text"},{"text":" ","type":"text"},{"text":"placeholder for the modified content, and ","type":"text"},{"code":".modifier(_:)","type":"codeVoice"},{"text":" wraps both in a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent","isActive":true,"type":"reference"},{"text":" value. Terminal-specific buffer transformations (padding","type":"text"},{"text":" ","type":"text"},{"text":"rows, background fills) run behind an internal buffer-modifier layer that","type":"text"},{"text":" ","type":"text"},{"text":"adjusts the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true,"type":"reference"},{"text":" before rendering and transforms the rendered","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" afterwards.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"]},{"level":3,"text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}]},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference","isActive":true}]},{"type":"text","text":": Two-way connection to a value owned elsewhere"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","type":"reference"}],"type":"strong"},{"type":"text","text":": Values propagated down the view tree"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}],"type":"unorderedList"},{"level":3,"text":"6. Rendering Layer","anchor":"6-Rendering-Layer","type":"heading"},{"inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"View tree traversal","type":"text"}],"type":"strong"},{"text":": Each view produces a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":" backed by terminal cells","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout and compositing","type":"text"}]},{"type":"text","text":": Containers position, clip, and layer complete grapheme cells"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Terminal output","type":"text"}],"type":"strong"},{"type":"text","text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary"}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Package Boundaries","anchor":"Package-Boundaries","type":"heading"},{"inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","type":"reference","isActive":true},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}],"type":"paragraph"},{"level":2,"text":"Event Loop","anchor":"Event-Loop","type":"heading"},{"inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"code":"PulseTimer","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CursorTimer","type":"codeVoice"},{"text":" are monotonic phase calculators rather than","type":"text"},{"text":" ","type":"text"},{"text":"background timers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The runner then awaits ","type":"text"},{"code":"RuntimeEventChannel","type":"codeVoice"},{"text":". State invalidations request a","type":"text"},{"text":" ","type":"text"},{"text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the","type":"text"},{"text":" ","type":"text"},{"text":"diff cache, animation deadlines advance visible focus effects, and termination","type":"text"},{"text":" ","type":"text"},{"text":"events begin cleanup. These paths are serialized on the main actor. With no","type":"text"},{"text":" ","type":"text"},{"text":"pending event or visible animation deadline, the runtime remains suspended and","type":"text"},{"text":" ","type":"text"},{"text":"does no periodic work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"type":"codeVoice","code":"TUIContext.reset()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}],"type":"paragraph"},{"inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"architecture-input-dispatch.png","type":"image"}],"type":"paragraph"},{"level":2,"text":"Focus System","anchor":"Focus-System","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}],"type":"paragraph"}]}],"metadata":{"title":"Architecture","modules":[{"name":"TUIkit"}],"role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"sections":[],"references":{"doc://TUIkit/documentation/TUIkit/HStack":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"HStack","kind":"identifier"}],"url":"\/documentation\/tuikit\/hstack","role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","navigatorTitle":[{"kind":"identifier","text":"HStack"}],"kind":"symbol","abstract":[{"type":"text","text":"A view that arran