e-event-loop.png","traits":["1x","light"]},{"url":"\/images\/TUIkit\/architecture-event-loop~dark.png","traits":["1x","dark"]}],"alt":"Flowchart of the TUIkit event loop: @main entry initializes subsystems, sets up terminal, starts timers and observers, performs an initial render, then enters the main loop. The loop checks shouldShutdown, consumes the resize flag to invalidate the diff cache, checks rerenderFlag or needsRender to conditionally render, reads key events non-blocking up to 128 per frame, dispatches through 5 input layers, and sleeps 28ms. SIGINT exits to cleanup. Async render triggers from timers, state changes, SIGWINCH, and focus changes feed back into the needsRender check."},"doc://TUIkit/documentation/TUIkit/ProposedSize":{"url":"\/documentation\/tuikit\/proposedsize","abstract":[{"type":"text","text":"How much space a parent proposes to a child view."}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"ProposedSize","kind":"identifier"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ProposedSize","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","title":"ProposedSize"},"doc://TUIkit/documentation/TUIkit/Card":{"role":"symbol","url":"\/documentation\/tuikit\/card","navigatorTitle":[{"text":"Card","kind":"identifier"}],"abstract":[{"text":"A padded, optionally titled container with background support.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","kind":"symbol","type":"topic","title":"Card","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Card","kind":"identifier"}]},"tuikit-logo.png":{"variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"type":"image","identifier":"tuikit-logo.png","alt":"TUIkit Logo"},"doc://TUIkit/documentation/TUIkit/RenderCycle":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle","abstract":[{"type":"text","text":"Unders