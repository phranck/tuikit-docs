/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Layout","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"text":", ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}]}]}],"type":"unorderedList"},{"text":"3. Layout Layer","anchor":"3-Layout-Layer","level":3,"type":"heading"},{"inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"text":": Each child is proposed a size (","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"text":") and returns a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"text":" with flexibility flags","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Render"}],"type":"strong"},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","type":"reference","isActive":true},{"type":"text","text":" for details."}],"type":"paragraph"},{"text":"4. Modifier Layer","anchor":"4-Modifier-Layer","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"View modifiers implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":" protocol. They operate in two phases: "},{"type":"codeVoice","code":"adjustContext(_:)"},{"type":"text","text":" modifies the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"type":"codeVoice","code":"modify(buffer:context:)"},{"type":"text","text":" transforms the rendered "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"type":"codeListing"},{"text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true}]},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","isActive":true}]},{"type":"text","text":": Two-way connection to a value owned elsewhere"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"}]},{"type":"text","text":": Values propagated down the view tree"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","isActive":true,"type":"reference"}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}],"type":"unorderedList"},{"text":"6. Rendering Layer","anchor":"6-Rendering-Layer","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View tree traversal"}]},{"type":"text","text":": Each view produces a "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"},{"type":"text","text":" backed by terminal cells"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Modifier application","type":"text"}]},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Layout and compositing","type":"text"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Package Boundaries","anchor":"Package-Boundaries","level":2},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"type":"heading","text":"Event Loop","anchor":"Event-Loop","level":2},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"code":"PulseTimer","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CursorTimer","type":"codeVoice"},{"text":" are monotonic phase calculators rather than","type":"text"},{"text":" ","type":"text"},{"text":"background timers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runner then awaits "},{"code":"RuntimeEventChannel","type":"codeVoice"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"type":"codeVoice","code":"TUIContext.reset()"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"type":"heading","text":"Focus System","anchor":"Focus-System","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"FocusManager","type":"codeVoice"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://TUIkit/documentation/TUIkit/FrameBuffer":{"abstract":[{"type":"text","text":"A 2D terminal-cell buffer that views render into before flushing."}],"type":"topic","url":"\/documentation\/tuikit\/framebuffer","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"FrameBuffer"}],"title":"FrameBuffer","role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","navigatorTitle":[{"kind":"identifier","text":"FrameBuffer"}]},"doc://TUIkit/documentation/TUIkit/Text":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","url":"\/documentation\/tuikit\/text","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"A view that displays text in the terminal."}],"role":"symbol","navigatorTitle":[{"text":"Text","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","tex