{"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Essentials","generated":true,"title":"Essentials","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain.","type":"text"}],"type":"paragraph"},{"text":"Layer Model","anchor":"Layer-Model","level":2,"type":"heading"},{"text":"1. App Layer","anchor":"1-App-Layer","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}],"type":"paragraph"},{"syntax":null,"code":["@main → App → AppRunner → RuntimeEventChannel"],"type":"codeListing"},{"text":"2. View Layer","anchor":"2-View-Layer","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true},{"type":"text","text":" protocol. Views are composed declaratively using "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","isActive":true},{"type":"text","text":", which supports:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single and multiple child views (up to 10)"}]}]},{"content":[{"inlineContent":[{"text":"Conditionals (","type":"text"},{"type":"codeVoice","code":"if"},{"text":", ","type":"text"},{"type":"codeVoice","code":"if-else"},{"text":", ","type":"text"},{"type":"codeVoice","code":"if let"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Built-in views include:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Content","type":"text"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Interactive controls"}]},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Containers"}]},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Data collections"}]},{"type":"text","text":": "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout"}]},{"type":"text","text":": "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"anchor":"3-Layout-Layer","text":"3. Layout Layer"},{"type":"paragraph","inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":": Each child is proposed a size ("},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","type":"reference","isActive":true},{"type":"text","text":") and returns a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","type":"reference","isActive":true},{"type":"text","text":" with flexibility flags"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This enables spacers, flexible text fields, and proportional sizing. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},{"text":" for details.","type":"text"}]},{"type":"heading","level":3,"text":"4. Modifier Layer","anchor":"4-Modifier-Layer"},{"type":"paragraph","inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"text":" protocol. They operate in two phases: ","type":"text"},{"code":"adjustContext(_:)","type":"codeVoice"},{"text":" modifies the ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"code":"modify(buffer:context:)","type":"codeVoice"},{"text":" transforms the rendered ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"]},{"level":3,"type":"heading","text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","type":"reference"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference"}]},{"text":": Two-way connection to a value owned elsewhere","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true}]},{"type":"text","text":": Values propagated down the view tree"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"6. Rendering Layer","anchor":"6-Rendering-Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rendering pipeline converts the view tree into terminal output:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"View tree traversal"}],"type":"strong"},{"type":"text","text":": Each view produces a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" backed by terminal cells"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Modifier application","type":"text"}],"type":"strong"},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Layout and compositing"}],"type":"strong"},{"type":"text","text":": Containers position, clip, and layer complete grapheme cells"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"code":"TUIkitImage","type":"codeVoice"},{"type":"text","text":" depends on "},{"code":"TUIkitStyling","type":"codeVoice"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}]},{"level":2,"type":"heading","text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"code":"PulseTimer","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CursorTimer","type":"codeVoice"},{"text":" are monotonic phase calculators rather than","type":"text"},{"text":" ","type":"text"},{"text":"background timers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runner then awaits "},{"type":"codeVoice","code":"RuntimeEventChannel"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Signal and input callbacks only enqueue events. Shutdown stops every event"},{"type":"text","text":" "},{"type":"text","text":"source, finishes the channel, cancels view tasks through "},{"type":"codeVoice","code":"TUIContext.reset()"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and restores raw mode, cursor visibility, and the alternate screen before an"},{"type":"text","text":" "},{"type":"text","text":"I\/O failure is propagated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"level":2,"type":"heading","text":"Focus System","anchor":"Focus-System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"},"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Architecture"},"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"references":{"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"title":"Layout System","abstract":[{"text":"Understand the two-pass layout used by stacks and other layout containers.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/tuikit\/layoutsystem","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","role":"article"},"doc://TUIkit/documentation/TUIkit/View":{"navigatorTitle":[{"text":"View","kind":"identifier"}],"title":"View","abstract":[{"type":"text","text":"The base protocol for all TUIkit views."}],"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"View","kind":"identifier"}],"url":"\/documentation\/tuikit\/view","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","role":"symbol"},"doc://TUIkit/documentation/TUIkit/Toggle":{"type":"topic","abstract":[{"text":"A control that toggles between on and off states.","type":"text"}],"role":"symbol","kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","navigatorTitle":[{"text":"Toggle","kind":"identifier"}],"title":"Toggle","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Toggle","kind":"identifier"}],"url":"\/documentation\/tuikit\/toggle"},"doc://TUIkit/documentation/TUIkit/LazyVStack":{"navigatorTitle":[{"kind":"identifier","text":"LazyVStack"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A view that arranges its children in a line that grows vertically,"},{"type":"text","text":" "},{"type":"text","text":"creating items only as needed."}],"title":"LazyVStack","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazyVStack"}],"url":"\/documentation\/tuikit\/lazyvstack"},"tuikit-logo.png":{"alt":"TUIkit Logo","variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"type":"image","identifier":"tuikit-logo.png"},"doc://TUIkit/documentation/TUIkit/AppLifecycle":{"role":"article","abstract":[{"text":"Understand how a TUIkit application starts, runs, and shuts down.","type":"text"}],"title":"App Lifecycle","url":"\/documentation\/tuikit\/applifecycle","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","kind":"article","type":"topic"},"doc://TUIkit/documentation/TUIkit/PlatformImageLoader":{"type":"topic","title":"PlatformImageLoader","role":"symbol","abstract":[{"text":"Cross-platform image loader backed by pure Swift PNG and JPEG decoders.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PlatformImageLoader"}],"url":"\/documentation\/tuikit\/platformimageloader","navigatorTitle":[{"kind":"identifier","text":"PlatformImageLoader"}]},"architecture-input-dispatch.png":{"alt":"Flowchart of the 5-layer input dispatch: A hasTextInputFocus check gates Layer 0 (Text Input via focusManager.dispatchKeyEvent for TextField\/SecureField). Layer 1 Status Bar Items (statusBar.handleKeyEvent). Layer 2 View Handlers (keyEventDispatcher.dispatch, deepest view first). A second hasTextInputFocus check skips Layer 3 if text input was focused. Layer 3 Focus System (focusManager.dispatchKeyEvent: focused element delegation, Tab\/Shift+Tab, arrow key fallback). Layer 4 Default Bindings (q quit, t theme, a appearance). Unmatched events are dropped.","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/architecture-input-dispatch.png"},{"traits":["1x","dark"],"url":"\/images\/TUIkit\/architecture-input-dispatch~dark.png"}],"identifier":"architecture-input-dispatch.png","type":"image"},"doc://TUIkit/documentation/TUIkit/RadioButtonGroup":{"navigatorTitle":[{"kind":"identifier","text":"RadioButtonGroup"}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RadioButtonGroup"}],"url":"\/documentation\/tuikit\/radiobuttongroup","role":"symbol","kind":"symbol","title":"RadioButtonGroup","abstract":[{"text":"An interactive radio button group for single-selection from multiple options.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/LazyHStack":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","role":"symbol","navigatorTitle":[{"text":"LazyHStack","kind":"identifier"}],"abstract":[{"type":"text","text":"A view that arranges its children in a line that grows horizontally,"},{"type":"text","text":" "},{"type":"text","text":"creating items only as needed."}],"kind":"symbol","title":"LazyHStack","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazyHStack","kind":"identifier"}],"type":"topic","url":"\/documentation\/tuikit\/lazyhst