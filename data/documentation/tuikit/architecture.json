{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain."}],"type":"paragraph"},{"anchor":"Layer-Model","text":"Layer Model","level":2,"type":"heading"},{"anchor":"1-App-Layer","text":"1. App Layer","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App"},{"type":"text","text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" manages the async event loop, terminal setup, signal handling, and event dispatching."}],"type":"paragraph"},{"syntax":null,"code":["@main → App → AppRunner → RuntimeEventChannel"],"type":"codeListing"},{"anchor":"2-View-Layer","text":"2. View Layer","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","isActive":true,"type":"reference"},{"type":"text","text":" protocol. Views are composed declaratively using "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","isActive":true,"type":"reference"},{"type":"text","text":", which supports:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Single and multiple child views (up to 10)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conditionals ("},{"code":"if","type":"codeVoice"},{"type":"text","text":", "},{"code":"if-else","type":"codeVoice"},{"type":"text","text":", "},{"code":"if let","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Loops (","type":"text"},{"code":"for-in","type":"codeVoice"},{"text":" via ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true,"type":"reference"},{"text":")","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Built-in views include:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Content","type":"text"}]},{"text":": ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Text","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spinner","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Divider","type":"reference"},{"text":", ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Interactive controls","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Button","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/TextField","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/SecureField","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Toggle","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Slider","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RadioButtonGroup","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Menu","type":"reference","isActive":true},{"text":", ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProgressView","type":"reference","isActive":true}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Containers"}]},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Card"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Panel"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Alert"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Dialog"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationSplitView"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Data collections","type":"text"}]},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/List"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout","type":"text"}]},{"type":"text","text":": "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}]}]}],"type":"unorderedList"},{"anchor":"3-Layout-Layer","text":"3. Layout Layer","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Measure"}]},{"type":"text","text":": Each child is proposed a size ("},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true,"type":"reference"},{"type":"text","text":") and returns a "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true,"type":"reference"},{"type":"text","text":" with flexibility flags"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},{"type":"text","text":" for details."}],"type":"paragraph"},{"anchor":"4-Modifier-Layer","text":"4. Modifier Layer","level":3,"type":"heading"},{"inlineContent":[{"text":"View modifiers implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"text":" protocol. They operate in two phases: ","type":"text"},{"code":"adjustContext(_:)","type":"codeVoice"},{"text":" modifies the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"text":" before children render (e.g. setting environment values), and ","type":"text"},{"code":"modify(buffer:context:)","type":"codeVoice"},{"text":" transforms the rendered ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"text":" (e.g. adding padding, borders, backgrounds).","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"type":"codeListing"},{"anchor":"5-State--Environment-Layer","text":"5. State & Environment Layer","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}],"type":"strong"},{"text":": Mutable per-view state that triggers re-renders","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","type":"reference","isActive":true}],"type":"strong"},{"type":"text","text":": Two-way connection to a value owned elsewhere"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues"}],"type":"strong"},{"text":": Values propagated down the view tree","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage","type":"reference","isActive":true}],"type":"strong"},{"text":": Persistent key-value storage through the app runtime","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"6-Rendering-Layer","text":"6. Rendering Layer","level":3,"type":"heading"},{"inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View tree traversal"}]},{"type":"text","text":": Each view produces a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" backed by terminal cells"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modifier application"}]},{"type":"text","text":": Modifiers transform or style cell surfaces"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Layout and compositing","type":"text"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Terminal output","type":"text"}],"type":"strong"},{"type":"text","text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary"}]}]}],"type":"orderedList"},{"anchor":"Package-Boundaries","text":"Package Boundaries","level":2,"type":"heading"},{"inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true,"type":"reference"},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}],"type":"paragraph"},{"anchor":"Event-Loop","text":"Event Loop","level":2,"type":"heading"},{"inlineContent":[{"code":"AppRunner","type":"codeVoice"},{"text":" owns the terminal session and signal manager plus one ","type":"text"},{"code":"TUIContext","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"That context owns the application’s render state, storage, caches, localization,","type":"text"},{"text":" ","type":"text"},{"text":"notifications, focus, themes, image loading, and other view-facing services.","type":"text"},{"text":" ","type":"text"},{"code":"AppRunner","type":"codeVoice"},{"text":" creates ","type":"text"},{"code":"InputHandler","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", and a","type":"text"},{"text":" ","type":"text"},{"code":"RuntimeAnimationScheduler","type":"codeVoice"},{"text":"; installs dispatch-backed signal and terminal-input","type":"text"},{"text":" ","type":"text"},{"text":"sources; registers state and focus observers; and performs an initial render.","type":"text"},{"text":" ","type":"text"},{"code":"PulseTimer","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CursorTimer","type":"codeVoice"},{"text":" are monotonic phase calculators rather than","type":"text"},{"text":" ","type":"text"},{"text":"background timers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The runner then awaits "},{"type":"codeVoice","code":"RuntimeEventChannel"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}],"type":"paragraph"},{"inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"code":"TUIContext.reset()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use ","type":"text"},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}],"type":"paragraph"},{"anchor":"Focus-System","text":"Focus System","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"modules":[{"name":"TUIkit"}],"title":"Architecture","roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"Understand the layer model and rendering pipeline of TUIkit."}],"sections":[],"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/GettingStarted","doc:\/\/TUIkit\/documentation\/TUIkit\/AppLifecycle","doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCycle"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"references":{"doc://TUIkit/documentation/TUIkit/LazyHStack":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","abstract":[{"text":"A view that arranges its children in a line that grows horizontally,","type":"text"},{"text":" ","type":"text"},{"text":"creating items only as needed.","type":"text"}],"navigatorTitle":[{"text":"LazyHStack","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"LazyHStack","kind":"identifier"}],"url":"\/documentation\/tuikit\/lazyhstack","title":"LazyHStack"},"doc://TUIkit/documentation/TUIkit/Binding":{"type":"topic","abstract":[{"type":"text","text":"A two-way connection to a mutable value."}],"role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Binding"}],"title":"Binding","fragments":[{"kind":"keyword","t