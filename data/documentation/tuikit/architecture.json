xt":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Layout","type":"text"}]},{"type":"text","text":": "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","isActive":true}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"3. Layout Layer","anchor":"3-Layout-Layer"},{"type":"paragraph","inlineContent":[{"text":"Layout containers use a two-pass system to distribute space among children:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Measure","type":"text"}],"type":"strong"},{"type":"text","text":": Each child is proposed a size ("},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize","isActive":true},{"type":"text","text":") and returns a "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize","isActive":true},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Render","type":"text"}],"type":"strong"},{"text":": The parent distributes remaining space among flexible children and renders each with its final allocation","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"},{"type":"text","text":" for details."}]},{"level":3,"type":"heading","text":"4. Modifier Layer","anchor":"4-Modifier-Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"View modifiers implement the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","isActive":true},{"type":"text","text":" protocol. They operate in two phases: "},{"code":"adjustContext(_:)","type":"codeVoice"},{"type":"text","text":" modifies the "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext","isActive":true},{"type":"text","text":" before children render (e.g. setting environment values), and "},{"code":"modify(buffer:context:)","type":"codeVoice"},{"type":"text","text":" transforms the rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" (e.g. adding padding, borders, backgrounds)."}]},{"type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"],"syntax":"swift"},{"level":3,"type":"heading","text":"5. State & Environment Layer","anchor":"5-State--Environment-Layer"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State"}]},{"text":": Mutable per-view state that triggers re-renders","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"}]},{"text":": Two-way connection to a value owned elsewhere","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true,"type":"reference"}]},{"type":"text","text":": Values propagated down the view tree"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"}]},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}]},{"level":3,"type":"heading","text":"6. Rendering Layer","anchor":"6-Rendering-Layer"},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"View tree traversal","type":"text"}],"type":"strong"},{"type":"text","text":": Each view produces a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" backed by terminal cells"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Modifier application"}],"type":"strong"},{"text":": Modifiers transform or style cell surfaces","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Layout and compositing"}]},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"type":"text","text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary"}]}]}]},{"level":2,"type":"heading","text":"Package Boundaries","anchor":"Package-Boundaries"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The framework is split into five Swift library modules. "},{"type":"codeVoice","code":"TUIkitImage"},{"type":"text","text":" depends on "},{"type":"codeVoice","code":"TUIkitStyling"},{"type":"text","text":" plus vendored, namespaced pure Swift PNG,"},{"type":"text","text":" "},{"type":"text","text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader","isActive":true},{"type":"text","text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,"},{"type":"text","text":" "},{"type":"text","text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File"},{"type":"text","text":" "},{"type":"text","text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing."}]},{"level":2,"type":"heading","text":"Event Loop","anchor":"Event-Loop"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" creates "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RuntimeAnimationScheduler"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runner then awaits "},{"type":"codeVoice","code":"RuntimeEventChannel"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"code":"TUIContext.reset()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"code":"focusManager.dispatchKeyEvent()","type":"codeVoice"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"type":"heading","anchor":"Focus-System","level":2,"text":"Focus System"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"references":{"doc://TUIkit/documentation/TUIkit/EmptyView":{"url":"\/documentation\/tuikit\/emptyview","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EmptyView"}],"navigatorTitle":[{"kind":"identifier","text":"EmptyView"}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EmptyView","title":"EmptyView","abstract":[{"text":"A view that displays no content.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/State":{"abstract":[{"type":"text","text":"A property wrapper that stores mutable state for a view."}],"kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"text":"State","kind":"identifier"}],"url":"\/documentation\/tuikit\/state","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"identifier"}],"title":"State