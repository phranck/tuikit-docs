ence","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/VStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/HStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ZStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyVStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LazyHStack"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Spacer"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"3. Layout Layer","type":"heading","anchor":"3-Layout-Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Layout containers use a two-pass system to distribute space among children:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Measure"}],"type":"strong"},{"type":"text","text":": Each child is proposed a size ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ProposedSize"},{"type":"text","text":") and returns a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewSize"},{"type":"text","text":" with flexibility flags"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Render"}]},{"type":"text","text":": The parent distributes remaining space among flexible children and renders each with its final allocation"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This enables spacers, flexible text fields, and proportional sizing. See "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","isActive":true},{"type":"text","text":" for details."}]},{"text":"4. Modifier Layer","type":"heading","anchor":"4-Modifier-Layer","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Public view modifiers implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier"},{"type":"text","text":" protocol with SwiftUI’s"},{"type":"text","text":" "},{"code":"body(content:)","type":"codeVoice"},{"type":"text","text":" contract: the modifier composes a replacement view around a"},{"type":"text","text":" "},{"type":"text","text":"placeholder for the modified content, and "},{"code":".modifier(_:)","type":"codeVoice"},{"type":"text","text":" wraps both in a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent"},{"type":"text","text":" value. Terminal-specific buffer transformations (padding"},{"type":"text","text":" "},{"type":"text","text":"rows, background fills) run behind an internal buffer-modifier layer that"},{"type":"text","text":" "},{"type":"text","text":"adjusts the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderContext"},{"type":"text","text":" before rendering and transforms the rendered"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" afterwards."}]},{"syntax":"swift","type":"codeListing","code":["Text(\"Hello\")","    .padding(1)","    .border(.rounded)","    .frame(width: 40)"]},{"text":"5. State & Environment Layer","type":"heading","anchor":"5-State--Environment-Layer","level":3},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/State","isActive":true,"type":"reference"}]},{"type":"text","text":": Mutable per-view state that triggers re-renders"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Binding"}],"type":"strong"},{"text":": Two-way connection to a value owned elsewhere","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EnvironmentValues","isActive":true}]},{"type":"text","text":": Values propagated down the view tree"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppStorage"}],"type":"strong"},{"type":"text","text":": Persistent key-value storage through the app runtime"}]}]}],"type":"unorderedList"},{"text":"6. Rendering Layer","type":"heading","anchor":"6-Rendering-Layer","level":3},{"type":"paragraph","inlineContent":[{"text":"The rendering pipeline converts the view tree into terminal output:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"View tree traversal","type":"text"}],"type":"strong"},{"text":": Each view produces a ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference","isActive":true},{"text":" backed by terminal cells","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Modifier application"}]},{"type":"text","text":": Modifiers transform or style cell surfaces"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Layout and compositing"}],"type":"strong"},{"text":": Containers position, clip, and layer complete grapheme cells","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Terminal output"}]},{"type":"text","text":": Final rows are encoded into normalized ANSI SGR strings and diffed at the terminal boundary"}]}]}],"type":"orderedList"},{"text":"Package Boundaries","type":"heading","anchor":"Package-Boundaries","level":2},{"type":"paragraph","inlineContent":[{"text":"The framework is split into five Swift library modules. ","type":"text"},{"code":"TUIkitImage","type":"codeVoice"},{"text":" depends on ","type":"text"},{"code":"TUIkitStyling","type":"codeVoice"},{"text":" plus vendored, namespaced pure Swift PNG,","type":"text"},{"text":" ","type":"text"},{"text":"JPEG, and checksum targets with documented upstream revisions. The package graph has no C or C++ target and no native decoder dependency.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PlatformImageLoader"},{"text":" accepts static PNG and JPEG data and produces non-premultiplied 8-bit RGBA pixels. Before a format decoder runs,","type":"text"},{"text":" ","type":"text"},{"text":"the internal decoding layer validates encoded bytes, dimensions, pixel and frame counts, decompressed samples, and final allocation. File","type":"text"},{"text":" ","type":"text"},{"text":"and URL loading feed data into that deterministic decoder rather than participating in format parsing.","type":"text"}]},{"text":"Event Loop","type":"heading","anchor":"Event-Loop","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" owns the terminal session and signal manager plus one "},{"type":"codeVoice","code":"TUIContext"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"That context owns the application’s render state, storage, caches, localization,"},{"type":"text","text":" "},{"type":"text","text":"notifications, focus, themes, image loading, and other view-facing services."},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRunner"},{"type":"text","text":" creates "},{"type":"codeVoice","code":"InputHandler"},{"type":"text","text":", "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RuntimeAnimationScheduler"},{"type":"text","text":"; installs dispatch-backed signal and terminal-input"},{"type":"text","text":" "},{"type":"text","text":"sources; registers state and focus observers; and performs an initial render."},{"type":"text","text":" "},{"type":"codeVoice","code":"PulseTimer"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CursorTimer"},{"type":"text","text":" are monotonic phase calculators rather than"},{"type":"text","text":" "},{"type":"text","text":"background timers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The runner then awaits "},{"type":"codeVoice","code":"RuntimeEventChannel"},{"type":"text","text":". State invalidations request a"},{"type":"text","text":" "},{"type":"text","text":"render, input readiness drains up to 128 key events, SIGWINCH invalidates the"},{"type":"text","text":" "},{"type":"text","text":"diff cache, animation deadlines advance visible focus effects, and termination"},{"type":"text","text":" "},{"type":"text","text":"events begin cleanup. These paths are serialized on the main actor. With no"},{"type":"text","text":" "},{"type":"text","text":"pending event or visible animation deadline, the runtime remains suspended and"},{"type":"text","text":" "},{"type":"text","text":"does no periodic work."}]},{"type":"paragraph","inlineContent":[{"text":"Signal and input callbacks only enqueue events. Shutdown stops every event","type":"text"},{"text":" ","type":"text"},{"text":"source, finishes the channel, cancels view tasks through ","type":"text"},{"code":"TUIContext.reset()","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and restores raw mode, cursor visibility, and the alternate screen before an","type":"text"},{"text":" ","type":"text"},{"text":"I\/O failure is propagated.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Input dispatch uses a first-consumer-wins model. Layer 0 and Layer 3 are mutually exclusive: when a text input element (TextField\/SecureField) is focused, Layer 0 runs and Layer 3 is skipped; otherwise Layer 0 is skipped and Layer 3 runs. Both use "},{"type":"codeVoice","code":"focusManager.dispatchKeyEvent()"},{"type":"text","text":", which first delegates to the focused element, then handles Tab\/Shift+Tab navigation, then arrow key fallback."}]},{"type":"paragraph","inlineContent":[{"type":"image","identifier":"architecture-input-dispatch.png"}]},{"text":"Focus System","type":"heading","anchor":"Focus-System","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"FocusManager"},{"type":"text","text":" manages keyboard navigation between interactive elements. Views register as focusable, and the user navigates with Tab\/Shift+Tab or arrow keys."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/architecture"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"title":"Architecture","modules":[{"name":"TUIkit"}],"role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture","interfaceLanguage":"swift"},"references":{"doc://TUIkit/documentation/TUIkit/Stepper":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Stepper","type":"topic","navigatorTitle":[{"text":"Stepper","kind":"identifier"}],"title":"Stepper","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Stepper","kind":"identifier"}],"role":"symbol","url":"\/documentation\/tuikit\/stepper","abstract":[{"type":"text","text":"A control 