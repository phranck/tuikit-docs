{"metadata":{"modules":[{"name":"TUIkit"}],"roleHeading":"Article","role":"article","title":"Architecture"},"abstract":[{"text":"Understand the layer model and rendering pipeline of TUIkit.","type":"text"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Architecture"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit is structured in six layers, each building on the one below. This clean separation makes the framework easy to extend and maintain.","type":"text"}]},{"type":"heading","level":2,"anchor":"Layer-Model","text":"Layer Model"},{"type":"heading","level":3,"anchor":"1-App-Layer","text":"1. App Layer"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/App","isActive":true,"type":"reference"},{"text":" protocol is the entry point. It defines one or more scenes that make up your application. The internal ","type":"text"},{"type":"codeVoice","code":"AppRunner"},{"text":" manages the main run loop, terminal setup, signal handling, and event dispatching.","type":"text"}]},{"type":"codeListing","syntax":null,"code":["@main → App → AppRunner → Main Loop"]},{"type":"heading","level":3,"anchor":"2-View-Layer","text":"2. View Layer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every UI component conforms to the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"},{"type":"text","text":" protocol. Views are composed declaratively using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder"},{"type":"text","text":", which supports:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","