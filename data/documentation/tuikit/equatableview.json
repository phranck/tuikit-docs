{"kind":"symbol","variants":[{"paths":["\/documentation\/tuikit\/equatableview"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"A wrapper that enables subtree memoization for views conforming to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"topicSections":[{"generated":true,"title":"Initializers","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/init(content:)"],"anchor":"Initializers"},{"generated":true,"title":"Instance Properties","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/body"],"anchor":"Instance-Properties"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/Renderable-Implementations","doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/View-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"type":"conformsTo","kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","doc:\/\/TUIkit\/s8CopyableP","doc:\/\/TUIkit\/s8SendableP","doc:\/\/TUIkit\/documentation\/TUIkit\/View"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"title":"EquatableView","roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatableView","kind":"identifier"}],"externalID":"s:10TUIkitView09EquatableB0V","navigatorTitle":[{"kind":"identifier","text":"EquatableView"}],"modules":[{"name":"TUIkit"}],"role":"symbol","symbolKind":"struct"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView"},"seeAlsoSections":[{"generated":true,"title":"View Composition","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView"],"anchor":"View-Composition"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"},{"text":", ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","text":"View","kind":"typeIdentifier","preciseIdentifier":"s:10TUIkitView0B0P"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When TUIKit renders an ","type":"text"},{"code":"EquatableView","type":"codeVoice"},{"text":", it compares the current content with","type":"text"},{"text":" ","type":"text"},{"text":"the previously cached value. If the content is unchanged ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" the available","type":"text"},{"text":" ","type":"text"},{"text":"size hasn’t changed, the cached ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"},{"text":" is returned immediately —","type":"text"},{"text":" ","type":"text"},{"text":"skipping the entire subtree rendering.","type":"text"}]},{"anchor":"Usage","level":2,"type":"heading","text":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" to any "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" view:"}]},{"type":"codeListing","syntax":"swift","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"score","type":"codeVoice"},{"text":" are unchanged between frames, the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" and both","type":"text"},{"text":" ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" views are never re-rendered — the cached buffer is returned directly.","type":"text"}]},{"anchor":"When-to-Use","level":2,"type":"heading","text":"When to Use"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Large static subtrees","type":"text"}],"type":"strong"},{"text":" — views with many children that rarely change","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Expensive rendering","type":"text"}],"type":"strong"},{"type":"text","text":" — views whose "},{"type":"codeVoice","code":"body"},{"type":"text","text":" or "},{"type":"codeVoice","code":"renderToBuffer"},{"type":"text","text":" is costly"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation siblings"}]},{"text":" — static views next to animated ones","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"When-NOT-to-Use","level":2,"type":"heading","text":"When NOT to Use"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Views that read "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Views that change every frame (the cache overhead adds no value)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Views that depend on environment values that change frequently","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Effect-Bypass","level":2,"type":"heading","text":"Effect Bypass"},{"type":"paragraph","inlineContent":[{"text":"Content that registers per-pass effects while rendering — key handlers,","type":"text"},{"text":" ","type":"text"},{"text":"focus registrations (Button, Toggle, …), status-bar declarations,","type":"text"},{"text":" ","type":"text"},{"text":"preference writes, or lifetime-effect records (","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":", ","type":"text"},{"code":".task","type":"codeVoice"},{"text":", …) —","type":"text"},{"text":" ","type":"text"},{"text":"must reach the frame’s collectors on EVERY frame; serving it from a","type":"text"},{"text":" ","type":"text"},{"text":"cache would silently drop those registrations at the frame commit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" frames the wrapper therefore classifies its content","type":"text"},{"text":" ","type":"text"},{"text":"on every cache miss: it snapshots the pass’s effect-registration probe","type":"text"},{"text":" ","type":"text"},{"text":"around the rendering, and any delta flags the identity as effect-bearing","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache","isActive":true,"type":"reference"},{"text":". Flagged identities never produce hits, so the","type":"text"},{"text":" ","type":"text"},{"text":"subtree renders each frame and behaves exactly as if it were unwrapped","type":"text"},{"text":" ","type":"text"},{"text":"(including pulse-animated focus indicators). Only provably effect-free","type":"text"},{"text":" ","type":"text"},{"text":"output is ever served from the cache, making ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" safe to","type":"text"},{"text":" ","type":"text"},{"text":"apply anywhere — on effect-bearing subtrees it simply has no effect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Measurement passes (","type":"text"},{"code":"RenderPhase.measure","type":"codeVoice"},{"text":") stay out of the cache","type":"text"},{"text":" ","type":"text"},{"text":"entirely: effect sites are inert there, so a buffer stored during","type":"text"},{"text":" ","type":"text"},{"text":"sizing would let the same frame’s output pass hit a subtree whose","type":"text"},{"text":" ","type":"text"},{"text":"effects were never recorded, and any classification would measure an","type":"text"},{"text":" ","type":"text"},{"text":"inert traversal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the live path (no "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", e.g. "},{"type":"codeVoice","code":"ViewRenderer"},{"type":"text","text":" or test"},{"type":"text","text":" "},{"type":"text","text":"harnesses) caching keeps its historical semantics without"},{"type":"text","text":" "},{"type":"text","text":"classification."}]},{"anchor":"Cache-Invalidation","level":2,"type":"heading","text":"Cache Invalidation"},{"type":"paragraph","inlineContent":[{"text":"The render cache is selectively cleared when ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values change:","type":"text"},{"text":" ","type":"text"},{"text":"only cache entries in the ancestor\/descendant path of the changed state","type":"text"},{"text":" ","type":"text"},{"text":"are invalidated. Sibling subtrees retain their cached buffers.","type":"text"}]},{"type":"aside","style":"note","name":"See Also","content":[{"inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()"}],"type":"paragraph"}]}]}],"references":{"doc://TUIkit/documentation/TUIkit/RenderCache":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderCache","kind":"identifier"}],"url":"\/documentation\/tuikit\/rendercache","title":"RenderCache","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache","kind":"symbol","navigatorTitle":[{"text":"RenderCache","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Caches rendered "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" results for views that opt into subtree memoization."}]},"doc://TUIkit/documentation/TUIkit/Renderable":{"abstract":[{"type":"text","text":"A protocol for views that produce terminal output directly."}],"type":"topic","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Content","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}]},"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Renderable","kind":"identifier"}],"navigatorTitle":[{"text":"Renderable","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","title":"Renderable","url":"\/documentation\/tuikit\/renderable"},"doc://TUIkit/s8CopyableP":{"type":"unresolvable","identifier":"doc:\/\/TUIkit\/s8CopyableP","title":"Swift.Copyable"},"doc://TUIkit/documentation/TUIkit/EquatableView/init(content:)":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView