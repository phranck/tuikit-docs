"type":"conformsTo"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"},{"text":", ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","preciseIdentifier":"s:10TUIkitView0B0P"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When TUIKit renders an ","type":"text"},{"code":"EquatableView","type":"codeVoice"},{"text":", it compares the current content with","type":"text"},{"text":" ","type":"text"},{"text":"the previously cached value. If the content is unchanged ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" the available","type":"text"},{"text":" ","type":"text"},{"text":"size hasn’t changed, the cached ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" is returned immediately —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}]},{"level":2,"text":"Usage","anchor":"Usage","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" to any "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" view:"}]},{"syntax":"swift","type":"codeListing","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"score","type":"codeVoice"},{"text":" are unchanged between frames, the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" and both","type":"text"},{"text":" ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" views are never re-rendered — the cached buffer is returned directly.","type":"text"}]},{"level":2,"text":"When to Use","anchor":"When-to-Use","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Large static subtrees","type":"text"}]},{"type":"text","text":" — views with many children that rarely change"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Expensive rendering"}]},{"type":"text","text":" — views whose "},{"type":"codeVoice","code":"body"},{"type":"text","text":" or "},{"type":"codeVoice","code":"renderToBuffer"},{"type":"text","text":" is costly"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Animation siblings"}],"type":"strong"},{"type":"text","text":" — static views next to animated ones"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"When NOT to Use","anchor":"When-NOT-to-Use","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that read "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}]}]},{"content":[{"inlineContent":[{"text":"Views that change every frame (the cache overhead adds no value)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Views that depend on environment values that change frequently","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Effect Bypass","anchor":"Effect-Bypass","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Content that registers per-pass effects while rendering — key handlers,","type":"text"},{"text":" ","type":"text"},{"text":"focus registrations (Button, Toggle, …), status-bar declarations,","type":"text"},{"text":" ","type":"text"},{"text":"preference writes, or lifetime-effect records (","type":"text"},{"type":"codeVoice","code":"onAppear"},{"text":", ","type":"text"},{"type":"codeVoice","code":".task"},{"text":", …) —","type":"text"},{"text":" ","type":"text"},{"text":"must reach the frame’s collectors on EVERY frame; serving it from a","type":"text"},{"text":" ","type":"text"},{"text":"cache would silently drop those registrations at the frame commit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"type":"codeVoice","code":"RenderLoop"},{"text":" frames the wrapper therefore classifies its content","type":"text"},{"text":" ","type":"text"},{"text":"on every cache miss: it snapshots the pass’s effect-registration probe","type":"text"},{"text":" ","type":"text"},{"text":"around the rendering, and any delta flags the identity as effect-bearing","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache","isActive":true,"type":"reference"},{"text":". Flagged identities never produce hits, so the","type":"text"},{"text":" ","type":"text"},{"text":"subtree renders each frame and behaves exactly as if it were unwrapped","type":"text"},{"text":" ","type":"text"},{"text":"(including pulse-animated focus indicators). Only provably effect-free","type":"text"},{"text":" ","type":"text"},{"text":"output is ever served from the cache, making ","type":"text"},{"type":"codeVoice","code":".equatable()"},{"text":" safe to","type":"text"},{"text":" ","type":"text"},{"text":"apply anywhere — on effect-bearing subtrees it simply has no effect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Measurement passes ("},{"code":"RenderPhase.measure","type":"codeVoice"},{"type":"text","text":") stay out of the cache"},{"type":"text","text":" "},{"type":"text","text":"entirely: effect sites are inert there, so a buffer stored during"},{"type":"text","text":" "},{"type":"text","text":"sizing would let the same frame’s output pass hit a subtree whose"},{"type":"text","text":" "},{"type":"text","text":"effects were never recorded, and any classification would measure an"},{"type":"text","text":" "},{"type":"text","text":"inert traversal."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the live path (no "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", e.g. "},{"type":"codeVoice","code":"ViewRenderer"},{"type":"text","text":" or test"},{"type":"text","text":" "},{"type":"text","text":"harnesses) caching keeps its historical semantics without"},{"type":"text","text":" "},{"type":"text","text":"classification."}]},{"level":2,"text":"Cache Invalidation","anchor":"Cache-Invalidation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The render cache is selectively cleared when "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values change:"},{"type":"text","text":" "},{"type":"text","text":"only cache entries in the ancestor\/descendant path of the changed state"},{"type":"text","text":" "},{"type":"text","text":"are invalidated. Sibling subtrees retain their cached buffers."}]},{"style":"note","ty