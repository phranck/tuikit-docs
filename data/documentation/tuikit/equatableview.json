oice"},{"type":"text","text":", it compares the current content with"},{"type":"text","text":" "},{"type":"text","text":"the previously cached value. If the content is unchanged "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the available"},{"type":"text","text":" "},{"type":"text","text":"size hasn’t changed, the cached "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" is returned immediately —"},{"text":" ","type":"text"},{"text":"skipping the entire subtree rendering.","type":"text"}],"type":"paragraph"},{"text":"Usage","anchor":"Usage","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" to any "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" view:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When "},{"code":"name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"score","type":"codeVoice"},{"type":"text","text":" are unchanged between frames, the "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" and both"},{"type":"text","text":" "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" views are never re-rendered — the cached buffer is returned directly."}],"type":"paragraph"},{"text":"When to Use","anchor":"When-to-Use","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Large static subtrees","type":"text"}],"type":"strong"},{"text":" — views with many children that rarely change","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Expensive rendering"}]},{"type":"text","text":" — views whose "},{"type":"codeVoice","code":"body"},{"type":"text","text":" or "},{"type":"codeVoice","code":"renderToBuffer"},{"type":"text","text":" is costly"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Animation siblings","type":"text"}]},{"type":"text","text":" — static views next to animated ones"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"When NOT to Use","anchor":"When-NOT-to-Use","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Views that read "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Views that change every frame (the cache overhead adds no value)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that depend on environment values that change frequently"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Views containing focused interactive elements"}],"type":"strong"},{"text":" (Button, Toggle, Slider,","type":"text"},{"text":" ","type":"text"},{"text":"etc.) whose focus indicator animates via pulse phase. The cached buffer","type":"text"},{"text":" ","type":"text"},{"text":"would show a frozen pulse animation.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Cache Invalidation","anchor":"Cache-Invalidation","type":"heading","level":2},{"inlineContent":[{"text":"The render cache is selectively cleared when ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values change:","type":"text"},{"text":" ","type":"text"},{