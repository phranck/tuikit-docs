{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"relationshipsSections":[{"type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","doc:\/\/TUIkit\/s8CopyableP","doc:\/\/TUIkit\/s8SendableP","doc:\/\/TUIkit\/documentation\/TUIkit\/View"],"kind":"relationships"}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/init(content:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/body"],"generated":true,"anchor":"Instance-Properties"},{"title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/Renderable-Implementations","doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/View-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatableView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Equatable","preciseIdentifier":"s:SQ"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"View","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","preciseIdentifier":"s:10TUIkitView0B0P"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"When TUIKit renders an ","type":"text"},{"code":"EquatableView","type":"codeVoice"},{"text":", it compares the current content with","type":"text"},{"text":" ","type":"text"},{"text":"the previously cached value. If the content is unchanged ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" the available","type":"text"},{"text":" ","type":"text"},{"text":"size hasn’t changed, the cached ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"text":" is returned immediately —","type":"text"},{"text":" ","type":"text"},{"text":"skipping the entire subtree rendering.","type":"text"}]},{"type":"heading","text":"Usage","anchor":"Usage","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"code":".equatable()","type":"codeVoice"},{"type":"text","text":" to any "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" view:"}]},{"syntax":"swift","type":"codeListing","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"score","type":"codeVoice"},{"type":"text","text":" are unchanged between frames, the "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" and both"},{"type":"text","text":" "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" views are never re-rendered — the cached buffer is returned directly."}]},{"type":"heading","text":"When to Use","anchor":"When-to-Use","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Large static subtrees"}],"type":"strong"},{"type":"text","text":" — views with many children that rarely change"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Expensive rendering","type":"text"}],"type":"strong"},{"type":"text","text":" — views whose "},{"code":"body","type":"codeVoice"},{"type":"text","text":" or "},{"code":"renderToBuffer","type":"codeVoice"},{"type":"text","text":" is costly"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation siblings"}]},{"text":" — static views next to animated ones","type":"text"}]}]}]},{"type":"heading","text":"When NOT to Use","anchor":"When-NOT-to-Use","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Views that read ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" directly (state lives in a reference-type box,","type":"text"},{"text":" ","type":"text"},{"text":"so the view struct compares as equal even when state changed)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Views that change every frame (the cache overhead adds no value)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Views that depend on environment values that change frequently","type":"text"}]}]}]},{"type":"heading","text":"Effect Bypass","anchor":"Effect-Bypass","level":2},{"type":"paragraph","inlineContent":[{"text":"Content that registers per-pass effects while rendering — key handlers,","type":"text"},{"text":" ","type":"text"},{"text":"focus registrations (Button, Toggle, …), status-bar declarations,","type":"text"},{"text":" ","type":"text"},{"text":"preference writes, or lifetime-effect records (","type":"text"},{"code":"onAppear","type":"codeVoice"},{"text":", ","type":"text"},{"code":".task","type":"codeVoice"},{"text":", …) —","type":"text"},{"text":" ","type":"text"},{"text":"must reach the frame’s collectors on EVERY frame; serving it from a","type":"text"},{"text":" ","type":"text"},{"text":"cache would silently drop those registrations at the frame commit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" frames the wrapper therefore classifies its content","type":"text"},{"text":" ","type":"text"},{"text":"on every cache miss: it snapshots the pass’s effect-registration probe","type":"text"},{"text":" ","type":"text"},{"text":"around the rendering, and any delta flags the identity as effect-bearing","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache","type":"reference"},{"text":". Flagged identities never produce hits, so the","type":"text"},{"text":" ","type":"text"},{"text":"subtree renders each frame and behaves exactly as if it were unwrapped","type":"text"},{"text":" ","type":"text"},{"text":"(including pulse-animated focus indicators). Only provably effect-free","type":"text"},{"text":" ","type":"text"},{"text":"output is ever served from the cache, making ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" safe to","type":"text"},{"text":" ","type":"text"},{"text":"apply anywhere — on effect-bearing subtrees it simply has no effect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Measurement passes (","type":"text"},{"code":"RenderPhase.measure","type":"codeVoice"},{"text":") stay out of the cache","type":"text"},{"text":" ","type":"text"},{"text":"entirely: effect sites are inert there, so a buffer stored during","type":"text"},{"text":" ","type":"text"},{"text":"sizing would let the same frame’s output pass hit a subtree whose","type":"text"},{"text":" ","type":"text"},{"text":"effects were never recorded, and any classification would measure an","type":"text"},{"text":" ","type":"text"},{"text":"inert traversal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the live path (no "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", e.g. "},{"type":"codeVoice","code":"ViewRenderer"},{"type":"text","text":" or test"},{"type":"text","text":" "},{"type":"text","text":"harnesses) caching keeps its historical semantics without"},{"type":"text","text":" "},{"type":"text","text":"classification."}]},{"type":"heading","text":"Cache Invalidation","anchor":"Cache-Invalidation","level":2},{"type":"paragraph","inlineContent":[{"text":"The render cache is selectively cleared when ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values change:","type":"text"},{"text":" ","type":"text"},{"text":"only cache entries in the ancestor\/descendant path of the changed state","type":"text"},{"text":" ","type":"text"},{"text":"are invalidated. Sibling subtrees retain their cached buffers.","type":"text"}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()","isActive":true}]}],"name":"See Also"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/equatableview"]}],"seeAlsoSections":[{"title":"View Composition","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedContent"],"generated":true,"anchor":"View-Composition"}],"abstract":[{"type":"text","text":"A wrapper that enables subtree memoization for views conforming to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"TUIkit"}],"navigatorTitle":[{"kind":"identifier","text":"EquatableView"}],"title":"EquatableView","symbolKind":"struct","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifi