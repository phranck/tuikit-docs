{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"anchor":"View-Composition","title":"View Composition","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView"],"generated":true}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/equatableview"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView","interfaceLanguage":"swift"},"metadata":{"externalID":"s:10TUIkitView09EquatableB0V","roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"TUIkit"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"}],"title":"EquatableView","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EquatableView"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatableView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:SQ","text":"Equatable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:10TUIkitView0B0P","text":"View","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When TUIKit renders an "},{"type":"codeVoice","code":"EquatableView"},{"type":"text","text":", it compares the current content with"},{"type":"text","text":" "},{"type":"text","text":"the previously cached value. If the content is unchanged "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the available"},{"type":"text","text":" "},{"type":"text","text":"size hasn’t changed, the cached "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" is returned immediately —"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}]},{"type":"heading","text":"Usage","level":2,"anchor":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" to any "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" view:"}]},{"code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"score","type":"codeVoice"},{"type":"text","text":" are unchanged between frames, the "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" and both"},{"type":"text","text":" "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" views are never re-rendered — the cached buffer is returned directly."}]},{"type":"heading","text":"When to Use","level":2,"anchor":"When-to-Use"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Large static subtrees"}]},{"text":" — views with many children that rarely change","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Expensive rendering","type":"text"}]},{"type":"text","text":" — views whose "},{"type":"codeVoice","code":"body"},{"type":"text","text":" or "},{"type":"codeVoice","code":"renderToBuffer"},{"type":"text","text":" is costly"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Animation siblings","type":"text"}],"type":"strong"},{"text":" — static views next to animated ones","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"When NOT to Use","level":2,"anchor":"When-NOT-to-Use"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Views that read ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" directly (state lives in a reference-type box,","type":"text"},{"text":" ","type":"text"},{"text":"so the view struct compares as equal even when state changed)","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Views that change every frame (the cache overhead adds no value)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Views that depend on environment values that change frequently"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Views containing focused interactive elements","type":"text"}],"type":"strong"},{"text":" (Button, Toggle, Slider,","type":"text"},{"text":" ","type":"text"},{"text":"etc.) whose focus indicator animates via pulse phase. The cached buffer","type":"text"},{"text":" ","type":"text"},{"text":"would show a frozen pulse animation.","type":"text"}]}]}]},{"type":"heading","text":"Cache Invalidation","level":2,"anchor":"Cache-Invalidation"},{"type":"paragraph","inlineContent":[{"text":"The render cache is selectively cleared when ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" values change:","type":"text"},{"text":" ","type":"text"},{"text":"only cache entries in the ancestor\/descendant path of the changed state","type":"text"},{"text":" ","type":"text"},{"text":"are invalidated. Sibling subtrees retain their cached buffers.","type":"text"},{"text":" ","type":"text"},{"text":"Pulse animation changes do ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" invalidate the cache, which is why","type":"text"},{"text":" ","type":"text"},{"text":"subtrees containing focused interactive views should not be wrapped.","type":"text"}]},{"type":"aside","style":"note","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()"}]}]}]}],"abstract":[{"text":"A wrapper that enables subtree memoization for views conforming to ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/init(content:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/body"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/Renderable-Implementations","doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/View-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","doc:\/\/TUIkit\/s8CopyableP","doc:\/\/TUIkit\/s8SendableP","doc:\/\/TUIkit\/documentation\/TUIkit\/View"],"type":"conformsTo"}],"kind":"symbol","references":{"doc://TUIkit/documentation/TUIkit/EquatableView/Renderable-Imple