{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"navigatorTitle":[{"kind":"identifier","text":"EquatableView"}],"roleHeading":"Structure","symbolKind":"struct","externalID":"s:10TUIkitView09EquatableB0V","role":"symbol","title":"EquatableView","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatableView","kind":"identifier"}]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/init(content:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/Renderable-Implementations","doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"abstract":[{"type":"text","text":"A wrapper that enables subtree memoization for views conforming to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Equatable","preciseIdentifier":"s:SQ","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","preciseIdentifier":"s:10TUIkitView0B0P","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"When TUIKit renders an "},{"type":"codeVoice","code":"EquatableView"},{"type":"text","text":", it compares the current content with"},{"type":"text","text":" "},{"type":"text","text":"the previously cached value. If the content is unchanged "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" the available"},{"type":"text","text":" "},{"type":"text","text":"size hasn’t changed, the cached "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" is returned immediately —"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Usage","anchor":"Usage"},{"inlineContent":[{"text":"Apply ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" to any ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" view:","type":"text"}],"type":"paragraph"},{"code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"score","type":"codeVoice"},{"text":" are unchanged between frames, the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" and both","type":"text"},{"text":" ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" views are never re-rendered — the cached buffer is returned directly.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"When to Use","anchor":"When-to-Use"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Large static subtrees"}]},{"type":"text","text":" — views with many children that rarely change"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Expensive rendering","type":"text"}],"type":"strong"},{"text":" — views whose ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"renderToBuffer","type":"codeVoice"},{"text":" is costly","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Animation siblings","type":"text"}]},{"type":"text","text":" — static views next to animated ones"}]}]}]},{"level":2,"type":"heading","text":"When NOT to Use","anchor":"When-NOT-to-Use"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that read "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that change every frame (the cache overhead adds no value)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Views that depend on environment values that change frequently"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Effect Bypass","anchor":"Effect-Bypass"},{"inlineContent":[{"type":"text","text":"Content that registers per-pass effects while rendering — key handlers,"},{"type":"text","text":" "},{"type":"text","text":"focus registrations (Button, Toggle, …), status-bar declarations,"},{"type":"text","text":" "},{"type":"text","text":"preference writes, or lifetime-effect records ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":", "},{"type":"codeVoice","code":".task"},{"type":"text","text":", …) —"},{"type":"text","text":" "},{"type":"text","text":"must reach the frame’s collectors on EVERY frame; serving it from a"},{"type":"text","text":" "},{"type":"text","text":"cache would silently drop those registrations at the frame commit."}],"type":"paragraph"},{"inlineContent":[{"text":"Inside ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" frames the wrapper therefore classifies its content","type":"text"},{"text":" ","type":"text"},{"text":"on every cache miss: it snapshots the pass’s effect-registration probe","type":"text"},{"text":" ","type":"text"},{"text":"around the rendering, and any delta flags the identity as effect-bearing","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache","type":"reference"},{"text":". Flagged identities never produce hits, so the","type":"text"},{"text":" ","type":"text"},{"text":"subtree renders each frame and behaves exactly as if it were unwrapped","type":"text"},{"text":" ","type":"text"},{"text":"(including pulse-animated focus indicators). Only provably effect-free","type":"text"},{"text":" ","type":"text"},{"text":"output is ever served from the cache, making ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" safe to","type":"text"},{"text":" ","type":"text"},{"text":"apply anywhere — on effect-bearing subtrees it simply has no effect.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Measurement passes ("},{"type":"codeVoice","code":"RenderPhase.measure"},{"type":"text","text":") stay out of the cache"},{"type":"text","text":" "},{"type":"text","text":"entirely: effect sites are inert there, so a buffer stored during"},{"type":"text","text":" "},{"type":"text","text":"sizing would let the same frame’s output pass hit a subtree whose"},{"type":"text","text":" "},{"text":"effects were never recorded, and any classification would measure an","type":"text"},{"text":" ","type":"text"},{"text":"inert traversal.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"On the live path (no ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", e.g. ","type":"text"},{"code":"ViewRenderer","type":"codeVoice"},{"text":" or test","type":"text"},{"text":" ","type":"text"},{"text":"harnesses) caching keeps its historical semantics without","type":"text"},{"text":" ","type":"text"},{"text":"classification.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Cache Invalidation","anchor":"Cache-Invalidation"},{"inlineContent":[{"text":"The render cache is selectively cleared when ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" values change:","type":"text"},{"text":" ","type":"text"},{"text":"only cache entries in the ancestor\/descendant path of the changed state","type":"text"},{"text":" ","type":"text"},{"text":"are invalidated. Sibling subtrees retain their cached buffers.","type":"text"}],"type":"paragraph"},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()","type":"reference"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","doc:\/\/TUIkit\/s8CopyableP","doc:\/\/TUIkit\/s8SendableP","doc:\/\/TUIkit\/documentation\/TUIkit\/View"],"title":"Conforms To","kind":"relationships"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/equatableview"]}],"seeAlsoSections":[{"generated":true,"identifiers":["d