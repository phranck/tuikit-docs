{"metadata":{"modules":[{"name":"TUIkit"}],"role":"symbol","symbolKind":"struct","title":"EquatableView","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"}],"navigatorTitle":[{"kind":"identifier","text":"EquatableView"}],"roleHeading":"Structure","externalID":"s:10TUIkitView09EquatableB0V"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"A wrapper that enables subtree memoization for views conforming to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","doc:\/\/TUIkit\/s8CopyableP","doc:\/\/TUIkit\/s8SendableP","doc:\/\/TUIkit\/documentation\/TUIkit\/View"],"kind":"relationships","title":"Conforms To"}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView"],"anchor":"View-Composition","title":"View Composition"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EquatableView","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Content","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"Equatable","kind":"typeIdentifier","preciseIdentifier":"s:SQ"},{"text":", ","kind":"text"},{"text":"Content","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"text":"View","kind":"typeIdentifier","preciseIdentifier":"s:10TUIkitView0B0P","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When TUIKit renders an "},{"type":"codeVoice","code":"EquatableView"},{"type":"text","text":", it compares the current content with"},{"type":"text","text":" "},{"type":"text","text":"the previously cached value. If the content is unchanged "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the available"},{"type":"text","text":" "},{"type":"text","text":"size hasn’t changed, the cached "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer"},{"type":"text","text":" is returned immediately —"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}]},{"text":"Usage","type":"heading","level":2,"anchor":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" to any "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" view:"}]},{"type":"codeListing","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"name","type":"codeVoice"},{"type":"text","text":" and "},{"code":"score","type":"codeVoice"},{"type":"text","text":" are unchanged between frames, the "},{"code":"VStack","type":"codeVoice"},{"type":"text","text":" and both"},{"type":"text","text":" "},{"code":"Text","type":"codeVoice"},{"type":"text","text":" views are never re-rendered — the cached buffer is returned directly."}]},{"text":"When to Use","type":"heading","level":2,"anchor":"When-to-Use"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Large static subtrees"}],"type":"strong"},{"text":" — views with many children that rarely change","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Expensive rendering","type":"text"}],"type":"strong"},{"text":" — views whose ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"renderToBuffer","type":"codeVoice"},{"text":" is costly","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Animation siblings","type":"text"}],"type":"strong"},{"type":"text","text":" — static views next to animated ones"}]}]}],"type":"unorderedList"},{"text":"When NOT to Use","type":"heading","level":2,"anchor":"When-NOT-to-Use"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Views that read "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Views that change every frame (the cache overhead adds no value)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Views that depend on environment values that change frequently","type":"text"}]}]}],"type":"unorderedList"},{"text":"Effect Bypass","type":"heading","level":2,"anchor":"Effect-Bypass"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Content that registers per-pass effects while rendering — key handlers,"},{"type":"text","text":" "},{"type":"text","text":"focus registrations (Button, Toggle, …), status-bar declarations,"},{"type":"text","text":" "},{"type":"text","text":"preference writes, or lifetime-effect records ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":", "},{"type":"codeVoice","code":".task"},{"type":"text","text":", …) —"},{"type":"text","text":" "},{"type":"text","text":"must reach the frame’s collectors on EVERY frame; serving it from a"},{"type":"text","text":" "},{"type":"text","text":"cache would silently drop those registrations at the frame commit."}]},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":" frames the wrapper therefore classifies its content","type":"text"},{"text":" ","type":"text"},{"text":"on every cache miss: it snapshots the pass’s effect-registration probe","type":"text"},{"text":" ","type":"text"},{"text":"around the rendering, and any delta flags the identity as effect-bearing","type":"text"},{"text":" ","type":"text"},{"text":"in the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache"},{"text":". Flagged identities never produce hits, so the","type":"text"},{"text":" ","type":"text"},{"text":"subtree renders each frame and behaves exactly as if it were unwrapped","type":"text"},{"text":" ","type":"text"},{"text":"(including pulse-animated focus indicators). Only provably effect-free","type":"text"},{"text":" ","type":"text"},{"text":"output is ever served from the cache, making ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" safe to","type":"text"},{"text":" ","type":"text"},{"text":"apply anywhere — on effect-bearing subtrees it simply has no effect.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Measurement passes ("},{"code":"RenderPhase.measure","type":"codeVoice"},{"type":"text","text":") stay out of the cache"},{"type":"text","text":" "},{"type":"text","text":"entirely: effect sites are inert there, so a buffer stored during"},{"type":"text","text":" "},{"type":"text","text":"sizing would let the same frame’s output pass hit a subtree whose"},{"type":"text","text":" "},{"type":"text","text":"effects were never recorded, and any classification would measure an"},{"type":"text","text":" "},{"type":"text","text":"inert traversal."}]},{"type":"paragraph","inlineContent":[{"text":"On the live path (no ","type":"text"},{"code":"RenderLoop","type":"codeVoice"},{"text":", e.g. ","type":"text"},{"code":"ViewRenderer","type":"codeVoice"},{"text":" or test","type":"text"},{"text":" ","type":"text"},{"text":"harnesses) caching keeps its historical semantics without","type":"text"},{"text":" ","type":"text"},{"text":"classification.","type":"text"}]},{"text":"Cache Invalidation","type":"heading","level":2,"anchor":"Cache-Invalidation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The render cache is selectively cleared when "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values change:"},{"type":"text","text":" "},{"type":"text","text":"only cache entries in the ancestor\/descendant path of the changed state"},{"type":"text","text":" "},{"type":"text","text":"are invalidated. Sibling subtrees retain their cached buffers."}]},{"name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()","type":"reference"}],"type":"paragraph"}],"type":"aside","style":"note"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"topicSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/init(content:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/Renderable-Implementations","doc:\/\/TUIkit\/documentation\/TUIkit\