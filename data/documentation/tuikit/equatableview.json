,"text":" is returned immediately —"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}]},{"type":"heading","level":2,"text":"Usage","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apply "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" to any "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" view:"}]},{"syntax":"swift","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"score","type":"codeVoice"},{"text":" are unchanged between frames, the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" and both","type":"text"},{"text":" ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" views are never re-rendered — the cached buffer is returned directly.","type":"text"}]},{"type":"heading","level":2,"text":"When to Use","anchor":"When-to-Use"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Large static subtrees","type":"text"}],"type":"strong"},{"text":" — views with many children that rarely change","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Expensive rendering","type":"text"}],"type":"strong"},{"text":" — views whose ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"renderToBuffer","type":"codeVoice"},{"text":" is costly","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Animation siblings"}]},{"text":" — static views