eIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SQ","kind":"typeIdentifier","text":"Equatable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:10TUIkitView0B0P","kind":"typeIdentifier","text":"View","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When TUIKit renders an "},{"type":"codeVoice","code":"EquatableView"},{"type":"text","text":", it compares the current content with"},{"type":"text","text":" "},{"type":"text","text":"the previously cached value. If the content is unchanged "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" the available"},{"type":"text","text":" "},{"type":"text","text":"size hasn’t changed, the cached "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true,"type":"reference"},{"type":"text","text":" is returned immediately —"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}]},{"type":"heading","level":2,"text":"Usage","anchor":"Usage"},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" to any ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" view:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"name"},{"type":"text","text":" and "},{"type":"codeVoice","code":"score"},{"type":"text","text":" are unchanged between frames, the "},{"type":"codeVoice","code":"VStack"},{"type":"text","text":" and both"},{"type":"text","text":" "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" views are never re-rendered — the cached buffer is returned directly."}]},{"type":"heading","level":2,"text":"When to Use","anchor":"When-to-Use"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Large static subtrees","type":"text"}]},{"text":" — views with many children that rarely change","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Expensive rendering","type":"text"}]},{"text":" — views whose ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"renderToBuffer","type":"codeVoice"},{"text":" is costly","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Animation siblings","type":"text"}]},{"text":" — static views next to animated ones","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"When NOT to Use","anchor":"When-NOT-to-Use"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Views that read "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that change every frame (the cache overhead adds no value)"}]}]},{"content":[{"inlineContent":[{"text":"Views that depend on environment values that change frequently","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Views containing focused interactive elements"}],"type":"strong"},{"text":" (Button, Toggle, Slider,","type":"text"},{"text":" ","type":"text"},{"text":"etc.) whose focus indicator animates via pulse phase. The cached buffer","type":"text"},{"text":" ","type":"text"},{"text":"would show a frozen pulse animation.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Cache Invalidation","anchor":"Cache-Invalidation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The render cache is selectively cleared when "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values change:"},{"type":"text","text":" "},{"type":"text","text":"only cache entries in the ancestor\/descendant path of the changed state"},{"type":"text","text":" "},{"type":"text","text":"are invalidated. Sibling subtrees retain their cached buffers."},{"type":"text","text":" "},{"type":"text","text":"Pulse animation changes do "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" invalidate the cache, which is why"},{"type":"text","text":" "},{"type":"text","text":"subtrees containing focused interactive views should not be wrapped."}]},{"type":"aside","style":"note","name":"See Also","content":[{"inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()","type":"reference","isActive":true}],"type":"paragraph"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/equatableview"]}],"references":{"doc://TUIkit/documentation/TUIkit/ModifiedView":{"type":"topic",