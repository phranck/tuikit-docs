()"],"syntax":"swift"},{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"name"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"score"},{"text":" are unchanged between frames, the ","type":"text"},{"type":"codeVoice","code":"VStack"},{"text":" and both","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Text"},{"text":" views are never re-rendered — the cached buffer is returned directly.","type":"text"}],"type":"paragraph"},{"text":"When to Use","type":"heading","anchor":"When-to-Use","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Large static subtrees","type":"text"}]},{"type":"text","text":" — views with many children that rarely change"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Expensive rendering","type":"text"}]},{"text":" — views whose ","type":"text"},{"code":"body","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"renderToBuffer","type":"codeVoice"},{"text":" is costly","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Animation siblings","type":"text"}],"type":"strong"},{"text":" — static views next to animated ones","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"When NOT to Use","type":"heading","anchor":"When-NOT-to-Use","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that read "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" directly (state lives in a reference-type box,"},{"type":"text","text":" "},{"type":"text","text":"so the view struct compares as equal even when state changed)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Views that change every frame (the cache overhead adds no value)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Views that depend on environment values that change frequently"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Views containing focused interactive elements"}],"type":"strong"},{"text":" (Button, Toggle, Slider,","type":"text"},{"text":" ","type":"text"},{"text":"etc.) whose focus indicator animates via pulse phase. The cached buffer","type":"text"},{"text":" ","type":"text"},{"text":"would show a frozen pulse animation.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Cache Invalidation","type":"heading","anchor":"Cache-Invalidation","level":2},{"inlineContent":[{"type":"text","text":"The render cache is selectively cleared when "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values change:"},{"type":"text","text":" "},{"type":"text","text":"only cache entries in the ancestor\/descendant path of the changed state"},{"type":"text","text":" "},{"type":"text","text":"are invalidated. Sibling subtrees retain their cached buffers."},{"type":"text","text":" "},{"type":"text","text":"Pulse animation changes do "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" invalidate the cache, which is why"},{"type":"text","text":" "},{"type":"text","text":"subtrees containing focused interactive views should not be wrapped."}],"type":"paragraph"},{"type":"aside","name":"See Also","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()","isActive":true,"type":"reference"}]}],"style":"note"}]}],"seeAlsoSections":[{"title":"View Composition","anchor":"View-Composition","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/equatableview"]}],"references":{"doc://TUIkit/documentation/TUIkit/EquatableView/View-Implementat