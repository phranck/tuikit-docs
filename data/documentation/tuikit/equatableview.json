{"topicSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/init(content:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/body"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/Renderable-Implementations","doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView\/View-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/EquatableView","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/ViewBuilder","doc:\/\/TUIkit\/documentation\/TUIkit\/ViewModifier","doc:\/\/TUIkit\/documentation\/TUIkit\/ModifiedView"],"anchor":"View-Composition","title":"View Composition"}],"abstract":[{"type":"text","text":"A wrapper that enables subtree memoization for views conforming to "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","text":"Equatable","preciseIdentifier":"s:SQ"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","kind":"typeIdentifier","text":"View","preciseIdentifier":"s:10TUIkitView0B0P"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When TUIKit renders an "},{"type":"codeVoice","code":"EquatableView"},{"type":"text","text":", it compares the current content with"},{"type":"text","text":" "},{"type":"text","text":"the previously cached value. If the content is unchanged "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the available"},{"type":"text","text":" "},{"type":"text","text":"size hasn’t changed, the cached "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","isActive":true},{"type":"text","text":" is returned immediately —"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree rendering."}]},{"anchor":"Usage","type":"heading","level":2,"text":"Usage"},{"type":"paragraph","inlineContent":[{"text":"Apply ","type":"text"},{"code":".equatable()","type":"codeVoice"},{"text":" to any ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" view:","type":"text"}]},{"code":["struct ScoreDisplay: View, Equatable {","    let name: String","    let score: Int","","    var body: some View {","        VStack {","            Text(name)","            Text(\"Score: \\(score)\")","        }","    }","}","","\/\/ In a parent view:","ScoreDisplay(name: \"Player 1\", score: 42).equatable()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"score","type":"codeVoice"},{"text":" are unchanged between frames, the ","type":"text"},{"code":"VStack","type":"codeVoice"},{"text":" and both","type":"text"},{"text":" ","type":"text"},{"code":"Text","type":"codeVoice"},{"text":" views are never re-rendered — the cached buffer is returned directly.","type":"text"}]},{"anchor":"When-to-Use","type":"heading","level":2,"text":"When to Use"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Large static subtrees","type":"text"}],"type":"strong"},{"text":" — views with many children that rarely change","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Expensive rendering","type":"text"}]},{"type":"text","text":" — views whose "},{"type":"codeVoice","code":"body"},{"type":"text","text":" or "},{"type":"codeVoice","code":"renderToBuffer"},{"type":"text","text":" is costly"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Animation siblings","type":"text"}]},{"type":"text","text":" — static views next to animated ones"}],"type":"paragraph"}]}]},{"anchor":"When-NOT-to-Use","type":"heading","level":2,"text":"When NOT to Use"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Views that read ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" directly (state lives in a reference-type box,","type":"text"},{"text":" ","type":"text"},{"text":"so the view struct compares as equal even when state changed)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Views that change every frame (the cache overhead adds no value)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Views that depend on environment values that change frequently"}],"type":"paragraph"}]}]},{"anchor":"Effect-Bypass","type":"heading","level":2,"text":"Effect Bypass"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Content that registers per-pass effects while rendering — key handlers,"},{"type":"text","text":" "},{"type":"text","text":"focus registrations (Button, Toggle, …), status-bar declarations,"},{"type":"text","text":" "},{"type":"text","text":"preference writes, or lifetime-effect records ("},{"type":"codeVoice","code":"onAppear"},{"type":"text","text":", "},{"type":"codeVoice","code":".task"},{"type":"text","text":", …) —"},{"type":"text","text":" "},{"type":"text","text":"must reach the frame’s collectors on EVERY frame; serving it from a"},{"type":"text","text":" "},{"type":"text","text":"cache would silently drop those registrations at the frame commit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":" frames the wrapper therefore classifies its content"},{"type":"text","text":" "},{"type":"text","text":"on every cache miss: it snapshots the pass’s effect-registration probe"},{"type":"text","text":" "},{"type":"text","text":"around the rendering, and any delta flags the identity as effect-bearing"},{"type":"text","text":" "},{"type":"text","text":"in the "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/RenderCache","isActive":true,"type":"reference"},{"type":"text","text":". Flagged identities never produce hits, so the"},{"type":"text","text":" "},{"type":"text","text":"subtree renders each frame and behaves exactly as if it were unwrapped"},{"type":"text","text":" "},{"type":"text","text":"(including pulse-animated focus indicators). Only provably effect-free"},{"type":"text","text":" "},{"type":"text","text":"output is ever served from the cache, making "},{"type":"codeVoice","code":".equatable()"},{"type":"text","text":" safe to"},{"type":"text","text":" "},{"type":"text","text":"apply anywhere — on effect-bearing subtrees it simply has no effect."}]},{"type":"paragraph","inlineContent":[{"text":"Measurement passes (","type":"text"},{"code":"RenderPhase.measure","type":"codeVoice"},{"text":") stay out of the cache","type":"text"},{"text":" ","type":"text"},{"text":"entirely: effect sites are inert there, so a buffer stored during","type":"text"},{"text":" ","type":"text"},{"text":"sizing would let the same frame’s output pass hit a subtree whose","type":"text"},{"text":" ","type":"text"},{"text":"effects were never recorded, and any classification would measure an","type":"text"},{"text":" ","type":"text"},{"text":"inert traversal.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On the live path (no "},{"type":"codeVoice","code":"RenderLoop"},{"type":"text","text":", e.g. "},{"type":"codeVoice","code":"ViewRenderer"},{"type":"text","text":" or test"},{"type":"text","text":" "},{"type":"text","text":"harnesses) caching keeps its historical semantics without"},{"type":"text","text":" "},{"type":"text","text":"classification."}]},{"type":"heading","level":2,"text":"Cache Invalidation","anchor":"Cache-Invalidation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The render cache is selectively cleared when "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" values change:"},{"type":"text","text":" "},{"type":"text","text":"only cache entries in the ancestor\/descendant path of the changed state"},{"type":"text","text":" "},{"type":"text","text":"are invalidated. Sibling subtrees retain their cached buffers."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View\/equatable()","isActive":true}]}],"type":"aside","style":"note","name":"See Also"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/equatableview"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"relationshipsSections":[{"type":"conformsTo","kind":"relationships","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/Renderable","doc:\/\/TUIkit\/s8CopyableP","doc:\/\/TUIkit\/s8SendableP","doc:\/\/TUIkit\/documentation\/TUIkit\/View"],"title":"Conforms To"}],"kind":"symbol","metadata":{"title":"EquatableView","symbolKind":"struct","modules":[{"name":"TUIkit"}],"role":"symbol","fragments":[{"text":"struct","kind":"k