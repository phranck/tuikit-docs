{"abstract":[{"text":"A wrapper that enables subtree memoization for views conforming to ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":".","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EquatableView"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Content"},{"kind":"text","text":"> "},{"kind":"keyword","text":"where"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:SQ","kind":"typeIdentifier","text":"Equatable"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Content"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:10TUIkitView0B0P","kind":"typeIdentifier","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/View","text":"View"}],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"When TUIKit renders an ","type":"text"},{"code":"EquatableView","type":"codeVoice"},{"text":", it compares the current content with","type":"text"},{"text":" ","type":"text"},{"text":"the previously cached value. If the content is unchanged ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" the available","type":"text"},{"text":" ","type":"text"},{"text":"size hasn’t changed, the cached ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FrameBuffer","type":"reference"},{"text":" is returned immediately —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"skipping the entire subtree renderin