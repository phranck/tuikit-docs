t"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"List","type":"text"}]},{"text":": A vertical collection of arbitrary view content with selection support","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Table"}],"type":"strong"},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}],"type":"paragraph"},{"anchor":"List","level":2,"text":"List","type":"heading"},{"inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Optional title in the border"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Optional footer section"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single or multi-selection","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keyboard navigation","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Basic-Usage","level":3,"text":"Basic Usage","type":"heading"},{"syntax":"swift","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"With-Footer","level":3,"text":"With Footer","type":"heading"},{"inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"type":"codeListing"},{"anchor":"Multi-Selection","level":3,"text":"Multi-Selection","type":"heading"},{"inlineContent":[{"text":"Use a ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":" binding for multi-selection mode:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"type":"codeListing"},{"anchor":"Visual-States","level":3,"text":"Visual States","type":"heading"},{"inlineContent":[{"text":"List rows display different visual states:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"State","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Focused + Selected"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pulsing accent background"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Focused only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Highlight background bar","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Selected only"}]}],[{"type":"paragraph","inlineContent":[{"text":"Subtle accent background","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Neither","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default