h Footer","anchor":"With-Footer","level":3},{"type":"paragraph","inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"]},{"anchor":"Multi-Selection","type":"heading","text":"Multi-Selection","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}]},{"type":"codeListing","syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"]},{"anchor":"Visual-States","type":"heading","text":"Visual States","level":3},{"type":"paragraph","inlineContent":[{"text":"List rows display different visual states:","type":"text"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"State"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused + Selected"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pulsing accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Highlight background bar","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Selected only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Subtle accent background","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Neither"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default appearance","type":"text"}],"type":"paragraph"}