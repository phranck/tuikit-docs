{"abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"TUIkit provides two components for displaying collections of data:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"List"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Table"}],"type":"strong"},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}],"type":"paragraph"},{"text":"List","anchor":"List","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Optional title in the border","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional footer section"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single or multi-selection","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Basic Usage","anchor":"Basic-Usage","level":3,"type":"heading"},{"code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"With Footer","anchor":"With-Footer","level":3,"type":"heading"},{"inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}],"type":"paragraph"},{"code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Multi-Selection","anchor":"Multi-Selection","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}],"type":"paragraph"},{"code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Visual States","anchor":"Visual-States","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"List rows display different visual states:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"State"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Focused + Selected","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pulsing accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Highlight background bar","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Selected only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Subtle accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Neither","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default appearance"}],"type":"paragraph"}]]],"type":"table"},{"text":"Table","anchor":"Table","level":2,"type":"heading"},{"inlineContent":[{"code":"Table","type":"codeVoice"},{"type":"text","text":" displays tabular data with column headers, alignment, and configurable widths."}],"type":"paragraph"},{"text":"Basic Usage","anchor":"Basic-Usage","level":3,"type":"heading"},{"code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Column Configuration","anchor":"Column-Configuration","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Columns support three width modes:"}],"type":"paragraph"},{"code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"],"syntax":"swift","type":"codeListing"},{"text":"Column Alignment","anchor":"Column-Alignment","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Align column content to leading, center, or trailing:"}],"type":"paragraph"},{"code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"],"syntax":"swift","type":"codeListing"},{"text":"Keyboard Navigation","anchor":"Keyboard-Navigation","level":2,"type":"heading"},{"inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus up (wraps to end)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}],[{"type":"paragraph","inlineContent":[{"text":"Jump to first item","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to last item"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move up by viewport height","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move down by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle selection","type":"text"}]}]]],"type":"table"},{"text":"Scroll Indicators","anchor":"Scroll-Indicators","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When content extends beyond the viewport, scroll indicators appear:"}],"type":"paragraph"},{"code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 5                       │","│ Item 6                       │","│ Item 7                       │","│         ▼ more below         │","└──────────────────────────────┘"],"syntax":null,"type":"codeListing"},{"text":"Sections","anchor":"Sections","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true},{"type":"text","text":" to group list items with headers and optional footers:"}],"type":"paragraph"},{"code":["List(\"Settings\", selection: $selected) {","    Section(\"General\") {","        ForEach(generalItems) { item in","            Text(item.name)","        }","    }","    Section(\"Advanced\") {","        ForEach(advancedItems) { item in","            Text(item.name)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Section headers are rendered with secondary foreground color and bold styling above the group.","type":"text"}],"type":"paragraph"},{"text":"Badges","anchor":"Badges","level":2,"type":"heading"},{"inlineContent":[{"text":"Add badges to list rows using the ","type":"text"},{"code":".badge(_:)","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"code":["List(\"Inbox\", selection: $selected) {","    ForEach(mailboxes) { mailbox in","        Text(mailbox.name)","            .badge(mailbox.unreadCount)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Badges appear right-aligned in the row and support both integer and string values."}],"type":"paragraph"},{"text":"List Modifiers","anchor":"List-Modifiers","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Lists support several TUI-specific modifiers:"}],"type":"paragraph"},{"code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"],"syntax":"swift","type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Modifier"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".focusID(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Sets a stable, explicit focus identifier"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".listEmptyPlaceholder(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Text shown when the list has no items (default: “No items”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".listFooterSeparator(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Controls the separator line before the footer","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".disabled(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prevents keyboard interaction"}],"type":"paragraph"}]]],"type":"table"},{"text":"Environment Propagation","anchor":"Environment-Propagation","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Modifiers applied to List or Table propagate to their content:"}],"type":"paragraph"},{"code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIki