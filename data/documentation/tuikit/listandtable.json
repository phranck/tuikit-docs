{"sections":[],"metadata":{"modules":[{"name":"TUIkit"}],"role":"article","roleHeading":"Article","title":"List and Table Components"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/List","doc:\/\/TUIkit\/documentation\/TUIkit\/Table","doc:\/\/TUIkit\/documentation\/TUIkit\/TableColumn","doc:\/\/TUIkit\/documentation\/TUIkit\/ColumnWidth","doc:\/\/TUIkit\/documentation\/TUIkit\/Section","doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","doc:\/\/TUIkit\/documentation\/TUIkit\/SelectionMode","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"]},{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/listandtable"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two components for displaying collections of data:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"List","type":"text"}],"type":"strong"},{"text":": A vertical collection of arbitrary view content with selection support","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Table"}],"type":"strong"},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"text":"List","level":2,"type":"heading","anchor":"List"},{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional title in the border","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Optional footer section"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single or multi-selection","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Keyboard navigation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Automatic scrolling with viewport management","type":"text"}],"type":"paragraph"}]}]},{"text":"Basic Usage","level":3,"type":"heading","anchor":"Basic-Usage"},{"type":"codeListing","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"syntax":"swift"},{"text":"With Footer","level":3,"type":"heading","anchor":"With-Footer"},{"type":"paragraph","inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}]},{"type":"codeListing","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"syntax":"swift"},{"text":"Multi-Selection","level":3,"type":"heading","anchor":"Multi-Selection"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":" binding for multi-selection mode:","type":"text"}]},{"type":"codeListing","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"syntax":"swift"},{"text":"Visual States","level":3,"type":"heading","anchor":"Visual-States"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List rows display different visual states:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"State"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused + Selected"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pulsing accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Highlight background bar","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Selected only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Subtle accent background","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Neither"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default appearance","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"text":"Table","level":2,"type":"heading","anchor":"Table"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Table"},{"text":" displays tabular data with column headers, alignment, and configurable widths.","type":"text"}]},{"text":"Basic Usage","level":3,"type":"heading","anchor":"Basic-Usage"},{"type":"codeListing","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"],"syntax":"swift"},{"text":"Column Configuration","level":3,"type":"heading","anchor":"Column-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Columns support three width modes:"}]},{"type":"codeListing","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"],"syntax":"swift"},{"text":"Column Alignment","level":3,"type":"heading","anchor":"Column-Alignment"},{"type":"paragraph","inlineContent":[{"text":"Align column content to leading, center, or trailing:","type":"text"}]},{"type":"codeListing","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"],"syntax":"swift"},{"text":"Keyboard Navigation","level":2,"type":"heading","anchor":"Keyboard-Navigation"},{"type":"paragraph","inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to first item"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to last item"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move up by viewport height","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move down by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Space"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle selection"}]}]]],"type":"table"},{"text":"Scroll Indicators","level":2,"type":"heading","anchor":"Scroll-Indicators"},{"type":"paragraph","inlineContent":[{"text":"When content extends beyond the viewport, scroll indicators appear:","type":"text"}]},{"type":"codeListing","code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 5                       │","│ Item 6                       │","│ Item 7                       │","│         ▼ more below         │","└──────────────────────────────┘"],"syntax":null},{"text":"Sections","level":2,"type":"heading","anchor":"Sections"},{"type":"paragraph","inline