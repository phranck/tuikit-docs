{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"List"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"type":"heading","anchor":"List","level":2,"text":"List"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Optional title in the border"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional footer section"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single or multi-selection"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keyboard navigation","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Automatic scrolling with viewport management","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Basic-Usage","level":3,"text":"Basic Usage"},{"type":"codeListing","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"With-Footer","level":3,"text":"With Footer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}]},{"type":"codeListing","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Multi-Selection","level":3,"text":"Multi-Selection"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"type":"codeVoice","code":"Set"},{"text":" binding for multi-selection mode:","type":"text"}]},{"type":"codeListing","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Visual-States","level":3,"text":"Visual States"},{"type":"paragraph","inlineContent":[{"text":"List rows display different visual states:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"State","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Focused + Selected","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pulsing accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Highlight background bar"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Selected only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Subtle accent background","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Neither"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default appearance","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","anchor":"Table","level":2,"text":"Table"},{"type":"paragraph","inlineContent":[{"code":"Table","type":"codeVoice"},{"text":" displays tabular data with column headers, alignment, and configurable widths.","type":"text"}]},{"type":"heading","anchor":"Basic-Usage","level":3,"text":"Basic Usage"},{"type":"codeListing","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Column-Configuration","level":3,"text":"Column Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Columns support three width modes:"}]},{"type":"codeListing","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"],"syntax":"swift"},{"type":"heading","anchor":"Column-Alignment","level":3,"text":"Column Alignment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Align column content to leading, center, or trailing:"}]},{"type":"codeListing","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"],"syntax":"swift"},{"type":"heading","anchor":"Keyboard-Navigation","level":2,"text":"Keyboard Navigation"},{"type":"paragraph","inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Home"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Jump to first item"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"End"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Jump to last item"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Page Up","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move up by viewport height"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Page Down"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move down by viewport height"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Enter \/ Space","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Toggle selection"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Scroll-Indicators","type":"heading","text":"Scroll Indicators","level":2},{"inlineContent":[{"type":"text","text":"When content extends beyond the viewport, scroll indicators appear:"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 5                       │","│ Item 6                       │","│ Item 7                       │","│         ▼ more below         │","└──────────────────────────────┘"]},{"anchor":"Sections","type":"heading","text":"Sections","level":2},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","isActive":true},{"text":" to group list items with headers and optional footers:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["List(\"Settings\", selection: $selected) {","    Section(\"General\") {","        ForEach(generalItems) { item in","            Text(item.name)","        }","    }","    Section(\"Advanced\") {","        ForEach(advancedItems) { item in","            Text(item.name)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Section headers are rendered with secondary foreground color and bold styling above the group."}],"type":"paragraph"},{"anchor":"Badges","type":"heading","text":"Badges","level":2},{"inlineContent":[{"text":"Add badges to list rows using the ","type":"text"},{"code":".badge(_:)","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["List(\"Inbox\", selection: $selected) {","    ForEach(mailboxes) { mailbox in","        Text(mailbox.name)","            .badge(mailbox.unreadCount)","    }","}"]},{"inlineContent":[{"type":"text","text":"Badges appear right-aligned in the row and support both integer and string values."}],"type":"paragraph"},{"anchor":"List-Modifiers","type":"heading","text":"List Modifiers","level":2},{"inlineContent":[{"type":"text","text":"Lists support several TUI-specific modifiers:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Modifier","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".focusID(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets a stable, explicit focus identifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".listEmptyPlaceholder(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Text shown when the list has no items (default: “No items”)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listFooterSeparator(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Controls the separator line before the footer"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".disabled(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Prevents keyboard interaction","type":"text"}]}]]],"header":"row","type":"table"},{"anchor":"Environment-Propagation","type":"heading","text":"Environment Propagation","level":2},{"inlineContent":[{"type":"text","text":"Modifiers applied to List or Table propagate to their content:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/List","doc:\/\/TUIkit\/documentation\/TUIkit\/Table","doc:\/\/TUIkit\/documentation\/TUIkit\/TableColumn","doc:\/\/TUIkit\/documentation\/TUIkit\