{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"List","type":"text"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"text":": A columnar data display with headers and configurable column widths","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}]},{"type":"heading","anchor":"List","level":2,"text":"List"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Optional title in the border","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Optional footer section","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single or multi-selection"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatic scrolling with viewport management","type":"text"}]}]}]},{"type":"heading","anchor":"Basic-Usage","level":3,"text":"Basic Usage"},{"type":"codeListing","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"With-Footer","level":3,"text":"With Footer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}]},{"type":"codeListing","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Multi-Selection","level":3,"text":"Multi-Selection"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}],"type":"paragraph"},{"syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"type":"codeListing"},{"level":3,"text":"Visual States","anchor":"Visual-States","type":"heading"},{"inlineContent":[{"type":"text","text":"List rows display different visual states:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"State","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Focused + Selected"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pulsing accent background","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Focused only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Highlight background bar"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Selected only"}]}],[{"inlineContent":[{"type":"text","text":"Subtle accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Neither"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Default appearance","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"level":2,"text":"Table","anchor":"Table","type":"heading"},{"inlineContent":[{"code":"Table","type":"codeVoice"},{"text":" displays tabular data with column headers, alignment, and configurable widths.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Basic-Usage","type":"heading","text":"Basic Usage"},{"syntax":"swift","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"],"type":"codeListing"},{"level":3,"anchor":"Column-Configuration","type":"heading","text":"Column Configuration"},{"inlineContent":[{"type":"text","text":"Columns support three width modes:"}],"type":"paragraph"},{"syntax":"swift","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"],"type":"codeListing"},{"level":3,"anchor":"Column-Alignment","type":"heading","text":"Column Alignment"},{"inlineContent":[{"type":"text","text":"Align column content to leading, center, or trailing:"}],"type":"paragraph"},{"syntax":"swift","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"],"type":"codeListing"},{"level":2,"anchor":"Keyboard-Navigation","type":"heading","text":"Keyboard Navigation"},{"inlineContent":[{"type":"text","text":"Both List and Table support the same keyboard shortcuts:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus down (wraps to start)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}],[{"type":"paragraph","inlineContent":[{"text":"Jump to first item","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to last item"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move up by viewport height","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move down by viewport height","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle selection","type":"text"}]}]]]},{"level":2,"anchor":"Scroll-Indicators","type":"heading","text":"Scroll Indicators"},{"inlineContent":[{"type":"text","text":"When content extends beyond the viewport, scroll indicators appear:"}],"type":"paragraph"},{"syntax":null,"code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 5                       │","│ Item 6                       │","│ Item 7                       │","│         ▼ more below         │","└──────────────────────────────┘"],"type":"codeListing"},{"level":2,"anchor":"Sections","type":"heading","text":"Sections"},{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section"},{"type":"text","text":" to group list items with headers and optional footers:"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Settings\", selection: $selected) {","    Section(\"General\") {","        ForEach(generalItems) { item in","            Text(item.name)","        }","    }","    Section(\"Advanced\") {","        ForEach(advancedItems) { item in","            Text(item.name)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Section headers are rendered with secondary foreground color and bold styling above the group."}],"type":"paragraph"},{"level":2,"anchor":"Badges","type":"heading","text":"Badges"},{"inlineContent":[{"type":"text","text":"Add badges to list rows using the "},{"type":"codeVoice","code":".badge(_:)"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Inbox\", selection: $selected) {","    ForEach(mailboxes) { mailbox in","        Text(mailbox.name)","            .badge(mailbox.unreadCount)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Badges appear right-aligned in the row and support both integer and string values."}],"type":"paragraph"},{"level":2,"anchor":"List-Modifiers","type":"heading","text":"List Modifiers"},{"inlineContent":[{"text":"Lists support several TUI-specific modifiers:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyP