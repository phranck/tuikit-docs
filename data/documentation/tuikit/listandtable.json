e":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Align column content to leading, center, or trailing:"}]},{"syntax":"swift","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"],"type":"codeListing"},{"level":2,"text":"Keyboard Navigation","anchor":"Keyboard-Navigation","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both List and Table support the same keyboard shortcuts:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Up","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Home","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Jump to first item","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"End","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Jump to last item","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Page Up","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move up by viewport height","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Page Down"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move down by viewport height"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Enter \/ Space","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Toggle selection"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"text":"Scroll Indicators","anchor":"Scroll-Indicators","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When content extends beyond the 