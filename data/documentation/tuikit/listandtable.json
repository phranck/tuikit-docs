{"sections":[],"abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"List","type":"text"}],"type":"strong"},{"text":": A vertical collection of arbitrary view content with selection support","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Table","type":"text"}],"type":"strong"},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"anchor":"List","type":"heading","level":2,"text":"List"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional title in the border","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional footer section","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single or multi-selection"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keyboard navigation","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}]}]}]},{"anchor":"Basic-Usage","type":"heading","level":3,"text":"Basic Usage"},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"]},{"anchor":"With-Footer","type":"heading","level":3,"text":"With Footer"},{"type":"paragraph","inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"]},{"anchor":"Multi-Selection","type":"heading","level":3,"text":"Multi-Selection"},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":" binding for multi-selection mode:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"]},{"anchor":"Visual-States","type":"heading","level":3,"text":"Visual States"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List rows display different visual states:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"State","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Focused + Selected","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pulsing accent background","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Focused only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Highlight background bar"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Selected only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Subtle accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Neither","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default appearance"}],"type":"paragraph"}]]]},{"anchor":"Table","type":"heading","level":2,"text":"Table"},{"type":"paragraph","inlineContent":[{"code":"Table","type":"codeVoice"},{"text":" displays tabular data with column headers, alignment, and configurable widths.","type":"text"}]},{"anchor":"Basic-Usage","type":"heading","level":3,"text":"Basic Usage"},{"type":"codeListing","syntax":"swift","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"]},{"anchor":"Column-Configuration","type":"heading","level":3,"text":"Column Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Columns support three width modes:"}]},{"type":"codeListing","syntax":"swift","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"]},{"anchor":"Column-Alignment","type":"heading","level":3,"text":"Column Alignment"},{"type":"paragraph","inlineContent":[{"text":"Align column content to leading, center, or trailing:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"]},{"anchor":"Keyboard-Navigation","type":"heading","level":2,"text":"Keyboard Navigation"},{"type":"paragraph","inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}],[{"type":"paragraph","inlineContent":[{"text":"Jump to first item","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"End","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to last item"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move up by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move down by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Enter \/ Space","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle selection","type":"text"}]}]]]},{"anchor":"Scroll-Indicators","type":"heading","level":2,"text":"Scroll Indicators"},{"type":"paragraph","inlineContent":[{"text":"When content extends beyond the viewport, scroll indicators appear:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 5                       │","│ Item 6                       │","│ Item 7                       │","│         ▼ more below         │","└──────────────────────────────┘"]},{"anchor":"Sections","type":"heading","level":2,"text":"Sections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","type":"reference","isActive":true},{"type":"text","text":" to group list items with headers and optional footers:"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Settings\", selection: $selected) {","    Section(\"General\") {","        ForEach(generalItems) { item in","            Text(item.name)","        }","    }","    Section(\"Advanced\") {","        ForEach(advancedItems) { item in","            Text(item.name)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Section headers are rendered with secondary foreground color and bold styling above the group.","type":"text"}]},{"anchor":"Badges","type":"heading","level":2,"text":"Badges"},{"type":"paragraph","inlineContent":[{"text":"Add badges to list rows using the ","type":"text"},{"code":".badge(_:)","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Inbox\", selection: $selected) {","    ForEach(mailboxes) { mailbox in","        Text(mailbox.name)","            .badge(mailbox.unreadCount)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Badges appear right-aligned in the row and support both integer and string values.","type":"text"}]},{"anchor":"List-Modifiers","type":"heading","level":2,"text":"List Modifiers"},{"type":"paragraph","inlineContent":[{"text":"Lists support several TUI-specific modifiers:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Modifier"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Description","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".focusID(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Sets a stable, explicit focus identifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".listEmptyPlaceholder(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Text shown when the list has no items (default: “No items”)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".listFooterSeparator(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Controls the separator line before the footer"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".disabled(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Prevents keyboard interaction","type":"text"}],"type":"paragraph"}]]]},{"anchor":"Environment-Propagation","type":"heading","level":2,"text":"Environment Propagation"},{"type":"paragraph","inlineContent":[{"text":"Modifiers applied to List or Table propagate to their content:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}]}],"metadata":{"title":"List and Table Components","roleHeading":"Article","modules":[{"name":"TUIkit"}],"role":"article"},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identif