{"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"roleHeading":"Article","title":"List and Table Components","modules":[{"name":"TUIkit"}],"role":"article"},"sections":[],"variants":[{"paths":["\/documentation\/tuikit\/listandtable"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two components for displaying collections of data:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"List"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"type":"heading","level":2,"text":"List","anchor":"List"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Optional title in the border"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional footer section","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Single or multi-selection","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text