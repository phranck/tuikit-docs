ed in the row and support both integer and string values."}]},{"type":"heading","level":2,"text":"List Modifiers","anchor":"List-Modifiers"},{"type":"paragraph","inlineContent":[{"text":"Lists support several TUI-specific modifiers:","type":"text"}]},{"syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"],"type":"codeListing"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Modifier","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".focusID(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Sets a stable, explicit focus identifier"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".listEmptyPlaceholder(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Text shown when the list has no items (default: “No items”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".listFooterSeparator(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Controls the separator line before the footer","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".disabled(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prevents keyboard interaction"}],"type":"paragraph"}]]]},{"type":"heading","level":2,"text":"Environment Propagation","anchor":"Environment-Propagation"},{"type":"paragraph","inlineContent":[{"text":"Modifiers applied to List or Table propagate to their content:","type":"text"}]},{"syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEa