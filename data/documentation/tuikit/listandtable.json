teger and string values.","type":"text"}],"type":"paragraph"},{"anchor":"List-Modifiers","type":"heading","level":2,"text":"List Modifiers"},{"inlineContent":[{"type":"text","text":"Lists support several TUI-specific modifiers:"}],"type":"paragraph"},{"type":"codeListing","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"],"syntax":"swift"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Modifier"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Description"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".focusID(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets a stable, explicit focus identifier"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listEmptyPlaceholder(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text shown when the list has no items (default: “No items”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listFooterSeparator(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Controls the separator line before the footer","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".disabled(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Prevents keyboard interaction","type":"text"}]}]]]},{"level":2,"type":"heading","anchor":"Environment-Propagation","text":"Environment Propagation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifiers applied to List or Table propagate to their content:"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/List","doc:\/\/TUIkit\/documentation\/TUIkit\/Table","doc:\/\/TUIkit\/documentation\/TUIkit\/TableColumn","doc:\/\/TUIkit\/documentation\/TUIkit\/ColumnWidth","doc:\/\/TUIkit\/documentation\/TUIkit\/Section","doc:\/\/TUIkit\/documentation\/TUIkit\/ForEach","doc:\/\/TUIkit\/documentation\/TUIkit\/SelectionMode","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem"],"title":"Related Documentation"},{"anchor":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/listandtable"]}],"references":{"doc://TUIkit/documentation/TUIkit/Table":{"type":"topic","abstract":[{"type":"text","text":"A scrollable table with columns, keyboard navigation, and selection."}],"kind":"symbol","navigatorTitle":[{"text":"Table","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Table","url":"\/documentation\/tuikit\/table","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Table","kind":"identifier"}],"title":"Table"},"doc://TUIkit/documentation/TUIkit/ForEach":{"url"