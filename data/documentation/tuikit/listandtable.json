{","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Modifier","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".focusID(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets a stable, explicit focus identifier"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".listEmptyPlaceholder(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text shown when the list has no items (default: “No items”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listFooterSeparator(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Controls the separator line before the footer"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".disabled(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Prevents keyboard interaction","type":"text"}]}]]]},{"anchor":"Environment-Propagation","level":2,"type":"heading","text":"Environment Propagation"},{"inlineContent":[{"type":"text","text":"Modifiers applied to List or Table propagate to their content:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}]}],"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/List","doc:\/\/TUIkit\/documentation\/TUIkit\/Table","doc:\/\/TUIkit\/do