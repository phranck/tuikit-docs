":[{"text":"Table","type":"text"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}],"type":"paragraph"},{"level":2,"text":"List","anchor":"List","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional title in the border"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional footer section"}]}]},{"content":[{"inlineContent":[{"text":"Single or multi-selection","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}]}]}],"type":"unorderedList"},{"level":3,"text":"Basic Usage","anchor":"Basic-Usage","type":"heading"},{"code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"With Footer","anchor":"With-Footer","type":"heading"},{"inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}],"type":"paragraph"},{"code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(