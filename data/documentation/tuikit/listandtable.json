ing","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifier"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".focusID(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Sets a stable, explicit focus identifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listEmptyPlaceholder(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text shown when the list has no items (default: “No items”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listFooterSeparator(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Controls the separator line before the footer"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".disabled(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Prevents keyboard interaction","type":"text"}]}]]],"type":"table","header":"row"},{"text":"Environment Propagation","level":2,"type":"heading","anchor":"Environment-Propagation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifiers applied to List or Table propagate to their content:"}]},{"syntax":"swift","type":"codeListing","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}]}],"metadata":{"role":"article","roleHeading":"Article","title":"List and Table Components","modules":[{"name":"TUIkit"}]},"sections":[],"identifier