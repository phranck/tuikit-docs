t"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"List","type":"text"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}],"type":"paragraph"},{"anchor":"List","text":"List","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Optional title in the border","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional footer section"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single or multi-selection"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Keyboard navigation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}],"type":"paragraph"}]}]},{"anchor":"Basic-Usage","text":"Basic Usage","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"]},{"anchor":"With-Footer","text":"With Footer","type":"heading","level":3},{"inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}],"type":"paragraph"},{"code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"Multi-Selection","level":3,"text":"Multi-Selection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}]},{"type":"codeListing","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Visual-States","level":3,"text":"Visual States"},{"type":"paragraph","inlineContent":[{"text":"List rows display different visual states:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"State"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Appearance"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Focused + Selected","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pulsing accent background","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Highlight background bar","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Selected only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Subtle accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Neither","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default appearance"}],"typ