{"metadata":{"role":"article","modules":[{"name":"TUIkit"}],"roleHeading":"Article","title":"List and Table Components"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"List","type":"text"}],"type":"strong"},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Table"}],"type":"strong"},{"text":": A columnar data display with headers and configurable column widths","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"anchor":"List","type":"heading","text":"List","level":2},{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional title in the border"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional footer section","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single or multi-selection"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keyboard navigation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}]}]}]},{"anchor":"Basic-Usage","type":"heading","text":"Basic Usage","level":3},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"]},{"anchor":"With-Footer","type":"heading","text":"With Footer","level":3},{"type":"paragraph","inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"]},{"anchor":"Multi-Selection","type":"heading","text":"Multi-Selection","level":3},{"type":"paragraph","inlineContent":[{"text":"Use a ","type":"text"},{"code":"Set","type":"codeVoice"},{"text":" binding for multi-selection mode:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"]},{"anchor":"Visual-States","type":"heading","text":"Visual States","level":3},{"type":"paragraph","inlineContent":[{"text":"List rows display different visual states:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"State","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Focused + Selected","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pulsing accent background"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Focused only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Highlight background bar"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Selected only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subtle accent background"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Neither"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default appearance"}]}]]],"type":"table","header":"row"},{"anchor":"Table","type":"heading","text":"Table","level":2},{"type":"paragraph","inlineContent":[{"code":"Table","type":"codeVoice"},{"type":"text","text":" displays tabular data with column headers, alignment, and configurable widths."}]},{"anchor":"Basic-Usage","type":"heading","text":"Basic Usage","level":3},{"type":"codeListing","syntax":"swift","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"]},{"anchor":"Column-Configuration","type":"heading","text":"Column Configuration","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Columns support three width modes:"}]},{"type":"codeListing","syntax":"swift","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"]},{"anchor":"Column-Alignment","type":"heading","text":"Column Alignment","level":3},{"type":"paragraph","