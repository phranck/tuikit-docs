{"abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"List"}]},{"text":": A vertical collection of arbitrary view content with selection support","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Table"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}]},{"level":2,"text":"List","anchor":"List","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Optional title in the border"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional footer section","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Single or multi-selection","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatic scrolling with viewport management","type":"text"}]}]}]},{"level":3,"text":"Basic Usage","anchor":"Basic-Usage","type":"heading"},{"syntax":"swift","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"type":"codeListing"},{"level":3,"text":"With Footer","anchor":"With-Footer","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}]},{"syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"type":"codeListing"},{"level":3,"text":"Multi-Selection","anchor":"Multi-Selection","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}]},{"syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"type":"codeListing"},{"level":3,"text":"Visual States","anchor":"Visual-States","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"List rows display different visual states:","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"State","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Focused + Selected","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Pulsing accent background"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Focused only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{