{"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two components for displaying collections of data:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"List"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"anchor":"List","text":"List","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional title in the border","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Optional footer section","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single or multi-selection"}]}]},{"content":[{"inlineContent":[{"text":"Keyboard navigation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Basic-Usage","text":"Basic Usage","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"]},{"anchor":"With-Footer","text":"With Footer","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"]},{"anchor":"Multi-Selection","text":"Multi-Selection","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}]},{"type":"codeListing","syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"]},{"anchor":"Visual-States","text":"Visual States","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"List rows display different visual states:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"State","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused + Selected"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pulsing accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Highlight background bar"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Selected only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Subtle accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Neither"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default appearance"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Table","text":"Table","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Table"},{"type":"text","text":" displays tabular data with column headers, alignment, and configurable widths."}]},{"anchor":"Basic-Usage","text":"Basic Usage","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"]},{"anchor":"Column-Configuration","text":"Column Configuration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Columns support three width modes:"}]},{"type":"codeListing","syntax":"swift","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"]},{"anchor":"Column-Alignment","text":"Column Alignment","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Align column content to leading, center, or trailing:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"]},{"anchor":"Keyboard-Navigation","text":"Keyboard Navigation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Up"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Down","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move focus down (wraps to start)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Home","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Jump to first item"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"End","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Jump to last item"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Page Up","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Move up by viewport height","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Page Down","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Move down by viewport height"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Enter \/ Space"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Toggle selection","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Scroll-Indicators","text":"Scroll Indicators","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When content extends beyond the viewport, scroll indicators appear:"}]},{"type":"codeListing","syntax":null,"code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ I