ntifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Modifier","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Description"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".focusID(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Sets a stable, explicit focus identifier","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".listEmptyPlaceholder(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Text shown when the list has no items (default: “No items”)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".listFooterSeparator(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Controls the separator line before the footer","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".disabled(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Prevents keyboard interaction"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Environment-Propagation","text":"Environment Propagation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modifiers applied to List or Table propagate to their content:"}]},{"type":"codeListing","syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}],"kind":"content"}],"sections":[],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/List","doc:\/\/TUIkit\/documentation\/TUIkit\/Table","doc:\/\/TUIkit\/documentation\/TUIkit\/TableColumn","doc:\/\/TUIkit\/documentation\/TUIkit\/ColumnWidth","doc:\/\/TUIkit\/doc