{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides two components for displaying collections of data:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"List","type":"text"}]},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Table"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}]},{"level":2,"type":"heading","text":"List","anchor":"List"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional title in the border","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional footer section"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single or multi-selection"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatic scrolling with viewport management","type":"text"}]}]}]},{"level":3,"type":"heading","text":"Basic Usage","anchor":"Basic-Usage"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"]},{"level":3,"type":"heading","text":"With Footer","anchor":"With-Footer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add action buttons or status text in a footer section:"}]},{"syntax":"swift","type":"codeListing","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"]},{"level":3,"type":"heading","text":"Multi-Selection","anchor":"Multi-Selection"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}]},{"syntax":"swift","type":"codeListing","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"]},{"level":3,"type":"heading","text":"Visual States","anchor":"Visual-States"},{"type":"paragraph","inlineContent":[{"type":"text","text":"List rows display different visual states:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"State","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Appearance","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Focused + Selected"}]}],[{"type":"paragraph","inlineContent":[{"text":"Pulsing accent background","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Focused only"}]}],[{"type":"paragraph","inlineContent":[{"text":"Highlight background bar","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Selected only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subtle accent background"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Neither"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default appearance"}]}]]],"type":"table"},{"level":2,"type":"heading","text":"Table","anchor":"Table"},{"type":"paragraph","inlineContent":[{"code":"Table","type":"codeVoice"},{"text":" displays tabular data with column headers, alignment, and configurable widths.","type":"text"}]},{"level":3,"type":"heading","text":"Basic Usage","anchor":"Basic-Usage"},{"syntax":"swift","type":"codeListing","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"]},{"level":3,"type":"heading","text":"Column Configuration","anchor":"Column-Configuration"},{"type":"paragraph","inlineContent":[{"text":"Columns support three width modes:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"]},{"level":3,"type":"heading","text":"Column Alignment","anchor":"Column-Alignment"},{"type":"paragraph","inlineContent":[{"text":"Align column content to leading, center, or trailing:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"]},{"level":2,"type":"heading","text":"Keyboard Navigation","anchor":"Keyboard-Navigation"},{"type":"paragraph","inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Up"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move focus down (wraps to start)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Home","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to first item"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}],[{"type":"paragraph","inlineContent":[{"text":"Jump to last item","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Up"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move up by viewport height","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move down by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle selection","type":"text"}]}]]],"type":"table"},{"level":2,"type":"heading","text":"Scroll Indicators","anchor":"Scroll-Indicators"},{"type":"paragraph","inlineContent":[{"text":"When content extends beyond the viewport, scroll indicators appear:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 5                       │","│ Item 6                       │","│ Item 7                       │","│         ▼ more below         │","└──────────────────────────────┘"]},{"level":2,"type":"heading","text":"Sections","anchor":"Sections"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section","type":"reference","isActive":true},{"type":"text","text":" to group list items with headers and optional footers:"}]},{"syntax":"swift","type":"codeListing","code":["List(\"Settings\", selection: $selected) {","    Section(\"General\") {","        ForEach(generalItems) { item in","            Text(item.name)","        }","    }","    Section(\"Advanced\") {","        ForEach(advancedItems) { item in","            Text(item.name)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Section headers are rendered with secondary foreground color and bold styling above the group.","type":"text"}]},{"level":2,"type":"heading","text":"Badges","anchor":"Badges"},{"type":"paragraph","inlineContent":[{"text":"Add badges to list rows using the ","type":"text"},{"type":"codeVoice","code":".badge(_:)"},{"text":" modifier:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["List(\"Inbox\", selection: $selected) {","    ForEach(mailboxes) { mailbox in","        Text(mailbox.name)","            .badge(mailbox.unreadCount)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Badges appear right-aligned in the row and support both integer and string values."}]},{"level":2,"type":"heading","text":"List Modifiers","anchor":"List-Modifiers"},{"type":"paragraph","inlineContent":[{"text":"Lists support several TUI-specific modifiers:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Modifier","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Description","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".focusID(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Sets a stable, explicit focus identifier","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".listEmptyPlaceholder(_:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Text shown when the list has no items (default: “No items”)"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".listFooterSeparator(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Controls the separator line before the footer","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".disabled(_:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Prevents keyboard interaction","type":"text"}]}]]],"type":"table"},{"level":2,"type":"heading","text":"Environment Propagation","anchor":"Environment-Propagation"},{"type":"paragraph","inlineContent":[{"text":"Modifiers applied to List or Table propagate to their content:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)  \/\/ Inherits red foreground","    }","}",".foregroundColor(.red)"]}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"metadata":{"roleHeading":"Article","title":"List and Table Components","role":"article","modules":[{"name":"TUIkit"}]},"seeAlsoSec