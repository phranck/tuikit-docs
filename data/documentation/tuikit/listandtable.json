ection of arbitrary view content with selection support"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Table"}]},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience.","type":"text"}]},{"type":"heading","level":2,"text":"List","anchor":"List"},{"type":"paragraph","inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional title in the border"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Optional footer section"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Single or multi-selection"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic scrolling with viewport management"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"Basic Usage","anchor":"Basic-Usage"},{"code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"With Footer","anchor":"With-Footer"},{"type":"paragraph","inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}]},{"type":