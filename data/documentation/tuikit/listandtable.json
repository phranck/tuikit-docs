{"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"List and Table Components","modules":[{"name":"TUIkit"}]},"abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"List"}],"type":"strong"},{"type":"text","text":": A vertical collection of arbitrary view content with selection support"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Table","type":"text"}]},{"type":"text","text":": A columnar data display with headers and configurable column widths"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}]},{"type":"heading","text":"List","level":2,"anchor":"List"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"List"},{"type":"text","text":" displays a vertical collection of items inside a bordered container. It supports:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Optional title in the border","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Optional footer section","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Single or multi-selection"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Keyboard navigation","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatic scrolling with vie