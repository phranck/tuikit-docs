","anchor":"Column-Alignment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Align column content to leading, center, or trailing:"}]},{"syntax":"swift","type":"codeListing","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"]},{"text":"Keyboard Navigation","level":2,"type":"heading","anchor":"Keyboard-Navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both List and Table support the same keyboard shortcuts:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Key","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Up"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to first item"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to last item"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move up by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Move down by viewport height","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle selection","type":"text"}]}]]],"type":"table","header":"row"},{"text":"Scroll Indicators","level":2,"type":"heading","anchor":"Scroll-Indicators"},{"type":"paragraph","inlineContent":[{"text":"When content ex