Sections","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/Section"},{"type":"text","text":" to group list items with headers and optional footers:"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Settings\", selection: $selected) {","    Section(\"General\") {","        ForEach(generalItems) { item in","            Text(item.name)","        }","    }","    Section(\"Advanced\") {","        ForEach(advancedItems) { item in","            Text(item.name)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Section headers are rendered with secondary foreground color and bold styling above the group.","type":"text"}],"type":"paragraph"},{"anchor":"Badges","level":2,"text":"Badges","type":"heading"},{"inlineContent":[{"text":"Add badges to list rows using the ","type":"text"},{"type":"codeVoice","code":".badge(_:)"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Inbox\", selection: $selected) {","    ForEach(mailboxes) { mailbox in","        Text(mailbox.name)","            .badge(mailbox.unreadCount)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Badges appear right-aligned in the row and support both integer and string values.","type":"text"}],"type":"paragraph"},{"anchor":"List-Modifiers","level":2,"text":"List Modifiers","type":"heading"},{"inlineContent":[{"type":"text","text":"Lists support several TUI-specific modifiers:"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Items\", selection: $selected) {","    ForEach(items) { item in","        Text(item.name)","    }","}",".focusID(\"my-list\")                    \/\/ Explicit focus identifier",".listEmptyPlaceholder(\"Nothing here\")  \/\/ Custom empty state text",".listFooterSeparator(false)            \/\/ Hide footer separator",".disabled(isLoading)                   \/\/ Disable interaction"],"type":"codeListi