{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides two components for displaying collections of data:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"List","type":"text"}],"type":"strong"},{"text":": A vertical collection of arbitrary view content with selection support","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Table"}]},{"text":": A columnar data display with headers and configurable column widths","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both components share the same keyboard navigation and selection infrastructure, providing a consistent user experience."}],"type":"paragraph"},{"anchor":"List","text":"List","level":2,"type":"heading"},{"inlineContent":[{"code":"List","type":"codeVoice"},{"text":" displays a vertical collection of items inside a bordered container. It supports:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional title in the border"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optional footer section"}]}]},{"content":[{"inlineContent":[{"text":"Single or multi-selection","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keyboard navigation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Automatic scrolling with viewport management","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Basic-Usage","text":"Basic Usage","level":3,"type":"heading"},{"syntax":"swift","code":["struct ContentView: View {","    @State var selectedID: String?","    ","    let items = [\"Apple\", \"Banana\", \"Cherry\", \"Date\", \"Elderberry\"]","    ","    var body: some View {","        List(\"Fruits\", selection: $selectedID) {","            ForEach(items, id: \\.self) { item in","                Text(item)","            }","        }","    }","}"],"type":"codeListing"},{"anchor":"With-Footer","text":"With Footer","level":3,"type":"heading"},{"inlineContent":[{"text":"Add action buttons or status text in a footer section:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["List(\"Tasks\", selection: $selectedTask) {","    ForEach(tasks) { task in","        Text(task.title)","    }","} footer: {","    ButtonRow {","        Button(\"Add\") { addTask() }","        Button(\"Remove\") { removeTask() }","    }","}"],"type":"codeListing"},{"anchor":"Multi-Selection","text":"Multi-Selection","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use a "},{"type":"codeVoice","code":"Set"},{"type":"text","text":" binding for multi-selection mode:"}],"type":"paragraph"},{"syntax":"swift","code":["@State var selectedIDs: Set<String> = []","","List(\"Files\", selection: $selectedIDs) {","    ForEach(files) { file in","        HStack {","            Text(file.icon)","            Text(file.name)","        }","    }","}"],"type":"codeListing"},{"anchor":"Visual-States","text":"Visual States","level":3,"type":"heading"},{"inlineContent":[{"text":"List rows display different visual states:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"State","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Appearance","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Focused + Selected","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pulsing accent background"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Focused only"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Highlight background bar"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Selected only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Subtle accent background","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Neither"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Default appearance"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Table","text":"Table","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Table"},{"type":"text","text":" displays tabular data with column headers, alignment, and configurable widths."}],"type":"paragraph"},{"anchor":"Basic-Usage","text":"Basic Usage","level":3,"type":"heading"},{"syntax":"swift","code":["struct FileInfo: Identifiable {","    let id: String","    let name: String","    let size: String","    let modified: String","}","","struct ContentView: View {","    @State var selectedFile: String?","    let files: [FileInfo] = [...]","    ","    var body: some View {","        Table(files, selection: $selectedFile) {","            TableColumn(\"Name\", value: \\.name)","            TableColumn(\"Size\", value: \\.size)","                .width(.fixed(10))","                .alignment(.trailing)","            TableColumn(\"Modified\", value: \\.modified)","        }","    }","}"],"type":"codeListing"},{"anchor":"Column-Configuration","text":"Column Configuration","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Columns support three width modes:"}],"type":"paragraph"},{"syntax":"swift","code":["TableColumn(\"Name\", value: \\.name)","    .width(.flexible)        \/\/ Shares remaining space (default)","","TableColumn(\"Size\", value: \\.size)","    .width(.fixed(12))       \/\/ Exactly 12 characters","","TableColumn(\"Progress\", value: \\.progress)","    .width(.ratio(0.3))      \/\/ 30% of available width"],"type":"codeListing"},{"anchor":"Column-Alignment","text":"Column Alignment","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Align column content to leading, center, or trailing:"}],"type":"paragraph"},{"syntax":"swift","code":["TableColumn(\"Amount\", value: \\.amount)","    .alignment(.trailing)    \/\/ Right-align numbers"],"type":"codeListing"},{"anchor":"Keyboard-Navigation","text":"Keyboard Navigation","level":2,"type":"heading"},{"inlineContent":[{"text":"Both List and Table support the same keyboard shortcuts:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Key"}]}],[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus up (wraps to end)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Down","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move focus down (wraps to start)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to first item"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"End"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Jump to last item"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Page Up","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move up by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Page Down"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Move down by viewport height"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enter \/ Space"}]}],[{"type":"paragraph","inlineContent":[{"text":"Toggle selection","type":"text"}]}]]],"header":"row","type":"table"},{"anchor":"Scroll-Indicators","text":"Scroll Indicators","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When content extends beyond the viewport, scroll indicators appear:"}],"type":"paragraph"},{"syntax":null,"code":["┌─ My List ────────────────────┐","│         ▲ more above         │","│ Item 