{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"text":"bottom-up data flow","type":"text"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","type":"reference","isActive":true}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","type":"reference"}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}]},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"text":"Defining a Preference Key","type":"heading","level":2,"anchor":"Defining-a-Preference-Key"},{"type":"paragraph","inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"defaultValue"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"type":"text","text":": Combines values when multiple children set the same key"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}]},{"text":"Setting a Preference","type":"heading","level":2,"anchor":"Setting-a-Preference"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"code":"PreferenceModifier","type":"codeVoice"},{"type":"text","text":" that calls "},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" function."}]},{"text":"Observing Preferences","type":"heading","level":2,"anchor":"Observing-Preferences"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"text":"The Navigation Title Shortcut","type":"heading","level":2,"anchor":"The-Navigation-Title-Shortcut"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}]},{"text":"How Preferences Flow per Frame","type":"heading","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reset","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Set"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Scope","type":"text"}]},{"text":": ","type":"text"},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Collect"}]},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Discard","type":"text"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"text":"Reduce Strategies","type":"heading","level":2,"anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Strategy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"type":"text","text":" (default)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Counting items, summing heights","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}],"type":"paragraph"}]]]},{"type":"codeListing","syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"topicSections":[{"anchor":"Protocols","title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"]},{"anchor":"Storage","title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Preferences","modules":[{"name":"TUIkit"}]},"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"kind":"article","variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://TUIkit/documentation/TUIkit/StateManagement":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","type":"topic","kind":"article","abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"url":"\/documentation\/tuikit\/statemanagement","role":"article","title":"State Management"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"url":"\/documentation\/tuikit\/focussystem","title":"Focus System","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","role":"article","type":"topic"},"doc://TUIkit/documentation/TUIkit/StatusBarGu