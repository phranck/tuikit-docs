{"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"type":"strong","inlineContent":[{"text":"bottom-up data flow","type":"text"}]},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceKey"}]},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceValues","type":"codeVoice"}]},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"type":"heading","text":"Defining a Preference Key","level":2,"anchor":"Defining-a-Preference-Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}]},{"type":"codeListing","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"defaultValue"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}]},{"type":"heading","text":"Setting a Preference","level":2,"anchor":"Setting-a-Preference"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}]},{"type":"heading","text":"Observing Preferences","level":2,"anchor":"Observing-Preferences"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}]},{"type":"heading","text":"The Navigation Title Shortcut","level":2,"anchor":"The-Navigation-Title-Shortcut"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"NavigationTitleKey","type":"codeVoice"},{"text":" uses the default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"type":"heading","text":"How Preferences Flow per Frame","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reset"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Set"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"type":"codeVoice","code":"PreferenceModifier"},{"text":" views call ","type":"text"},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"text":", which reduces values into the current stack frame","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Scope"}],"type":"strong"},{"text":": ","type":"text"},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Collect","type":"text"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Discard"}],"type":"strong"},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"type":"heading","text":"Reduce Strategies","level":2,"anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strategy"}]}],[{"type":"paragraph","inlineContent":[{"text":"Implementation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use Case"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last value wins","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"type":"text","text":" (default)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additive"}]}],[{"type":"paragraph","inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Counting items, summing heights"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Array collection","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}]}],[{"type":"paragraph","inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}]}]]],"header":"row"},{"type":"codeListing","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"syntax":"swift"}],"ki