":"topic","title":"Theming Guide"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"role":"collectionGroup","title":"Custom Views","url":"\/documentation\/tuikit\/customviews","abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"kind":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"title":"Focus System","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"type":"topic","url":"\/documentation\/tuikit","kind":"symbol","title":"TUIkit","role":"collection"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"abstract":[{"text":"Control border styles, visual appearances, and the color system.","type":"text"}],"type":"topic","title":"Appearance and Colors","url":"\/documentation\/tuikit\/appearanceandcolors","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","kind":"article","role":"article"}}}