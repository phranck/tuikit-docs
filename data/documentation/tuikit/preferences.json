{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"type":"text","text":"bottom-up data flow"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"PreferenceKey","type":"codeVoice"}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceValues"}]},{"type":"text","text":": Type-safe storage that holds all preference values for a scope"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"type":"heading","text":"Defining a Preference Key","level":2,"anchor":"Defining-a-Preference-Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"defaultValue","type":"codeVoice"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}],"type":"strong"},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}]},{"type":"heading","text":"Setting a Preference","level":2,"anchor":"Setting-a-Preference"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"code":".preference(key:value:)","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" that calls ","type":"text"},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function.","type":"text"}]},{"type":"heading","text":"Observing Preferences","level":2,"anchor":"Observing-Preferences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"type":"heading","text":"The Navigation Title Shortcut","level":2,"anchor":"The-Navigation-Title-Shortcut"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference","isActive":true},{"text":" as a built-in preference key with a convenience modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"NavigationTitleKey","type":"codeVoice"},{"text":" uses the default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"type":"heading","text":"How Preferences Flow per Frame","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reset","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Collect","type":"text"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Discard","type":"text"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"type":"heading","text":"Reduce Strategies","level":2,"anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Strategy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}],"type":"paragraph"}]]]},{"type":"codeListing","syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"title":"Preferences"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://TUIkit/documentation/TUIkit/NavigationTitleKey":{"abstract":[{"type":"text","text":"A preference key for the navigation title."}],"url":"\/documentation\/tuikit\/navigationtitlekey","navigatorTitle":[{"text":"NavigationTitleKey","kind":"identifier"}],"type":"topic","role":"symbol","title":"NavigationTitleKey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationTitleKey","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","kind":"symbol"},"doc://TUIkit/documentation/TUIkit/PaletteReference":{"url":"\/documentation\/tuikit\/palettereference","kind":"article","title":"Palette Reference","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","type":"topic","role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"role":"article","url":"\/documentation\/tuikit\/listandtable","kind":"article","title":"List 