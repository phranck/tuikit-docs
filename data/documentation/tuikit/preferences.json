{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides"}],"sections":[],"kind":"article","metadata":{"roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"title":"Preferences","role":"collectionGroup"},"variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"topicSections":[{"title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"],"anchor":"Protocols"},{"title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"],"anchor":"Storage"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"text":"bottom-up data flow","type":"text"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","type":"reference","isActive":true}]},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","type":"reference"}]},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true,"type":"reference"},{"text":": a child view sets ","type":"text"},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Defining a Preference Key","anchor":"Defining-a-Preference-Key","type":"heading"},{"inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"defaultValue","type":"codeVoice"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}],"type":"strong"},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}],"type":"paragraph"},{"level":2,"text":"Setting a Preference","anchor":"Setting-a-Preference","type":"heading"},{"inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"code":".preference(key:value:)","type":"codeVoice"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}],"type":"paragraph"},{"text":"Observing Preferences","type":"heading","level":2,"anchor":"Observing-Preferences"},{"inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}],"type":"paragraph"},{"text":"The Navigation Title Shortcut","type":"heading","level":2,"anchor":"The-Navigation-Title-Shortcut"},{"inlineContent":[{"type":"text","text":"TUIkit provides "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference"},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"text":" uses the default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"type":"heading","anchor":"How-Preferences-Flow-per-Frame","level":2,"text":"How Preferences Flow per Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"RenderLoop.render()"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Set"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"type":"codeVoice","code":"PreferenceModifier"},{"text":" views call ","type":"text"},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"text":", which reduces values into the current stack frame","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Scope"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Collect"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Discard"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"type":"heading","anchor":"Reduce-Strategies","level":2,"text":"Reduce Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Strategy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use Case","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Last value wins"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"text":" (default)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Additive","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Counting items, summing heights"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Array collection"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}]}]]]},{"type":"codeListing","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"syntax":"swift"}]}],"references":{"tuikit-logo.png":{"variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"identifier":"tuikit-logo.png","type":"image","alt":"TUIkit Logo"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"type":"topic","url":"\/documentation\/tuikit\/statemanagement","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"kind":"article","title":"State Management","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement"},"doc://TUIkit/documentation/TUIkit/ImageDecoding":{"kind":"article","type":"topic","url":"\/documentation\/tuikit\/imagedecoding","abstract":[{"text":"Load static PNG and JPEG images safely on macOS and Linux