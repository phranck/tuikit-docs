{"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"generated":true,"title":"Guides","anchor":"Guides"}],"variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"type":"text","text":"bottom-up data flow"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}],"type":"paragraph"},{"inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"}],"type":"strong"},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","type":"reference"}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}]},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"text":"Defining a Preference Key","type":"heading","anchor":"Defining-a-Preference-Key","level":2},{"type":"paragraph","inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"defaultValue"}]},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}]},{"text":"Setting a Preference","type":"heading","anchor":"Setting-a-Preference","level":2},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}]},{"code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" that calls ","type":"text"},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function.","type":"text"}]},{"text":"Observing Preferences","anchor":"Observing-Preferences","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"text":":","type":"text"}]},{"code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"text":"The Navigation Title Shortcut","anchor":"The-Navigation-Title-Shortcut","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"text":" uses the default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"text":"How Preferences Flow per Frame","anchor":"How-Preferences-Flow-per-Frame","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"text":": ","type":"text"},{"code":"RenderLoop.render()","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"type":"text","text":": As the view tree renders top-down, "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" views call "},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"type":"text","text":", which reduces values into the current stack frame"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Collect"}],"type":"strong"},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Discard","type":"text"}]},{"text":": At the start of the next frame, everything resets: stale preferences never persist","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"text":"Reduce Strategies","anchor":"Reduce-Strategies","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Strategy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use Case","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Additive"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Array collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}],"type":"paragraph"}]]]},{"code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing","syntax":"swift"}]}],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"],"anchor":"Protocols","title":"Protocols"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"],"anchor":"Storage","title":"Storage"}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","title":"Preferences"},"references":{"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"title":"Theming Guide","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","kind":"article","role":"article","type":"topic","url":"\/documentation\/tuikit\/themingguide","abstract":[{"text":"Customize the visual appearance of your TUIkit application with palettes.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"abstract":[{"type":"text","text":"Configure the shortcut bar at the bottom of the terminal."}],"url":"\/documentation\/tuikit\/statusbarguide","title":"Status Bar","role":"article","type":"topic","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide"},"tuikit-logo.png":{"identif