{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"type":"text","text":"bottom-up data flow"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PreferenceKey"}],"type":"strong"},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceValues"}]},{"type":"text","text":": Type-safe storage that holds all preference values for a scope"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"type":"heading","anchor":"Defining-a-Preference-Key","text":"Defining a Preference Key","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}]},{"type":"codeListing","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"defaultValue"}]},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}]},{"type":"heading","anchor":"Setting-a-Preference","text":"Setting a Preference","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"type":"codeVoice","code":".preference(key:value:)"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}]},{"type":"heading","anchor":"Observing-Preferences","text":"Observing Preferences","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"type":"heading","anchor":"The-Navigation-Title-Shortcut","text":"The Navigation Title Shortcut","level":2},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true,"type":"reference"},{"text":" as a built-in preference key with a convenience modifier:","type":"text"}]},{"type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}]},{"type":"heading","anchor":"How-Preferences-Flow-per-Frame","text":"How Preferences Flow per Frame","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reset"}]},{"type":"text","text":": "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"text":": As the view tree renders top-down, ","type":"text"},{"type":"codeVoice","code":"PreferenceModifier"},{"text":" views call ","type":"text"},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Collect"}]},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Discard","type":"text"}],"type":"strong"},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically."}]},{"type":"heading","anchor":"Reduce-Strategies","text":"Reduce Strategies","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strategy"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use Case","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Last value wins"}]}],[{"type":"paragraph","inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"text":" (default)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additive"}]}],[{"type":"paragraph","inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Counting items, summing heights"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Array collection","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}]}]]],"type":"table"},{"type":"codeListing","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"title":"Preferences"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIki