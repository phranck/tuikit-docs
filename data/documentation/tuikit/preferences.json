{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"metadata":{"role":"collectionGroup","title":"Preferences","modules":[{"name":"TUIkit"}]},"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"text":"bottom-up data flow","type":"text"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PreferenceKey"}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceValues"}]},{"type":"text","text":": Type-safe storage that holds all preference values for a scope"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"type":"heading","level":2,"text":"Defining a Preference Key","anchor":"Defining-a-Preference-Key"},{"type":"paragraph","inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"defaultValue"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"type":"text","text":": Combines values when multiple children set the same key"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}]},{"type":"heading","level":2,"text":"Setting a Preference","anchor":"Setting-a-Preference"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"code":".preference(key:value:)","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"code":"PreferenceModifier","type":"codeVoice"},{"type":"text","text":" that calls "},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" function."}]},{"type":"heading","level":2,"text":"Observing Preferences","anchor":"Observing-Preferences"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}]},{"type":"heading","level":2,"text":"The Navigation Title Shortcut","anchor":"The-Navigation-Title-Shortcut"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true,"type":"reference"},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"NavigationTitleKey","type":"codeVoice"},{"text":" uses the default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"type":"heading","level":2,"text":"How Preferences Flow per Frame","anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reset","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"type":"codeVoice","code":"RenderLoop.render()"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Set","type":"text"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Scope","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Collect"}]},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Discard","type":"text"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically."}]},{"type":"heading","level":2,"text":"Reduce Strategies","anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Strategy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"type":"text","text":" (default)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}],"type":"paragraph"}]]],"header":"row"},{"type":"codeListing","syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"url":"\/documentation\/tuikit\/palettereference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","title":"Palette Reference","kind":"article","type":"topic","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","title":"Status Bar","role":"article","url":"\/documentation\/tuikit\/statusbarguide","type":"topic","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"kind":"article"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"url":"\/documentation\/tuikit\/focussystem","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","title":"Focus System","kind":"article","type":"topic","abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"role":"article"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"title":"Theming Guide","kind":"article","role":"article","type":"top