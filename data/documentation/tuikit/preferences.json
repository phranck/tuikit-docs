{"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","roleHeading":"API Collection","title":"Preferences"},"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"topicSections":[{"anchor":"Protocols","title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"]},{"anchor":"Storage","title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"]}],"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"text":"bottom-up data flow","type":"text"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","isActive":true,"type":"reference"}]},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","isActive":true}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference","isActive":true},{"text":": a child view sets ","type":"text"},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"text":"Defining a Preference Key","level":2,"anchor":"Defining-a-Preference-Key","type":"heading"},{"inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"defaultValue","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}],"type":"strong"},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}],"type":"paragraph"},{"text":"Setting a Preference","level":2,"anchor":"Setting-a-Preference","type":"heading"},{"inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"type":"codeVoice","code":".preference(key:value:)"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"type":"codeVoice","code":"PreferenceModifier"},{"text":" that calls ","type":"text"},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function.","type":"text"}],"type":"paragraph"},{"text":"Observing Preferences","level":2,"anchor":"Observing-Preferences","type":"heading"},{"inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}],"type":"paragraph"},{"text":"The Navigation Title Shortcut","level":2,"anchor":"The-Navigation-Title-Shortcut","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}],"type":"paragraph"},{"text":"How Preferences Flow per Frame","level":2,"anchor":"How-Preferences-Flow-per-Frame","type":"heading"},{"inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"text":": ","type":"text"},{"code":"RenderLoop.render()","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Set","type":"text"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"type":"text","text":": "},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Collect"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Discard"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically."}],"type":"paragraph"},{"text":"Reduce Strategies","level":2,"anchor":"Reduce-Strategies","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Strategy"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Implementation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last value wins","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"type":"text","text":" (default)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Counting items, summing heights","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Array collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"kind":"article","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"tuikit-logo.png":{"type":"image","identifier":"tuikit-logo.png","alt":"TUIkit Logo","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}]},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"kind":"article","type":"topic","url":"\/documentation\/tuikit\/appearanceandcolors","title":"Appearance and Colors","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"role":"article","title":"State Management","url":"\/documentation\/tuikit\/statemanagement","kind":"article","identifier":