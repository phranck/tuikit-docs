{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"text":"bottom-up data flow","type":"text"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"PreferenceKey","type":"codeVoice"}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceValues","type":"codeVoice"}]},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A built-in example is ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference","isActive":true},{"text":": a child view sets ","type":"text"},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}]},{"type":"heading","anchor":"Defining-a-Preference-Key","level":2,"text":"Defining a Preference Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}]},{"type":"codeListing","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"defaultValue"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}]},{"type":"heading","anchor":"Setting-a-Preference","level":2,"text":"Setting a Preference"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"code":".preference(key:value:)","type":"codeVoice"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}]},{"type":"heading","anchor":"Observing-Preferences","level":2,"text":"Observing Preferences"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"type":"heading","anchor":"The-Navigation-Title-Shortcut","level":2,"text":"The Navigation Title Shortcut"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference"},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"text":" uses the default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"type":"heading","anchor":"How-Preferences-Flow-per-Frame","level":2,"text":"How Preferences Flow per Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reset","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"RenderLoop.render()","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Set","type":"text"}]},{"type":"text","text":": As the view tree renders top-down, "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" views call "},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"type":"text","text":", which reduces values into the current stack frame"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Scope","type":"text"}],"type":"strong"},{"text":": ","type":"text"},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Collect","type":"text"}]},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Discard","type":"text"}],"type":"strong"},{"text":": At the start of the next frame, everything resets: stale preferences never persist","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"type":"heading","anchor":"Reduce-Strategies","level":2,"text":"Reduce Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Strategy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Array collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}],"type":"paragraph"}]]]},{"type":"codeListing","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"syntax":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"seeAlsoSections":[{"title":"Guides","generated":true,"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"],"anchor":"Guides"}],"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"metadata":{"title":"Preferences","role":"collectionGroup","modules":[{"name":"TUIkit"}]},"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"references":{"doc://TUIkit/documentation/TUIkit/NavigationTitleKey":{"role":"symbol","url":"\/documentation\/tuikit\/navigationtitlekey","title":"NavigationTitleKey","abstract":[{"type":"text","text":"A preference key for the navigation title."}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationTitleKey","kind":"identifier"}],"navigatorTitle":[{"text":"NavigationTitleKey","kind":"identifier"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"kind":"article","abstract":[{"text":"Control border styles, visual appearances, and the color system.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","type":"topic","role":"article","title":"Appearance and Colors","url":"\/documentation\/tuikit\/appearanceandcolors"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"type":"topic","abstract":[{"type":"text","text":"Build scrollable, navigable data collections with keyboard support."}],"title":"List and Table Components","role":"article","url":"\/documentation\/tuikit\/listan