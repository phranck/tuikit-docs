{"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","topicSections":[{"title":"Protocols","anchor":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"]},{"title":"Storage","anchor":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"title":"Preferences","roleHeading":"API Collection"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"bottom-up data flow"}]},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","isActive":true,"type":"reference"}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"text":": a child view sets ","type":"text"},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"anchor":"Defining-a-Preference-Key","level":2,"type":"heading","text":"Defining a Preference Key"},{"inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"defaultValue"}]},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}],"type":"strong"},{"text":": Combines values when multiple children set the same key","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}],"type":"paragraph"},{"anchor":"Setting-a-Preference","level":2,"type":"heading","text":"Setting a Preference"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"code":".preference(key:value:)","type":"codeVoice"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}]},{"type":"heading","anchor":"Observing-Preferences","level":2,"text":"Observing Preferences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}]},{"type":"heading","anchor":"The-Navigation-Title-Shortcut","level":2,"text":"The Navigation Title Shortcut"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference"},{"text":" as a built-in preference key with a convenience modifier:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}]},{"type":"heading","level":2,"anchor":"How-Preferences-Flow-per-Frame","text":"How Preferences Flow per Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Reset","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Collect","type":"text"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Discard","type":"text"}]},{"text":": At the start of the next frame, everything resets: stale preferences never persist","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"type":"heading","level":2,"anchor":"Reduce-Strategies","text":"Reduce Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Strategy"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Implementation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last value wins","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"type":"text","text":" (default)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Additive"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Counting items, summing heights","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}],"type":"paragraph"}]]]},{"type":"codeListing","syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"seeAlsoSections":[{"title":"Guides","generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"references":{"doc://TUIkit/documentation/TUIkit/NavigationTitleKey":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","abstract":[{"text":"A preference key for the navigation title.","type":"text"}],"title":"NavigationTitleKey","kind":"symbol","type":"topic","url":"\/documentation\/tuikit\/navigationtitlekey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationTitleKey","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"NavigationTitleKey","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"type":"topic","kind":"article","role":"collectionGroup","title":"Keyboard Shortcuts","url":"\/documentation\/tuikit\/keybo