ues"}],"role":"symbol","kind":"symbol","url":"\/documentation\/tuikit\/preferencevalues","abstract":[{"type":"text","text":"A collection of preference values propagated up the view hierarchy."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PreferenceValues"}],"title":"PreferenceValues","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"kind":"article","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"type":"topic","url":"\/documentation\/tuikit\/layoutsystem","title":"Layout System"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"url":"\/documentation\/tuikit\/listandtable","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"title":"List and Table Components","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/NavigationTitleKey":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationTitleKey","kind":"identifier"}],"abstract":[{"text":"A preference key for the navigation title.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","title":"NavigationTitleKey","navigatorTitle":[{"text":"NavigationTitleKey","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/tuikit\/navigationtitlekey","type":"topic","role":"symbol"},"doc://TUIkit/documentation/TUIkit/PreferenceKey":{"role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PreferenceKey","kind":"identifier"}],"abstract":[{"type":"text","text":"A key for defining preference values that propagate up the view hierarchy."}],"navigatorTitle":[{"text"