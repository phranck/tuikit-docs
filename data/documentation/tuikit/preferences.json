{"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"title":"Preferences"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"type":"strong","inlineContent":[{"text":"bottom-up data flow","type":"text"}]},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceKey","type":"codeVoice"}]},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceValues","type":"codeVoice"}]},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference"},{"text":": a child view sets ","type":"text"},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"text":"Defining a Preference Key","anchor":"Defining-a-Preference-Key","level":2,"type":"heading"},{"inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"defaultValue","type":"codeVoice"}]},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}],"type":"paragraph"},{"text":"Setting a Preference","anchor":"Setting-a-Preference","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"type":"codeVoice","code":".preference(key:value:)"},{"type":"text","text":" modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" that calls ","type":"text"},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function.","type":"text"}],"type":"paragraph"},{"text":"Observing Preferences","anchor":"Observing-Preferences","level":2,"type":"heading"},{"inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}],"type":"paragraph"},{"text":"The Navigation Title Shortcut","anchor":"The-Navigation-Title-Shortcut","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}],"type":"paragraph"},{"text":"How Preferences Flow per Frame","anchor":"How-Preferences-Flow-per-Frame","level":2,"type":"heading"},{"inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"type":"text","text":": "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Set"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Scope","type":"text"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Collect"}]},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Discard","type":"text"}],"type":"strong"},{"text":": At the start of the next frame, everything resets: stale preferences never persist","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}],"type":"paragraph"},{"text":"Reduce Strategies","anchor":"Reduce-Strategies","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Strategy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Implementation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use Case"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last value wins","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"type":"text","text":" (default)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Additive","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Counting items, summing heights"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Array collection","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}]}]]],"header":"row","type":"table"},{"type":"codeListing","syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}]}],"references":{"doc://TUIkit/documentation/TUIkit/StateManagement":{"url":"\/documentation\/tuikit\/statemanagement","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","type":"topic","role":"article","title":"State Management","kind":"article","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}]},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"url":"\/documentation\/tuikit\/layoutsystem","role":"article","type":"topic","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"title":"Layout System","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","kind":"article"},"doc://TUIkit/documentation/TUIkit":{"images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"type":"topic","title":"TUIkit","role":"collection","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","kind":"symbol","url":"\/documentation\/tuikit"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"ti