{"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"identifier":{"url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences","interfaceLanguage":"swift"},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","modules":[{"name":"TUIkit"}],"title":"Preferences"},"seeAlsoSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides","anchor":"Guides","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"sections":[],"kind":"article","topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"],"title":"Protocols","anchor":"Protocols"},{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"],"title":"Storage","anchor":"Storage"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"type":"text","text":"bottom-up data flow"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","type":"reference","isActive":true}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","isActive":true}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true,"type":"reference"},{"text":": a child view sets ","type":"text"},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Defining-a-Preference-Key","text":"Defining a Preference Key","type":"heading"},{"inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}],"type":"paragraph"},{"code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"defaultValue","type":"codeVoice"}]},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}],"type":"paragraph"},{"level":2,"anchor":"Setting-a-Preference","text":"Setting a Preference","type":"heading"},{"inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}],"type":"paragraph"},{"level":2,"anchor":"Observing-Preferences","type":"heading","text":"Observing Preferences"},{"inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"The-Navigation-Title-Shortcut","type":"heading","text":"The Navigation Title Shortcut"},{"inlineContent":[{"text":"TUIkit provides ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"text":" as a built-in preference key with a convenience modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}],"type":"paragraph"},{"text":"How Preferences Flow per Frame","anchor":"How-Preferences-Flow-per-Frame","level":2,"type":"heading"},{"inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reset"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Set","type":"text"}]},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Scope","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Collect"}],"type":"strong"},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Discard","type":"text"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}],"type":"paragraph"},{"text":"Reduce Strategies","anchor":"Reduce-Strategies","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}],"type":"paragraph"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strategy"}]}],[{"type":"paragraph","inlineContent":[{"text":"Implementation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use Case","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last value wins","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"text":" (default)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Additive","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Counting items, summing heights"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Array collection"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}]}],[{"type":"paragraph","inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}]}]]],"type":"table"},{"syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/ImageDecoding":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","title":"Image Decoding","kind":"article","url":"\/documentation\/tuikit\/imagedecoding","abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"role":"collectionGroup"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"url":"\/documentation\/tuikit\/statusbarguide","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","title":"Status Bar","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"kind":"article","role":"article"},"doc://TUIkit/documentation/TU