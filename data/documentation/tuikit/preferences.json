{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"title":"Preferences"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"type":"text","text":"bottom-up data flow"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","isActive":true}],"type":"strong"},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"}]},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}],"type":"strong"},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"text":": a child view sets ","type":"text"},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"anchor":"Defining-a-Preference-Key","level":2,"text":"Defining a Preference Key","type":"heading"},{"inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}],"type":"paragraph"},{"code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"defaultValue","type":"codeVoice"}],"type":"strong"},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}],"type":"strong"},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}],"type":"paragraph"},{"anchor":"Setting-a-Preference","level":2,"text":"Setting a Preference","type":"heading"},{"inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}],"type":"paragraph"},{"anchor":"Observing-Preferences","level":2,"text":"Observing Preferences","type":"heading"},{"inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result.","type":"text"}],"type":"paragraph"},{"anchor":"The-Navigation-Title-Shortcut","level":2,"text":"The Navigation Title Shortcut","type":"heading"},{"inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}],"type":"paragraph"},{"code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}],"type":"paragraph"},{"anchor":"How-Preferences-Flow-per-Frame","level":2,"text":"How Preferences Flow per Frame","type":"heading"},{"inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Reset","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Set","type":"text"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Scope"}],"type":"strong"},{"text":": ","type":"text"},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Collect","type":"text"}]},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Discard"}],"type":"strong"},{"text":": At the start of the next frame, everything resets: stale preferences never persist","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}],"type":"paragraph"},{"anchor":"Reduce-Strategies","level":2,"text":"Reduce Strategies","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Strategy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use Case","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Protocols","title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"]},{"anchor":"Storage","title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"]}],"sections":[],"seeAlsoSections":[{"anchor":"Guides","generated":true,"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"type":"topic","title":"Palette Reference","role":"collectionGroup","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}],"kind":"article","url":"\/documentation\/tuikit\/palettereference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference"},"doc://TUIkit/documentation/TUIkit/PreferenceValues":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PreferenceValues"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","abstract":[{"type":"text","text":"A collection of preference values propagated up the view hierarchy."}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PreferenceValues"}],"role":"symbol","kind":"symbol","title":"PreferenceValues","url":"\/documentation\/tuikit\/preferencevalues"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","role":"article","title":"Status Bar","url":"\/documentation\/tuikit\/statusbarguide","type":"topic","abstract":[{"type":"text","text":"Configure the shortcut bar at the bottom of the terminal."}]},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","kind":"article","abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"type":"topic","title":"Focus System","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit":{"images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","url":"\/documentation\/tuikit","kind":"symbol","type":"topic","role":"collection","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"title":"TUIkit"},"doc://TUIkit/documentation/TUIkit/NavigationTitleKey":{"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"NavigationTitleKey"}],"abstract":[{"type":"text","text":"A preference key for the navigation title."}],"navigatorTitle":[{"kind":"identifier","text":"NavigationTitleKey"}],"title":"NavigationTitleKey","url":"\/documentation\/tuikit\/navigationtitlekey"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"abstract":[{"type":"text","text":"Build your own views by composing existing ones or creating custom view modifiers."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","url":"\/documentation\/tuikit\/customviews","role":"collectionGroup","type":"topic","kind":"article","title":"Custom Views"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"role":"article","title":"State Management","kind":"article","url":"\/documentation\/tuikit\/statemanagement"},"tuikit-logo.png":{"alt":"TUIkit Logo","identifier":"tuikit-logo.png","variants":[{"traits":["1x","light"],"url":"\/images\/TUIkit\/tuikit-logo.png"}],"type":"image"},"doc://TUIkit/documentation/TUIkit/PreferenceKey":{"kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PreferenceKey"}],"url":"\/documentation\/tuikit\/preferencekey","navigatorTitle":[{"kind":"identifier","text":"PreferenceKey"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"A key for defining preference values that propagate up the view hierarchy."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","title":"PreferenceKey"},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","kind":"article","title":"List and Table Components","url":"\/documentation\/tuikit\/listandtable","role":"article","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/ImageDecoding":{"kind":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}],"title":"Image Decoding","role":"collectionGroup","url":"\/documentation\/tuikit\/imagedecoding"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"url":"\/documentation\/tuikit\/keyboardshortcuts","type":"topic","role":"collectionGroup","title":"Keyboard Shortcuts","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","abstract":[{"text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers.","type":"text"}],"kind":"article"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","role":"article","kind":"article","title":"Layout System","url":"\/documentation\/tuikit\/layoutsystem"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"title":"Appearance and Colors","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","url":"\/documentation\/tuikit\/appearanceandcolors","abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"type":"topic","role":"article","kind":"article"},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"abstract":[{"text":"Customize the visual appearance of your TUIkit application with palettes.","type":"text"}],"url":"\/documentation\/tuikit\/themingguide","role":"article","title":"Theming Guide","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","kind":"article","type":"topic"}}}