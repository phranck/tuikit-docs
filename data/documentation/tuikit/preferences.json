{"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"type":"text","text":"bottom-up data flow"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceKey","type":"codeVoice"}]},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceValues","type":"codeVoice"}]},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}],"type":"strong"},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"anchor":"Defining-a-Preference-Key","level":2,"text":"Defining a Preference Key","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}]},{"code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"defaultValue","type":"codeVoice"}],"type":"strong"},{"text":": Returned when no child has set this preference","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}]},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}]},{"anchor":"Setting-a-Preference","level":2,"text":"Setting a Preference","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}]},{"code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}]},{"anchor":"Observing-Preferences","level":2,"text":"Observing Preferences","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"anchor":"The-Navigation-Title-Shortcut","level":2,"text":"The Navigation Title Shortcut","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"NavigationTitleKey","type":"codeVoice"},{"type":"text","text":" uses the default "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}]},{"anchor":"How-Preferences-Flow-per-Frame","level":2,"text":"How Preferences Flow per Frame","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reset"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"RenderLoop.render()"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Set"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Scope"}],"type":"strong"},{"text":": ","type":"text"},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Collect","type":"text"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Discard","type":"text"}],"type":"strong"},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"anchor":"Reduce-Strategies","level":2,"text":"Reduce Strategies","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}]},{"rows":[[[{"inlineContent":[{"text":"Strategy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"type":"text","text":" (default)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"metadata":{"modules":[{"name":"TUIkit"}],"role":"collectionGroup","title":"Preferences"},"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://TUIkit/documentation/TUIkit/FocusSystem":{"role":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","title":"Focus System","abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"kind":"article","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"type":"topic","kind":"article","abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}],"title":"State Management","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","url":"\/documentation\/tuikit\/statemanagement"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"url":"\/documentation\/tuikit\/layoutsystem","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","kind":"article","role":"article","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"title":"Layout System","type":"topic"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"title":"Appearance and Colors","abstract":[{"text":"Control border styles, visual appearanc