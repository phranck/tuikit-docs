{"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"topicSections":[{"identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"],"anchor":"Protocols","title":"Protocols"},{"anchor":"Storage","title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"]}],"abstract":[{"text":"Pass data from child views up to their ancestors.","type":"text"}],"metadata":{"role":"collectionGroup","modules":[{"name":"TUIkit"}],"roleHeading":"API Collection","title":"Preferences"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"type":"strong","inlineContent":[{"text":"bottom-up data flow","type":"text"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The system mirrors SwiftUI’s preference API and consists of three parts:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"}]},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","isActive":true}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}]}]}]},{"inlineContent":[{"text":"A built-in example is ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"text":": a child view sets ","type":"text"},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Defining a Preference Key","anchor":"Defining-a-Preference-Key","level":2},{"inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}],"type":"paragraph"},{"type":"codeListing","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"defaultValue","type":"codeVoice"}]},{"text":": Returned when no child has set this preference","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}]},{"inlineContent":[{"type":"text","text":"The default "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}],"type":"paragraph"},{"type":"heading","text":"Setting a Preference","anchor":"Setting-a-Preference","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"type":"codeVoice","code":".preference(key:value:)"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" that calls ","type":"text"},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function.","type":"text"}]},{"level":2,"type":"heading","text":"Observing Preferences","anchor":"Observing-Preferences"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"level":2,"type":"heading","text":"The Navigation Title Shortcut","anchor":"The-Navigation-Title-Shortcut"},{"type":"paragraph","inlineContent":[{"text":"TUIkit provides ","type":"text"},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference","isActive":true},{"text":" as a built-in preference key with a convenience modifier:","type":"text"}]},{"syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"text":" uses the default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"text":"How Preferences Flow per Frame","type":"heading","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"type":"text","text":": "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Set"}],"type":"strong"},{"text":": As the view tree renders top-down, ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" views call ","type":"text"},{"code":"setValue(_:forKey:)","type":"codeVoice"},{"text":", which reduces values into the current stack frame","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Scope","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Collect","type":"text"}]},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Discard"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"type":"heading","level":2,"text":"Reduce Strategies","anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Strategy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Implementation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use Case"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last value wins","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Titles, labels: deepest child wins"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Counting items, summing heights"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Array collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}],"type":"paragraph"}]]],"header":"row"},{"syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing"}]}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"references":{"doc://TUIkit/documentation/TUIkit/FocusSystem":{"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"role":"article","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","type":"topic","title":"Focus System","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit":{"kind":"symbol","title":"TUIkit","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift.","type":"text"}],"role":"collection","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card