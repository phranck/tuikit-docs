ikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"kind":"symbol","role":"collection"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"type":"topic","url":"\/documentation\/tuikit\/layoutsystem","title":"Layout System","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","title":"Status Bar","type":"topic","role":"article","kind":"article","abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"url":"\/documentation\/tuikit\/statusbarguide"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"type":"topic","url":"\/documentation\/tuikit\/statemanagement","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"title":"State Management","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","kind":"article","role":"article"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"url":"\/documentation\/tuikit\/keyboardshortcuts","kind":"article","type":"topic","title":"Keyboard Shortcuts","abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"role":"collectionGroup","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts"}}}