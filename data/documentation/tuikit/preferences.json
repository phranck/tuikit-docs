":[{"type":"text","text":"A preference key for the navigation title."}],"kind":"symbol","url":"\/documentation\/tuikit\/navigationtitlekey","title":"NavigationTitleKey","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationTitleKey","kind":"identifier"}],"navigatorTitle":[{"text":"NavigationTitleKey","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/ListAndTable":{"type":"topic","abstract":[{"text":"Build scrollable, navigable data collections with keyboard support.","type":"text"}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","title":"List and Table Components","kind":"article","url":"\/documentation\/tuikit\/listandtable","role":"article"},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"abstract":[{"type":"text","text":"Navigate between interactive elements using the keyboard."}],"title":"Focus System","role":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","kind":"article","url":"\/documentation\/tuikit\/focussystem"},"doc://TUIkit/documentation/TUIkit/LayoutSystem":{"title":"Layout System","type":"topic","abstract":[{"type":"text","text":"Understand the two-pass layout used by stacks and other layout containers."}],"kind":"article","url":"\/documentation\/tuikit\/layoutsystem","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem"}}}