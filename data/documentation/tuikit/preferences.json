{"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"metadata":{"roleHeading":"API Collection","role":"collectionGroup","title":"Preferences","modules":[{"name":"TUIkit"}]},"kind":"article","topicSections":[{"anchor":"Protocols","title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"]},{"anchor":"Storage","title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"]}],"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"type":"text","text":"bottom-up data flow"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","isActive":true}],"type":"strong"},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","type":"reference"}],"type":"strong"},{"type":"text","text":": Type-safe storage that holds all preference values for a scope"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}]},{"text":": Stack-based collector that manages preference contexts per render pass","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A built-in example is ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"text":": a child view sets ","type":"text"},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}]},{"type":"heading","level":2,"anchor":"Defining-a-Preference-Key","text":"Defining a Preference Key"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"defaultValue"}]},{"type":"text","text":": Returned when no child has set this preference"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}]},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}]},{"type":"heading","level":2,"anchor":"Setting-a-Preference","text":"Setting a Preference"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"code":".preference(key:value:)","type":"codeVoice"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"type":"codeVoice","code":"PreferenceModifier"},{"text":" that calls ","type":"text"},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" function.","type":"text"}]},{"anchor":"Observing-Preferences","type":"heading","text":"Observing Preferences","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"anchor":"The-Navigation-Title-Shortcut","type":"heading","text":"The Navigation Title Shortcut","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}]},{"type":"heading","text":"How Preferences Flow per Frame","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Reset","type":"text"}],"type":"strong"},{"type":"text","text":": "},{"code":"RenderLoop.render()","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"type":"text","text":", clearing all callbacks and resetting the stack to a single empty context"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Set","type":"text"}]},{"type":"text","text":": As the view tree renders top-down, "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" views call "},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"type":"text","text":", which reduces values into the current stack frame"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"type":"text","text":": "},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Collect","type":"text"}]},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Discard","type":"text"}],"type":"strong"},{"text":": At the start of the next frame, everything resets: stale preferences never persist","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically."}]},{"type":"heading","text":"Reduce Strategies","level":2,"anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Strategy"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Implementation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use Case","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Additive"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value += nextValue()","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Counting items, summing heights","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Array collection"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}],"type":"paragraph"}]]],"type":"table"},{"code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"title":"Appearance and Colors","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Control border styles, visual appearances, and the color system."}],"url":"\/documentation\/tuikit\/appearanceandcolors"},"doc://TUIkit/documentation/TUIkit":{"type":"topic","url":"\/documentation\/tuikit","role":"collection","kind":"symbol","images":[{"identifier":"tuikit-logo.png","type":"icon"},{"identifier":"tuikit-logo.png","type":"card"}],"title":"TUIkit","abstract":[{"text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in S