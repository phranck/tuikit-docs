{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"],"title":"Protocols"},{"anchor":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"],"title":"Storage"}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"title":"Guides"}],"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"text":"bottom-up data flow","type":"text"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","type":"reference"}]},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues","isActive":true,"type":"reference"}]},{"type":"text","text":": Type-safe storage that holds all preference values for a scope"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"PreferenceStorage"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":": a child view sets "},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}]},{"anchor":"Defining-a-Preference-Key","type":"heading","text":"Defining a Preference Key","level":2},{"type":"paragraph","inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"defaultValue"}]},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}],"type":"strong"},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies."}]},{"anchor":"Setting-a-Preference","type":"heading","text":"Setting a Preference","level":2},{"inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"code":".preference(key:value:)","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Under the hood, this wraps the view in a "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" that calls "},{"type":"codeVoice","code":"preferences.setValue(_:forKey:)"},{"type":"text","text":" during rendering. The value is reduced into the current scope using the key’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Observing Preferences","anchor":"Observing-Preferences"},{"inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The Navigation Title Shortcut","anchor":"The-Navigation-Title-Shortcut"},{"inlineContent":[{"type":"text","text":"TUIkit provides "},{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}],"type":"paragraph"},{"syntax":"swift","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"NavigationTitleKey","type":"codeVoice"},{"type":"text","text":" uses the default "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}]},{"type":"heading","text":"How Preferences Flow per Frame","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Reset"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"RenderLoop.render()"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"preferences.beginRenderPass()"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"type":"text","text":": As the view tree renders top-down, "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" views call "},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"type":"text","text":", which reduces values into the current stack frame"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Scope"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Collect"}],"type":"strong"},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Discard"}],"type":"strong"},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically."}]},{"type":"heading","text":"Reduce Strategies","level":2,"anchor":"Reduce-Strategies"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Strategy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Implementation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use Case","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last value wins"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"text":" (default)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Additive","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Counting items, summing heights","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Array collection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gathering menu items, breadcrumbs","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"syntax":"swift","type":"codeListing","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}]}],"variants":[{"paths":["\/documentation\/tuikit\/preferences"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Preferences","roleHeading":"API Collection","modules":[{"name":"TUIkit"}],"role":"collectionGroup"},"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"references":{"doc://TUIkit/documentation/TUIkit/StateManagement":{"type":"topic","kind":"article","role":"article","title":"State Management","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","url":"\/documentation\/tuikit\/statemanagement","abstract":[{"text":"Manage reactive state in your TUIkit application.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/PreferenceKey":{"kind":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","type":"topic","role":"symbol","abstract":[{"text":"A key for defining preference values that propagate up the view hierarchy.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier