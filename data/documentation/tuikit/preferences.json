{"sections":[],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"TUIkit’s preference system enables ","type":"text"},{"inlineContent":[{"type":"text","text":"bottom-up data flow"}],"type":"strong"},{"text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"}]},{"type":"text","text":": Protocol that defines a named value type with a default and a reduce strategy"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"}],"type":"strong"},{"text":": Type-safe storage that holds all preference values for a scope","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A built-in example is ","type":"text"},{"isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference"},{"text":": a child view sets ","type":"text"},{"code":".navigationTitle(\"Settings\")","type":"codeVoice"},{"text":", and the enclosing navigation container reads that preference to render the title bar.","type":"text"}]},{"type":"heading","level":2,"anchor":"Defining-a-Preference-Key","text":"Defining a Preference Key"},{"type":"paragraph","inlineContent":[{"text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"defaultValue"}]},{"text":": Returned when no child has set this preference","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(value:nextValue:)"}]},{"type":"text","text":": Combines values when multiple children set the same key"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}]},{"type":"heading","level":2,"anchor":"Setting-a-Preference","text":"Setting a Preference"},{"type":"paragraph","inlineContent":[{"text":"Child views publish a preference using the ","type":"text"},{"type":"codeVoice","code":".preference(key:value:)"},{"text":" modifier:","type":"text"}]},{"type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" that calls ","type":"text"},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function.","type":"text"}]},{"text":"Observing Preferences","type":"heading","level":2,"anchor":"Observing-Preferences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Ancestor views react to collected preferences using "},{"type":"codeVoice","code":".onPreferenceChange(_:perform:)"},{"type":"text","text":":"}]},{"type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"text":"The Navigation Title Shortcut","type":"heading","level":2,"anchor":"The-Navigation-Title-Shortcut"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"isActive":true,"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey"},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"text":" uses the default ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" (last value wins), so the deepest child’s title takes precedence.","type":"text"}]},{"text":"How Preferences Flow per Frame","anchor":"How-Preferences-Flow-per-Frame","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"text":": ","type":"text"},{"code":"RenderLoop.render()","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"type":"text","text":": As the view tree renders top-down, "},{"type":"codeVoice","code":"PreferenceModifier"},{"type":"text","text":" views call "},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"type":"text","text":", which reduces values into the current stack frame"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Scope","type":"text"}]},{"text":": ","type":"text"},{"code":"OnPreferenceChangeModifier","type":"codeVoice"},{"text":" pushes a new context before rendering its subtree, isolating child preferences","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Collect"}]},{"type":"text","text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Discard"}]},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically.","type":"text"}]},{"text":"Reduce Strategies","anchor":"Reduce-Strategies","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" function determines how multiple children’s values combine. Common patterns:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strategy"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use Case"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Last value wins"}]}],[{"type":"paragraph","inlineContent":[{"code":"value = nextValue()","type":"codeVoice"},{"type":"text","text":" (default)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}]}],[{"type":"paragraph","inlineContent":[{"text":"Counting items, summing heights","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Array collection","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"value.append(contentsOf: nextValue())","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}]}]]],"header":"row"},{"type":"codeListing","syntax":"swift","code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"title":"Protocols","anchor":"Prot