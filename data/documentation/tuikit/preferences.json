{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"TUIkit’s preference system enables "},{"type":"strong","inlineContent":[{"text":"bottom-up data flow","type":"text"}]},{"type":"text","text":": the reverse of environment values. While the environment passes data down from parent to child, preferences let child views publish values that ancestors can observe and react to."}],"type":"paragraph"},{"inlineContent":[{"text":"The system mirrors SwiftUI’s preference API and consists of three parts:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey","isActive":true,"type":"reference"}]},{"text":": Protocol that defines a named value type with a default and a reduce strategy","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"}],"type":"strong"},{"type":"text","text":": Type-safe storage that holds all preference values for a scope"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"PreferenceStorage","type":"codeVoice"}]},{"type":"text","text":": Stack-based collector that manages preference contexts per render pass"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A built-in example is "},{"type":"reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","isActive":true},{"type":"text","text":": a child view sets "},{"type":"codeVoice","code":".navigationTitle(\"Settings\")"},{"type":"text","text":", and the enclosing navigation container reads that preference to render the title bar."}],"type":"paragraph"},{"text":"Defining a Preference Key","type":"heading","anchor":"Defining-a-Preference-Key","level":2},{"inlineContent":[{"type":"text","text":"A preference key declares what type of value it carries and how multiple values from sibling children are combined:"}],"type":"paragraph"},{"code":["struct CounterKey: PreferenceKey {","    static let defaultValue: Int = 0","","    static func reduce(value: inout Int, nextValue: () -> Int) {","        value += nextValue()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"defaultValue"}],"type":"strong"},{"type":"text","text":": Returned when no child has set this preference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"reduce(value:nextValue:)","type":"codeVoice"}],"type":"strong"},{"text":": Combines values when multiple children set the same key","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" implementation simply takes the last value. Override it when you need additive behavior (summing counts), array collection, or other merge strategies.","type":"text"}],"type":"paragraph"},{"text":"Setting a Preference","type":"heading","anchor":"Setting-a-Preference","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Child views publish a preference using the "},{"type":"codeVoice","code":".preference(key:value:)"},{"type":"text","text":" modifier:"}]},{"type":"codeListing","code":["struct ItemView: View {","    var body: some View {","        Text(\"Item\")","            .preference(key: CounterKey.self, value: 1)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Under the hood, this wraps the view in a ","type":"text"},{"code":"PreferenceModifier","type":"codeVoice"},{"text":" that calls ","type":"text"},{"code":"preferences.setValue(_:forKey:)","type":"codeVoice"},{"text":" during rendering. The value is reduced into the current scope using the key’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function.","type":"text"}]},{"type":"heading","level":2,"anchor":"Observing-Preferences","text":"Observing Preferences"},{"type":"paragraph","inlineContent":[{"text":"Ancestor views react to collected preferences using ","type":"text"},{"code":".onPreferenceChange(_:perform:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["struct ItemList: View {","    var body: some View {","        VStack {","            ItemView()","            ItemView()","            ItemView()","        }","        .onPreferenceChange(CounterKey.self) { totalCount in","            \/\/ totalCount == 3 (three children each set value: 1, additive reduce)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modifier pushes a new preference context, renders all children (which set their preferences), pops the context, and fires the callback with the accumulated result."}]},{"type":"heading","level":2,"anchor":"The-Navigation-Title-Shortcut","text":"The Navigation Title Shortcut"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TUIkit provides "},{"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","type":"reference","isActive":true},{"type":"text","text":" as a built-in preference key with a convenience modifier:"}]},{"type":"codeListing","code":["struct SettingsPage: View {","    var body: some View {","        VStack {","            Text(\"App settings go here\")","        }","        .navigationTitle(\"Settings\")","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTitleKey"},{"type":"text","text":" uses the default "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" (last value wins), so the deepest child’s title takes precedence."}],"type":"paragraph"},{"text":"How Preferences Flow per Frame","type":"heading","level":2,"anchor":"How-Preferences-Flow-per-Frame"},{"inlineContent":[{"text":"Preferences are collected fresh every frame. Here’s the lifecycle within a single render pass:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Reset"}],"type":"strong"},{"text":": ","type":"text"},{"code":"RenderLoop.render()","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"preferences.beginRenderPass()","type":"codeVoice"},{"text":", clearing all callbacks and resetting the stack to a single empty context","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Set"}]},{"text":": As the view tree renders top-down, ","type":"text"},{"type":"codeVoice","code":"PreferenceModifier"},{"text":" views call ","type":"text"},{"type":"codeVoice","code":"setValue(_:forKey:)"},{"text":", which reduces values into the current stack frame","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Scope","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"OnPreferenceChangeModifier"},{"type":"text","text":" pushes a new context before rendering its subtree, isolating child preferences"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Collect"}]},{"text":": After the subtree finishes, the modifier pops the context (merging into the parent) and fires the callback with the scoped result","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Discard"}],"type":"strong"},{"type":"text","text":": At the start of the next frame, everything resets: stale preferences never persist"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"This per-frame reset ensures preferences always reflect the current view tree. Removed views stop contributing automatically."}],"type":"paragraph"},{"text":"Reduce Strategies","type":"heading","level":2,"anchor":"Reduce-Strategies"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" function determines how multiple children’s values combine. Common patterns:","type":"text"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Strategy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use Case"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last value wins","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value = nextValue()"},{"text":" (default)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Titles, labels: deepest child wins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Additive"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value += nextValue()"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Counting items, summing heights"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Array collection"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"value.append(contentsOf: nextValue())"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Gathering menu items, breadcrumbs"}]}]]],"type":"table","header":"row"},{"code":["\/\/ Array collection example","struct BreadcrumbKey: PreferenceKey {","    static let defaultValue: [String] = []","","    static func reduce(value: inout [String], nextValue: () -> [String]) {","        value.append(contentsOf: nextValue())","    }","}"],"type":"codeListing","syntax":"swift"}]}],"metadata":{"modules":[{"name":"TUIkit"}],"title":"Preferences","roleHeading":"API Collection","role":"collectionGroup"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/TUIkit\/documentation\/TUIkit\/Preferences"},"kind":"article","hierarchy":{"paths":[["doc:\/\/TUIkit\/documentation\/TUIkit"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Pass data from child views up to their ancestors."}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","doc:\/\/TUIkit\/documentation\/TUIkit\/CustomViews","doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","doc:\/\/TUIkit\/documentation\/TUIkit\/ListAndTable","doc:\/\/TUIkit\/documentation\/TUIkit\/LayoutSystem","doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding"],"anchor":"Guides","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/tuikit\/preferences"]}],"topicSections":[{"title":"Protocols","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"],"anchor":"Protocols"},{"title":"Storage","identifiers":["doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceValues"],"anchor":"Storage"}],"references":{"doc://TUIkit/documentation/TUIkit/PaletteReference":{"title":"Palette Reference","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PaletteReference","url":"\/documentation\/tuikit\/palettereference","role":"collectionGroup","type":"topic","kind":"article","abstract":[{"type":"text","text":"A visual reference for all built-in color palettes with their exact color values."}]},"doc://TUIkit/documentation/TUIkit/StatusBarGuide":{"abstract":[{"text":"Configure the shortcut bar at the bottom of the terminal.","type":"text"}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StatusBarGuide","url":"\/documentation\/tuikit\/statusbarguide","title":"Status Bar"},"doc://TUIkit/documentation/TUIkit/PreferenceKey":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PreferenceKey"}],"title":"PreferenceKey","kind":"symbol","type":"topic","abstract":[{"text":"A key for defining preference values that propagate up the view hierarchy.","type":"text"}],"url":"\/documentation\/tuikit\/preferencekey","navigatorTitle":[{"kind":"identifier","text":"PreferenceKey"}],"role":"symbol","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/PreferenceKey"},"doc://TUIkit/documentation/TUIkit/AppearanceAndColors":{"kind":"article","title":"Appearance and Colors","url":"\/documentation\/tuikit\/appearanceandcolors","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/AppearanceAndColors","type":"topic","role":"article","abstract":[{"text":"Control border styles, visual appearances, and the color system.","type":"text"}]},"doc://TUIkit/documentation/TUIkit/ThemingGuide":{"type":"topic","abstract":[{"type":"text","text":"Customize the visual appearance of your TUIkit application with palettes."}],"title":"Theming Guide","kind":"article","role":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ThemingGuide","url":"\/documentation\/tuikit\/themingguide"},"doc://TUIkit/documentation/TUIkit":{"type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit","abstract":[{"type":"text","text":"A declarative, SwiftUI-like framework for building Terminal User Interfaces in Swift."}],"kind":"symbol","title":"TUIkit","role":"collection","images":[{"type":"icon","identifier":"tuikit-logo.png"},{"type":"card","identifier":"tuikit-logo.png"}],"url":"\/documentation\/tuikit"},"doc://TUIkit/documentation/TUIkit/StateManagement":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Manage reactive state in your TUIkit application."}],"kind":"article","title":"State Management","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/StateManagement","url":"\/documentation\/tuikit\/statemanagement"},"doc://TUIkit/documentation/TUIkit/KeyboardShortcuts":{"role":"collectionGroup","url":"\/documentation\/tuikit\/keyboardshortcuts","abstract":[{"type":"text","text":"How keyboard input flows through TUIkit: from raw terminal bytes to your view handlers."}],"kind":"article","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/KeyboardShortcuts","type":"topic","title":"Keyboard Shortcuts"},"tuikit-logo.png":{"variants":[{"url":"\/images\/TUIkit\/tuikit-logo.png","traits":["1x","light"]}],"identifier":"tuikit-logo.png","alt":"TUIkit Logo","type":"image"},"doc://TUIkit/documentation/TUIkit/ImageDecoding":{"role":"collectionGroup","type":"topic","kind":"article","url":"\/documentation\/tuikit\/imagedecoding","title":"Image Decoding","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/ImageDecoding","abstract":[{"type":"text","text":"Load static PNG and JPEG images safely on macOS and Linux."}]},"doc://TUIkit/documentation/TUIkit/NavigationTitleKey":{"url":"\/documentation\/tuikit\/navigationtitlekey","abstract":[{"type":"text","text":"A preference key for the navigation title."}],"identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/NavigationTitleKey","title":"NavigationTitleKey","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"NavigationTitleKey"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"NavigationTitleKey","kind":"identifier"}]},"doc://TUIkit/documentation/TUIkit/FocusSystem":{"kind":"article","abstract":[{"text":"Navigate between interactive elements using the keyboard.","type":"text"}],"role":"article","type":"topic","identifier":"doc:\/\/TUIkit\/documentation\/TUIkit\/FocusSystem","url":"\/documentation\/tuikit\/focussystem","title":"Focus System"},"doc://TUIkit/documentation/TUIkit/CustomViews":{"title":"Custom Views","abstract":[{"text":"Build your own views by composing existing ones or creating custom view modifiers.","type":"text"}],"type":"topic","kind":